Private Sub WriteParserRegressionReports( _
    ByRef oldDoc As tPdfDocument, _
    ByRef goodDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal detailOutputPath As String, _
    ByVal superShortOutputPath As String)

    Const METHOD_NAME As String = "WriteParserRegressionReports"
    Dim dictIssueCounts As Object
    Dim dictIssuePriorities As Object
    Dim dictIssueSamples As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngDetailFile As Long
    Dim lngMaxPages As Long
    Dim lngPage As Long

    On Error GoTo ErrorHandler

    Set dictIssueCounts = CreateObject("Scripting.Dictionary")
    Set dictIssuePriorities = CreateObject("Scripting.Dictionary")
    Set dictIssueSamples = CreateObject("Scripting.Dictionary")

    lngMaxPages = oldDoc.PageCount
    If goodDoc.PageCount > lngMaxPages Then
        lngMaxPages = goodDoc.PageCount
    End If
    If currentDoc.PageCount > lngMaxPages Then
        lngMaxPages = currentDoc.PageCount
    End If

    lngDetailFile = FreeFile
    Open detailOutputPath For Output Access Write As #lngDetailFile

    Print #lngDetailFile, "ORACLE_PARSER_REGRESSION_FORENSIC_V16"
    Print #lngDetailFile, "OLD_ORACLE|" & oldDoc.PdfPath
    Print #lngDetailFile, "PREVIOUS_GOOD|" & goodDoc.PdfPath
    Print #lngDetailFile, "CURRENT|" & currentDoc.PdfPath
    Print #lngDetailFile, "PURPOSE|Find parser-facing changes introduced between PREVIOUS_GOOD and CURRENT. OLD Oracle is a directional reference, not the only pass/fail target."
    Print #lngDetailFile, "REQUIREMENT|PREVIOUS_GOOD_AND_CURRENT_SHOULD_USE_THE_SAME_LOGICAL_REPORT_INPUT=TRUE"
    Print #lngDetailFile, "POLICY|Business-value differences are not treated as parser regressions. WKN content remains excluded. ISIN/currency/date text topology remains audited."
    Print #lngDetailFile, ""

    Call RegressionWriteDocumentHeader( _
        lngDetailFile, _
        oldDoc, _
        goodDoc, _
        currentDoc)

    If goodDoc.PageCount <> currentDoc.PageCount Then
        Call RegressionAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            "PAGE_COUNT_CHANGED", _
            3, _
            "GOOD=" & CStr(goodDoc.PageCount) & _
            "|CURRENT=" & CStr(currentDoc.PageCount) & _
            "|OLD=" & CStr(oldDoc.PageCount))
    End If

    For lngPage = 1 To lngMaxPages
        Call RegressionWritePageAnalysis( _
            lngDetailFile, _
            oldDoc, _
            goodDoc, _
            currentDoc, _
            lngPage, _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples)
    Next lngPage

    Close #lngDetailFile
    lngDetailFile = 0

    Call RegressionWriteSuperShortReport( _
        oldDoc, _
        goodDoc, _
        currentDoc, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples, _
        superShortOutputPath)

ExitSub:
    If lngDetailFile <> 0 Then
        Close #lngDetailFile
    End If
    Set dictIssueCounts = Nothing
    Set dictIssuePriorities = Nothing
    Set dictIssueSamples = Nothing
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "detailOutputPath;superShortOutputPath", _
        detailOutputPath, _
        superShortOutputPath

    errorManager.save
    Resume ExitSub
End Sub

Private Sub RegressionWriteDocumentHeader( _
    ByVal fileNo As Long, _
    ByRef oldDoc As tPdfDocument, _
    ByRef goodDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument)

    Print #fileNo, "DOCUMENT_STRUCTURE"
    Print #fileNo, _
        "DOC|role=OLD_ORACLE" & _
        "|version=" & oldDoc.PdfVersion & _
        "|xref=" & oldDoc.XrefKind & _
        "|pages=" & CStr(oldDoc.PageCount) & _
        "|objects=" & CStr(oldDoc.ObjectCount) & _
        "|bytes=" & CStr(oldDoc.FileSize)

    Print #fileNo, _
        "DOC|role=PREVIOUS_GOOD" & _
        "|version=" & goodDoc.PdfVersion & _
        "|xref=" & goodDoc.XrefKind & _
        "|pages=" & CStr(goodDoc.PageCount) & _
        "|objects=" & CStr(goodDoc.ObjectCount) & _
        "|bytes=" & CStr(goodDoc.FileSize)

    Print #fileNo, _
        "DOC|role=CURRENT" & _
        "|version=" & currentDoc.PdfVersion & _
        "|xref=" & currentDoc.XrefKind & _
        "|pages=" & CStr(currentDoc.PageCount) & _
        "|objects=" & CStr(currentDoc.ObjectCount) & _
        "|bytes=" & CStr(currentDoc.FileSize)

    Print #fileNo, ""
End Sub

Private Sub RegressionWritePageAnalysis( _
    ByVal fileNo As Long, _
    ByRef oldDoc As tPdfDocument, _
    ByRef goodDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Const METHOD_NAME As String = "RegressionWritePageAnalysis"
    Dim currentContextMap As Object
    Dim dictCurrentProfile As Object
    Dim dictGoodProfile As Object
    Dim dictOldProfile As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim goodContextMap As Object
    Dim oldContextMap As Object
    Dim strCurrent As String
    Dim strDirection As String
    Dim strGood As String
    Dim strOld As String

    On Error GoTo ErrorHandler

    Print #fileNo, "================================================================"
    Print #fileNo, "PAGE|" & CStr(pageNo)
    Print #fileNo, "================================================================"

    If pageNo > oldDoc.PageCount Or _
       pageNo > goodDoc.PageCount Or _
       pageNo > currentDoc.PageCount Then

        Print #fileNo, _
            "PAGE_PRESENCE" & _
            "|OLD=" & BoolText(pageNo <= oldDoc.PageCount) & _
            "|GOOD=" & BoolText(pageNo <= goodDoc.PageCount) & _
            "|CURRENT=" & BoolText(pageNo <= currentDoc.PageCount)

        Call RegressionAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            "PAGE_MISSING_IN_TRIAD", _
            3, _
            "page=" & CStr(pageNo) & _
            "|OLD=" & BoolText(pageNo <= oldDoc.PageCount) & _
            "|GOOD=" & BoolText(pageNo <= goodDoc.PageCount) & _
            "|CURRENT=" & BoolText(pageNo <= currentDoc.PageCount))

        GoTo ExitSub
    End If

    Print #fileNo, _
        "STREAM_META" & _
        "|OLD_refs=" & oldDoc.Pages(pageNo).ContentReferences & _
        "|GOOD_refs=" & goodDoc.Pages(pageNo).ContentReferences & _
        "|CURRENT_refs=" & currentDoc.Pages(pageNo).ContentReferences & _
        "|OLD_len=" & CStr(oldDoc.Pages(pageNo).ContentLength) & _
        "|GOOD_len=" & CStr(goodDoc.Pages(pageNo).ContentLength) & _
        "|CURRENT_len=" & CStr(currentDoc.Pages(pageNo).ContentLength)

    Print #fileNo, _
        "RESOURCES_RAW" & _
        "|OLD=" & RegressionLimitText(oldDoc.Pages(pageNo).ResourcesDictionary, 1200) & _
        "|GOOD=" & RegressionLimitText(goodDoc.Pages(pageNo).ResourcesDictionary, 1200) & _
        "|CURRENT=" & RegressionLimitText(currentDoc.Pages(pageNo).ResourcesDictionary, 1200)

    Call RegressionCompareAndRecord( _
        fileNo, _
        pageNo, _
        "CONTENT_STREAM_SHAPE", _
        RegressionContentReferenceShape(oldDoc.Pages(pageNo).ContentReferences), _
        RegressionContentReferenceShape(goodDoc.Pages(pageNo).ContentReferences), _
        RegressionContentReferenceShape(currentDoc.Pages(pageNo).ContentReferences), _
        2, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Call RegressionCompareAndRecord( _
        fileNo, _
        pageNo, _
        "CONTENT_FILTERS", _
        oldDoc.Pages(pageNo).ContentFilters, _
        goodDoc.Pages(pageNo).ContentFilters, _
        currentDoc.Pages(pageNo).ContentFilters, _
        2, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Call RegressionCompareAndRecord( _
        fileNo, _
        pageNo, _
        "FONT_RESOURCE_BINDING", _
        oldDoc.Pages(pageNo).ResolvedFonts, _
        goodDoc.Pages(pageNo).ResolvedFonts, _
        currentDoc.Pages(pageNo).ResolvedFonts, _
        2, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Call RegressionCompareAndRecord( _
        fileNo, _
        pageNo, _
        "FONT_RESOURCE_FORENSIC", _
        RegressionStripFontObjectNumbers(oldDoc.Pages(pageNo).FontForensicSignature), _
        RegressionStripFontObjectNumbers(goodDoc.Pages(pageNo).FontForensicSignature), _
        RegressionStripFontObjectNumbers(currentDoc.Pages(pageNo).FontForensicSignature), _
        2, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Set dictOldProfile = BuildOperatorProfileDictionary(oldDoc.Pages(pageNo).ContentText)
    Set dictGoodProfile = BuildOperatorProfileDictionary(goodDoc.Pages(pageNo).ContentText)
    Set dictCurrentProfile = BuildOperatorProfileDictionary(currentDoc.Pages(pageNo).ContentText)

    Call RegressionCompareAndRecord( _
        fileNo, _
        pageNo, _
        "OPERATOR_PROFILE_COUNTS", _
        DictionaryCountSignature(dictOldProfile), _
        DictionaryCountSignature(dictGoodProfile), _
        DictionaryCountSignature(dictCurrentProfile), _
        1, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    strOld = RegressionOperatorSequenceSignature( _
        oldDoc.Pages(pageNo).ContentText, _
        False)

    strGood = RegressionOperatorSequenceSignature( _
        goodDoc.Pages(pageNo).ContentText, _
        False)

    strCurrent = RegressionOperatorSequenceSignature( _
        currentDoc.Pages(pageNo).ContentText, _
        False)

    If strGood <> strCurrent Then
        strDirection = RegressionDirection(strOld, strGood, strCurrent)

        Print #fileNo, _
            "OPERATOR_ORDER_DIFF" & _
            "|direction=" & strDirection & _
            "|" & RegressionFirstOperatorDifferenceSummary( _
                goodDoc.Pages(pageNo).ContentText, _
                currentDoc.Pages(pageNo).ContentText, _
                False)

        Call RegressionAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            "OPERATOR_ORDER_CHANGED", _
            RegressionPriorityFromDirection(strDirection, 2), _
            "page=" & CStr(pageNo) & _
            "|direction=" & strDirection & _
            "|" & RegressionFirstOperatorDifferenceSummary( _
                goodDoc.Pages(pageNo).ContentText, _
                currentDoc.Pages(pageNo).ContentText, _
                False))
    Else
        Print #fileNo, "OPERATOR_ORDER|GOOD=CURRENT"
    End If

    strOld = RegressionOperatorSequenceSignature( _
        oldDoc.Pages(pageNo).ContentText, _
        True)

    strGood = RegressionOperatorSequenceSignature( _
        goodDoc.Pages(pageNo).ContentText, _
        True)

    strCurrent = RegressionOperatorSequenceSignature( _
        currentDoc.Pages(pageNo).ContentText, _
        True)

    If strGood <> strCurrent Then
        strDirection = RegressionDirection(strOld, strGood, strCurrent)

        Print #fileNo, _
            "OPERATOR_SERIALIZATION_DIFF" & _
            "|direction=" & strDirection & _
            "|" & RegressionFirstOperatorDifferenceSummary( _
                goodDoc.Pages(pageNo).ContentText, _
                currentDoc.Pages(pageNo).ContentText, _
                True)

        Call RegressionAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            "OPERATOR_SERIALIZATION_CHANGED", _
            RegressionPriorityFromDirection(strDirection, 2), _
            "page=" & CStr(pageNo) & _
            "|direction=" & strDirection & _
            "|" & RegressionFirstOperatorDifferenceSummary( _
                goodDoc.Pages(pageNo).ContentText, _
                currentDoc.Pages(pageNo).ContentText, _
                True))
    Else
        Print #fileNo, "OPERATOR_SERIALIZATION|GOOD=CURRENT"
    End If

    Call RegressionCompareAndRecord( _
        fileNo, _
        pageNo, _
        "INVISIBLE_RECTANGLE_PROFILE", _
        RegressionInvisibleRectangleSignature(oldDoc.Pages(pageNo).ContentText), _
        RegressionInvisibleRectangleSignature(goodDoc.Pages(pageNo).ContentText), _
        RegressionInvisibleRectangleSignature(currentDoc.Pages(pageNo).ContentText), _
        3, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Call RegressionCompareSeparatorFamily( _
        fileNo, _
        pageNo, _
        TARGET_X_FIRST, _
        oldDoc, _
        goodDoc, _
        currentDoc, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Call RegressionCompareSeparatorFamily( _
        fileNo, _
        pageNo, _
        TARGET_X_SECOND, _
        oldDoc, _
        goodDoc, _
        currentDoc, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Set oldContextMap = RegressionBuildTextContextMap( _
        oldDoc.Pages(pageNo).ContentText)

    Set goodContextMap = RegressionBuildTextContextMap( _
        goodDoc.Pages(pageNo).ContentText)

    Set currentContextMap = RegressionBuildTextContextMap( _
        currentDoc.Pages(pageNo).ContentText)

    Call RegressionCompareTargetTextContexts( _
        fileNo, _
        pageNo, _
        oldDoc, _
        goodDoc, _
        currentDoc, _
        oldContextMap, _
        goodContextMap, _
        currentContextMap, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Print #fileNo, ""

ExitSub:
    Set currentContextMap = Nothing
    Set dictCurrentProfile = Nothing
    Set dictGoodProfile = Nothing
    Set dictOldProfile = Nothing
    Set goodContextMap = Nothing
    Set oldContextMap = Nothing
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo", _
        pageNo

    errorManager.save
    Resume ExitSub
End Sub

Private Sub RegressionCompareAndRecord( _
    ByVal fileNo As Long, _
    ByVal pageNo As Long, _
    ByVal family As String, _
    ByVal oldSignature As String, _
    ByVal goodSignature As String, _
    ByVal currentSignature As String, _
    ByVal basePriority As Long, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim lngPriority As Long
    Dim strDirection As String

    strDirection = RegressionDirection( _
        oldSignature, _
        goodSignature, _
        currentSignature)

    Print #fileNo, _
        "TRIAD" & _
        "|family=" & family & _
        "|direction=" & strDirection & _
        "|OLD=" & RegressionLimitText(oldSignature, 900) & _
        "|GOOD=" & RegressionLimitText(goodSignature, 900) & _
        "|CURRENT=" & RegressionLimitText(currentSignature, 900)

    If goodSignature <> currentSignature Then
        lngPriority = RegressionPriorityFromDirection( _
            strDirection, _
            basePriority)

        Call RegressionAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            family, _
            lngPriority, _
            "page=" & CStr(pageNo) & _
            "|direction=" & strDirection & _
            "|GOOD=" & RegressionLimitText(goodSignature, 500) & _
            "|CURRENT=" & RegressionLimitText(currentSignature, 500))
    End If
End Sub

Private Sub RegressionCompareSeparatorFamily( _
    ByVal fileNo As Long, _
    ByVal pageNo As Long, _
    ByVal targetX As Double, _
    ByRef oldDoc As tPdfDocument, _
    ByRef goodDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim strFamily As String
    Dim strTarget As String

    strTarget = Replace(NumTxt(targetX), ".", "_")

    strFamily = "VISIBLE_SEPARATOR_ENCODING_X" & strTarget
    Call RegressionCompareAndRecord( _
        fileNo, _
        pageNo, _
        strFamily, _
        RegressionVisibleSeparatorSignature(oldDoc, pageNo, targetX), _
        RegressionVisibleSeparatorSignature(goodDoc, pageNo, targetX), _
        RegressionVisibleSeparatorSignature(currentDoc, pageNo, targetX), _
        3, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    strFamily = "RECTANGLE_EDGE_TOPOLOGY_X" & strTarget
    Call RegressionCompareAndRecord( _
        fileNo, _
        pageNo, _
        strFamily, _
        RegressionRectangleEdgeSignature(oldDoc.Pages(pageNo).ContentText, targetX), _
        RegressionRectangleEdgeSignature(goodDoc.Pages(pageNo).ContentText, targetX), _
        RegressionRectangleEdgeSignature(currentDoc.Pages(pageNo).ContentText, targetX), _
        3, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)
End Sub

Private Function RegressionVisibleSeparatorSignature( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal targetX As Double) As String

    Const METHOD_NAME As String = "RegressionVisibleSeparatorSignature"
    Dim dictLines As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngStart As Long
    Dim strKey As String

    On Error GoTo ErrorHandler

    Set dictLines = CreateObject("Scripting.Dictionary")

    If pageNo < 1 Or pageNo > pdfDoc.PageCount Then
        RegressionVisibleSeparatorSignature = "(page-missing)"
        GoTo ExitFunction
    End If

    lngStart = pdfDoc.Pages(pageNo).LineStart
    lngEnd = lngStart + pdfDoc.Pages(pageNo).LineCount - 1

    For lngIndex = lngStart To lngEnd
        If IsVerticalAtX( _
            pdfDoc.Lines(lngIndex), _
            targetX) Then

            strKey = _
                "y=" & NumTxt(WorksheetFunction.Min( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)) & _
                ".." & _
                NumTxt(WorksheetFunction.Max( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)) & _
                ",w=" & NumTxt(pdfDoc.Lines(lngIndex).LineWidth) & _
                ",paint=" & pdfDoc.Lines(lngIndex).PaintOperator & _
                ",source=" & pdfDoc.Lines(lngIndex).SourceOperator & _
                ",stroke=" & pdfDoc.Lines(lngIndex).StrokeColor

            Call IncrementDictionaryValue(dictLines, strKey)
        End If
    Next lngIndex

    If dictLines.Count = 0 Then
        RegressionVisibleSeparatorSignature = "(none)"
    Else
        RegressionVisibleSeparatorSignature = DictionaryCountSignature(dictLines)
    End If

ExitFunction:
    Set dictLines = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    RegressionVisibleSeparatorSignature = "(error)"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo;targetX", _
        pageNo, _
        targetX

    errorManager.save
    Resume ExitFunction
End Function

