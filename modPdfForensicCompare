    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "oldPdfPath;newPdfPath;auditPath;detailPath;breaksPath;breaksSummaryPath;breaksSuperShortPath", _
