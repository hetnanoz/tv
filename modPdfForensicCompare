Private Function RegressionStripFontObjectNumbers( _
    ByVal forensicSignature As String) As String

    Const METHOD_NAME As String = "RegressionStripFontObjectNumbers"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngEnd As Long
    Dim lngStart As Long
    Dim strResult As String

    On Error GoTo ErrorHandler

    strResult = forensicSignature
    lngStart = InStr(1, strResult, "|obj=", vbBinaryCompare)

    Do While lngStart > 0
        lngEnd = InStr(lngStart + 5, strResult, "|", vbBinaryCompare)

        If lngEnd = 0 Then
            strResult = Left$(strResult, lngStart - 1)
            Exit Do
        End If

        strResult = _
            Left$(strResult, lngStart - 1) & _
            Mid$(strResult, lngEnd)

        lngStart = InStr(lngStart, strResult, "|obj=", vbBinaryCompare)
    Loop

    RegressionStripFontObjectNumbers = strResult

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    RegressionStripFontObjectNumbers = forensicSignature

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionDirection( _
    ByVal oldSignature As String, _
    ByVal goodSignature As String, _
    ByVal currentSignature As String) As String

    If goodSignature = currentSignature Then
        RegressionDirection = "STABLE_GOOD_TO_CURRENT"
    ElseIf goodSignature = oldSignature And _
           currentSignature <> oldSignature Then
        RegressionDirection = "REGRESSED_FROM_OLD_MATCH"
    ElseIf currentSignature = oldSignature And _
           goodSignature <> oldSignature Then
        RegressionDirection = "MOVED_TOWARD_OLD"
    ElseIf goodSignature <> oldSignature And _
           currentSignature <> oldSignature Then
        RegressionDirection = "CHANGED_BETWEEN_GENERATED"
    Else
        RegressionDirection = "CHANGED"
    End If
End Function

Private Function RegressionPriorityFromDirection( _
    ByVal direction As String, _
    ByVal basePriority As Long) As Long

    RegressionPriorityFromDirection = basePriority

    If direction = "REGRESSED_FROM_OLD_MATCH" Then
        If RegressionPriorityFromDirection < 3 Then
            RegressionPriorityFromDirection = _
                RegressionPriorityFromDirection + 1
        End If
    ElseIf direction = "MOVED_TOWARD_OLD" Then
        If RegressionPriorityFromDirection > 1 Then
            RegressionPriorityFromDirection = _
                RegressionPriorityFromDirection - 1
        End If
    End If
End Function

Private Function RegressionLimitText( _
    ByVal textValue As String, _
    ByVal maxLength As Long) As String

    Dim strResult As String

    strResult = SanitizeReportText(textValue)

    If maxLength > 0 And Len(strResult) > maxLength Then
        strResult = Left$(strResult, maxLength) & "...[truncated]"
    End If

    RegressionLimitText = strResult
End Function

Private Sub RegressionAddIssue( _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object, _
    ByVal family As String, _
    ByVal priority As Long, _
    ByVal sample As String)

    Const MAX_SAMPLES_PER_FAMILY As Long = 4
    Dim lngCount As Long
    Dim lngExistingPriority As Long
    Dim lngSampleNo As Long
    Dim strSampleKey As String

    If dictIssueCounts.Exists(family) Then
        lngCount = CLng(dictIssueCounts(family)) + 1
    Else
        lngCount = 1
    End If
    dictIssueCounts(family) = lngCount

    If dictIssuePriorities.Exists(family) Then
        lngExistingPriority = CLng(dictIssuePriorities(family))
        If priority > lngExistingPriority Then
            dictIssuePriorities(family) = priority
        End If
    Else
        dictIssuePriorities(family) = priority
    End If

    For lngSampleNo = 1 To MAX_SAMPLES_PER_FAMILY
        strSampleKey = family & "|" & CStr(lngSampleNo)

        If Not dictIssueSamples.Exists(strSampleKey) Then
            dictIssueSamples(strSampleKey) = _
                RegressionLimitText(sample, 1400)
            Exit For
        End If
    Next lngSampleNo
End Sub

Private Function RegressionPriorityLabel( _
    ByVal priority As Long) As String

    Select Case priority
        Case Is >= 3
            RegressionPriorityLabel = "CRITICAL"
        Case 2
            RegressionPriorityLabel = "HIGH"
        Case Else
            RegressionPriorityLabel = "REVIEW"
    End Select
End Function

Private Function RegressionOperatorSequenceSignature( _
    ByVal content As String, _
    ByVal includeOperands As Boolean) As String

    Const METHOD_NAME As String = "RegressionOperatorSequenceSignature"
    Dim arrTokens() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim h0 As String
    Dim h1 As String
    Dim h2 As String
    Dim h3 As String
    Dim h4 As String
    Dim h5 As String
    Dim lngIndex As Long
    Dim lngTokenCount As Long
    Dim strResult As String
    Dim strToken As String

    On Error GoTo ErrorHandler

    lngTokenCount = Tokenize(content, arrTokens)

    For lngIndex = 0 To lngTokenCount - 1
        strToken = arrTokens(lngIndex)

        If IsAuditOperator(strToken) Then
            If Len(strResult) > 0 Then
                strResult = strResult & ";"
            End If

            If includeOperands Then
                strResult = strResult & _
                    RegressionOperatorSummary( _
                        strToken, _
                        h0, _
                        h1, _
                        h2, _
                        h3, _
                        h4, _
                        h5)
            Else
                strResult = strResult & strToken
            End If
        End If

        h5 = h4
        h4 = h3
        h3 = h2
        h2 = h1
        h1 = h0
        h0 = strToken
    Next lngIndex

    RegressionOperatorSequenceSignature = strResult

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    RegressionOperatorSequenceSignature = "(error)"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "contentLength;includeOperands", _
        Len(content), _
        includeOperands

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionFirstOperatorDifferenceSummary( _
    ByVal goodContent As String, _
    ByVal currentContent As String, _
    ByVal includeOperands As Boolean) As String

    Const METHOD_NAME As String = "RegressionFirstOperatorDifferenceSummary"
    Dim arrCurrent() As String
    Dim arrGood() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCurrentCount As Long
    Dim lngGoodCount As Long
    Dim lngIndex As Long
    Dim lngLimit As Long

    On Error GoTo ErrorHandler

    lngGoodCount = RegressionBuildOperatorEventArray( _
        goodContent, _
        includeOperands, _
        arrGood)

    lngCurrentCount = RegressionBuildOperatorEventArray( _
        currentContent, _
        includeOperands, _
        arrCurrent)

    lngLimit = lngGoodCount
    If lngCurrentCount < lngLimit Then
        lngLimit = lngCurrentCount
    End If

    For lngIndex = 0 To lngLimit - 1
        If arrGood(lngIndex) <> arrCurrent(lngIndex) Then
            RegressionFirstOperatorDifferenceSummary = _
                "firstDiffOrdinal=" & CStr(lngIndex + 1) & _
                "|GOOD_WINDOW=" & _
                RegressionArrayWindow(arrGood, lngGoodCount, lngIndex, 5) & _
                "|CURRENT_WINDOW=" & _
                RegressionArrayWindow(arrCurrent, lngCurrentCount, lngIndex, 5)
            GoTo ExitFunction
        End If
    Next lngIndex

    If lngGoodCount <> lngCurrentCount Then
        RegressionFirstOperatorDifferenceSummary = _
            "firstDiffOrdinal=" & CStr(lngLimit + 1) & _
            "|GOOD_COUNT=" & CStr(lngGoodCount) & _
            "|CURRENT_COUNT=" & CStr(lngCurrentCount) & _
            "|GOOD_TAIL=" & _
            RegressionArrayWindow(arrGood, lngGoodCount, lngLimit, 5) & _
            "|CURRENT_TAIL=" & _
            RegressionArrayWindow(arrCurrent, lngCurrentCount, lngLimit, 5)
    Else
        RegressionFirstOperatorDifferenceSummary = _
            "firstDiffOrdinal=(none)"
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    RegressionFirstOperatorDifferenceSummary = "(error)"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "includeOperands", _
        includeOperands

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionBuildOperatorEventArray( _
    ByVal content As String, _
    ByVal includeOperands As Boolean, _
    ByRef events() As String) As Long

    Const METHOD_NAME As String = "RegressionBuildOperatorEventArray"
    Dim arrTokens() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim h0 As String
    Dim h1 As String
    Dim h2 As String
    Dim h3 As String
    Dim h4 As String
    Dim h5 As String
    Dim lngCount As Long
    Dim lngIndex As Long
    Dim lngTokenCount As Long
    Dim strToken As String

    On Error GoTo ErrorHandler

    lngTokenCount = Tokenize(content, arrTokens)
    ReDim events(0 To lngTokenCount)

    For lngIndex = 0 To lngTokenCount - 1
        strToken = arrTokens(lngIndex)

        If IsAuditOperator(strToken) Then
            If includeOperands Then
                events(lngCount) = _
                    RegressionOperatorSummary( _
                        strToken, _
                        h0, _
                        h1, _
                        h2, _
                        h3, _
                        h4, _
                        h5)
            Else
                events(lngCount) = strToken
            End If

            lngCount = lngCount + 1
        End If

        h5 = h4
        h4 = h3
        h3 = h2
        h2 = h1
        h1 = h0
        h0 = strToken
    Next lngIndex

    RegressionBuildOperatorEventArray = lngCount

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ReDim events(0 To 0)
    RegressionBuildOperatorEventArray = 0

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionOperatorSummary( _
    ByVal operatorName As String, _
    ByVal h0 As String, _
    ByVal h1 As String, _
    ByVal h2 As String, _
    ByVal h3 As String, _
    ByVal h4 As String, _
    ByVal h5 As String) As String

    Select Case operatorName
        Case "Tf"
            RegressionOperatorSummary = _
                "Tf(" & h1 & "," & h0 & ")"

        Case "Tm", "cm"
            RegressionOperatorSummary = _
                operatorName & _
                "(" & h5 & "," & h4 & "," & h3 & "," & _
                h2 & "," & h1 & "," & h0 & ")"

        Case "Td", "TD", "m", "l"
            RegressionOperatorSummary = _
                operatorName & "(" & h1 & "," & h0 & ")"

        Case "re"
            RegressionOperatorSummary = _
                "re(" & h3 & "," & h2 & "," & h1 & "," & h0 & ")"

        Case "w", "G", "g", "J", "j", "M", "Tr", "Tc", "Tw", "Tz", "Ts"
            RegressionOperatorSummary = _
                operatorName & "(" & h0 & ")"

        Case "RG", "rg"
            RegressionOperatorSummary = _
                operatorName & "(" & h2 & "," & h1 & "," & h0 & ")"

        Case "K", "k"
            RegressionOperatorSummary = _
                operatorName & _
                "(" & h3 & "," & h2 & "," & h1 & "," & h0 & ")"

        Case "Do"
            RegressionOperatorSummary = _
                "Do(" & h0 & ")"

        Case "Tj", "'", """", "TJ"
            RegressionOperatorSummary = operatorName & "(<TEXT>)"

        Case Else
            RegressionOperatorSummary = operatorName
    End Select
End Function

Private Function RegressionArrayWindow( _
    ByRef values() As String, _
    ByVal valueCount As Long, _
    ByVal centreIndex As Long, _
    ByVal radius As Long) As String

    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngStart As Long
    Dim strResult As String

    If valueCount <= 0 Then
        RegressionArrayWindow = "(none)"
        Exit Function
    End If

    lngStart = centreIndex - radius
    If lngStart < 0 Then
        lngStart = 0
    End If

    lngEnd = centreIndex + radius
    If lngEnd > valueCount - 1 Then
        lngEnd = valueCount - 1
    End If

    For lngIndex = lngStart To lngEnd
        If Len(strResult) > 0 Then
            strResult = strResult & ">"
        End If

        strResult = strResult & _
            CStr(lngIndex + 1) & ":" & values(lngIndex)
    Next lngIndex

    RegressionArrayWindow = RegressionLimitText(strResult, 1400)
End Function

