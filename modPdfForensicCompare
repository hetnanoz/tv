Private Function RegressionTextFontSemanticSignature( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal textIndex As Long) As String

    Dim strAlias As String
    Dim strSemantic As String

    If pageNo < 1 Or pageNo > pdfDoc.PageCount Then
        RegressionTextFontSemanticSignature = "(page-missing)"
        Exit Function
    End If

    If textIndex < 0 Or textIndex >= pdfDoc.TextCount Then
        RegressionTextFontSemanticSignature = "(text-missing)"
        Exit Function
    End If

    strAlias = pdfDoc.Texts(textIndex).FontName
    strSemantic = RegressionFontSemanticForAlias( _
        pdfDoc.Pages(pageNo).ResolvedFonts, _
        strAlias)

    RegressionTextFontSemanticSignature = _
        "semantic=" & strSemantic & _
        "|size=" & NumTxt(pdfDoc.Texts(textIndex).FontSize)
End Function

Private Function RegressionFontSemanticForAlias( _
    ByVal resolvedFonts As String, _
    ByVal fontAlias As String) As String

    Dim arrEntries As Variant
    Dim lngIndex As Long
    Dim strEntry As String
    Dim strPrefix As String

    If Len(fontAlias) = 0 Then
        RegressionFontSemanticForAlias = "(alias-missing)"
        Exit Function
    End If

    strPrefix = fontAlias & "="
    arrEntries = Split(resolvedFonts, ";")

    For lngIndex = LBound(arrEntries) To UBound(arrEntries)
        strEntry = CStr(arrEntries(lngIndex))

        If Left$(strEntry, Len(strPrefix)) = strPrefix Then
            RegressionFontSemanticForAlias = _
                Mid$(strEntry, Len(strPrefix) + 1)
            Exit Function
        End If
    Next lngIndex

    RegressionFontSemanticForAlias = "(unresolved)"
End Function

Private Sub RegressionWriteSuperShortReport( _
    ByRef oldDoc As tPdfDocument, _
    ByRef goodDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object, _
    ByVal outputPath As String)

    Const METHOD_NAME As String = "RegressionWriteSuperShortReport"
    Dim arrKeys As Variant
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCriticalEvents As Long
    Dim lngFile As Long
    Dim lngHighEvents As Long
    Dim lngIndex As Long
    Dim lngPriority As Long
    Dim lngReviewEvents As Long
    Dim lngSampleNo As Long
    Dim strFamily As String
    Dim strSampleKey As String
    Dim strStatus As String

    On Error GoTo ErrorHandler

    If dictIssueCounts.Count = 0 Then
        strStatus = "NO_GOOD_TO_CURRENT_PARSER_REGRESSION_FOUND"
    Else
        strStatus = "ACTION_REQUIRED"
    End If

    If dictIssueCounts.Count > 0 Then
        arrKeys = SortedDictionaryKeys(dictIssueCounts)

        For lngIndex = LBound(arrKeys) To UBound(arrKeys)
            strFamily = CStr(arrKeys(lngIndex))
            lngPriority = CLng(dictIssuePriorities(strFamily))

            Select Case lngPriority
                Case Is >= 3
                    lngCriticalEvents = _
                        lngCriticalEvents + _
                        CLng(dictIssueCounts(strFamily))
                Case 2
                    lngHighEvents = _
                        lngHighEvents + _
                        CLng(dictIssueCounts(strFamily))
                Case Else
                    lngReviewEvents = _
                        lngReviewEvents + _
                        CLng(dictIssueCounts(strFamily))
            End Select
        Next lngIndex
    End If

    lngFile = FreeFile
    Open outputPath For Output Access Write As #lngFile

    Print #lngFile, "ORACLE_PARSER_REGRESSION_SUPER_SHORT_V16"
    Print #lngFile, "OLD_ORACLE|" & oldDoc.PdfPath
    Print #lngFile, "PREVIOUS_GOOD|" & goodDoc.PdfPath
    Print #lngFile, "CURRENT|" & currentDoc.PdfPath
    Print #lngFile, _
        "RESULT|status=" & strStatus & _
        "|families=" & CStr(dictIssueCounts.Count) & _
        "|criticalEvents=" & CStr(lngCriticalEvents) & _
        "|highEvents=" & CStr(lngHighEvents) & _
        "|reviewEvents=" & CStr(lngReviewEvents) & _
        "|pagesOld=" & CStr(oldDoc.PageCount) & _
        "|pagesGood=" & CStr(goodDoc.PageCount) & _
        "|pagesCurrent=" & CStr(currentDoc.PageCount)

    Print #lngFile, _
        "SCOPE|This report asks what changed from PREVIOUS_GOOD to CURRENT at parser-facing PDF-stream level. OLD Oracle is used only to tell whether the change moved away from or toward the Oracle structure."

    Print #lngFile, _
        "IMPORTANT|A clean V15 optical audit is not sufficient. V16 checks operator order, operator operands, re/n invisible paths, separator source encoding, font binding and local text operator windows."

    Print #lngFile, ""

    If dictIssueCounts.Count = 0 Then
        Print #lngFile, "BREAKING_REGRESSION_SIGNALS|NONE"
        Print #lngFile, _
            "NEXT|No parser-facing regression was found between the selected GOOD and CURRENT binaries. Verify that these are the exact files sent/tested by the client and that GOOD/CURRENT were generated from the same logical input."
        GoTo ExitSub
    End If

    Print #lngFile, "BREAKING_REGRESSION_SIGNALS"

    For lngPriority = 3 To 1 Step -1
        arrKeys = SortedDictionaryKeys(dictIssueCounts)

        For lngIndex = LBound(arrKeys) To UBound(arrKeys)
            strFamily = CStr(arrKeys(lngIndex))

            If CLng(dictIssuePriorities(strFamily)) = lngPriority Then
                Print #lngFile, _
                    "ISSUE" & _
                    "|priority=" & RegressionPriorityLabel(lngPriority) & _
                    "|family=" & strFamily & _
                    "|count=" & CStr(dictIssueCounts(strFamily))

                For lngSampleNo = 1 To 2
                    strSampleKey = _
                        strFamily & "|" & CStr(lngSampleNo)

                    If dictIssueSamples.Exists(strSampleKey) Then
                        Print #lngFile, _
                            "DETAIL" & _
                            "|family=" & strFamily & _
                            "|" & CStr(dictIssueSamples(strSampleKey))
                    End If
                Next lngSampleNo
            End If
        Next lngIndex
    Next lngPriority

    Print #lngFile, ""
    Print #lngFile, "HYPOTHESIS_RANKING"
    Call RegressionWriteHypothesisRanking( _
        lngFile, _
        dictIssueCounts)

    Print #lngFile, ""
    Print #lngFile, _
        "NEXT|Fix only the highest-ranked GOOD-to-CURRENT regression families first. Keep FIX34 business formatting unless this report explicitly ties it to a parser-facing stream change. Then regenerate the same input and rerun V16."

ExitSub:
    If lngFile <> 0 Then
        Close #lngFile
    End If
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "outputPath", _
        outputPath

    errorManager.save
    Resume ExitSub
End Sub

Private Sub RegressionWriteHypothesisRanking( _
    ByVal fileNo As Long, _
    ByVal dictIssueCounts As Object)

    Dim lngRank As Long

    lngRank = 1

    If RegressionDictionaryHasPrefix( _
        dictIssueCounts, _
        "TARGET_OPERATOR_WINDOW_") Or _
       RegressionDictionaryHasPrefix( _
        dictIssueCounts, _
        "TARGET_PATH_NEIGHBOR_") Then

        Print #fileNo, _
            "HYPOTHESIS|rank=" & CStr(lngRank) & _
            "|name=TEXT_LOCAL_OPERATOR_TOPOLOGY" & _
            "|reason=ISIN/currency/date text is surrounded by a different operator sequence or by different nearest path operators in CURRENT than in PREVIOUS_GOOD."
        lngRank = lngRank + 1
    End If

    If RegressionDictionaryHasPrefix( _
        dictIssueCounts, _
        "RECTANGLE_EDGE_TOPOLOGY_X") Or _
       dictIssueCounts.Exists("INVISIBLE_RECTANGLE_PROFILE") Or _
       RegressionDictionaryHasPrefix( _
        dictIssueCounts, _
        "VISIBLE_SEPARATOR_ENCODING_X") Then

        Print #fileNo, _
            "HYPOTHESIS|rank=" & CStr(lngRank) & _
            "|name=SEPARATOR_OR_INVISIBLE_RECTANGLE_ENCODING" & _
            "|reason=The same visual cell boundary may be serialized differently (m/l versus re, different paint finalizer, or invisible re n path). A primitive parser can treat these as different cells."
        lngRank = lngRank + 1
    End If

    If dictIssueCounts.Exists("OPERATOR_ORDER_CHANGED") Or _
       dictIssueCounts.Exists("OPERATOR_SERIALIZATION_CHANGED") Then

        Print #fileNo, _
            "HYPOTHESIS|rank=" & CStr(lngRank) & _
            "|name=CONTENT_STREAM_SERIALIZATION" & _
            "|reason=Operator counts can be identical while the actual order/operands differ. This is precisely the class of difference V15 could classify as compatible."
        lngRank = lngRank + 1
    End If

    If RegressionDictionaryHasPrefix( _
        dictIssueCounts, _
        "TARGET_FONT_") Or _
       dictIssueCounts.Exists("FONT_RESOURCE_BINDING") Or _
       dictIssueCounts.Exists("FONT_RESOURCE_FORENSIC") Then

        Print #fileNo, _
            "HYPOTHESIS|rank=" & CStr(lngRank) & _
            "|name=FONT_RESOURCE_BINDING" & _
            "|reason=The local font alias/size or semantic resource behind text changed between GOOD and CURRENT."
        lngRank = lngRank + 1
    End If

    If dictIssueCounts.Exists("CONTENT_STREAM_SHAPE") Or _
       dictIssueCounts.Exists("CONTENT_FILTERS") Then

        Print #fileNo, _
            "HYPOTHESIS|rank=" & CStr(lngRank) & _
            "|name=PAGE_CONTENT_STREAM_TOPOLOGY" & _
            "|reason=The number of content streams or their filter structure changed between GOOD and CURRENT."
        lngRank = lngRank + 1
    End If

    If lngRank = 1 Then
        Print #fileNo, _
            "HYPOTHESIS|rank=1|name=NO_REGRESSION_SIGNAL|reason=The selected GOOD and CURRENT PDFs are parser-facing equivalent under the V16 checks."
    End If
End Sub

Private Function RegressionDictionaryHasPrefix( _
    ByVal dictValues As Object, _
    ByVal prefix As String) As Boolean

    Dim varKey As Variant

    For Each varKey In dictValues.Keys
        If Left$(CStr(varKey), Len(prefix)) = prefix Then
            RegressionDictionaryHasPrefix = True
            Exit Function
        End If
    Next varKey
End Function

'===============================================================================
' V18 DOXIS TRANSACTION-ANCHORED FORENSIC
'===============================================================================
' IMPORTANT:
' - This is a heuristic forensic mode. It does NOT claim to reproduce an
'   undocumented DOXISLoader algorithm.
' - The middle PDF is deliberately called BETTER_PARSING, not GOOD. It is
'   evidence of parser behaviour and may still contain defects.
' - OLD Oracle remains the semantic/layout reference.
' - V18 removes the main V17 false-positive source: target occurrences are
'   matched by transaction number, not by page number plus Y coordinate.
'===============================================================================

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka / OpenAI-assisted forensic extension
' Creation date: 2026-08-11
' Parameters:    ---
' Returns:       ---
' Description:   Selects OLD Oracle, BETTER-PARSING and CURRENT PDFs and writes
'                a transaction-anchored DOXIS regression report.
'-------------------------------------------------------------------------------
Public Sub RunPdfDoxisTopologyBrowse()
    Const METHOD_NAME As String = "RunPdfDoxisTopologyBrowse"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strBetterPdfPath As String
    Dim strCurrentPdfPath As String
    Dim strDetailPath As String
    Dim strOldPdfPath As String
    Dim strSuperShortPath As String

    On Error GoTo ErrorHandler

    strOldPdfPath = SelectPdfFile( _
        "V18.2 DOXIS - Select OLD Oracle reference PDF")
    If Len(strOldPdfPath) = 0 Then GoTo ExitSub

    strBetterPdfPath = SelectPdfFile( _
        "V18.2 DOXIS - Select BETTER-PARSING intermediate PDF (not assumed perfect)")
    If Len(strBetterPdfPath) = 0 Then GoTo ExitSub

    strCurrentPdfPath = SelectPdfFile( _
        "V18.2 DOXIS - Select CURRENT PDF (client parses this version worse)")
    If Len(strCurrentPdfPath) = 0 Then GoTo ExitSub

    strDetailPath = BuildDoxisTopologyDetailOutputPath( _
        strBetterPdfPath, _
        strCurrentPdfPath)

    strSuperShortPath = BuildDoxisTopologySuperShortOutputPath( _
        strBetterPdfPath, _
        strCurrentPdfPath)

    If Not PdfDoxisTopologyAudit( _
        strOldPdfPath, _
        strBetterPdfPath, _
        strCurrentPdfPath, _
        strDetailPath, _
        strSuperShortPath) Then

        Err.Raise ERR_BASE + 40, METHOD_NAME, _
            "The V18.2 DOXIS transaction-anchored forensic could not be completed."
    End If

    MsgBox _
        "V18.2 DOXIS transaction-anchored forensic completed." & vbCrLf & vbCrLf & _
        "SEND THIS FILE FIRST:" & vbCrLf & strSuperShortPath & vbCrLf & vbCrLf & _
        "Detailed transaction forensic:" & vbCrLf & strDetailPath & vbCrLf & vbCrLf & _
        "Input order: OLD Oracle -> BETTER-PARSING intermediate -> CURRENT." & vbCrLf & _
        "BETTER-PARSING is evidence only and is NOT assumed to be correct.", _
        vbInformation, _
        "Oracle / DOXIS forensic V18.2"

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "oldPdfPath;betterPdfPath;currentPdfPath;detailPath;superShortPath", _
        strOldPdfPath, _
        strBetterPdfPath, _
        strCurrentPdfPath, _
        strDetailPath, _
        strSuperShortPath

    errorManager.save
    errorManager.display "The V18.2 DOXIS forensic failed."
    Resume ExitSub
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka / OpenAI-assisted forensic extension
' Creation date: 2026-08-11
' Parameters:    PDF paths and output paths
' Returns:       Boolean
' Description:   Loads the three PDFs and writes V18 DOXIS reports.
'-------------------------------------------------------------------------------
Public Function PdfDoxisTopologyAudit( _
    ByVal oldPdfPath As String, _
    ByVal betterPdfPath As String, _
    ByVal currentPdfPath As String, _
    ByVal detailOutputPath As String, _
    ByVal superShortOutputPath As String) As Boolean

    Const METHOD_NAME As String = "PdfDoxisTopologyAudit"
    Dim betterDoc As tPdfDocument
    Dim currentDoc As tPdfDocument
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim oldDoc As tPdfDocument

    On Error GoTo ErrorHandler

    PdfDoxisTopologyAudit = False

    Call ResetParserState
    Call LoadPdfDocument(oldPdfPath, oldDoc)
    If oldDoc.PageCount = 0 Then
        Err.Raise 1014, METHOD_NAME, "The OLD Oracle PDF could not be parsed."
    End If

    Call LoadPdfDocument(betterPdfPath, betterDoc)
    If betterDoc.PageCount = 0 Then
        Err.Raise 1014, METHOD_NAME, "The BETTER-PARSING PDF could not be parsed."
    End If

    Call LoadPdfDocument(currentPdfPath, currentDoc)
    If currentDoc.PageCount = 0 Then
        Err.Raise 1014, METHOD_NAME, "The CURRENT PDF could not be parsed."
    End If

    Call WriteDoxisTopologyReports( _
        oldDoc, _
        betterDoc, _
        currentDoc, _
        detailOutputPath, _
        superShortOutputPath)

    PdfDoxisTopologyAudit = True

ExitFunction:
    Call ResetParserState
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    PdfDoxisTopologyAudit = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "oldPdfPath;betterPdfPath;currentPdfPath;detailOutputPath;superShortOutputPath", _
        oldPdfPath, _
        betterPdfPath, _
        currentPdfPath, _
        detailOutputPath, _
        superShortOutputPath

    errorManager.save
    Resume ExitFunction
End Function

Private Sub WriteDoxisTopologyReports( _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal detailOutputPath As String, _
    ByVal superShortOutputPath As String)

    Const METHOD_NAME As String = "WriteDoxisTopologyReports"
    Dim betterAnchors As Object
    Dim currentAnchors As Object
    Dim dictIssueCounts As Object
    Dim dictIssuePriorities As Object
    Dim dictIssueSamples As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngDetailFile As Long
    Dim oldAnchors As Object

    On Error GoTo ErrorHandler

    Set dictIssueCounts = CreateObject("Scripting.Dictionary")
    Set dictIssuePriorities = CreateObject("Scripting.Dictionary")
    Set dictIssueSamples = CreateObject("Scripting.Dictionary")

    lngDetailFile = FreeFile
    Open detailOutputPath For Output Access Write As #lngDetailFile

    Print #lngDetailFile, "ORACLE_DOXIS_TRANSACTION_ANCHORED_FORENSIC_V18_2"
    Print #lngDetailFile, "OLD_ORACLE|" & oldDoc.PdfPath
    Print #lngDetailFile, "BETTER_PARSING|" & betterDoc.PdfPath
    Print #lngDetailFile, "CURRENT|" & currentDoc.PdfPath
    Print #lngDetailFile, _
        "PURPOSE|Compare the same logical transaction across OLD, BETTER and CURRENT by transaction number, independent of page/row-slot movement."
    Print #lngDetailFile, _
        "IMPORTANT|BETTER_PARSING_IS_NOT_ASSUMED_CORRECT=TRUE|It is behavioural evidence because the client said it extracted ISIN/currency better."
    Print #lngDetailFile, _
        "V18_2_CHANGE|Target pairing is transaction-number anchored. Blocking comparisons use OLD Oracle as gold standard; BETTER is behavioural evidence. Separator top intrusion is checked at 0.01pt."
    Print #lngDetailFile, _
        "FONT_MODEL|Semantic BaseFont names decode PDF #xx escapes. V18.2 also compares raw font core without alias, so /F1 versus /F2 alone cannot create a false font break."
    Print #lngDetailFile, _
        "ISIN_MODEL|TOP_ISIN gets fixed x=639 cut count plus separator risk. A cut is blocking only when CURRENT is worse than OLD Oracle; BETTER remains a behavioural control."
    Print #lngDetailFile, _
        "SEPARATOR_MODEL|x=468 and x=639 are compared relative to the matched transaction. V18.2 flags OLD=BETTER/CURRENT-different primitive changes and >0.01pt top-row intrusion."
    Print #lngDetailFile, _
        "GLOBAL_X_HYPOTHESIS|Also tests a deliberately naive parser model that projects vertical paths onto X and ignores row ownership. This is a diagnostic hypothesis, not an asserted DOXISLoader specification."
    Print #lngDetailFile, _
        "INVISIBLE_RE_N|re n paths are captured separately, but blocking comparisons are CURRENT versus OLD. BETTER having zero such paths no longer fires automatically."
    Print #lngDetailFile, _
        "TARGETS|TOP_ISIN;TOP_SCHLUSSTAG;TOP_VALUTATAG;TOP_FONDSBEZEICHNUNG;TOP_WERTPAPIERBEZEICHNUNG;TOP_NOMINALE_STUECKE;TOP_STUECKZINSEN;TOP_WHG_NOMINALE;BOTTOM_ABWICKLUNGSPROVISION;BOTTOM_WHG_MAKLER;BOTTOM_WHG_STEUERN;BOTTOM_WHG_ABWICKLUNG;BOTTOM_WHG_SPESEN;BOTTOM_WHG_ABRECH"
    Print #lngDetailFile, ""

    Call DoxisV18WriteDocumentHeader( _
        lngDetailFile, _
        oldDoc, _
        betterDoc, _
        currentDoc)

    Set oldAnchors = DoxisV18BuildAnchorMap(oldDoc, "OLD", lngDetailFile)
    Set betterAnchors = DoxisV18BuildAnchorMap(betterDoc, "BETTER", lngDetailFile)
    Set currentAnchors = DoxisV18BuildAnchorMap(currentDoc, "CURRENT", lngDetailFile)

    Call DoxisV18CompareTransactionSet( _
        lngDetailFile, _
        oldDoc, _
        betterDoc, _
        currentDoc, _
        oldAnchors, _
        betterAnchors, _
        currentAnchors, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Close #lngDetailFile
    lngDetailFile = 0

    Call DoxisWriteSuperShortReport( _
        oldDoc, _
        betterDoc, _
        currentDoc, _
        oldAnchors, _
        betterAnchors, _
        currentAnchors, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples, _
        superShortOutputPath)

ExitSub:
    If lngDetailFile <> 0 Then Close #lngDetailFile
    Set oldAnchors = Nothing
    Set betterAnchors = Nothing
    Set currentAnchors = Nothing
    Set dictIssueCounts = Nothing
    Set dictIssuePriorities = Nothing
    Set dictIssueSamples = Nothing
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "detailOutputPath;superShortOutputPath", _
        detailOutputPath, _
        superShortOutputPath

    errorManager.save
    Resume ExitSub
End Sub

