'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    textValue As String
' Returns:       String
' Description:   Returns a deterministic lightweight checksum for diagnostic text.
'-------------------------------------------------------------------------------
Private Function FontTextChecksum(ByVal textValue As String) As String

    Const METHOD_NAME As String = "FontTextChecksum"
    Dim dblChecksum As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long

    On Error GoTo ErrorHandler

    dblChecksum = 0#

    For lngIndex = 1 To Len(textValue)
        dblChecksum = _
            (dblChecksum + (CDbl(AscW(Mid$(textValue, lngIndex, 1))) * CDbl(lngIndex))) Mod 1000000007#
    Next lngIndex

    FontTextChecksum = Format$(dblChecksum, "0")

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    FontTextChecksum = "error"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "length", _
        Len(textValue)

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    fontObjectDictionary As String
' Returns:       String
' Description:   Captures descriptor metrics and embedded font-program presence/stream size.
'-------------------------------------------------------------------------------
Private Function FontDescriptorForensicSignature(ByVal fontObjectDictionary As String) As String

    Const METHOD_NAME As String = "FontDescriptorForensicSignature"
    Dim arrReferences() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngObjectIndex As Long
    Dim strDescriptorDictionary As String
    Dim strReferences As String

    On Error GoTo ErrorHandler

    strReferences = RefList(fontObjectDictionary, "/FontDescriptor")

    If Len(strReferences) = 0 Then
        FontDescriptorForensicSignature = "absent"
        GoTo ExitFunction
    End If

    arrReferences = Split(strReferences, ",")
    lngObjectIndex = IndexOfObject(CLng(arrReferences(0)))

    If lngObjectIndex < 0 Then
        FontDescriptorForensicSignature = "unresolved"
        GoTo ExitFunction
    End If

    strDescriptorDictionary = ObjectDict(m_objPos(lngObjectIndex))

    FontDescriptorForensicSignature = _
        "fontName=" & DictValue(strDescriptorDictionary, "/FontName") & _
