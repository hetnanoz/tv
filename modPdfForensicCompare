    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngOccurrence As Long
    Dim lngPage As Long
    Dim lngStart As Long
    Dim strAnchorId As String
    Dim strBaseKey As String
    Dim strDisplay As String
    Dim strRole As String

    On Error GoTo ErrorHandler

    Set dictAnchors = CreateObject("Scripting.Dictionary")
    Set dictOccurrences = CreateObject("Scripting.Dictionary")

    For lngPage = 1 To pdfDoc.PageCount
        lngStart = pdfDoc.Pages(lngPage).TextStart
        lngEnd = lngStart + pdfDoc.Pages(lngPage).TextCount - 1

        For lngIndex = lngStart To lngEnd
            strRole = RegressionInferStructuralFieldRole( _
                lngPage, _
                pdfDoc.Texts(lngIndex).X, _
                pdfDoc.Texts(lngIndex).Y)

            If strRole = "BOTTOM_TRANSAKTIONSNR" Then
                strDisplay = Trim$(pdfDoc.Texts(lngIndex).TextValue)
                strBaseKey = DoxisV18NormalizeAnchorKey(strDisplay)

                If Len(strBaseKey) > 0 Then
                    If dictOccurrences.Exists(strBaseKey) Then
                        lngOccurrence = CLng(dictOccurrences(strBaseKey)) + 1
                        dictOccurrences(strBaseKey) = lngOccurrence
                    Else
                        lngOccurrence = 1
                        dictOccurrences.Add strBaseKey, lngOccurrence
                    End If

                    strAnchorId = strBaseKey
                    If lngOccurrence > 1 Then
                        strAnchorId = strAnchorId & "#OCC" & CStr(lngOccurrence)
                    End If

                    dictAnchors.Add _
                        strAnchorId, _
                        DoxisV18PackAnchor( _
                            lngPage, _
                            pdfDoc.Texts(lngIndex).Y + 18#, _
                            pdfDoc.Texts(lngIndex).Y, _
                            lngIndex, _
                            strDisplay)

                    Print #fileNo, _
                        "ANCHOR" & _
                        "|doc=" & documentLabel & _
                        "|id=" & strAnchorId & _
                        "|tx=" & SanitizeReportText(strDisplay) & _
                        "|page=" & CStr(lngPage) & _
                        "|topY=" & NumTxt(pdfDoc.Texts(lngIndex).Y + 18#) & _
                        "|bottomY=" & NumTxt(pdfDoc.Texts(lngIndex).Y)
                End If
            End If
        Next lngIndex
    Next lngPage

    Print #fileNo, _
        "ANCHOR_SUMMARY" & _
        "|doc=" & documentLabel & _
        "|count=" & CStr(dictAnchors.Count) & _
        "|distinctTransactionNumbers=" & CStr(dictOccurrences.Count)
    Print #fileNo, ""

    Set DoxisV18BuildAnchorMap = dictAnchors

ExitFunction:
    Set dictOccurrences = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "documentLabel", _
        documentLabel

    errorManager.save

    If dictAnchors Is Nothing Then
        Set dictAnchors = CreateObject("Scripting.Dictionary")
    End If

    Set DoxisV18BuildAnchorMap = dictAnchors
    Resume ExitFunction
End Function

Private Function DoxisV18NormalizeAnchorKey(ByVal textValue As String) As String
    Dim strValue As String

    strValue = UCase$(Trim$(textValue))
    strValue = Replace(strValue, Chr$(160), " ")
    strValue = Replace(strValue, vbTab, " ")
    strValue = Replace(strValue, " ", "")

    DoxisV18NormalizeAnchorKey = strValue
End Function

Private Function DoxisV18PackAnchor( _
    ByVal pageNo As Long, _
    ByVal topY As Double, _
    ByVal bottomY As Double, _
    ByVal textIndex As Long, _
    ByVal displayValue As String) As String

    DoxisV18PackAnchor = _
        CStr(pageNo) & "|" & _
        NumTxt(topY) & "|" & _
        NumTxt(bottomY) & "|" & _
        CStr(textIndex) & "|" & _
        SanitizeReportText(displayValue)
End Function

Private Function DoxisV18AnchorPage(ByVal packedAnchor As String) As Long
    Dim arrParts As Variant

    arrParts = Split(packedAnchor, "|")
    If UBound(arrParts) >= 0 Then
        DoxisV18AnchorPage = CLng(arrParts(0))
    End If
End Function

Private Function DoxisV18AnchorTopY(ByVal packedAnchor As String) As Double
    Dim arrParts As Variant

    arrParts = Split(packedAnchor, "|")
    If UBound(arrParts) >= 1 Then
        DoxisV18AnchorTopY = Val(CStr(arrParts(1)))
    End If
End Function

Private Function DoxisV18AnchorBottomY(ByVal packedAnchor As String) As Double
    Dim arrParts As Variant

    arrParts = Split(packedAnchor, "|")
    If UBound(arrParts) >= 2 Then
        DoxisV18AnchorBottomY = Val(CStr(arrParts(2)))
    End If
End Function

Private Function DoxisV18AnchorDisplay(ByVal packedAnchor As String) As String
    Dim arrParts As Variant

    arrParts = Split(packedAnchor, "|")
    If UBound(arrParts) >= 4 Then
        DoxisV18AnchorDisplay = CStr(arrParts(4))
    End If
End Function

Private Sub DoxisV18CompareTransactionSet( _
    ByVal fileNo As Long, _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchors As Object, _
    ByVal betterAnchors As Object, _
    ByVal currentAnchors As Object, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim arrKeys As Variant
    Dim lngIndex As Long
    Dim strAnchorId As String
    Dim strSample As String

    Print #fileNo, "================================================================"
    Print #fileNo, "TRANSACTION_ANCHORED_COMPARISON"
    Print #fileNo, "================================================================"

    If betterAnchors.Count = 0 Then
        Call DoxisAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            "DOXIS_V18_2_NO_BETTER_TRANSACTION_ANCHORS", _
            2, _
            "The BETTER-PARSING PDF contains no detectable BOTTOM_TRANSAKTIONSNR anchors.")
        Exit Sub
    End If

    arrKeys = SortedDictionaryKeys(betterAnchors)

    For lngIndex = LBound(arrKeys) To UBound(arrKeys)
        strAnchorId = CStr(arrKeys(lngIndex))

        If Not currentAnchors.Exists(strAnchorId) Then
            strSample = _
                "tx=" & DoxisV18AnchorDisplay(CStr(betterAnchors(strAnchorId))) & _
                "|betterPage=" & CStr(DoxisV18AnchorPage(CStr(betterAnchors(strAnchorId))))

            If oldAnchors.Exists(strAnchorId) Then
                Call DoxisAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    "DOXIS_V18_2_TRANSACTION_ANCHOR_MISSING_CURRENT_VS_OLD", _
                    3, _
                    strSample & "|OLD_hasAnchor=TRUE")
            Else
                Call DoxisAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    "DOXIS_V18_2_TRANSACTION_ANCHOR_MISSING_CURRENT", _
                    1, _
                    strSample & "|OLD_hasAnchor=FALSE")
            End If

            Print #fileNo, _
                "TRANSACTION_MISSING_CURRENT" & _
                "|id=" & strAnchorId & _
                "|" & strSample
        Else
            Call DoxisV18CompareTransaction( _
                fileNo, _
                strAnchorId, _
                oldDoc, _
                betterDoc, _
                currentDoc, _
                oldAnchors, _
                betterAnchors, _
                currentAnchors, _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples)
        End If
    Next lngIndex

    If currentAnchors.Count > 0 Then
        arrKeys = SortedDictionaryKeys(currentAnchors)

        For lngIndex = LBound(arrKeys) To UBound(arrKeys)
            strAnchorId = CStr(arrKeys(lngIndex))

            If Not betterAnchors.Exists(strAnchorId) Then
                Print #fileNo, _
                    "TRANSACTION_CURRENT_ONLY" & _
                    "|id=" & strAnchorId & _
                    "|tx=" & DoxisV18AnchorDisplay(CStr(currentAnchors(strAnchorId))) & _
                    "|page=" & CStr(DoxisV18AnchorPage(CStr(currentAnchors(strAnchorId))))

                Call DoxisAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    "DOXIS_V18_TRANSACTION_ANCHOR_CURRENT_ONLY", _
                    1, _
                    "tx=" & DoxisV18AnchorDisplay(CStr(currentAnchors(strAnchorId))))
            End If
        Next lngIndex
    End If

    Print #fileNo, ""
End Sub

Private Sub DoxisV18CompareTransaction( _
    ByVal fileNo As Long, _
    ByVal anchorId As String, _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchors As Object, _
    ByVal betterAnchors As Object, _
    ByVal currentAnchors As Object, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim arrRoles As Variant
    Dim betterAnchor As String
    Dim currentAnchor As String
    Dim lngRole As Long
    Dim oldAnchor As String
    Dim strRole As String

    betterAnchor = CStr(betterAnchors(anchorId))
    currentAnchor = CStr(currentAnchors(anchorId))

    If oldAnchors.Exists(anchorId) Then
        oldAnchor = CStr(oldAnchors(anchorId))
    Else
        oldAnchor = vbNullString
    End If

    Print #fileNo, "----------------------------------------------------------------"
    Print #fileNo, _
        "TRANSACTION" & _
        "|id=" & anchorId & _
        "|tx=" & DoxisV18AnchorDisplay(betterAnchor) & _
        "|OLD=" & DoxisV18AnchorLocation(oldAnchor) & _
        "|BETTER=" & DoxisV18AnchorLocation(betterAnchor) & _
        "|CURRENT=" & DoxisV18AnchorLocation(currentAnchor)

    Call DoxisV18CompareAnchorSeparator( _
        fileNo, _
        anchorId, _
        468#, _
        "TOP_SCHLUSSTAG", _
        oldDoc, _
        betterDoc, _
        currentDoc, _
        oldAnchor, _
        betterAnchor, _
        currentAnchor, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Call DoxisV18CompareAnchorSeparator( _
        fileNo, _
        anchorId, _
        639#, _
        "TOP_ISIN", _
        oldDoc, _
        betterDoc, _
        currentDoc, _
        oldAnchor, _
        betterAnchor, _
        currentAnchor, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Call DoxisV181CompareNoPaintTargetX( _
        fileNo, anchorId, 468#, "TOP_SCHLUSSTAG", _
        oldDoc, betterDoc, currentDoc, _
        oldAnchor, betterAnchor, currentAnchor, _
        dictIssueCounts, dictIssuePriorities, dictIssueSamples)

    Call DoxisV181CompareNoPaintTargetX( _
        fileNo, anchorId, 639#, "TOP_ISIN", _
        oldDoc, betterDoc, currentDoc, _
        oldAnchor, betterAnchor, currentAnchor, _
        dictIssueCounts, dictIssuePriorities, dictIssueSamples)

    Call DoxisV181CompareGlobalProjectionRoles( _
        fileNo, anchorId, _
        oldDoc, betterDoc, currentDoc, _
        oldAnchor, betterAnchor, currentAnchor, _
        dictIssueCounts, dictIssuePriorities, dictIssueSamples)

    arrRoles = DoxisV18TargetRoles()

    For lngRole = LBound(arrRoles) To UBound(arrRoles)
        strRole = CStr(arrRoles(lngRole))

        Call DoxisV18CompareTargetText( _
            fileNo, _
            anchorId, _
            strRole, _
            oldDoc, _
            betterDoc, _
            currentDoc, _
            oldAnchor, _
            betterAnchor, _
            currentAnchor, _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples)
    Next lngRole
End Sub

Private Function DoxisV18AnchorLocation(ByVal packedAnchor As String) As String
    If Len(packedAnchor) = 0 Then
        DoxisV18AnchorLocation = "MISSING"
    Else
        DoxisV18AnchorLocation = _
            "p" & CStr(DoxisV18AnchorPage(packedAnchor)) & _
            ",topY=" & NumTxt(DoxisV18AnchorTopY(packedAnchor)) & _
            ",bottomY=" & NumTxt(DoxisV18AnchorBottomY(packedAnchor))
    End If
End Function

Private Function DoxisV18TargetRoles() As Variant
    DoxisV18TargetRoles = Array( _
        "TOP_ISIN", _
        "TOP_SCHLUSSTAG", _
        "TOP_VALUTATAG", _
        "TOP_WHG_NOMINALE", _
        "BOTTOM_WHG_MAKLER", _
        "BOTTOM_WHG_STEUERN", _
        "BOTTOM_WHG_ABWICKLUNG", _
        "BOTTOM_WHG_SPESEN", _
        "BOTTOM_WHG_ABRECH")
End Function

Private Function DoxisV18FindTextInAnchor( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal packedAnchor As String, _
    ByVal role As String) As Long

    Const MAX_BASELINE_DISTANCE As Double = 3.5
    Dim dblBestDistance As Double
    Dim dblDistance As Double
    Dim dblExpectedY As Double
    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngPage As Long
    Dim lngStart As Long
    Dim strCandidateRole As String

    DoxisV18FindTextInAnchor = -1
    dblBestDistance = 1E+30

    If Len(packedAnchor) = 0 Then Exit Function

    lngPage = DoxisV18AnchorPage(packedAnchor)
    If lngPage < 1 Or lngPage > pdfDoc.PageCount Then Exit Function

    dblExpectedY = DoxisV18ExpectedBaseline(packedAnchor, role)
    lngStart = pdfDoc.Pages(lngPage).TextStart
    lngEnd = lngStart + pdfDoc.Pages(lngPage).TextCount - 1

    For lngIndex = lngStart To lngEnd
        strCandidateRole = RegressionInferStructuralFieldRole( _
            lngPage, _
            pdfDoc.Texts(lngIndex).X, _
            pdfDoc.Texts(lngIndex).Y)

        If strCandidateRole = role Then
            dblDistance = Abs(pdfDoc.Texts(lngIndex).Y - dblExpectedY)

            If dblDistance <= MAX_BASELINE_DISTANCE Then
                If dblDistance < dblBestDistance Then
                    dblBestDistance = dblDistance
                    DoxisV18FindTextInAnchor = lngIndex
                End If
            End If
        End If
    Next lngIndex
End Function

Private Function DoxisV18ExpectedBaseline( _
    ByVal packedAnchor As String, _
    ByVal role As String) As Double

    If Left$(role, 4) = "TOP_" Then
        DoxisV18ExpectedBaseline = DoxisV18AnchorTopY(packedAnchor)
    Else
        DoxisV18ExpectedBaseline = DoxisV18AnchorBottomY(packedAnchor)
    End If
End Function

Private Function DoxisV18RelativeY( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal textIndex As Long, _
    ByVal packedAnchor As String, _
    ByVal role As String) As Double

    DoxisV18RelativeY = _
        pdfDoc.Texts(textIndex).Y - _
        DoxisV18ExpectedBaseline(packedAnchor, role)
End Function

Private Sub DoxisV18CompareTargetText( _
    ByVal fileNo As Long, _
    ByVal anchorId As String, _
    ByVal role As String, _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchor As String, _
    ByVal betterAnchor As String, _
    ByVal currentAnchor As String, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Const METHOD_NAME As String = "DoxisV18CompareTargetText"
    Dim dblBetterRelY As Double
    Dim dblBetterRisk As Double
    Dim dblCurrentRelY As Double
    Dim dblCurrentRisk As Double
    Dim dblDx As Double
    Dim dblDyRel As Double
    Dim dblOldRelY As Double
    Dim dblOldRisk As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngBetterCut As Long
    Dim lngBetterIndex As Long
    Dim lngCurrentCut As Long
    Dim lngCurrentIndex As Long
    Dim lngOldCut As Long
    Dim lngOldIndex As Long
    Dim strBetterFontCore As String
    Dim strBetterFontRaw As String
    Dim strBetterFontRawFull As String
    Dim strBetterFontSemantic As String
    Dim strBetterLine As String
    Dim strBetterSnapshot As String
    Dim strBetterValue As String
    Dim strCurrentFontCore As String
    Dim strCurrentFontRaw As String
    Dim strCurrentFontRawFull As String
    Dim strCurrentFontSemantic As String
    Dim strCurrentLine As String
    Dim strCurrentSnapshot As String
    Dim strCurrentValue As String
    Dim strFamily As String
    Dim strOldFontCore As String
    Dim strOldFontRaw As String
    Dim strOldFontRawFull As String
    Dim strOldFontSemantic As String
    Dim strOldLine As String
    Dim strOldSnapshot As String
    Dim strOldValue As String
    Dim strSample As String

    On Error GoTo ErrorHandler

    lngBetterIndex = DoxisV18FindTextInAnchor( _
        betterDoc, _
        betterAnchor, _
        role)

    lngCurrentIndex = DoxisV18FindTextInAnchor( _
        currentDoc, _
        currentAnchor, _
        role)

    lngOldIndex = -1
    If Len(oldAnchor) > 0 Then
        lngOldIndex = DoxisV18FindTextInAnchor( _
            oldDoc, _
            oldAnchor, _
            role)
    End If

    If lngBetterIndex < 0 And lngCurrentIndex < 0 Then
        GoTo ExitSub
    End If

    If lngBetterIndex < 0 Then
        Print #fileNo, _
            "FIELD_CURRENT_ONLY" & _
            "|tx=" & anchorId & _
            "|role=" & role & _
            "|CURRENT=" & SanitizeReportText(currentDoc.Texts(lngCurrentIndex).TextValue)
        GoTo ExitSub
    End If

    strBetterValue = betterDoc.Texts(lngBetterIndex).TextValue

    If lngCurrentIndex < 0 Then
        If lngOldIndex >= 0 Then
            strFamily = "DOXIS_V18_2_TARGET_TEXT_MISSING_CURRENT_VS_OLD_" & role
            strSample = _
                "tx=" & anchorId & _
                "|role=" & role & _
                "|OLD=" & SanitizeReportText(oldDoc.Texts(lngOldIndex).TextValue) & _
                "|BETTER=" & SanitizeReportText(strBetterValue) & _
                "|CURRENT=(missing)|comparisonBasis=OLD_ORACLE"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                3, _
                strSample)
        Else
            strFamily = "DOXIS_V18_2_TARGET_TEXT_MISSING_CURRENT_" & role
            strSample = _
                "tx=" & anchorId & _
                "|role=" & role & _
                "|BETTER=" & SanitizeReportText(strBetterValue) & _
                "|CURRENT=(missing)|comparisonBasis=BETTER_FALLBACK_OLD_MISSING"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                1, _
                strSample)
        End If

        Print #fileNo, _
            "FIELD_MISSING_CURRENT" & _
            "|" & strSample
        GoTo ExitSub
    End If

    strCurrentValue = currentDoc.Texts(lngCurrentIndex).TextValue
    If lngOldIndex >= 0 Then
        strOldValue = oldDoc.Texts(lngOldIndex).TextValue
    End If

    dblBetterRelY = DoxisV18RelativeY( _
        betterDoc, _
        lngBetterIndex, _
        betterAnchor, _
        role)

    dblCurrentRelY = DoxisV18RelativeY( _
        currentDoc, _
        lngCurrentIndex, _
        currentAnchor, _
        role)

    If lngOldIndex >= 0 Then
        dblOldRelY = DoxisV18RelativeY( _
            oldDoc, _
            lngOldIndex, _
            oldAnchor, _
            role)
    End If

    dblDx = _
        currentDoc.Texts(lngCurrentIndex).X - _
        betterDoc.Texts(lngBetterIndex).X

    dblDyRel = dblCurrentRelY - dblBetterRelY

    strBetterSnapshot = DoxisTextTopologySnapshot( _
        betterDoc, _
        DoxisV18AnchorPage(betterAnchor), _
        lngBetterIndex, _
        role, _
        dblBetterRisk, _
        strBetterLine)

    strCurrentSnapshot = DoxisTextTopologySnapshot( _
        currentDoc, _
        DoxisV18AnchorPage(currentAnchor), _
        lngCurrentIndex, _
        role, _
        dblCurrentRisk, _
        strCurrentLine)

    If lngOldIndex >= 0 Then
        strOldSnapshot = DoxisTextTopologySnapshot( _
            oldDoc, _
            DoxisV18AnchorPage(oldAnchor), _
            lngOldIndex, _
            role, _
            dblOldRisk, _
            strOldLine)
    Else
        strOldSnapshot = "MISSING"
        strOldLine = "(none)"
    End If

    strBetterFontSemantic = DoxisV18TextSemanticFont( _
        betterDoc, _
        DoxisV18AnchorPage(betterAnchor), _
        lngBetterIndex)

    strCurrentFontSemantic = DoxisV18TextSemanticFont( _
        currentDoc, _
        DoxisV18AnchorPage(currentAnchor), _
        lngCurrentIndex)

    strBetterFontRaw = DoxisV18TextRawFontComparable( _
        betterDoc, _
        DoxisV18AnchorPage(betterAnchor), _
        lngBetterIndex)

    strCurrentFontRaw = DoxisV18TextRawFontComparable( _
        currentDoc, _
        DoxisV18AnchorPage(currentAnchor), _
        lngCurrentIndex)

    strBetterFontRawFull = DoxisV18TextRawFontDisplay( _
        betterDoc, _
        DoxisV18AnchorPage(betterAnchor), _
        lngBetterIndex)

    strCurrentFontRawFull = DoxisV18TextRawFontDisplay( _
        currentDoc, _
        DoxisV18AnchorPage(currentAnchor), _
        lngCurrentIndex)

    strBetterFontCore = DoxisV182TextRawFontCore( _
        betterDoc, _
        DoxisV18AnchorPage(betterAnchor), _
        lngBetterIndex)

    strCurrentFontCore = DoxisV182TextRawFontCore( _
        currentDoc, _
        DoxisV18AnchorPage(currentAnchor), _
        lngCurrentIndex)

    If lngOldIndex >= 0 Then
        strOldFontSemantic = DoxisV18TextSemanticFont( _
            oldDoc, _
            DoxisV18AnchorPage(oldAnchor), _
            lngOldIndex)

        strOldFontRaw = DoxisV18TextRawFontComparable( _
            oldDoc, _
            DoxisV18AnchorPage(oldAnchor), _
            lngOldIndex)

        strOldFontRawFull = DoxisV18TextRawFontDisplay( _
            oldDoc, _
            DoxisV18AnchorPage(oldAnchor), _
            lngOldIndex)

        strOldFontCore = DoxisV182TextRawFontCore( _
            oldDoc, _
            DoxisV18AnchorPage(oldAnchor), _
            lngOldIndex)
    Else
        strOldFontSemantic = "MISSING"
        strOldFontRaw = "MISSING"
        strOldFontRawFull = "MISSING"
        strOldFontCore = "MISSING"
    End If

    Print #fileNo, _
        "FIELD" & _
        "|tx=" & anchorId & _
        "|role=" & role & _
        "|OLD_VALUE=" & SanitizeReportText(strOldValue) & _
        "|BETTER_VALUE=" & SanitizeReportText(strBetterValue) & _
        "|CURRENT_VALUE=" & SanitizeReportText(strCurrentValue)

    Print #fileNo, _
        "FIELD_POSITION" & _
        "|tx=" & anchorId & _
        "|role=" & role & _
        "|OLD_X=" & DoxisV18OptionalTextX(oldDoc, lngOldIndex) & _
        "|BETTER_X=" & NumTxt(betterDoc.Texts(lngBetterIndex).X) & _
        "|CURRENT_X=" & NumTxt(currentDoc.Texts(lngCurrentIndex).X) & _
        "|dxCurrentMinusBetter=" & NumTxt(dblDx) & _
        "|OLD_relY=" & DoxisV18OptionalNumberByIndex(lngOldIndex, dblOldRelY) & _
        "|BETTER_relY=" & NumTxt(dblBetterRelY) & _
        "|CURRENT_relY=" & NumTxt(dblCurrentRelY) & _
        "|dRelY=" & NumTxt(dblDyRel)

    Print #fileNo, _
        "FIELD_FONT_SEMANTIC" & _
        "|tx=" & anchorId & _
        "|role=" & role & _
        "|OLD=" & strOldFontSemantic & _
        "|BETTER=" & strBetterFontSemantic & _
        "|CURRENT=" & strCurrentFontSemantic

    Print #fileNo, _
        "FIELD_FONT_RAW" & _
        "|tx=" & anchorId & _
        "|role=" & role & _
        "|OLD=" & strOldFontRaw & _
        "|BETTER=" & strBetterFontRaw & _
        "|CURRENT=" & strCurrentFontRaw

    Print #fileNo, _
        "FIELD_FONT_RAW_FULL" & _
        "|tx=" & anchorId & _
        "|role=" & role & _
        "|OLD=" & strOldFontRawFull & _
        "|BETTER=" & strBetterFontRawFull & _
        "|CURRENT=" & strCurrentFontRawFull

    Print #fileNo, _
        "FIELD_FONT_RAW_CORE" & _
        "|tx=" & anchorId & _
        "|role=" & role & _
        "|OLD=" & strOldFontCore & _
        "|BETTER=" & strBetterFontCore & _
        "|CURRENT=" & strCurrentFontCore

    Print #fileNo, _
        "FIELD_TOPOLOGY" & _
        "|tx=" & anchorId & _
        "|role=" & role & _
        "|OLD=" & strOldSnapshot & _
        "|BETTER=" & strBetterSnapshot & _
        "|CURRENT=" & strCurrentSnapshot

    If DoxisV18ComparableText(role, strBetterValue) <> _
       DoxisV18ComparableText(role, strCurrentValue) Then

        Call DoxisAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            "DOXIS_V18_VALUE_DIFFERENCE_" & role, _
            1, _
            "tx=" & anchorId & _
            "|BETTER=" & SanitizeReportText(strBetterValue) & _
            "|CURRENT=" & SanitizeReportText(strCurrentValue) & _
            "|comparisonRiskSuppressed=TRUE")

        Print #fileNo, _
            "FIELD_VALUE_DIFFERENCE" & _
            "|tx=" & anchorId & _
            "|role=" & role & _
            "|ACTION=Do not infer parser regression from text width/risk for this occurrence."
        GoTo ExitSub
    End If

    If lngOldIndex >= 0 Then
        If DoxisV18ComparableText(role, strOldValue) = _
           DoxisV18ComparableText(role, strCurrentValue) Then

            If dblCurrentRisk > dblOldRisk + 0.01 Then
                strFamily = "DOXIS_V18_2_CUT_RISK_WORSE_VS_OLD_" & role
                strSample = _
                    "tx=" & anchorId & _
                    "|text=" & SanitizeReportText(strCurrentValue) & _
                    "|riskOld=" & NumTxt(dblOldRisk) & _
                    "|riskBetter=" & NumTxt(dblBetterRisk) & _
                    "|riskCurrent=" & NumTxt(dblCurrentRisk) & _
                    "|OLD_LINE=" & strOldLine & _
                    "|BETTER_LINE=" & strBetterLine & _
                    "|CURRENT_LINE=" & strCurrentLine & _
                    "|comparisonBasis=OLD_ORACLE"

                Call DoxisAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    strFamily, _
                    3, _
                    strSample)
            End If
        Else
            Print #fileNo, _
                "CUT_RISK_OLD_VALUE_MISMATCH" & _
                "|tx=" & anchorId & _
                "|role=" & role & _
                "|ACTION=No blocking cut-risk comparison against OLD for this occurrence."
        End If
    ElseIf dblCurrentRisk > dblBetterRisk + 0.01 Then
        strFamily = "DOXIS_V18_2_CUT_RISK_WORSE_" & role
        strSample = _
            "tx=" & anchorId & _
            "|text=" & SanitizeReportText(strCurrentValue) & _
            "|riskBetter=" & NumTxt(dblBetterRisk) & _
            "|riskCurrent=" & NumTxt(dblCurrentRisk) & _
            "|comparisonBasis=BETTER_FALLBACK_OLD_MISSING"

        Call DoxisAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            strFamily, _
            3, _
            strSample)
    End If

    If role = "TOP_ISIN" Then
        lngBetterCut = DoxisV18FixedCutCount( _
            betterDoc, _
            lngBetterIndex, _
            639#)

        lngCurrentCut = DoxisV18FixedCutCount( _
            currentDoc, _
            lngCurrentIndex, _
            639#)

        If lngOldIndex >= 0 Then
            lngOldCut = DoxisV18FixedCutCount( _
                oldDoc, _
                lngOldIndex, _
                639#)
        Else
            lngOldCut = -1
        End If

        Print #fileNo, _
            "ISIN_FIXED_X639_CUT" & _
            "|tx=" & anchorId & _
            "|text=" & SanitizeReportText(strCurrentValue) & _
            "|OLD=" & CStr(lngOldCut) & _
            "|BETTER=" & CStr(lngBetterCut) & _
            "|CURRENT=" & CStr(lngCurrentCut)

        If lngOldIndex >= 0 Then
            If DoxisV182CutIsWorse(lngCurrentCut, lngOldCut) Then
                strSample = _
                    "tx=" & anchorId & _
                    "|text=" & SanitizeReportText(strCurrentValue) & _
                    "|oldCutAfterChars=" & CStr(lngOldCut) & _
                    "|betterCutAfterChars=" & CStr(lngBetterCut) & _
                    "|currentCutAfterChars=" & CStr(lngCurrentCut) & _
                    "|x=639|comparisonBasis=OLD_ORACLE"

                Call DoxisAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    "DOXIS_V18_2_ISIN_FIXED_X639_CUT_WORSE_VS_OLD", _
                    3, _
                    strSample)
            End If
        ElseIf DoxisV182CutIsWorse(lngCurrentCut, lngBetterCut) Then
            strSample = _
                "tx=" & anchorId & _
                "|text=" & SanitizeReportText(strCurrentValue) & _
                "|betterCutAfterChars=" & CStr(lngBetterCut) & _
                "|currentCutAfterChars=" & CStr(lngCurrentCut) & _
                "|x=639|comparisonBasis=BETTER_FALLBACK_OLD_MISSING"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                "DOXIS_V18_2_ISIN_FIXED_X639_CUT_WORSE", _
                3, _
                strSample)
        End If
    End If

    If lngOldIndex >= 0 Then
        If strCurrentFontSemantic <> strOldFontSemantic Then
            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                "DOXIS_V18_2_SEMANTIC_FONT_CURRENT_DIFFERS_OLD_" & role, _
                DoxisV182FontRegressionPriority( _
                    role, _
                    (strBetterFontSemantic = strOldFontSemantic)), _
                "tx=" & anchorId & _
                "|OLD=" & strOldFontSemantic & _
                "|BETTER=" & strBetterFontSemantic & _
                "|CURRENT=" & strCurrentFontSemantic & _
                "|comparisonBasis=OLD_ORACLE")
        ElseIf strCurrentFontCore <> strOldFontCore Then
            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                "DOXIS_V18_2_FONT_SERIALIZATION_CURRENT_DIFFERS_OLD_" & role, _
                DoxisV182FontRegressionPriority( _
                    role, _
                    (strBetterFontCore = strOldFontCore)), _
                "tx=" & anchorId & _
                "|OLD_CORE=" & strOldFontCore & _
                "|BETTER_CORE=" & strBetterFontCore & _
                "|CURRENT_CORE=" & strCurrentFontCore & _
                "|OLD_ALIAS_RAW=" & strOldFontRaw & _
                "|BETTER_ALIAS_RAW=" & strBetterFontRaw & _
                "|CURRENT_ALIAS_RAW=" & strCurrentFontRaw & _
                "|comparisonBasis=OLD_ORACLE")
        ElseIf strBetterFontSemantic <> strOldFontSemantic Or _
               strBetterFontCore <> strOldFontCore Then

            Print #fileNo, _
                "TRIAD_FONT_SIGNAL" & _
                "|tx=" & anchorId & _
                "|role=" & role & _
                "|classification=CURRENT_MATCHES_OLD_FONT_BETTER_DIFFERS" & _
                "|OLD_SEMANTIC=" & strOldFontSemantic & _
                "|BETTER_SEMANTIC=" & strBetterFontSemantic & _
                "|CURRENT_SEMANTIC=" & strCurrentFontSemantic & _
                "|interpretation=Do not change CURRENT font only because BETTER differs."
        End If
    Else
        If strBetterFontSemantic <> strCurrentFontSemantic Then
            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                "DOXIS_V18_2_SEMANTIC_FONT_CHANGED_" & role, _
                2, _
                "tx=" & anchorId & _
                "|BETTER=" & strBetterFontSemantic & _
                "|CURRENT=" & strCurrentFontSemantic & _
                "|comparisonBasis=BETTER_FALLBACK_OLD_MISSING")
        ElseIf strBetterFontCore <> strCurrentFontCore Then
            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                "DOXIS_V18_2_FONT_SERIALIZATION_CHANGED_" & role, _
                DoxisV18FontSerializationPriority(role), _
                "tx=" & anchorId & _
                "|BETTER_CORE=" & strBetterFontCore & _
                "|CURRENT_CORE=" & strCurrentFontCore & _
                "|comparisonBasis=BETTER_FALLBACK_OLD_MISSING")
        End If
    End If

    If lngOldIndex >= 0 Then
        If Abs(currentDoc.Texts(lngCurrentIndex).X - oldDoc.Texts(lngOldIndex).X) <= _
           DOXIS_POSITION_CHANGE_TOLERANCE And _
           Abs(dblCurrentRelY - dblOldRelY) <= DOXIS_POSITION_CHANGE_TOLERANCE And _
           (Abs(betterDoc.Texts(lngBetterIndex).X - oldDoc.Texts(lngOldIndex).X) > _
            DOXIS_POSITION_CHANGE_TOLERANCE Or _
            Abs(dblBetterRelY - dblOldRelY) > DOXIS_POSITION_CHANGE_TOLERANCE) Then

            Print #fileNo, _
                "TRIAD_POSITION_SIGNAL" & _
                "|tx=" & anchorId & _
                "|role=" & role & _
                "|classification=CURRENT_MATCHES_OLD_POSITION_BUT_CLIENT_REPORTS_WORSE" & _
                "|interpretation=Do not move this field only because BETTER differs."
        End If

        If strOldFontSemantic = strCurrentFontSemantic And _
           strOldFontCore = strCurrentFontCore And _
           strBetterFontCore <> strCurrentFontCore Then

            Print #fileNo, _
                "TRIAD_FONT_SIGNAL" & _
                "|tx=" & anchorId & _
                "|role=" & role & _
                "|classification=CURRENT_MATCHES_OLD_FONT_CORE_BETTER_DIFFERS" & _
                "|interpretation=Do not treat BETTER alias/raw differences as a required font fix."
        End If
    End If

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "anchorId;role", _
        anchorId, _
        role

    errorManager.save
    Resume ExitSub
End Sub

Private Function DoxisV18OptionalTextX( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal textIndex As Long) As String

    If textIndex < 0 Or textIndex >= pdfDoc.TextCount Then
        DoxisV18OptionalTextX = "NA"
    Else
        DoxisV18OptionalTextX = NumTxt(pdfDoc.Texts(textIndex).X)
    End If
End Function

Private Function DoxisV18OptionalNumberByIndex( _
    ByVal textIndex As Long, _
    ByVal numberValue As Double) As String

    If textIndex < 0 Then
        DoxisV18OptionalNumberByIndex = "NA"
    Else
        DoxisV18OptionalNumberByIndex = NumTxt(numberValue)
    End If
End Function

Private Function DoxisV18ComparableText( _
    ByVal role As String, _
    ByVal textValue As String) As String

    Dim strValue As String

    strValue = Trim$(textValue)
    strValue = Replace(strValue, Chr$(160), " ")
    strValue = Replace(strValue, vbTab, " ")

    Do While InStr(1, strValue, "  ", vbBinaryCompare) > 0
        strValue = Replace(strValue, "  ", " ")
    Loop

    If role = "TOP_ISIN" Or InStr(1, role, "WHG", vbBinaryCompare) > 0 Then
        strValue = Replace(strValue, " ", "")
        strValue = UCase$(strValue)
    End If

    DoxisV18ComparableText = strValue
End Function

Private Sub DoxisV18CompareAnchorSeparator( _
    ByVal fileNo As Long, _
    ByVal anchorId As String, _
    ByVal targetX As Double, _
    ByVal affectedRole As String, _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchor As String, _
    ByVal betterAnchor As String, _
    ByVal currentAnchor As String, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim blnBetterMatchesOld As Boolean
    Dim dblBetterTopRel As Double
    Dim dblCurrentTopRel As Double
    Dim dblOldTopRel As Double
    Dim lngBetterLine As Long
    Dim lngCurrentLine As Long
    Dim lngOldLine As Long
    Dim strBetter As String
    Dim strBetterPrimitive As String
    Dim strCurrent As String
    Dim strCurrentPrimitive As String
    Dim strFamily As String
    Dim strOld As String
    Dim strOldPrimitive As String
    Dim strSample As String

    lngBetterLine = -1
    lngCurrentLine = -1
    lngOldLine = -1

    strBetter = DoxisV18RelativeSeparatorSignature( _
        betterDoc, _
        betterAnchor, _
        targetX, _
        lngBetterLine)

    strCurrent = DoxisV18RelativeSeparatorSignature( _
        currentDoc, _
        currentAnchor, _
        targetX, _
        lngCurrentLine)

    strBetterPrimitive = DoxisV18LinePrimitiveSignature( _
        betterDoc, _
        lngBetterLine)

    strCurrentPrimitive = DoxisV18LinePrimitiveSignature( _
        currentDoc, _
        lngCurrentLine)

    If Len(oldAnchor) > 0 Then
        strOld = DoxisV18RelativeSeparatorSignature( _
            oldDoc, _
            oldAnchor, _
            targetX, _
            lngOldLine)

        strOldPrimitive = DoxisV18LinePrimitiveSignature( _
            oldDoc, _
            lngOldLine)
    Else
        strOld = "MISSING"
        strOldPrimitive = "MISSING"
    End If

    If lngBetterLine >= 0 Then
        dblBetterTopRel = _
            MaxDouble( _
                betterDoc.Lines(lngBetterLine).Y1, _
                betterDoc.Lines(lngBetterLine).Y2) - _
            DoxisV18AnchorBottomY(betterAnchor)
    End If

    If lngCurrentLine >= 0 Then
        dblCurrentTopRel = _
            MaxDouble( _
                currentDoc.Lines(lngCurrentLine).Y1, _
                currentDoc.Lines(lngCurrentLine).Y2) - _
            DoxisV18AnchorBottomY(currentAnchor)
    End If

    If lngOldLine >= 0 Then
        dblOldTopRel = _
            MaxDouble( _
                oldDoc.Lines(lngOldLine).Y1, _
                oldDoc.Lines(lngOldLine).Y2) - _
            DoxisV18AnchorBottomY(oldAnchor)
    End If

    Print #fileNo, _
        "SEPARATOR_TOP_REL" & _
        "|tx=" & anchorId & _
        "|x=" & NumTxt(targetX) & _
        "|OLD=" & DoxisV18OptionalNumberByIndex(lngOldLine, dblOldTopRel) & _
        "|BETTER=" & DoxisV18OptionalNumberByIndex(lngBetterLine, dblBetterTopRel) & _
        "|CURRENT=" & DoxisV18OptionalNumberByIndex(lngCurrentLine, dblCurrentTopRel) & _
        "|CURRENT_MINUS_OLD=" & _
            DoxisV182OptionalDelta(lngOldLine, lngCurrentLine, dblCurrentTopRel - dblOldTopRel)

    Print #fileNo, _
        "SEPARATOR_RELATIVE" & _
        "|tx=" & anchorId & _
        "|x=" & NumTxt(targetX) & _
        "|affectedRole=" & affectedRole & _
        "|OLD=" & strOld & _
        "|BETTER=" & strBetter & _
        "|CURRENT=" & strCurrent

    Print #fileNo, _
        "SEPARATOR_PRIMITIVE" & _
        "|tx=" & anchorId & _
        "|x=" & NumTxt(targetX) & _
        "|OLD=" & strOldPrimitive & _
        "|BETTER=" & strBetterPrimitive & _
        "|CURRENT=" & strCurrentPrimitive

    If Len(oldAnchor) > 0 Then
        blnBetterMatchesOld = _
            (strBetter = strOld And strBetterPrimitive = strOldPrimitive)

        If lngOldLine >= 0 And lngBetterLine >= 0 And lngCurrentLine >= 0 Then
            If Abs(dblBetterTopRel - dblOldTopRel) <= 0.01 And _
               dblCurrentTopRel > dblOldTopRel + 0.01 Then

                strFamily = _
                    "DOXIS_V18_2_ROW_INTRUSION_REGRESSION_X" & _
                    Replace(NumTxt(targetX), ".", "_")

                strSample = _
                    "tx=" & anchorId & _
                    "|affectedRole=" & affectedRole & _
                    "|OLD_topRel=" & NumTxt(dblOldTopRel) & _
                    "|BETTER_topRel=" & NumTxt(dblBetterTopRel) & _
                    "|CURRENT_topRel=" & NumTxt(dblCurrentTopRel) & _
                    "|CURRENT_extraIntoTop=" & _
                        NumTxt(dblCurrentTopRel - dblOldTopRel) & _
                    "|threshold=0.01|comparisonBasis=OLD_ORACLE"

                Call DoxisAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    strFamily, _
                    3, _
                    strSample)
            End If
        End If

        If strCurrent <> strOld Or strCurrentPrimitive <> strOldPrimitive Then
            strSample = _
                "tx=" & anchorId & _
                "|affectedRole=" & affectedRole & _
                "|OLD=" & strOld & _
                "|BETTER=" & strBetter & _
                "|CURRENT=" & strCurrent & _
                "|OLD_PRIMITIVE=" & strOldPrimitive & _
                "|BETTER_PRIMITIVE=" & strBetterPrimitive & _
                "|CURRENT_PRIMITIVE=" & strCurrentPrimitive & _
                "|comparisonBasis=OLD_ORACLE"

            If strCurrentPrimitive <> strOldPrimitive Then
                If blnBetterMatchesOld Then
                    strFamily = _
                        "DOXIS_V18_2_TRIAD_SEPARATOR_PRIMITIVE_REGRESSION_X" & _
                        Replace(NumTxt(targetX), ".", "_")

                    Call DoxisAddIssue( _
                        dictIssueCounts, _
                        dictIssuePriorities, _
                        dictIssueSamples, _
                        strFamily, _
                        3, _
                        strSample)
                Else
                    strFamily = _
                        "DOXIS_V18_2_SEPARATOR_PRIMITIVE_CURRENT_DIFFERS_OLD_X" & _
                        Replace(NumTxt(targetX), ".", "_")

                    Call DoxisAddIssue( _
                        dictIssueCounts, _
                        dictIssuePriorities, _
                        dictIssueSamples, _
                        strFamily, _
                        2, _
                        strSample)
                End If
            Else
                If blnBetterMatchesOld Then
                    strFamily = _
                        "DOXIS_V18_2_TRIAD_SEPARATOR_GEOMETRY_REGRESSION_X" & _
                        Replace(NumTxt(targetX), ".", "_")

                    Call DoxisAddIssue( _
                        dictIssueCounts, _
                        dictIssuePriorities, _
                        dictIssueSamples, _
                        strFamily, _
                        3, _
                        strSample)
                Else
                    strFamily = _
                        "DOXIS_V18_2_SEPARATOR_GEOMETRY_CURRENT_DIFFERS_OLD_X" & _
                        Replace(NumTxt(targetX), ".", "_")

                    Call DoxisAddIssue( _
                        dictIssueCounts, _
                        dictIssuePriorities, _
                        dictIssueSamples, _
                        strFamily, _
                        2, _
                        strSample)
                End If
            End If
        ElseIf strBetter <> strOld Or strBetterPrimitive <> strOldPrimitive Then
            Print #fileNo, _
                "TRIAD_SEPARATOR_SIGNAL" & _
                "|tx=" & anchorId & _
                "|x=" & NumTxt(targetX) & _
                "|classification=CURRENT_MATCHES_OLD_SEPARATOR_BETTER_DIFFERS" & _
                "|interpretation=Do not move or reserialize CURRENT only because BETTER differs."
        End If
    ElseIf strBetter <> strCurrent Then
        strSample = _
            "tx=" & anchorId & _
            "|affectedRole=" & affectedRole & _
            "|BETTER=" & strBetter & _
            "|CURRENT=" & strCurrent & _
            "|comparisonBasis=BETTER_FALLBACK_OLD_MISSING"

        If strBetterPrimitive <> strCurrentPrimitive Then
            strFamily = _
                "DOXIS_V18_2_SEPARATOR_PRIMITIVE_CHANGED_X" & _
                Replace(NumTxt(targetX), ".", "_")
        Else
            strFamily = _
                "DOXIS_V18_2_SEPARATOR_GEOMETRY_CHANGED_X" & _
                Replace(NumTxt(targetX), ".", "_")
        End If

        Call DoxisAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            strFamily, _
            2, _
            strSample)
    End If
End Sub


Private Function DoxisV181CountNoPaintReVerticalAtX( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal targetX As Double) As Long

    Dim dblX As Double
    Dim lngIndex As Long

    For lngIndex = 0 To pdfDoc.NoPaintLineCount - 1
        If LCase$(Trim$(pdfDoc.NoPaintLines(lngIndex).SourceOperator)) = "re" And _
           LCase$(Trim$(pdfDoc.NoPaintLines(lngIndex).PaintOperator)) = "n" Then

            If Abs(pdfDoc.NoPaintLines(lngIndex).X1 - pdfDoc.NoPaintLines(lngIndex).X2) <= _
               DOXIS_LINE_X_TOLERANCE Then

                dblX = _
                    (pdfDoc.NoPaintLines(lngIndex).X1 + _
                     pdfDoc.NoPaintLines(lngIndex).X2) / 2#

                If Abs(dblX - targetX) <= DOXIS_LINE_X_TOLERANCE Then
                    DoxisV181CountNoPaintReVerticalAtX = _
                        DoxisV181CountNoPaintReVerticalAtX + 1
                End If
            End If
        End If
    Next lngIndex
End Function

Private Sub DoxisV181CompareNoPaintTargetX( _
    ByVal fileNo As Long, _
    ByVal anchorId As String, _
    ByVal targetX As Double, _
    ByVal affectedRole As String, _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchor As String, _
    ByVal betterAnchor As String, _
    ByVal currentAnchor As String, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim lngBetterCount As Long
    Dim lngCurrentCount As Long
    Dim lngOldCount As Long
    Dim strBetter As String
    Dim strCurrent As String
    Dim strFamily As String
    Dim strOld As String
    Dim strSample As String

    strBetter = DoxisV181NoPaintTargetXSignature( _
        betterDoc, betterAnchor, targetX, lngBetterCount)

    strCurrent = DoxisV181NoPaintTargetXSignature( _
        currentDoc, currentAnchor, targetX, lngCurrentCount)

    If Len(oldAnchor) > 0 Then
        strOld = DoxisV181NoPaintTargetXSignature( _
            oldDoc, oldAnchor, targetX, lngOldCount)
    Else
        strOld = "MISSING"
    End If

    Print #fileNo, _
        "INVISIBLE_RE_N_TARGET_X" & _
        "|tx=" & anchorId & _
        "|x=" & NumTxt(targetX) & _
        "|affectedRole=" & affectedRole & _
        "|OLD=" & strOld & _
        "|BETTER=" & strBetter & _
        "|CURRENT=" & strCurrent

    If Len(oldAnchor) > 0 Then
        If strCurrent <> strOld Then
            strFamily = _
                "DOXIS_V18_2_INVISIBLE_RE_N_CURRENT_DIFFERS_OLD_X" & _
                Replace(NumTxt(targetX), ".", "_")

            strSample = _
                "tx=" & anchorId & _
                "|affectedRole=" & affectedRole & _
                "|OLD=" & strOld & _
                "|BETTER=" & strBetter & _
                "|CURRENT=" & strCurrent & _
                "|comparisonBasis=OLD_ORACLE"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                2, _
                strSample)
        End If

        If lngCurrentCount > lngOldCount Then
            strFamily = _
                "DOXIS_V18_2_INVISIBLE_RE_N_ADDED_VS_OLD_X" & _
                Replace(NumTxt(targetX), ".", "_")

            strSample = _
                "tx=" & anchorId & _
                "|affectedRole=" & affectedRole & _
                "|OLD_count=" & CStr(lngOldCount) & _
                "|BETTER_count=" & CStr(lngBetterCount) & _
                "|CURRENT_count=" & CStr(lngCurrentCount) & _
                "|comparisonBasis=OLD_ORACLE"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                3, _
                strSample)
        End If

        If strCurrent = strOld And strBetter <> strOld Then
            Print #fileNo, _
                "TRIAD_INVISIBLE_RE_N_SIGNAL" & _
                "|tx=" & anchorId & _
                "|x=" & NumTxt(targetX) & _
                "|classification=CURRENT_MATCHES_OLD_BETTER_DIFFERS" & _
                "|interpretation=BETTER having fewer/no re-n paths is not by itself a parser-regression proof."
        End If
    ElseIf strBetter <> strCurrent Then
        strFamily = _
            "DOXIS_V18_2_INVISIBLE_RE_N_CHANGED_X" & _
            Replace(NumTxt(targetX), ".", "_")

        strSample = _
            "tx=" & anchorId & _
            "|affectedRole=" & affectedRole & _
            "|BETTER=" & strBetter & _
            "|CURRENT=" & strCurrent & _
            "|comparisonBasis=BETTER_FALLBACK_OLD_MISSING"

        Call DoxisAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            strFamily, _
            2, _
            strSample)
    End If
End Sub

Private Function DoxisV181NoPaintTargetXSignature( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal packedAnchor As String, _
    ByVal targetX As Double, _
    ByRef matchCount As Long) As String

    Dim dblX As Double
    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngPage As Long
    Dim lngStart As Long
    Dim strResult As String

    matchCount = 0
    DoxisV181NoPaintTargetXSignature = "(none)"

    If Len(packedAnchor) = 0 Then
        DoxisV181NoPaintTargetXSignature = "MISSING_ANCHOR"
        Exit Function
    End If

    lngPage = DoxisV18AnchorPage(packedAnchor)
    If lngPage < 1 Or lngPage > pdfDoc.PageCount Then
        DoxisV181NoPaintTargetXSignature = "PAGE_MISSING"
        Exit Function
    End If

    lngStart = pdfDoc.Pages(lngPage).NoPaintLineStart
    lngEnd = lngStart + pdfDoc.Pages(lngPage).NoPaintLineCount - 1

    For lngIndex = lngStart To lngEnd
        If LCase$(Trim$(pdfDoc.NoPaintLines(lngIndex).SourceOperator)) = "re" And _
           LCase$(Trim$(pdfDoc.NoPaintLines(lngIndex).PaintOperator)) = "n" Then

            If Abs(pdfDoc.NoPaintLines(lngIndex).X1 - pdfDoc.NoPaintLines(lngIndex).X2) <= _
               DOXIS_LINE_X_TOLERANCE Then

                dblX = _
                    (pdfDoc.NoPaintLines(lngIndex).X1 + _
                     pdfDoc.NoPaintLines(lngIndex).X2) / 2#

                If Abs(dblX - targetX) <= DOXIS_LINE_X_TOLERANCE Then
                    matchCount = matchCount + 1

                    If matchCount <= 8 Then
                        If Len(strResult) > 0 Then strResult = strResult & ";"

                        strResult = strResult & _
                            "x=" & NumTxt(dblX) & _
                            ",y=" & NumTxt(MinDouble( _
                                pdfDoc.NoPaintLines(lngIndex).Y1, _
                                pdfDoc.NoPaintLines(lngIndex).Y2)) & _
                            ".." & NumTxt(MaxDouble( _
                                pdfDoc.NoPaintLines(lngIndex).Y1, _
                                pdfDoc.NoPaintLines(lngIndex).Y2)) & _
                            ",source=" & pdfDoc.NoPaintLines(lngIndex).SourceOperator & _
                            ",paint=" & pdfDoc.NoPaintLines(lngIndex).PaintOperator
                    End If
                End If
            End If
        End If
    Next lngIndex

    If matchCount > 0 Then
        DoxisV181NoPaintTargetXSignature = _
            "count=" & CStr(matchCount) & "|sample=" & strResult
    End If
End Function

Private Sub DoxisV181CompareGlobalProjectionRoles( _
    ByVal fileNo As Long, _
    ByVal anchorId As String, _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchor As String, _
    ByVal betterAnchor As String, _
    ByVal currentAnchor As String, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim arrRoles As Variant
    Dim lngIndex As Long
    Dim strRole As String

    arrRoles = Array( _
        "TOP_ISIN", _
        "TOP_SCHLUSSTAG", _
        "TOP_FONDSBEZEICHNUNG", _
        "TOP_WERTPAPIERBEZEICHNUNG", _
        "TOP_NOMINALE_STUECKE", _
        "TOP_STUECKZINSEN", _
        "TOP_WHG_NOMINALE", _
        "BOTTOM_ABWICKLUNGSPROVISION", _
        "BOTTOM_WHG_MAKLER", _
        "BOTTOM_WHG_STEUERN", _
        "BOTTOM_WHG_ABWICKLUNG", _
        "BOTTOM_WHG_SPESEN", _
        "BOTTOM_WHG_ABRECH")

    For lngIndex = LBound(arrRoles) To UBound(arrRoles)
        strRole = CStr(arrRoles(lngIndex))

        Call DoxisV181CompareGlobalProjectionRole( _
            fileNo, anchorId, strRole, _
            oldDoc, betterDoc, currentDoc, _
            oldAnchor, betterAnchor, currentAnchor, _
            dictIssueCounts, dictIssuePriorities, dictIssueSamples)
    Next lngIndex
End Sub

Private Sub DoxisV181CompareGlobalProjectionRole( _
    ByVal fileNo As Long, _
    ByVal anchorId As String, _
    ByVal role As String, _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchor As String, _
    ByVal betterAnchor As String, _
    ByVal currentAnchor As String, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim lngBetterCut As Long
    Dim lngBetterHiddenCut As Long
    Dim lngCurrentCut As Long
    Dim lngCurrentHiddenCut As Long
    Dim lngOldCut As Long
    Dim lngOldHiddenCut As Long
    Dim strBetter As String
    Dim strCurrent As String
    Dim strFamily As String
    Dim strOld As String
    Dim strSample As String

    strBetter = DoxisV181GlobalProjectionSnapshot( _
        betterDoc, betterAnchor, role, _
        lngBetterCut, lngBetterHiddenCut)

    strCurrent = DoxisV181GlobalProjectionSnapshot( _
        currentDoc, currentAnchor, role, _
        lngCurrentCut, lngCurrentHiddenCut)

    If Len(oldAnchor) > 0 Then
        strOld = DoxisV181GlobalProjectionSnapshot( _
            oldDoc, oldAnchor, role, _
            lngOldCut, lngOldHiddenCut)
    Else
        strOld = "MISSING"
        lngOldCut = -1
        lngOldHiddenCut = -1
    End If

    If strBetter <> "NO_TEXT" Or strCurrent <> "NO_TEXT" Then
        Print #fileNo, _
            "GLOBAL_X_PROJECTION" & _
            "|tx=" & anchorId & _
            "|role=" & role & _
            "|OLD=" & strOld & _
            "|BETTER=" & strBetter & _
            "|CURRENT=" & strCurrent
    End If

    If Len(oldAnchor) > 0 Then
        If DoxisV182CutIsWorse(lngCurrentCut, lngOldCut) Then
            strFamily = "DOXIS_V18_2_GLOBAL_VISIBLE_X_CUT_WORSE_VS_OLD_" & role
            strSample = _
                "tx=" & anchorId & _
                "|role=" & role & _
                "|OLD_cutAfter=" & DoxisV181OptionalCut(lngOldCut) & _
                "|BETTER_cutAfter=" & DoxisV181OptionalCut(lngBetterCut) & _
                "|CURRENT_cutAfter=" & DoxisV181OptionalCut(lngCurrentCut) & _
                "|comparisonBasis=OLD_ORACLE" & _
                "|hypothesis=vertical visible paths projected globally on X, row ownership ignored"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                DoxisV181ProjectionPriority(role), _
                strSample)
        End If

        If DoxisV182CutIsWorse(lngCurrentHiddenCut, lngOldHiddenCut) Then
            strFamily = "DOXIS_V18_2_GLOBAL_INVISIBLE_RE_N_CUT_WORSE_VS_OLD_" & role
            strSample = _
                "tx=" & anchorId & _
                "|role=" & role & _
                "|OLD_hiddenCutAfter=" & DoxisV181OptionalCut(lngOldHiddenCut) & _
                "|BETTER_hiddenCutAfter=" & DoxisV181OptionalCut(lngBetterHiddenCut) & _
                "|CURRENT_hiddenCutAfter=" & DoxisV181OptionalCut(lngCurrentHiddenCut) & _
                "|comparisonBasis=OLD_ORACLE" & _
                "|hypothesis=invisible re n vertical edges projected globally on X"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                DoxisV181ProjectionPriority(role), _
                strSample)
        End If

        If lngCurrentCut = lngOldCut And lngBetterCut <> lngOldCut Then
            Print #fileNo, _
                "GLOBAL_X_TRIAD_SIGNAL" & _
                "|tx=" & anchorId & _
                "|role=" & role & _
                "|visible=CURRENT_MATCHES_OLD_BETTER_DIFFERS"
        End If

        If lngCurrentHiddenCut = lngOldHiddenCut And _
           lngBetterHiddenCut <> lngOldHiddenCut Then

            Print #fileNo, _
                "GLOBAL_X_TRIAD_SIGNAL" & _
                "|tx=" & anchorId & _
                "|role=" & role & _
                "|invisible=CURRENT_MATCHES_OLD_BETTER_DIFFERS"
        End If
    Else
        If DoxisV182CutIsWorse(lngCurrentCut, lngBetterCut) Then
            strFamily = "DOXIS_V18_2_GLOBAL_VISIBLE_X_CUT_WORSE_" & role
            strSample = _
                "tx=" & anchorId & _
                "|role=" & role & _
                "|BETTER_cutAfter=" & DoxisV181OptionalCut(lngBetterCut) & _
                "|CURRENT_cutAfter=" & DoxisV181OptionalCut(lngCurrentCut) & _
                "|comparisonBasis=BETTER_FALLBACK_OLD_MISSING"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                DoxisV181ProjectionPriority(role), _
                strSample)
        End If
    End If
End Sub

Private Function DoxisV181GlobalProjectionSnapshot( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal packedAnchor As String, _
    ByVal role As String, _
    ByRef visibleCutAfter As Long, _
    ByRef hiddenCutAfter As Long) As String

    Dim dblEndX As Double
    Dim dblLineX As Double
    Dim dblTextX As Double
    Dim dblTextWidth As Double
    Dim lngEnd As Long
    Dim lngHiddenHits As Long
    Dim lngIndex As Long
    Dim lngPage As Long
    Dim lngStart As Long
    Dim lngTextIndex As Long
    Dim lngVisibleHits As Long
    Dim lngCandidateCut As Long
    Dim strHidden As String
    Dim strVisible As String
    Dim strValue As String

    visibleCutAfter = -1
    hiddenCutAfter = -1
    DoxisV181GlobalProjectionSnapshot = "NO_TEXT"

    lngTextIndex = DoxisV18FindTextInAnchor(pdfDoc, packedAnchor, role)
    If lngTextIndex < 0 Then Exit Function

    lngPage = pdfDoc.Texts(lngTextIndex).PageNo
    strValue = pdfDoc.Texts(lngTextIndex).TextValue
    dblTextX = pdfDoc.Texts(lngTextIndex).X
    dblTextWidth = EstimateTextWidth( _
        strValue, _
        pdfDoc.Texts(lngTextIndex).FontName, _
        pdfDoc.Texts(lngTextIndex).FontSize)

    dblEndX = dblTextX + dblTextWidth

    lngStart = pdfDoc.Pages(lngPage).LineStart
    lngEnd = lngStart + pdfDoc.Pages(lngPage).LineCount - 1

    For lngIndex = lngStart To lngEnd
        If Abs(pdfDoc.Lines(lngIndex).X1 - pdfDoc.Lines(lngIndex).X2) <= _
           DOXIS_LINE_X_TOLERANCE Then

            dblLineX = _
                (pdfDoc.Lines(lngIndex).X1 + pdfDoc.Lines(lngIndex).X2) / 2#

            If DoxisV181XInsideText( _
                dblLineX, dblTextX, dblEndX) Then

                lngCandidateCut = DoxisPredictCutCharacter( _
                    strValue, _
                    pdfDoc.Texts(lngTextIndex).FontName, _
                    pdfDoc.Texts(lngTextIndex).FontSize, _
                    dblTextX, _
                    dblLineX)

                If visibleCutAfter < 0 Or lngCandidateCut < visibleCutAfter Then
                    visibleCutAfter = lngCandidateCut
                End If

                lngVisibleHits = lngVisibleHits + 1
                If lngVisibleHits <= 6 Then
                    If Len(strVisible) > 0 Then strVisible = strVisible & ","
                    strVisible = strVisible & _
                        NumTxt(dblLineX) & ":" & CStr(lngCandidateCut) & _
                        ":" & pdfDoc.Lines(lngIndex).SourceOperator & _
                        "/" & pdfDoc.Lines(lngIndex).PaintOperator
                End If
            End If
        End If
    Next lngIndex

    lngStart = pdfDoc.Pages(lngPage).NoPaintLineStart
    lngEnd = lngStart + pdfDoc.Pages(lngPage).NoPaintLineCount - 1

    For lngIndex = lngStart To lngEnd
        If LCase$(Trim$(pdfDoc.NoPaintLines(lngIndex).SourceOperator)) = "re" And _
           LCase$(Trim$(pdfDoc.NoPaintLines(lngIndex).PaintOperator)) = "n" Then

            If Abs(pdfDoc.NoPaintLines(lngIndex).X1 - pdfDoc.NoPaintLines(lngIndex).X2) <= _
               DOXIS_LINE_X_TOLERANCE Then

                dblLineX = _
                    (pdfDoc.NoPaintLines(lngIndex).X1 + _
                     pdfDoc.NoPaintLines(lngIndex).X2) / 2#

                If DoxisV181XInsideText( _
                    dblLineX, dblTextX, dblEndX) Then

                    lngCandidateCut = DoxisPredictCutCharacter( _
                        strValue, _
                        pdfDoc.Texts(lngTextIndex).FontName, _
                        pdfDoc.Texts(lngTextIndex).FontSize, _
                        dblTextX, _
                        dblLineX)

                    If hiddenCutAfter < 0 Or lngCandidateCut < hiddenCutAfter Then
                        hiddenCutAfter = lngCandidateCut
                    End If

                    lngHiddenHits = lngHiddenHits + 1
                    If lngHiddenHits <= 6 Then
                        If Len(strHidden) > 0 Then strHidden = strHidden & ","
                        strHidden = strHidden & _
                            NumTxt(dblLineX) & ":" & CStr(lngCandidateCut) & _
                            ":re/n"
                    End If
                End If
            End If
        End If
    Next lngIndex

    DoxisV181GlobalProjectionSnapshot = _
        "text=" & SanitizeReportText(strValue) & _
        "|x=" & NumTxt(dblTextX) & ".." & NumTxt(dblEndX) & _
        "|visibleHits=" & CStr(lngVisibleHits) & _
        "|visibleMinCut=" & DoxisV181OptionalCut(visibleCutAfter) & _
        "|visibleX=" & IIf(Len(strVisible) = 0, "(none)", strVisible) & _
        "|reNhiddenHits=" & CStr(lngHiddenHits) & _
        "|reNhiddenMinCut=" & DoxisV181OptionalCut(hiddenCutAfter) & _
        "|reNhiddenX=" & IIf(Len(strHidden) = 0, "(none)", strHidden)
End Function

Private Function DoxisV181XInsideText( _
    ByVal candidateX As Double, _
    ByVal textX As Double, _
    ByVal textEndX As Double) As Boolean

    DoxisV181XInsideText = _
        candidateX > textX + DOXIS_GLOBAL_PROJECTION_EDGE_MARGIN And _
        candidateX < textEndX - DOXIS_GLOBAL_PROJECTION_EDGE_MARGIN
End Function

Private Function DoxisV181OptionalCut(ByVal cutValue As Long) As String
    If cutValue < 0 Then
        DoxisV181OptionalCut = "NONE"
    Else
        DoxisV181OptionalCut = CStr(cutValue)
    End If
End Function

Private Function DoxisV181ProjectionPriority(ByVal role As String) As Long
    Select Case role
        Case "TOP_ISIN", _
             "TOP_SCHLUSSTAG", _
             "TOP_WHG_NOMINALE", _
             "BOTTOM_WHG_MAKLER", _
             "BOTTOM_WHG_STEUERN", _
             "BOTTOM_WHG_ABWICKLUNG", _
             "BOTTOM_WHG_SPESEN", _
             "BOTTOM_WHG_ABRECH"
            DoxisV181ProjectionPriority = 3

        Case Else
            DoxisV181ProjectionPriority = 2
    End Select
End Function

Private Function DoxisV18LinePrimitiveSignature( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal lineIndex As Long) As String

    If lineIndex < 0 Or lineIndex >= pdfDoc.LineCount Then
        DoxisV18LinePrimitiveSignature = "(none)"
        Exit Function
    End If

    DoxisV18LinePrimitiveSignature = _
        "w=" & NumTxt(pdfDoc.Lines(lineIndex).LineWidth) & _
        ",source=" & pdfDoc.Lines(lineIndex).SourceOperator & _
        ",paint=" & pdfDoc.Lines(lineIndex).PaintOperator & _
        ",color=" & pdfDoc.Lines(lineIndex).StrokeColor
End Function

Private Function DoxisV18RelativeSeparatorSignature( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal packedAnchor As String, _
    ByVal targetX As Double, _
    ByRef matchedLineIndex As Long) As String

    Const MAX_TRANSACTION_LINE_GAP As Double = 8#
    Dim dblBandBottom As Double
    Dim dblBandTop As Double
    Dim dblBestScore As Double
    Dim dblGap As Double
    Dim dblLineMid As Double
    Dim dblLineX As Double
    Dim dblMidTarget As Double
    Dim dblScore As Double
    Dim dblYMax As Double
    Dim dblYMin As Double
    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngPage As Long
    Dim lngStart As Long

    matchedLineIndex = -1
    DoxisV18RelativeSeparatorSignature = "(none)"
    dblBestScore = 1E+30

    If Len(packedAnchor) = 0 Then
        DoxisV18RelativeSeparatorSignature = "MISSING_ANCHOR"
        Exit Function
    End If

    lngPage = DoxisV18AnchorPage(packedAnchor)
    If lngPage < 1 Or lngPage > pdfDoc.PageCount Then
        DoxisV18RelativeSeparatorSignature = "PAGE_MISSING"
        Exit Function
    End If

    dblBandBottom = DoxisV18AnchorBottomY(packedAnchor) - 6#
    dblBandTop = DoxisV18AnchorTopY(packedAnchor) + 2#
    dblMidTarget = DoxisV18AnchorBottomY(packedAnchor) + 4.5

    lngStart = pdfDoc.Pages(lngPage).LineStart
    lngEnd = lngStart + pdfDoc.Pages(lngPage).LineCount - 1

    For lngIndex = lngStart To lngEnd
        If Abs(pdfDoc.Lines(lngIndex).X1 - pdfDoc.Lines(lngIndex).X2) <= _
           DOXIS_LINE_X_TOLERANCE Then

            dblLineX = _
                (pdfDoc.Lines(lngIndex).X1 + pdfDoc.Lines(lngIndex).X2) / 2#

            If Abs(dblLineX - targetX) <= DOXIS_LINE_X_TOLERANCE Then
                dblYMin = MinDouble( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)

                dblYMax = MaxDouble( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)

                dblGap = DoxisVerticalGapToBand( _
                    dblYMin, _
                    dblYMax, _
                    dblBandBottom, _
                    dblBandTop)

                If dblGap <= MAX_TRANSACTION_LINE_GAP Then
                    dblLineMid = (dblYMin + dblYMax) / 2#
                    dblScore = _
                        dblGap * 100# + _
                        Abs(dblLineMid - dblMidTarget)

                    If dblScore < dblBestScore Then
                        dblBestScore = dblScore
                        matchedLineIndex = lngIndex
                    End If
                End If
            End If
        End If
    Next lngIndex

    If matchedLineIndex >= 0 Then
        dblLineX = _
            (pdfDoc.Lines(matchedLineIndex).X1 + _
             pdfDoc.Lines(matchedLineIndex).X2) / 2#

        dblYMin = MinDouble( _
            pdfDoc.Lines(matchedLineIndex).Y1, _
            pdfDoc.Lines(matchedLineIndex).Y2)

        dblYMax = MaxDouble( _
            pdfDoc.Lines(matchedLineIndex).Y1, _
            pdfDoc.Lines(matchedLineIndex).Y2)

        DoxisV18RelativeSeparatorSignature = _
            "x=" & NumTxt(dblLineX) & _
            ",dxTarget=" & NumTxt(dblLineX - targetX) & _
            ",relY=" & NumTxt(dblYMin - DoxisV18AnchorBottomY(packedAnchor)) & _
            ".." & NumTxt(dblYMax - DoxisV18AnchorBottomY(packedAnchor)) & _
            ",w=" & NumTxt(pdfDoc.Lines(matchedLineIndex).LineWidth) & _
            ",source=" & pdfDoc.Lines(matchedLineIndex).SourceOperator & _
            ",paint=" & pdfDoc.Lines(matchedLineIndex).PaintOperator & _
            ",color=" & pdfDoc.Lines(matchedLineIndex).StrokeColor
    End If
End Function

Private Function DoxisV18FixedCutCount( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal textIndex As Long, _
    ByVal separatorX As Double) As Long

    DoxisV18FixedCutCount = DoxisPredictCutCharacter( _
        pdfDoc.Texts(textIndex).TextValue, _
        pdfDoc.Texts(textIndex).FontName, _
        pdfDoc.Texts(textIndex).FontSize, _
        pdfDoc.Texts(textIndex).X, _
        separatorX)
End Function

Private Function DoxisV182OptionalDelta( _
    ByVal oldIndex As Long, _
    ByVal currentIndex As Long, _
    ByVal deltaValue As Double) As String

    If oldIndex < 0 Or currentIndex < 0 Then
        DoxisV182OptionalDelta = "NA"
    Else
        DoxisV182OptionalDelta = NumTxt(deltaValue)
    End If
End Function

Private Function DoxisV182CutIsWorse( _
    ByVal currentCut As Long, _
    ByVal referenceCut As Long) As Boolean

    If currentCut < 0 Then Exit Function

    If referenceCut < 0 Then
        DoxisV182CutIsWorse = True
    Else
        DoxisV182CutIsWorse = (currentCut < referenceCut)
    End If
End Function

Private Function DoxisV182FontRegressionPriority( _
    ByVal role As String, _
    ByVal betterMatchesOld As Boolean) As Long

    If betterMatchesOld Then
        If role = "TOP_ISIN" Or _
           InStr(1, role, "WHG", vbBinaryCompare) > 0 Then

            DoxisV182FontRegressionPriority = 3
        Else
            DoxisV182FontRegressionPriority = 2
        End If
    Else
        DoxisV182FontRegressionPriority = _
            DoxisV18FontSerializationPriority(role)

        If DoxisV182FontRegressionPriority < 1 Then
            DoxisV182FontRegressionPriority = 1
        End If
    End If
End Function

Private Function DoxisV182TextRawFontCore( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal textIndex As Long) As String

    Dim strBase As String
    Dim strDescriptor As String
    Dim strEncoding As String
    Dim strEntry As String
    Dim strSubtype As String
    Dim strWidths As String

    If textIndex < 0 Or textIndex >= pdfDoc.TextCount Then
        DoxisV182TextRawFontCore = "MISSING"
        Exit Function
    End If

    strEntry = DoxisV18RawFontEntry( _
        pdfDoc, _
        pageNo, _
        pdfDoc.Texts(textIndex).FontName)

    If Len(strEntry) = 0 Then
        DoxisV182TextRawFontCore = _
            "raw=(unresolved)" & _
            "|size=" & NumTxt(pdfDoc.Texts(textIndex).FontSize)
        Exit Function
    End If

    strBase = DoxisV18PipeField(strEntry, "base")
    strSubtype = DoxisV18PipeField(strEntry, "subtype")
    strEncoding = DoxisV18PipeField(strEntry, "encoding")
    strWidths = DoxisV18PipeField(strEntry, "widths")
    strDescriptor = DoxisV18PipeField(strEntry, "descriptor")

    DoxisV182TextRawFontCore = _
        "baseRaw=" & strBase & _
        "|subtypeRaw=" & strSubtype & _
        "|encodingRaw=" & strEncoding & _
        "|widths=" & strWidths & _
        "|descriptorChecksum=" & FontTextChecksum(strDescriptor) & _
        "|size=" & NumTxt(pdfDoc.Texts(textIndex).FontSize)
End Function

Private Function DoxisV182CountPaintedPrimitive( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal sourceOperator As String) As Long

    Dim lngIndex As Long

    For lngIndex = 0 To pdfDoc.LineCount - 1
        If LCase$(Trim$(pdfDoc.Lines(lngIndex).SourceOperator)) = _
           LCase$(Trim$(sourceOperator)) Then

            If LCase$(Trim$(pdfDoc.Lines(lngIndex).PaintOperator)) <> "n" Then
                DoxisV182CountPaintedPrimitive = _
                    DoxisV182CountPaintedPrimitive + 1
            End If
        End If
    Next lngIndex
End Function

Private Function DoxisV182DocumentInfoValue( _
    ByVal keyName As String) As String

    Dim blnEscaped As Boolean
    Dim lngDepth As Long
    Dim lngIndex As Long
    Dim lngLength As Long
    Dim lngPos As Long
    Dim lngStart As Long
    Dim strChar As String
    Dim strPdf As String
    Dim strValue As String

    DoxisV182DocumentInfoValue = "(absent)"

    On Error GoTo ExitFunction

    lngLength = UBound(m_pdf) + 1
    If lngLength <= 0 Then GoTo ExitFunction

    strPdf = ByteArrayText(m_pdf, lngLength)
    lngPos = InStrRev(strPdf, keyName, -1, vbBinaryCompare)
    If lngPos <= 0 Then GoTo ExitFunction

    lngIndex = lngPos + Len(keyName)

    Do While lngIndex <= Len(strPdf)
        strChar = Mid$(strPdf, lngIndex, 1)
        If strChar <> " " And strChar <> vbTab And _
           strChar <> vbCr And strChar <> vbLf Then Exit Do
        lngIndex = lngIndex + 1
    Loop

    If lngIndex > Len(strPdf) Then GoTo ExitFunction

    strChar = Mid$(strPdf, lngIndex, 1)

    If strChar = "(" Then
        lngStart = lngIndex + 1
        lngDepth = 1
        lngIndex = lngStart

        Do While lngIndex <= Len(strPdf)
            strChar = Mid$(strPdf, lngIndex, 1)

            If blnEscaped Then
                blnEscaped = False
            ElseIf strChar = "\" Then
                blnEscaped = True
            ElseIf strChar = "(" Then
                lngDepth = lngDepth + 1
            ElseIf strChar = ")" Then
                lngDepth = lngDepth - 1
                If lngDepth = 0 Then Exit Do
            End If

            lngIndex = lngIndex + 1
        Loop

        If lngIndex > lngStart Then
            strValue = Mid$(strPdf, lngStart, lngIndex - lngStart)
        End If
    ElseIf strChar = "<" Then
        lngStart = lngIndex
        lngIndex = InStr(lngStart + 1, strPdf, ">", vbBinaryCompare)

        If lngIndex > lngStart Then
            strValue = Mid$(strPdf, lngStart, lngIndex - lngStart + 1)
        End If
    Else
        lngStart = lngIndex

        Do While lngIndex <= Len(strPdf)
            strChar = Mid$(strPdf, lngIndex, 1)

            If strChar = " " Or strChar = vbTab Or _
               strChar = vbCr Or strChar = vbLf Or _
               strChar = "/" Or strChar = ">" Then Exit Do

            lngIndex = lngIndex + 1
        Loop

        If lngIndex > lngStart Then
            strValue = Mid$(strPdf, lngStart, lngIndex - lngStart)
        End If
    End If

    If Len(strValue) > 0 Then
        DoxisV182DocumentInfoValue = _
            RegressionLimitText(SanitizeReportText(strValue), 300)
    End If

ExitFunction:
End Function

Private Function DoxisV18TextSemanticFont( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal textIndex As Long) As String

    Dim strAlias As String
    Dim strBase As String
    Dim strEncoding As String
    Dim strEntry As String
    Dim strSubtype As String

    If textIndex < 0 Or textIndex >= pdfDoc.TextCount Then
        DoxisV18TextSemanticFont = "MISSING"
        Exit Function
    End If

    strAlias = pdfDoc.Texts(textIndex).FontName
    strEntry = DoxisV18RawFontEntry(pdfDoc, pageNo, strAlias)

    If Len(strEntry) = 0 Then
        DoxisV18TextSemanticFont = _
            "base=(unresolved)" & _
            "|subtype=(unresolved)" & _
            "|encoding=(unresolved)" & _
            "|size=" & NumTxt(pdfDoc.Texts(textIndex).FontSize)
        Exit Function
    End If

    strBase = DoxisV18DecodePdfName( _
        DoxisV18PipeField(strEntry, "base"))

    strSubtype = DoxisV18DecodePdfName( _
        DoxisV18PipeField(strEntry, "subtype"))

    strEncoding = DoxisV18DecodePdfName( _
        DoxisV18PipeField(strEntry, "encoding"))

    DoxisV18TextSemanticFont = _
        "base=" & strBase & _
        "|subtype=" & strSubtype & _
        "|encoding=" & strEncoding & _
        "|size=" & NumTxt(pdfDoc.Texts(textIndex).FontSize)
End Function

Private Function DoxisV18TextRawFontComparable( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal textIndex As Long) As String

    Dim strAlias As String
    Dim strBase As String
    Dim strDescriptor As String
    Dim strEncoding As String
    Dim strEntry As String
    Dim strSubtype As String
    Dim strWidths As String

    If textIndex < 0 Or textIndex >= pdfDoc.TextCount Then
        DoxisV18TextRawFontComparable = "MISSING"
        Exit Function
    End If

    strAlias = pdfDoc.Texts(textIndex).FontName
    strEntry = DoxisV18RawFontEntry(pdfDoc, pageNo, strAlias)

    If Len(strEntry) = 0 Then
        DoxisV18TextRawFontComparable = _
            "alias=" & strAlias & _
            "|raw=(unresolved)" & _
            "|size=" & NumTxt(pdfDoc.Texts(textIndex).FontSize)
        Exit Function
    End If

    strBase = DoxisV18PipeField(strEntry, "base")
    strSubtype = DoxisV18PipeField(strEntry, "subtype")
    strEncoding = DoxisV18PipeField(strEntry, "encoding")
    strWidths = DoxisV18PipeField(strEntry, "widths")
    strDescriptor = DoxisV18PipeField(strEntry, "descriptor")

    DoxisV18TextRawFontComparable = _
        "alias=" & strAlias & _
        "|baseRaw=" & strBase & _
        "|subtypeRaw=" & strSubtype & _
        "|encodingRaw=" & strEncoding & _
        "|widths=" & strWidths & _
        "|descriptorChecksum=" & FontTextChecksum(strDescriptor) & _
        "|size=" & NumTxt(pdfDoc.Texts(textIndex).FontSize)
End Function

Private Function DoxisV18TextRawFontDisplay( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal textIndex As Long) As String

    Dim strAlias As String
    Dim strEntry As String

    If textIndex < 0 Or textIndex >= pdfDoc.TextCount Then
        DoxisV18TextRawFontDisplay = "MISSING"
        Exit Function
    End If

    strAlias = pdfDoc.Texts(textIndex).FontName
    strEntry = DoxisV18RawFontEntry(pdfDoc, pageNo, strAlias)

    If Len(strEntry) = 0 Then
        DoxisV18TextRawFontDisplay = _
            "alias=" & strAlias & "|entry=(unresolved)"
    Else
        DoxisV18TextRawFontDisplay = _
            RegressionLimitText(strEntry, 700)
    End If
End Function

Private Function DoxisV18RawFontEntry( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal fontAlias As String) As String

    Dim arrEntries As Variant
    Dim lngIndex As Long
    Dim strEntry As String
    Dim strSignature As String

    If pageNo < 1 Or pageNo > pdfDoc.PageCount Then Exit Function

    strSignature = pdfDoc.Pages(pageNo).FontForensicSignature
    If Len(strSignature) = 0 Then Exit Function
    If strSignature = "(none)" Or strSignature = "(unresolved)" Then Exit Function

    arrEntries = Split(strSignature, ";")

    For lngIndex = LBound(arrEntries) To UBound(arrEntries)
        strEntry = CStr(arrEntries(lngIndex))

        If Left$(strEntry, Len(fontAlias) + 1) = fontAlias & "|" Then
            DoxisV18RawFontEntry = strEntry
            Exit Function
        End If
    Next lngIndex
End Function

Private Function DoxisV18PipeField( _
    ByVal pipeText As String, _
    ByVal fieldName As String) As String

    Dim arrParts As Variant
    Dim lngIndex As Long
    Dim strPrefix As String
    Dim strValue As String

    strPrefix = fieldName & "="
    arrParts = Split(pipeText, "|")

    For lngIndex = LBound(arrParts) To UBound(arrParts)
        strValue = CStr(arrParts(lngIndex))

        If Left$(strValue, Len(strPrefix)) = strPrefix Then
            DoxisV18PipeField = Mid$(strValue, Len(strPrefix) + 1)
            Exit Function
        End If
    Next lngIndex

    DoxisV18PipeField = "(absent)"
End Function

Private Function DoxisV18DecodePdfName(ByVal pdfName As String) As String
    Dim lngCode As Long
    Dim lngIndex As Long
    Dim strHex As String
    Dim strResult As String

    lngIndex = 1

    Do While lngIndex <= Len(pdfName)
        If Mid$(pdfName, lngIndex, 1) = "#" And _
           lngIndex + 2 <= Len(pdfName) Then

            strHex = Mid$(pdfName, lngIndex + 1, 2)

            If DoxisV18IsHexByte(strHex) Then
                lngCode = CLng("&H" & strHex)
                strResult = strResult & Chr$(lngCode)
                lngIndex = lngIndex + 3
            Else
                strResult = strResult & Mid$(pdfName, lngIndex, 1)
                lngIndex = lngIndex + 1
            End If
        Else
            strResult = strResult & Mid$(pdfName, lngIndex, 1)
            lngIndex = lngIndex + 1
        End If
    Loop

    DoxisV18DecodePdfName = strResult
End Function

Private Function DoxisV18IsHexByte(ByVal textValue As String) As Boolean
    Dim lngIndex As Long
    Dim strChar As String

    If Len(textValue) <> 2 Then Exit Function

    For lngIndex = 1 To 2
        strChar = UCase$(Mid$(textValue, lngIndex, 1))

        If InStr(1, "0123456789ABCDEF", strChar, vbBinaryCompare) = 0 Then
            Exit Function
        End If
    Next lngIndex

    DoxisV18IsHexByte = True
End Function

Private Function DoxisV18FontSerializationPriority(ByVal role As String) As Long
    If role = "TOP_ISIN" Or InStr(1, role, "WHG", vbBinaryCompare) > 0 Then
        DoxisV18FontSerializationPriority = 2
    Else
        DoxisV18FontSerializationPriority = 1
    End If
End Function

Private Function DoxisTextTopologySnapshot( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal textIndex As Long, _
    ByVal role As String, _
    ByRef riskScore As Double, _
    ByRef separatorSignature As String) As String

    Const METHOD_NAME As String = "DoxisTextTopologySnapshot"
    Dim dblBandBottom As Double
    Dim dblGlyphBottom As Double
    Dim dblGlyphTop As Double
    Dim dblLineGap As Double
    Dim dblLineX As Double
    Dim dblTextEnd As Double
    Dim dblTextWidth As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCutIndex As Long
    Dim lngLineIndex As Long
    Dim strRisk As String

    On Error GoTo ErrorHandler

    riskScore = 0#
    separatorSignature = "(none)"

    dblTextWidth = EstimateTextWidth( _
        pdfDoc.Texts(textIndex).TextValue, _
        pdfDoc.Texts(textIndex).FontName, _
        pdfDoc.Texts(textIndex).FontSize)

    dblTextEnd = pdfDoc.Texts(textIndex).X + dblTextWidth
    dblGlyphBottom = pdfDoc.Texts(textIndex).Y - _
        (pdfDoc.Texts(textIndex).FontSize * DOXIS_TEXT_DESCENDER_FACTOR)
    dblGlyphTop = pdfDoc.Texts(textIndex).Y + _
        (pdfDoc.Texts(textIndex).FontSize * DOXIS_TEXT_ASCENDER_FACTOR)
    dblBandBottom = pdfDoc.Texts(textIndex).Y - DOXIS_SEGMENTATION_BASELINE_BELOW

    lngLineIndex = DoxisFindMostRelevantVerticalSeparator( _
        pdfDoc, _
        pageNo, _
        pdfDoc.Texts(textIndex).X, _
        dblTextEnd, _
        dblGlyphBottom, _
        dblGlyphTop, _
        dblBandBottom, _
        pdfDoc.Texts(textIndex).Y, _
        dblLineGap, _
        dblLineX)

    If lngLineIndex >= 0 Then
        separatorSignature = DoxisLineSignature(pdfDoc.Lines(lngLineIndex))
        lngCutIndex = DoxisPredictCutCharacter( _
            pdfDoc.Texts(textIndex).TextValue, _
            pdfDoc.Texts(textIndex).FontName, _
            pdfDoc.Texts(textIndex).FontSize, _
            pdfDoc.Texts(textIndex).X, _
            dblLineX)

        riskScore = DoxisSeparatorRiskScore( _
            pdfDoc.Lines(lngLineIndex), _
            dblLineGap, _
            dblLineX, _
            pdfDoc.Texts(textIndex).X, _
            dblTextEnd, _
            dblGlyphBottom, _
            dblGlyphTop)

        strRisk = DoxisRiskLabel(riskScore)
    Else
        lngCutIndex = 0
        dblLineGap = 999#
        strRisk = "NONE"
    End If

    DoxisTextTopologySnapshot = _
        "text=" & SanitizeReportText(pdfDoc.Texts(textIndex).TextValue) & _
        ",x=" & NumTxt(pdfDoc.Texts(textIndex).X) & _
        ",y=" & NumTxt(pdfDoc.Texts(textIndex).Y) & _
        ",font=" & pdfDoc.Texts(textIndex).FontName & "@" & NumTxt(pdfDoc.Texts(textIndex).FontSize) & _
        ",estW=" & NumTxt(dblTextWidth) & _
        ",risk=" & strRisk & _
        ",riskScore=" & NumTxt(riskScore) & _
        ",separatorGapPt=" & DoxisOptionalNumber(dblLineGap) & _
        ",gapPx300=" & DoxisOptionalNumber(DoxisPointsToPixels(dblLineGap, DOXIS_RASTER_PROXY_DPI_LOW)) & _
        ",gapPx600=" & DoxisOptionalNumber(DoxisPointsToPixels(dblLineGap, DOXIS_RASTER_PROXY_DPI_HIGH)) & _
        ",predictedCutAfterChars=" & CStr(lngCutIndex) & _
        ",separator=" & separatorSignature

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    DoxisTextTopologySnapshot = "ERROR"
    riskScore = 0#
    separatorSignature = "(error)"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo;textIndex;role", _
        pageNo, _
        textIndex, _
        role

    errorManager.save
    Resume ExitFunction
End Function

Private Function DoxisFindMostRelevantVerticalSeparator( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal textX As Double, _
    ByVal textEndX As Double, _
    ByVal glyphBottom As Double, _
    ByVal glyphTop As Double, _
    ByVal segmentationBottom As Double, _
    ByVal baselineY As Double, _
    ByRef bestGap As Double, _
    ByRef bestLineX As Double) As Long

    Dim dblGap As Double
    Dim dblLineX As Double
    Dim dblScore As Double
    Dim dblBestScore As Double
    Dim dblYMax As Double
    Dim dblYMin As Double
    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngStart As Long

    DoxisFindMostRelevantVerticalSeparator = -1
    bestGap = 999#
    bestLineX = 0#
    dblBestScore = 1E+30

    If pageNo < 1 Or pageNo > pdfDoc.PageCount Then Exit Function

    lngStart = pdfDoc.Pages(pageNo).LineStart
    lngEnd = lngStart + pdfDoc.Pages(pageNo).LineCount - 1

    For lngIndex = lngStart To lngEnd
        If Abs(pdfDoc.Lines(lngIndex).X1 - pdfDoc.Lines(lngIndex).X2) <= _
           DOXIS_LINE_X_TOLERANCE Then

            dblLineX = _
                (pdfDoc.Lines(lngIndex).X1 + pdfDoc.Lines(lngIndex).X2) / 2#

            If dblLineX >= textX + DOXIS_TEXT_X_MARGIN And _
               dblLineX <= textEndX - DOXIS_TEXT_X_MARGIN Then

                dblYMin = MinDouble( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)

                dblYMax = MaxDouble( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)

                dblGap = DoxisVerticalGapToBand( _
                    dblYMin, _
                    dblYMax, _
                    glyphBottom, _
                    glyphTop)

                If dblGap > DOXIS_NEAR_SEPARATOR_GAP Then
                    dblGap = DoxisVerticalGapToBand( _
                        dblYMin, _
                        dblYMax, _
                        segmentationBottom, _
                        baselineY + 1#)
                End If

                If dblGap <= DOXIS_NEAR_SEPARATOR_GAP Then
                    dblScore = _
                        dblGap * 100# + _
                        Abs(dblLineX - ((textX + textEndX) / 2#))

                    If dblScore < dblBestScore Then
                        dblBestScore = dblScore
                        bestGap = dblGap
                        bestLineX = dblLineX
                        DoxisFindMostRelevantVerticalSeparator = lngIndex
                    End If
                End If
            End If
        End If
    Next lngIndex
End Function

Private Function DoxisSeparatorRiskScore( _
    ByRef pdfLine As tPdfLine, _
    ByVal lineGap As Double, _
    ByVal lineX As Double, _
    ByVal textX As Double, _
    ByVal textEndX As Double, _
    ByVal glyphBottom As Double, _
    ByVal glyphTop As Double) As Double

    Dim dblScore As Double
    Dim dblYMax As Double
    Dim dblYMin As Double

    dblYMin = MinDouble(pdfLine.Y1, pdfLine.Y2)
    dblYMax = MaxDouble(pdfLine.Y1, pdfLine.Y2)

    If lineX > textX And lineX < textEndX Then
        dblScore = dblScore + 30#
    End If

    If dblYMax >= glyphBottom And dblYMin <= glyphTop Then
        dblScore = dblScore + 70#
    ElseIf lineGap <= 1# Then
        dblScore = dblScore + 45#
    ElseIf lineGap <= 3# Then
        dblScore = dblScore + 30#
    ElseIf lineGap <= DOXIS_NEAR_SEPARATOR_GAP Then
        dblScore = dblScore + 15#
    End If

    If LCase$(pdfLine.SourceOperator) = "re" Then
        dblScore = dblScore + 8#
    End If

    If pdfLine.PaintOperator <> "S" Then
        dblScore = dblScore + 4#
    End If

    If pdfLine.LineWidth > 0.01 Then
        dblScore = dblScore + MinDouble(10#, pdfLine.LineWidth * 10#)
    End If

    DoxisSeparatorRiskScore = dblScore
End Function

Private Function DoxisRiskLabel(ByVal riskScore As Double) As String
    If riskScore >= 90# Then
        DoxisRiskLabel = "CROSSING_OR_VERY_HIGH"
    ElseIf riskScore >= 60# Then
        DoxisRiskLabel = "HIGH"
    ElseIf riskScore >= 40# Then
        DoxisRiskLabel = "MEDIUM"
    ElseIf riskScore > 0# Then
        DoxisRiskLabel = "NEAR"
    Else
        DoxisRiskLabel = "NONE"
    End If
End Function

Private Function DoxisPredictCutCharacter( _
    ByVal textValue As String, _
    ByVal fontName As String, _
    ByVal fontSize As Double, _
    ByVal textX As Double, _
    ByVal separatorX As Double) As Long

    Dim dblCursor As Double
    Dim lngIndex As Long

    DoxisPredictCutCharacter = 0
    dblCursor = textX

    If separatorX <= textX Then Exit Function

    For lngIndex = 1 To Len(textValue)
        dblCursor = dblCursor + DoxisCharacterWidthPoints( _
            Mid$(textValue, lngIndex, 1), _
            fontName, _
            fontSize)

        If dblCursor >= separatorX Then
            DoxisPredictCutCharacter = lngIndex - 1
            Exit Function
        End If
    Next lngIndex

    DoxisPredictCutCharacter = Len(textValue)
End Function

Private Function DoxisCharacterWidthPoints( _
    ByVal characterValue As String, _
    ByVal fontName As String, _
    ByVal fontSize As Double) As Double

    Dim dblFactor As Double
    Dim dblUnits As Double

    Select Case characterValue
        Case " "
            dblUnits = 0.25
        Case "i", "l", "I", ".", ",", ":", ";", "!", "'", "|"
            dblUnits = 0.25
        Case "M", "W", "m", "w", "@", "%"
            dblUnits = 0.85
        Case "0" To "9"
            dblUnits = 0.5
        Case "A" To "Z"
            dblUnits = 0.65
        Case Else
            dblUnits = 0.48
    End Select

    dblFactor = 1#
    If InStr(1, fontName, "Bold", vbTextCompare) > 0 Then
        dblFactor = 1.03
    End If

    DoxisCharacterWidthPoints = dblUnits * fontSize * dblFactor
End Function

Private Function DoxisVerticalGapToBand( _
    ByVal lineMinY As Double, _
    ByVal lineMaxY As Double, _
    ByVal bandMinY As Double, _
    ByVal bandMaxY As Double) As Double

    If lineMaxY < bandMinY Then
        DoxisVerticalGapToBand = bandMinY - lineMaxY
    ElseIf lineMinY > bandMaxY Then
        DoxisVerticalGapToBand = lineMinY - bandMaxY
    Else
        DoxisVerticalGapToBand = 0#
    End If
End Function

Private Function DoxisLineSignature(ByRef pdfLine As tPdfLine) As String
    DoxisLineSignature = _
        "x=" & NumTxt((pdfLine.X1 + pdfLine.X2) / 2#) & _
        ",y=" & NumTxt(MinDouble(pdfLine.Y1, pdfLine.Y2)) & _
        ".." & NumTxt(MaxDouble(pdfLine.Y1, pdfLine.Y2)) & _
        ",w=" & NumTxt(pdfLine.LineWidth) & _
        ",source=" & pdfLine.SourceOperator & _
        ",paint=" & pdfLine.PaintOperator & _
        ",color=" & pdfLine.StrokeColor
End Function

Private Function DoxisPointsToPixels( _
    ByVal pointsValue As Double, _
    ByVal dpi As Double) As Double

    If pointsValue >= 900# Then
        DoxisPointsToPixels = pointsValue
    Else
        DoxisPointsToPixels = pointsValue * dpi / 72#
    End If
End Function

Private Function DoxisOptionalNumber(ByVal value As Double) As String
    If value >= 900# Then
        DoxisOptionalNumber = "NA"
    Else
        DoxisOptionalNumber = NumTxt(value)
    End If
End Function

Private Function DoxisRolePriority(ByVal role As String) As Long
    If role = "TOP_ISIN" Then
        DoxisRolePriority = 3
    ElseIf InStr(1, role, "WHG", vbBinaryCompare) > 0 Then
        DoxisRolePriority = 3
    ElseIf role = "TOP_SCHLUSSTAG" Or role = "TOP_VALUTATAG" Then
        DoxisRolePriority = 2
    Else
        DoxisRolePriority = 1
    End If
End Function

Private Sub DoxisAddIssue( _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object, _
    ByVal family As String, _
    ByVal priority As Long, _
    ByVal sampleText As String)

    Dim lngCount As Long
    Dim lngSampleNo As Long
    Dim strKey As String

    If dictIssueCounts.Exists(family) Then
        dictIssueCounts(family) = CLng(dictIssueCounts(family)) + 1

        If priority > CLng(dictIssuePriorities(family)) Then
            dictIssuePriorities(family) = priority
        End If
    Else
        dictIssueCounts.Add family, 1
        dictIssuePriorities.Add family, priority
    End If

    lngCount = CLng(dictIssueCounts(family))
    lngSampleNo = lngCount

    If lngSampleNo > DOXIS_MAX_SAMPLES_PER_FAMILY Then Exit Sub

    strKey = family & "|" & CStr(lngSampleNo)

    If Not dictIssueSamples.Exists(strKey) Then
        dictIssueSamples.Add strKey, sampleText
    End If
End Sub

Private Sub DoxisWriteSuperShortReport( _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchors As Object, _
    ByVal betterAnchors As Object, _
    ByVal currentAnchors As Object, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object, _
    ByVal outputPath As String)

    Const METHOD_NAME As String = "DoxisWriteSuperShortReport"
    Dim arrKeys As Variant
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCritical As Long
    Dim lngFile As Long
    Dim lngHigh As Long
    Dim lngIndex As Long
    Dim lngPriority As Long
    Dim lngReview As Long
    Dim lngSample As Long
    Dim strFamily As String
    Dim strSampleKey As String
    Dim strStatus As String

    On Error GoTo ErrorHandler

    If dictIssueCounts.Count > 0 Then
        arrKeys = SortedDictionaryKeys(dictIssueCounts)

        For lngIndex = LBound(arrKeys) To UBound(arrKeys)
            strFamily = CStr(arrKeys(lngIndex))

            Select Case CLng(dictIssuePriorities(strFamily))
                Case Is >= 3
                    lngCritical = lngCritical + CLng(dictIssueCounts(strFamily))
                Case 2
                    lngHigh = lngHigh + CLng(dictIssueCounts(strFamily))
                Case Else
                    lngReview = lngReview + CLng(dictIssueCounts(strFamily))
            End Select
        Next lngIndex
    End If

    If lngCritical > 0 Then
        strStatus = "ACTION_REQUIRED_CRITICAL"
    ElseIf lngHigh > 0 Then
        strStatus = "ACTION_REQUIRED_HIGH"
    Else
        strStatus = "NO_TRANSACTION_ANCHORED_PARSER_REGRESSION_FOUND"
    End If

    lngFile = FreeFile
    Open outputPath For Output Access Write As #lngFile

    Print #lngFile, "ORACLE_DOXIS_TRANSACTION_ANCHORED_SUPER_SHORT_V18_2"
    Print #lngFile, "OLD_ORACLE|" & oldDoc.PdfPath
    Print #lngFile, "BETTER_PARSING|" & betterDoc.PdfPath
    Print #lngFile, "CURRENT|" & currentDoc.PdfPath
    Print #lngFile, _
        "RESULT|status=" & strStatus & _
        "|families=" & CStr(dictIssueCounts.Count) & _
        "|criticalEvents=" & CStr(lngCritical) & _
        "|highEvents=" & CStr(lngHigh) & _
        "|reviewEvents=" & CStr(lngReview)
    Print #lngFile, _
        "ANCHORS|OLD=" & CStr(oldAnchors.Count) & _
        "|BETTER=" & CStr(betterAnchors.Count) & _
        "|CURRENT=" & CStr(currentAnchors.Count)
    Print #lngFile, _
        "MODEL|Transaction-number anchored. OLD Oracle is the gold standard. BETTER is behavioural evidence only. V18.2 also tests 0.01pt row overlap, primitive serialization, global-X projection and invisible re n paths."
    Print #lngFile, _
        "ISIN|Fixed x=639 and global visible/invisible-X cuts are blocking only when CURRENT is worse than OLD Oracle; BETTER is shown as a behavioural control."
    Print #lngFile, _
        "IMPORTANT|BETTER_PARSING_IS_NOT_A_GOLD_STANDARD=TRUE|A BETTER-only difference is not a blocker unless OLD supports the same direction."
    Print #lngFile, _
        "PROVENANCE|PRODUCER_OLD=" & SanitizeReportText(oldDoc.ProducerValue) & _
        "|PRODUCER_BETTER=" & SanitizeReportText(betterDoc.ProducerValue) & _
        "|PRODUCER_CURRENT=" & SanitizeReportText(currentDoc.ProducerValue) & _
        "|CREATOR_OLD=" & SanitizeReportText(oldDoc.CreatorValue) & _
        "|CREATOR_BETTER=" & SanitizeReportText(betterDoc.CreatorValue) & _
        "|CREATOR_CURRENT=" & SanitizeReportText(currentDoc.CreatorValue)
    Print #lngFile, _
        "PAINTED_PRIMITIVES" & _
        "|OLD_ml=" & CStr(DoxisV182CountPaintedPrimitive(oldDoc, "m/l")) & _
        "|OLD_re=" & CStr(DoxisV182CountPaintedPrimitive(oldDoc, "re")) & _
        "|BETTER_ml=" & CStr(DoxisV182CountPaintedPrimitive(betterDoc, "m/l")) & _
        "|BETTER_re=" & CStr(DoxisV182CountPaintedPrimitive(betterDoc, "re")) & _
        "|CURRENT_ml=" & CStr(DoxisV182CountPaintedPrimitive(currentDoc, "m/l")) & _
        "|CURRENT_re=" & CStr(DoxisV182CountPaintedPrimitive(currentDoc, "re"))
    Print #lngFile, _
        "RE_N_CAPTURE|OLD_segments=" & CStr(oldDoc.NoPaintLineCount) & _
        "|BETTER_segments=" & CStr(betterDoc.NoPaintLineCount) & _
        "|CURRENT_segments=" & CStr(currentDoc.NoPaintLineCount) & _
        "|x468=" & CStr(DoxisV181CountNoPaintReVerticalAtX(oldDoc, 468#)) & "/" & _
                     CStr(DoxisV181CountNoPaintReVerticalAtX(betterDoc, 468#)) & "/" & _
                     CStr(DoxisV181CountNoPaintReVerticalAtX(currentDoc, 468#)) & _
        "|x639=" & CStr(DoxisV181CountNoPaintReVerticalAtX(oldDoc, 639#)) & "/" & _
                     CStr(DoxisV181CountNoPaintReVerticalAtX(betterDoc, 639#)) & "/" & _
                     CStr(DoxisV181CountNoPaintReVerticalAtX(currentDoc, 639#)) & _
        "|order=OLD/BETTER/CURRENT"

    If lngCritical = 0 And lngHigh = 0 Then
        Print #lngFile, "BREAKING_SIGNALS|NONE"

        If lngReview > 0 Then
            Print #lngFile, _
                "REVIEW_ONLY|There are non-blocking value/anchor differences, but no V18 transaction-anchored parser regression signal."
        End If

        Print #lngFile, _
            "NEXT|No CURRENT-vs-OLD parser-facing regression was found. If client behaviour still differs, inspect post-processing/provenance and the DOXISLoader extraction profile/configuration."
        GoTo ExitSub
    End If

    Print #lngFile, ""
    Print #lngFile, "BREAKING_SIGNALS"

    For lngPriority = 3 To 2 Step -1
        arrKeys = SortedDictionaryKeys(dictIssueCounts)

        For lngIndex = LBound(arrKeys) To UBound(arrKeys)
            strFamily = CStr(arrKeys(lngIndex))

            If CLng(dictIssuePriorities(strFamily)) = lngPriority Then
                Print #lngFile, _
                    "ISSUE" & _
                    "|priority=" & RegressionPriorityLabel(lngPriority) & _
                    "|family=" & strFamily & _
                    "|count=" & CStr(dictIssueCounts(strFamily))

                For lngSample = 1 To DOXIS_MAX_SAMPLES_PER_FAMILY
                    strSampleKey = strFamily & "|" & CStr(lngSample)

                    If dictIssueSamples.Exists(strSampleKey) Then
                        Print #lngFile, _
                            "DETAIL" & _
                            "|family=" & strFamily & _
                            "|" & CStr(dictIssueSamples(strSampleKey))
                    End If
                Next lngSample
            End If
        Next lngIndex
    Next lngPriority

    Print #lngFile, ""
    Print #lngFile, "INTERPRETATION_PRIORITY"
    Print #lngFile, _
        "1|TRIAD_SEPARATOR_PRIMITIVE_REGRESSION_X468/X639: strongest signal when OLD=BETTER and CURRENT alone changes m/l versus re and/or the exact Y span."
    Print #lngFile, _
        "2|ROW_INTRUSION_REGRESSION_X468/X639: direct transaction-anchored check catches >0.01pt CURRENT top-span growth, including the observed 0.04pt class."
    Print #lngFile, _
        "3|FONT_*_CURRENT_DIFFERS_OLD: inspect BaseFont literal versus #xx serialization and size only when CURRENT truly differs from OLD; alias-only differences are excluded from raw-core comparison."
    Print #lngFile, _
        "4|GLOBAL_INVISIBLE_RE_N_* is blocking only versus OLD. BETTER having zero re-n paths no longer creates a false regression by itself."
    Print #lngFile, _
        "5|PROVENANCE/PAINTED_PRIMITIVES: if CURRENT says re while the VBA source emits m/l, different Producer/Creator or a radically changed primitive profile supports post-processing/wrong-build rather than a geometry formula bug."

    Print #lngFile, ""
    Print #lngFile, _
        "NEXT|Send this V18.2 SUPER_SHORT first. Use DETAIL only for families that remain CRITICAL/HIGH after OLD-based filtering."

ExitSub:
    If lngFile <> 0 Then Close #lngFile
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "outputPath", _
        outputPath

    errorManager.save
    Resume ExitSub
End Sub

Private Function BuildDoxisTopologyDetailOutputPath( _
    ByVal betterPdfPath As String, _
    ByVal currentPdfPath As String) As String

    Dim lngSlashPosition As Long
    Dim strFolder As String

    lngSlashPosition = InStrRev(currentPdfPath, "\")
    If lngSlashPosition > 0 Then
        strFolder = Left$(currentPdfPath, lngSlashPosition)
    End If

    BuildDoxisTopologyDetailOutputPath = _
        strFolder & _
        FileBaseName(betterPdfPath) & _
        "_VS_" & _
        FileBaseName(currentPdfPath) & _
        "_DOXIS_V18_2_DETAIL.txt"
End Function

