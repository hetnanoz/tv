'===============================================================================
' V16 PARSER REGRESSION FORENSIC
' PURPOSE:
'   Compare three binaries of the same logical report:
'       OLD Oracle reference
'       PREVIOUS GOOD generated PDF (client parsed better)
'       CURRENT generated PDF (client parses worse)
'
'   V15 intentionally normalised several differences that are visually harmless.
'   V16 adds a raw parser-facing layer: exact operator order, operator operands,
'   invisible rectangle paths, separator construction source, content-stream
'   topology and local operator windows around ISIN/currency/date text.
'===============================================================================

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    none
' Returns:       none
' Description:   Interactive three-way parser-regression forensic.
'                This is the macro to assign to an Excel button for V16.
'-------------------------------------------------------------------------------
Public Sub RunPdfParserRegressionBrowse()
    Const METHOD_NAME As String = "RunPdfParserRegressionBrowse"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strCurrentPdfPath As String
    Dim strDetailPath As String
    Dim strGoodPdfPath As String
    Dim strOldPdfPath As String
    Dim strSuperShortPath As String

    On Error GoTo ErrorHandler

    strOldPdfPath = SelectPdfFile("V16 - Select OLD Oracle reference PDF")
    If Len(strOldPdfPath) = 0 Then
        GoTo ExitSub
    End If

    strGoodPdfPath = SelectPdfFile("V16 - Select PREVIOUS GOOD PDF (client parsed this version better)")
    If Len(strGoodPdfPath) = 0 Then
        GoTo ExitSub
    End If

    strCurrentPdfPath = SelectPdfFile("V16 - Select CURRENT PDF (client parses this version worse)")
    If Len(strCurrentPdfPath) = 0 Then
        GoTo ExitSub
    End If

    strDetailPath = BuildParserRegressionDetailOutputPath( _
        strGoodPdfPath, _
        strCurrentPdfPath)

    strSuperShortPath = BuildParserRegressionSuperShortOutputPath( _
        strGoodPdfPath, _
        strCurrentPdfPath)

    If Not PdfParserRegressionAudit( _
        strOldPdfPath, _
        strGoodPdfPath, _
        strCurrentPdfPath, _
        strDetailPath, _
        strSuperShortPath) Then

        Err.Raise ERR_BASE + 30, METHOD_NAME, _
            "The V16 parser-regression forensic could not be completed."
    End If

    MsgBox _
        "V16 parser-regression forensic completed." & vbCrLf & vbCrLf & _
        "SEND THIS FILE FIRST:" & vbCrLf & strSuperShortPath & vbCrLf & vbCrLf & _
        "Detailed three-way forensic:" & vbCrLf & strDetailPath & vbCrLf & vbCrLf & _
        "Important: PREVIOUS GOOD and CURRENT should represent the same logical report/input.", _
        vbInformation, _
        "Oracle parser regression V16"

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "oldPdfPath;goodPdfPath;currentPdfPath;detailPath;superShortPath", _
        strOldPdfPath, _
        strGoodPdfPath, _
        strCurrentPdfPath, _
        strDetailPath, _
        strSuperShortPath

    errorManager.save
    errorManager.display "The V16 parser-regression forensic failed."
    Resume ExitSub
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    oldPdfPath, goodPdfPath, currentPdfPath, detailOutputPath,
'                superShortOutputPath
' Returns:       Boolean
' Description:   Programmatic three-way parser-regression forensic.
'-------------------------------------------------------------------------------
Public Function PdfParserRegressionAudit( _
    ByVal oldPdfPath As String, _
    ByVal goodPdfPath As String, _
    ByVal currentPdfPath As String, _
    ByVal detailOutputPath As String, _
    ByVal superShortOutputPath As String) As Boolean

    Const METHOD_NAME As String = "PdfParserRegressionAudit"
    Dim currentDoc As tPdfDocument
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim goodDoc As tPdfDocument
    Dim oldDoc As tPdfDocument

    On Error GoTo ErrorHandler

    If Len(Trim$(oldPdfPath)) = 0 Then
        Err.Raise 1001, METHOD_NAME, "The OLD Oracle PDF path is required."
    End If

    If Len(Trim$(goodPdfPath)) = 0 Then
        Err.Raise 1001, METHOD_NAME, "The PREVIOUS GOOD PDF path is required."
    End If

    If Len(Trim$(currentPdfPath)) = 0 Then
        Err.Raise 1001, METHOD_NAME, "The CURRENT PDF path is required."
    End If

    If Len(Trim$(detailOutputPath)) = 0 Then
        Err.Raise 1020, METHOD_NAME, "The V16 detail output path is required."
    End If

    If Len(Trim$(superShortOutputPath)) = 0 Then
        Err.Raise 1020, METHOD_NAME, "The V16 super-short output path is required."
    End If

    Call LoadPdfDocument(oldPdfPath, oldDoc)
    If oldDoc.PageCount = 0 Then
        Err.Raise 1014, METHOD_NAME, "The OLD Oracle PDF could not be parsed."
    End If

    Call LoadPdfDocument(goodPdfPath, goodDoc)
    If goodDoc.PageCount = 0 Then
        Err.Raise 1014, METHOD_NAME, "The PREVIOUS GOOD PDF could not be parsed."
    End If

    Call LoadPdfDocument(currentPdfPath, currentDoc)
    If currentDoc.PageCount = 0 Then
        Err.Raise 1014, METHOD_NAME, "The CURRENT PDF could not be parsed."
    End If

    Call WriteParserRegressionReports( _
        oldDoc, _
        goodDoc, _
        currentDoc, _
        detailOutputPath, _
        superShortOutputPath)

    PdfParserRegressionAudit = True

ExitFunction:
    Call ResetParserState
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    PdfParserRegressionAudit = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "oldPdfPath;goodPdfPath;currentPdfPath;detailOutputPath;superShortOutputPath", _
        oldPdfPath, _
        goodPdfPath, _
        currentPdfPath, _
        detailOutputPath, _
        superShortOutputPath

    errorManager.save
    Resume ExitFunction
End Function

