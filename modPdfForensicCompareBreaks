Private Sub BreaksWriteFocusedFieldDiagnostics( _
    ByRef oldDoc As tPdfDocument, _
    ByRef newDoc As tPdfDocument, _
    ByVal fileNumber As Long)

    Const METHOD_NAME As String = "BreaksWriteFocusedFieldDiagnostics"
    Dim blnNewUsed() As Boolean
    Dim dictFocused As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim lngNewIndex As Long
    Dim lngPage As Long
    Dim lngPages As Long
    Dim strKey As String
    Dim strNewText As String
    Dim strOldText As String
    Dim strRole As String

    On Error GoTo ErrorHandler

    Set dictFocused = CreateObject("Scripting.Dictionary")

    lngPages = oldDoc.PageCount
    If newDoc.PageCount < lngPages Then
        lngPages = newDoc.PageCount
    End If

    For lngPage = 1 To lngPages
        If newDoc.TextCount > 0 Then
            ReDim blnNewUsed(0 To newDoc.TextCount - 1)
        Else
            ReDim blnNewUsed(0 To 0)
        End If

        For lngIndex = 0 To oldDoc.TextCount - 1
            If oldDoc.Texts(lngIndex).PageNo = lngPage Then
                lngNewIndex = FindBreaksExactTextMatch( _
                    oldDoc, _
                    newDoc, _
                    lngIndex, _
                    lngPage, _
                    blnNewUsed)

                If lngNewIndex < 0 Then
                    lngNewIndex = FindBreaksGeometryTextMatch( _
                        oldDoc, _
                        newDoc, _
                        lngIndex, _
                        lngPage, _
                        blnNewUsed)
                End If

                If lngNewIndex >= 0 Then
                    blnNewUsed(lngNewIndex) = True

                    strOldText = oldDoc.Texts(lngIndex).TextValue
                    strNewText = newDoc.Texts(lngNewIndex).TextValue
                    strRole = BreaksInferFieldRole( _
                        strOldText, _
                        oldDoc.Texts(lngIndex).X)

                    If BreaksIsFocusedFieldRole(strRole) Then
                        strKey = _
                            "role=" & strRole & _
                            "|valueOld=" & BreaksShortText(Trim$(strOldText)) & _
                            "|valueNew=" & BreaksShortText(Trim$(strNewText))

                        strKey = strKey & _
                            "|valueComparable=" & PfcCore_BoolText( _
                                BreaksAreComparableFieldValues( _
                                    strOldText, _
                                    strNewText)) & _
                            "|xActionable=" & PfcCore_BoolText( _
                                Not BreaksShouldIgnoreHorizontalPositionForInputDifference( _
                                    strRole, _
                                    strOldText, _
                                    strNewText))

                        strKey = strKey & _
                            "|rawOld=" & BreaksVisibleWhitespace(strOldText) & _
                            "|rawNew=" & BreaksVisibleWhitespace(strNewText) & _
                            "|x=" & NumTxt(oldDoc.Texts(lngIndex).X) & ">" & _
                                NumTxt(newDoc.Texts(lngNewIndex).X) & _
                            "|y=" & NumTxt(oldDoc.Texts(lngIndex).Y) & ">" & _
                                NumTxt(newDoc.Texts(lngNewIndex).Y)

                        strKey = strKey & _
                            "|dX=" & NumTxt(newDoc.Texts(lngNewIndex).X - oldDoc.Texts(lngIndex).X) & _
                            "|dY=" & NumTxt(newDoc.Texts(lngNewIndex).Y - oldDoc.Texts(lngIndex).Y) & _
                            "|fontSize=" & NumTxt(oldDoc.Texts(lngIndex).FontSize) & ">" & _
                                NumTxt(newDoc.Texts(lngNewIndex).FontSize) & _
                            "|fontAlias=" & oldDoc.Texts(lngIndex).FontName & ">" & _
                                newDoc.Texts(lngNewIndex).FontName

                        strKey = strKey & _
                            "|lead=" & CStr(BreaksLeadingSpaceCount(strOldText)) & ">" & _
                                CStr(BreaksLeadingSpaceCount(strNewText)) & _
                            "|trail=" & CStr(BreaksTrailingSpaceCount(strOldText)) & ">" & _
                                CStr(BreaksTrailingSpaceCount(strNewText))

                        Call PfcCore_IncrementDictionaryValue( _
                            dictFocused, _
                            strKey)
                    End If
                End If
            End If
        Next lngIndex
    Next lngPage

    Call BreaksSummaryWriteDictionary( _
        dictFocused, _
        fileNumber, _
        36, _
        "FOCUS")

ExitSub:
    Set dictFocused = Nothing
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitSub
End Sub

