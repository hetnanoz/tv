Private Function BreaksDictionaryMaxLong(ByVal dictionary As Object) As Long

    Const METHOD_NAME As String = "BreaksDictionaryMaxLong"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strKey As Variant

    On Error GoTo ErrorHandler

    If dictionary Is Nothing Then
        GoTo ExitFunction
    End If

    For Each strKey In dictionary.Keys
        If CLng(dictionary(strKey)) > BreaksDictionaryMaxLong Then
            BreaksDictionaryMaxLong = CLng(dictionary(strKey))
        End If
    Next strKey

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksDictionaryMaxLong = 0

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    oldDictionary As Object, newDictionary As Object, ByRef sample As String
' Returns:       Long
' Description:   Counts exact horizontal geometry occurrences present more often in NEW than OLD.
'-------------------------------------------------------------------------------
Private Function BreaksCountDictionaryExcess( _
    ByVal oldDictionary As Object, _
    ByVal newDictionary As Object, _
    ByRef sample As String) As Long

    Const METHOD_NAME As String = "BreaksCountDictionaryExcess"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngDifference As Long
    Dim lngOldCount As Long
    Dim strKey As Variant

    On Error GoTo ErrorHandler

    sample = vbNullString

    If newDictionary Is Nothing Then
        GoTo ExitFunction
    End If

    For Each strKey In newDictionary.Keys
        lngOldCount = 0

        If Not oldDictionary Is Nothing Then
            If oldDictionary.Exists(CStr(strKey)) Then
                lngOldCount = CLng(oldDictionary(CStr(strKey)))
            End If
        End If

        lngDifference = CLng(newDictionary(strKey)) - lngOldCount

        If lngDifference > 0 Then
            BreaksCountDictionaryExcess = _
                BreaksCountDictionaryExcess + lngDifference

            If Len(sample) = 0 Then
                sample = CStr(strKey) & _
                    " old=" & CStr(lngOldCount) & _
                    " new=" & CStr(newDictionary(strKey))
            End If
        End If
    Next strKey

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksCountDictionaryExcess = 0
    sample = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    pdfDoc As tPdfDocument, pageNo As Long
' Returns:       Long
' Description:   Counts near-parallel full-width horizontal rules that could rasterize as a thick band.
'-------------------------------------------------------------------------------
'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    oldDoc As tPdfDocument, newDoc As tPdfDocument, pageNo As Long, sample As String
' Returns:       Long
' Description:   Counts NEW full-width horizontals with no unused OLD partner inside coordinate tolerance.
'-------------------------------------------------------------------------------
Private Function BreaksCountTolerantFullWidthHorizontalExcess( _
    ByRef oldDoc As tPdfDocument, _
    ByRef newDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByRef sample As String) As Long

    Const METHOD_NAME As String = "BreaksCountTolerantFullWidthHorizontalExcess"
    Dim blnOldUsed() As Boolean
    Dim dblNewLength As Double
    Dim dblOldLength As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngNew As Long
    Dim lngOld As Long
    Dim lngPartner As Long

    On Error GoTo ErrorHandler

    sample = vbNullString

    If oldDoc.LineCount > 0 Then
        ReDim blnOldUsed(0 To oldDoc.LineCount - 1)
    End If

    For lngNew = 0 To newDoc.LineCount - 1
        If newDoc.Lines(lngNew).PageNo = pageNo And _
           BreaksLineOrientation(newDoc.Lines(lngNew)) = "H" Then

            dblNewLength = Abs( _
                newDoc.Lines(lngNew).X2 - newDoc.Lines(lngNew).X1)

            If dblNewLength >= BREAKS_FULL_WIDTH_MIN Then
                lngPartner = -1

                For lngOld = 0 To oldDoc.LineCount - 1
                    If Not blnOldUsed(lngOld) Then
                        If oldDoc.Lines(lngOld).PageNo = pageNo And _
                           BreaksLineOrientation(oldDoc.Lines(lngOld)) = "H" Then

                            dblOldLength = Abs( _
                                oldDoc.Lines(lngOld).X2 - oldDoc.Lines(lngOld).X1)

                            If dblOldLength >= BREAKS_FULL_WIDTH_MIN Then
                                If Abs(oldDoc.Lines(lngOld).X1 - newDoc.Lines(lngNew).X1) <= BREAKS_POSITION_TOLERANCE And _
                                   Abs(oldDoc.Lines(lngOld).X2 - newDoc.Lines(lngNew).X2) <= BREAKS_POSITION_TOLERANCE And _
                                   Abs(oldDoc.Lines(lngOld).Y1 - newDoc.Lines(lngNew).Y1) <= BREAKS_POSITION_TOLERANCE And _
                                   Abs(oldDoc.Lines(lngOld).Y2 - newDoc.Lines(lngNew).Y2) <= BREAKS_POSITION_TOLERANCE Then

                                    lngPartner = lngOld
                                    Exit For
                                End If
                            End If
                        End If
                    End If
                Next lngOld

                If lngPartner >= 0 Then
                    blnOldUsed(lngPartner) = True
                Else
                    BreaksCountTolerantFullWidthHorizontalExcess = _
                        BreaksCountTolerantFullWidthHorizontalExcess + 1

                    If Len(sample) = 0 Then
                        sample = _
                            "H y=" & NumTxt(newDoc.Lines(lngNew).Y1) & _
                            " x=" & NumTxt(newDoc.Lines(lngNew).X1) & _
                            ".." & NumTxt(newDoc.Lines(lngNew).X2) & _
                            " paint=" & newDoc.Lines(lngNew).PaintOperator & _
                            " source=" & newDoc.Lines(lngNew).SourceOperator
                    End If
                End If
            End If
        End If
    Next lngNew

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksCountTolerantFullWidthHorizontalExcess = 0
    sample = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo", _
        pageNo

    errorManager.save
    Resume ExitFunction
End Function

Private Function BreaksCountNearFullWidthHorizontalPairs( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long) As Long

    Const METHOD_NAME As String = "BreaksCountNearFullWidthHorizontalPairs"
    Dim errorManager As New ErrorManager
    Dim dblLengthA As Double
    Dim dblLengthB As Double
    Dim dblYA As Double
    Dim dblYB As Double
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngA As Long
    Dim lngB As Long

    On Error GoTo ErrorHandler

    For lngA = 0 To pdfDoc.LineCount - 2
        If pdfDoc.Lines(lngA).PageNo = pageNo And _
           BreaksLineOrientation(pdfDoc.Lines(lngA)) = "H" Then

            dblLengthA = Abs(pdfDoc.Lines(lngA).X2 - pdfDoc.Lines(lngA).X1)

            If dblLengthA >= BREAKS_FULL_WIDTH_MIN Then
                dblYA = (pdfDoc.Lines(lngA).Y1 + pdfDoc.Lines(lngA).Y2) / 2#

                For lngB = lngA + 1 To pdfDoc.LineCount - 1
                    If pdfDoc.Lines(lngB).PageNo = pageNo And _
                       BreaksLineOrientation(pdfDoc.Lines(lngB)) = "H" Then

                        dblLengthB = Abs(pdfDoc.Lines(lngB).X2 - pdfDoc.Lines(lngB).X1)

                        If dblLengthB >= BREAKS_FULL_WIDTH_MIN Then
                            dblYB = (pdfDoc.Lines(lngB).Y1 + pdfDoc.Lines(lngB).Y2) / 2#

                            If Abs(dblYA - dblYB) > COORD_TOLERANCE And _
                               Abs(dblYA - dblYB) <= BREAKS_NEAR_RULE_Y_TOLERANCE Then

                                BreaksCountNearFullWidthHorizontalPairs = _
                                    BreaksCountNearFullWidthHorizontalPairs + 1
                            End If
                        End If
                    End If
                Next lngB
            End If
        End If
    Next lngA

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksCountNearFullWidthHorizontalPairs = 0

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo", _
        pageNo

    errorManager.save
    Resume ExitFunction
End Function

