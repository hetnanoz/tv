Private Sub WriteBreaksExecutiveSummary( _
    ByRef oldDoc As tPdfDocument, _
    ByRef newDoc As tPdfDocument, _
    ByVal detailedBreaksPath As String, _
    ByVal outputPath As String)

    Const METHOD_NAME As String = "WriteBreaksExecutiveSummary"
    Dim errorManager As New ErrorManager
    Dim dictActionTypes As Object
    Dim dictFixNow As Object
    Dim dictFontPairs As Object
    Dim dictIgnore As Object
    Dim dictPages As Object
    Dim dictShiftPatterns As Object
    Dim dictTextShiftFields As Object
    Dim dictVerify As Object
    Dim dictWhgShifts As Object
    Dim dictWhitespace As Object
    Dim dictWhitespaceFields As Object
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCurrentPage As Long
    Dim lngFileIn As Long
    Dim lngFileOut As Long
    Dim lngLikelyTextShift As Long
    Dim lngMatchingNoise As Long
    Dim lngOperatorSerializationPages As Long
    Dim lngPage As Long
    Dim lngPagesCompared As Long
    Dim lngRawCritical As Long
    Dim lngRawInfo As Long
    Dim lngRawStructural As Long
    Dim lngTargetGeometry As Long
    Dim lngTargetStyleOnly As Long
    Dim lngTradeMismatchPages As Long
    Dim lngVectorGeometry As Long
    Dim lngVectorStyle As Long
    Dim oldTradeCount As Long
    Dim newTradeCount As Long
    Dim sampleFooter As Collection
    Dim sampleOperator As Collection
    Dim sampleTarget As Collection
    Dim sampleTextShift As Collection
    Dim sampleVector As Collection
    Dim strFooterOld As String
    Dim strFooterNew As String
    Dim strKey As Variant
    Dim strCompatibilityStatus As String
    Dim strLine As String
    Dim strRawStatus As String

    On Error GoTo ErrorHandler

    Set dictActionTypes = CreateObject("Scripting.Dictionary")
    Set dictFixNow = CreateObject("Scripting.Dictionary")
    Set dictFontPairs = CreateObject("Scripting.Dictionary")
    Set dictIgnore = CreateObject("Scripting.Dictionary")
    Set dictPages = CreateObject("Scripting.Dictionary")
    Set dictShiftPatterns = CreateObject("Scripting.Dictionary")
    Set dictTextShiftFields = CreateObject("Scripting.Dictionary")
    Set dictVerify = CreateObject("Scripting.Dictionary")
    Set dictWhgShifts = CreateObject("Scripting.Dictionary")
    Set dictWhitespace = CreateObject("Scripting.Dictionary")
    Set dictWhitespaceFields = CreateObject("Scripting.Dictionary")

    Set sampleFooter = New Collection
    Set sampleOperator = New Collection
    Set sampleTarget = New Collection
    Set sampleTextShift = New Collection
    Set sampleVector = New Collection

    lngFileIn = FreeFile
    Open detailedBreaksPath For Input Access Read As #lngFileIn

    Do While Not EOF(lngFileIn)
        Line Input #lngFileIn, strLine

        If Left$(strLine, 5) = "PAGE|" Then
            lngCurrentPage = CLng(Val(Mid$(strLine, 6)))
            If lngCurrentPage > lngPagesCompared Then
                lngPagesCompared = lngCurrentPage
            End If

        ElseIf Left$(strLine, 12) = "PAGE_RESULT|" Then
            Call BreaksSummarySetPageValue( _
                dictPages, _
                lngCurrentPage, _
                "result", _
                BreaksSummaryField(strLine, "result"))

            Call BreaksSummarySetPageValue( _
                dictPages, _
                lngCurrentPage, _
                "critical", _
                BreaksSummaryField(strLine, "newCritical"))

            Call BreaksSummarySetPageValue( _
                dictPages, _
                lngCurrentPage, _
                "structural", _
                BreaksSummaryField(strLine, "newStructural"))

        ElseIf Left$(strLine, 12) = "PAGE_LAYOUT|" Then
            oldTradeCount = CLng(Val(BreaksSummaryField(strLine, "tradesOld")))
            newTradeCount = CLng(Val(BreaksSummaryField(strLine, "tradesNew")))

            Call BreaksSummarySetPageValue( _
                dictPages, _
                lngCurrentPage, _
                "trades", _
                CStr(oldTradeCount) & ">" & CStr(newTradeCount))

            strFooterOld = BreaksSummaryField(strLine, "footerOld")
            strFooterNew = BreaksSummaryField(strLine, "footerNew")

            Call BreaksSummarySetPageValue( _
                dictPages, _
                lngCurrentPage, _
                "footer", _
                strFooterOld & ">" & strFooterNew)

            If oldTradeCount <> newTradeCount Then
                lngTradeMismatchPages = lngTradeMismatchPages + 1
            End If

        ElseIf Left$(strLine, 17) = "TARGET_SEPARATOR|" Then
            Call BreaksSummaryRegisterTarget( _
                strLine, _
                lngCurrentPage, _
                dictPages, _
                lngTargetStyleOnly, _
                lngTargetGeometry)

        ElseIf Left$(strLine, 23) = "TARGET_SEPARATOR_STYLE|" Then
            Call BreaksSummaryAddSample(sampleTarget, strLine, 4)

        ElseIf Left$(strLine, 26) = "TARGET_SEPARATOR_GEOMETRY|" Or _
               Left$(strLine, 27) = "TARGET_SEPARATOR_EXTRA_NEW|" Then

            Call BreaksSummaryAddSample(sampleTarget, strLine, 4)

        ElseIf Left$(strLine, 14) = "TEXT_POSITION|" Then
            If BreaksSummaryLikelyPairingNoise(strLine) Then
                lngMatchingNoise = lngMatchingNoise + 1
            Else
                lngLikelyTextShift = lngLikelyTextShift + 1
                Call BreaksSummaryRegisterShiftPattern( _
                    strLine, _
                    dictShiftPatterns)

                Call PfcCore_IncrementDictionaryValue( _
                    dictTextShiftFields, _
                    "role=" & BreaksSummaryField(strLine, "role") & _
                    "|value=" & BreaksSummaryField(strLine, "text") & _
                    "|delta=" & BreaksSummaryField(strLine, "DELTA_NEW_MINUS_OLD"))

                If Left$(BreaksSummaryField(strLine, "role"), 4) = "WHG_" Then
                    Call PfcCore_IncrementDictionaryValue( _
                        dictWhgShifts, _
                        "role=" & BreaksSummaryField(strLine, "role") & _
                        "|value=" & BreaksSummaryField(strLine, "text") & _
                        "|delta=" & BreaksSummaryField(strLine, "DELTA_NEW_MINUS_OLD"))
                End If

                Call BreaksSummaryAddSample(sampleTextShift, strLine, 5)
            End If

        ElseIf Left$(strLine, 10) = "TEXT_FONT|" Then
            Call BreaksSummaryRegisterFontPair(strLine, dictFontPairs)

        ElseIf Left$(strLine, 16) = "WHITESPACE_ONLY|" Then
            Call BreaksSummaryRegisterWhitespace(strLine, dictWhitespace)

            Call PfcCore_IncrementDictionaryValue( _
                dictWhitespaceFields, _
                "role=" & BreaksSummaryField(strLine, "role") & _
                "|text=" & BreaksSummaryField(strLine, "text") & _
                "|leading=" & BreaksSummaryField(strLine, "leadingOld") & ">" & _
                    BreaksSummaryField(strLine, "leadingNew") & _
                "|trailing=" & BreaksSummaryField(strLine, "trailingOld") & ">" & _
                    BreaksSummaryField(strLine, "trailingNew"))

        ElseIf Left$(strLine, 12) = "FOOTER_FONT|" Or _
               Left$(strLine, 13) = "FOOTER_SHIFT|" Then

            Call BreaksSummaryAddSample(sampleFooter, strLine, 4)

        ElseIf Left$(strLine, 17) = "PAGE_STREAM_INFO|" Then
            If BreaksSummaryField(strLine, "type") = "OPERATOR_PROFILE_COUNT_ONLY" Then
                lngOperatorSerializationPages = lngOperatorSerializationPages + 1
            End If

        ElseIf Left$(strLine, 18) = "PAGE_STREAM_BREAK|" Then
            If BreaksSummaryField(strLine, "type") = "OPERATOR_PROFILE" Then
                Call BreaksSummaryAddSample(sampleOperator, strLine, 2)
            End If

        ElseIf Left$(strLine, 24) = "VECTOR_GEOMETRY_SUMMARY|" Then
            lngVectorGeometry = lngVectorGeometry + _
                CLng(Val(BreaksSummaryField(strLine, "breaks")))

        ElseIf Left$(strLine, 21) = "VECTOR_STYLE_SUMMARY|" Then
            lngVectorStyle = lngVectorStyle + _
                CLng(Val(BreaksSummaryField(strLine, "breaks")))

        ElseIf Left$(strLine, 15) = "VECTOR_GEOMETRY|" Or _
               Left$(strLine, 13) = "VECTOR_STYLE|" Then

            Call BreaksSummaryAddSample(sampleVector, strLine, 4)

        ElseIf Left$(strLine, 7) = "ACTION|" Then
            Call BreaksSummaryRegisterActionType(strLine, dictActionTypes)

        ElseIf Left$(strLine, 15) = "BREAKS_SUMMARY|" Then
            strRawStatus = BreaksSummaryField(strLine, "status")
            lngRawCritical = CLng(Val(BreaksSummaryField(strLine, "critical")))
            lngRawStructural = CLng(Val(BreaksSummaryField(strLine, "structural")))
            lngRawInfo = CLng(Val(BreaksSummaryField(strLine, "informational")))
        End If
    Loop

    Close #lngFileIn
    lngFileIn = 0

    '-----------------------------------------------------------------------
    ' Convert raw event families into a small set of code-level decisions.
    '-----------------------------------------------------------------------
    For Each strKey In dictFontPairs.Keys
        Call BreaksSummaryIncrementBy( _
            dictFixNow, _
            "FONT_ROLE|" & CStr(strKey) & _
            "|ACTION=Use the OLD font resource/size for this recurring text role.", _
            CLng(dictFontPairs(strKey)))
    Next strKey

    For Each strKey In dictWhitespace.Keys
        Call BreaksSummaryIncrementBy( _
            dictFixNow, _
            "WHITESPACE|" & CStr(strKey) & _
            "|ACTION=Make Oracle-exporter whitespace match OLD; do not change upstream business formatting.", _
            CLng(dictWhitespace(strKey)))
    Next strKey

    If CLng(BreaksSummaryDictionaryValue( _
        dictActionTypes, _
        "PAGE_FONT_RESOURCES")) > 0 Then

        Call BreaksSummaryIncrementBy( _
            dictFixNow, _
            "PAGE_FONT_RESOURCES|ACTION=Match OLD page font-resource roles/dictionaries.", _
            CLng(BreaksSummaryDictionaryValue( _
                dictActionTypes, _
                "PAGE_FONT_RESOURCES")))
    End If

    If lngTargetStyleOnly > 0 Then
        Call BreaksSummaryIncrementBy( _
            dictFixNow, _
            "TARGET_SEPARATOR_STYLE|ACTION=Keep X/Y geometry; reproduce OLD width/paint/source/color.", _
            lngTargetStyleOnly)
    End If

    If lngVectorStyle > 0 Then
        Call BreaksSummaryIncrementBy( _
            dictFixNow, _
            "VECTOR_STYLE|ACTION=Reproduce OLD paint/source operator families; prioritize repeated rectangle/separator roles.", _
            lngVectorStyle)
    End If

    If sampleFooter.Count > 0 Then
        If CLng(BreaksSummaryDictionaryValue( _
            dictActionTypes, _
            "FOOTER_FONT")) > 0 Then

            Call BreaksSummaryIncrementBy( _
                dictFixNow, _
                "FOOTER_FONT|ACTION=Use the OLD footer font resource and size.", _
                CLng(BreaksSummaryDictionaryValue( _
                    dictActionTypes, _
                    "FOOTER_FONT")))
        End If

        If CLng(BreaksSummaryDictionaryValue( _
            dictActionTypes, _
            "FOOTER_SHIFT")) > 0 Then

            Call BreaksSummaryIncrementBy( _
                dictVerify, _
                "FOOTER_SHIFT|ACTION=Verify on matched pagination before moving footer coordinates.", _
                CLng(BreaksSummaryDictionaryValue( _
                    dictActionTypes, _
                    "FOOTER_SHIFT")))
        End If
    End If

    If lngTargetGeometry > 0 Then
        Call BreaksSummaryIncrementBy( _
            dictVerify, _
            "TARGET_SEPARATOR_GEOMETRY|ACTION=Review representative detail before changing X/Y.", _
            lngTargetGeometry)
    End If

    For Each strKey In dictShiftPatterns.Keys
        Call BreaksSummaryIncrementBy( _
            dictVerify, _
            "TEXT_SHIFT_PATTERN|" & CStr(strKey) & _
            "|ACTION=Apply only when the same delta repeats on logically matching fields.", _
            CLng(dictShiftPatterns(strKey)))
    Next strKey

    If CLng(BreaksSummaryDictionaryValue( _
        dictActionTypes, _
        "OPERATOR_PROFILE")) > 0 Then

        Call BreaksSummaryIncrementBy( _
            dictVerify, _
            "OPERATOR_PROFILE|ACTION=Tune after fonts/vector roles are stable; use representative sample below.", _
            CLng(BreaksSummaryDictionaryValue( _
                dictActionTypes, _
                "OPERATOR_PROFILE")))
    End If

    If lngTradeMismatchPages > 0 Then
        Call BreaksSummaryIncrementBy( _
            dictIgnore, _
            "TRADE_COUNT/PAGINATION|" & CStr(lngTradeMismatchPages) & _
            " page(s) differ|ACTION=Treat downstream row/text/vector count differences as input-contaminated unless reproduced on matched input.", _
            lngTradeMismatchPages)
    End If

    If lngMatchingNoise > 0 Then
        Call BreaksSummaryIncrementBy( _
            dictIgnore, _
            "TEXT_PAIRING_NOISE|ACTION=Do not change generator coordinates from implausibly large repeated-text deltas.", _
            lngMatchingNoise)
    End If

    Call BreaksSummaryIncrementBy( _
        dictIgnore, _
        "EXPECTED_INPUT_VALUES|ACTION=Security-description/business-value differences remain informational. WKN content is excluded by policy; position/font remain audited.", _
        1)

    If dictFixNow.Count = 0 And _
       dictVerify.Count = 0 And _
       lngRawCritical = 0 And _
       lngRawStructural = 0 Then

        strCompatibilityStatus = "READY_FOR_CLIENT_PARSER_TEST"
    Else
        strCompatibilityStatus = "ACTION_REQUIRED"
    End If

    '-----------------------------------------------------------------------
    ' Write compact decision-oriented summary.
    '-----------------------------------------------------------------------
    lngFileOut = OpenNew(outputPath)

    Call EmitLine(lngFileOut, "ORACLE_COMPATIBILITY_ACTIONABLE_SUMMARY_V15_OPTICAL_TOPOLOGY")
    Call EmitLine(lngFileOut, "OLD|" & oldDoc.PdfPath)
    Call EmitLine(lngFileOut, "NEW|" & newDoc.PdfPath)
    Call EmitLine(lngFileOut, _
        "PURPOSE|Full diagnostic summary. Use BREAKS_SUPER_SHORT first; this file retains extended forensic detail.")
    Call EmitLine(lngFileOut, _
        "POLICY|WKN content is excluded from content comparison. WKN position/font remain audited when text exists.")
    Call EmitLine(lngFileOut, _
        "IMPORTANT|Raw critical/structural numbers are event counts, NOT the number of unique code fixes.")

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "GLOBAL")
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, _
        "COMPATIBILITY|status=" & strCompatibilityStatus & _
        "|operatorSerializationInfoPages=" & CStr(lngOperatorSerializationPages))
    Call EmitLine(lngFileOut, _
        "RAW|status=" & strRawStatus & _
        "|criticalEvents=" & CStr(lngRawCritical) & _
        "|structuralEvents=" & CStr(lngRawStructural) & _
        "|informationalEvents=" & CStr(lngRawInfo) & _
        "|pagesCompared=" & CStr(lngPagesCompared))
    Call EmitLine(lngFileOut, _
        "DECISIONS|fixNowFamilies=" & CStr(dictFixNow.Count) & _
        "|verifyFamilies=" & CStr(dictVerify.Count) & _
        "|ignoreFamilies=" & CStr(dictIgnore.Count))
    Call EmitLine(lngFileOut, _
        "TEXT_POSITION|likelyRealEvents=" & CStr(lngLikelyTextShift) & _
        "|pairingNoiseEvents=" & CStr(lngMatchingNoise))
    Call EmitLine(lngFileOut, _
        "VECTORS|geometryEvents=" & CStr(lngVectorGeometry) & _
        "|styleEvents=" & CStr(lngVectorStyle))
    Call EmitLine(lngFileOut, _
        "TARGET_SEPARATORS|styleOnlyEvents=" & CStr(lngTargetStyleOnly) & _
        "|geometryOrCrossingEvents=" & CStr(lngTargetGeometry))
    Call EmitLine(lngFileOut, _
        "INPUT_CONTAMINATION|tradeMismatchPages=" & CStr(lngTradeMismatchPages))

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "FONT_RESOURCE_FORENSICS")
    Call EmitLine(lngFileOut, "============================================================")
    Call BreaksWriteFontResourceForensics( _
        oldDoc, _
        newDoc, _
        lngFileOut)

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "PADDING_AND_WHG_DECISION_MATRIX")
    Call EmitLine(lngFileOut, "============================================================")
    Call BreaksWritePaddingAndWhgDecisionMatrix( _
        oldDoc, _
        newDoc, _
        lngFileOut)

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "STRUCTURAL_FIELD_FORENSICS")
    Call EmitLine(lngFileOut, "============================================================")
    Call BreaksWriteStructuralFieldForensics( _
        oldDoc, _
        newDoc, _
        lngFileOut)

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "FIELD_DIAGNOSTICS")
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "TEXT_ALIGNMENT_BY_FIELD")
    Call BreaksSummaryWriteDictionary( _
        dictTextShiftFields, _
        lngFileOut, _
        20, _
        "FIELD_SHIFT")

    Call EmitLine(lngFileOut, "WHG_ALIGNMENT")
    Call BreaksSummaryWriteDictionary( _
        dictWhgShifts, _
        lngFileOut, _
        12, _
        "WHG")

    Call EmitLine(lngFileOut, "WHITESPACE_BY_FIELD")
    Call BreaksSummaryWriteDictionary( _
        dictWhitespaceFields, _
        lngFileOut, _
        12, _
        "FIELD_WS")

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "FOCUSED_FIELD_DETAILS")
    Call BreaksWriteFocusedFieldDiagnostics( _
        oldDoc, _
        newDoc, _
        lngFileOut)

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "FIX_NOW_STRONG")
    Call EmitLine(lngFileOut, "============================================================")
    Call BreaksSummaryWriteDictionary( _
        dictFixNow, _
        lngFileOut, _
        10, _
        "FIX_NOW")

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "VERIFY_BEFORE_CODE_CHANGE")
    Call EmitLine(lngFileOut, "============================================================")
    Call BreaksSummaryWriteDictionary( _
        dictVerify, _
        lngFileOut, _
        8, _
        "VERIFY")

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "IGNORE_OR_DEFER")
    Call EmitLine(lngFileOut, "============================================================")
    Call BreaksSummaryWriteDictionary( _
        dictIgnore, _
        lngFileOut, _
        6, _
        "IGNORE")

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "PAGE_HEALTH")
    Call EmitLine(lngFileOut, "============================================================")

    For lngPage = 1 To lngPagesCompared
        Call EmitLine(lngFileOut, _
            "PAGE|" & CStr(lngPage) & _
            "|result=" & BreaksSummaryGetPageValue( _
                dictPages, lngPage, "result", "?") & _
            "|trades=" & BreaksSummaryGetPageValue( _
                dictPages, lngPage, "trades", "?") & _
            "|expectedMax=" & CStr(BreaksOracleMaxTradesForPage(lngPage)) & _
            "|footer=" & BreaksSummaryGetPageValue( _
                dictPages, lngPage, "footer", "?") & _
            "|x468=" & BreaksSummaryGetPageValue( _
                dictPages, lngPage, "x468", "?") & _
            "|x639=" & BreaksSummaryGetPageValue( _
                dictPages, lngPage, "x639", "?"))
    Next lngPage

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "HORIZONTAL_RULE_SANITY")
    Call EmitLine(lngFileOut, "============================================================")

    For lngPage = 1 To lngPagesCompared
        Call BreaksWriteHorizontalRuleSanity( _
            oldDoc, _
            newDoc, _
            lngPage, _
            lngFileOut)
    Next lngPage

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "REPRESENTATIVE_DETAIL_SAMPLES")
    Call EmitLine(lngFileOut, "============================================================")

    Call BreaksSummaryWriteSamples( _
        sampleOperator, _
        lngFileOut, _
        "OPERATOR_PROFILE")

    Call BreaksSummaryWriteSamples( _
        sampleFooter, _
        lngFileOut, _
        "FOOTER")

    Call BreaksSummaryWriteSamples( _
        sampleTarget, _
        lngFileOut, _
        "TARGET_SEPARATOR")

    Call BreaksSummaryWriteSamples( _
        sampleTextShift, _
        lngFileOut, _
        "TEXT_POSITION")

    Call BreaksSummaryWriteSamples( _
        sampleVector, _
        lngFileOut, _
        "VECTOR")

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "============================================================")
    Call EmitLine(lngFileOut, "NEXT_STEP")
    Call EmitLine(lngFileOut, "============================================================")

    If dictFixNow.Count > 0 Then
        Call EmitLine(lngFileOut, _
            "NEXT|Apply FIX_NOW_STRONG families first, rerun the audit, then reassess VERIFY families.")
    ElseIf dictVerify.Count > 0 Then
        Call EmitLine(lngFileOut, _
            "NEXT|Use the representative samples above for the next targeted code change.")
    ElseIf lngRawCritical > 0 Or lngRawStructural > 0 Then
        Call EmitLine(lngFileOut, _
            "NEXT|ACTION_REQUIRED. Use BREAKS_SUPER_SHORT for the ungrouped parser-sensitive details.")
    Else
        Call EmitLine(lngFileOut, _
            "NEXT|READY_FOR_CLIENT_PARSER_TEST. No actionable parser-sensitive family remains.")
    End If

    If lngTradeMismatchPages > 0 Then
        Call EmitLine(lngFileOut, _
            "MATCHED_INPUT_TEST|Recommended for final coordinate/pagination proof because OLD and NEW trade counts differ on " & _
            CStr(lngTradeMismatchPages) & " page(s).")
    End If

    Call EmitLine(lngFileOut, _
        "SEND_ME|Send BREAKS_SUPER_SHORT first. This ACTIONABLE_SUMMARY is only needed when the short report contains an unresolved issue family.")

ExitSub:
    If lngFileIn > 0 Then Close #lngFileIn
    If lngFileOut > 0 Then Close #lngFileOut

    Set dictActionTypes = Nothing
    Set dictFixNow = Nothing
    Set dictFontPairs = Nothing
    Set dictIgnore = Nothing
    Set dictPages = Nothing
    Set dictShiftPatterns = Nothing
    Set dictTextShiftFields = Nothing
    Set dictVerify = Nothing
    Set dictWhgShifts = Nothing
    Set dictWhitespace = Nothing
    Set dictWhitespaceFields = Nothing

    Set sampleFooter = Nothing
    Set sampleOperator = Nothing
    Set sampleTarget = Nothing
    Set sampleTextShift = Nothing
    Set sampleVector = Nothing
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "detailedBreaksPath;outputPath", _
        detailedBreaksPath, _
        outputPath

    errorManager.save
    Resume ExitSub
End Sub

Private Sub BreaksSummaryRegisterShiftPattern( _
    ByVal lineText As String, _
    ByVal dictionary As Object)

    Dim dblDeltaX As Double
    Dim dblDeltaY As Double
    Dim strDelta As String
    Dim strKey As String

    strDelta = BreaksSummaryField(lineText, "DELTA_NEW_MINUS_OLD")
    If Len(strDelta) = 0 Then Exit Sub

    dblDeltaX = Val(BreaksSummarySubField(strDelta, "x"))
    dblDeltaY = Val(BreaksSummarySubField(strDelta, "y"))

    strKey = _
        "shiftX=" & BreaksSummaryRoundedDelta(dblDeltaX) & _
        "|shiftY=" & BreaksSummaryRoundedDelta(dblDeltaY)

    Call PfcCore_IncrementDictionaryValue(dictionary, strKey)
End Sub

Private Function BreaksSummaryRoundedDelta(ByVal value As Double) As String
    BreaksSummaryRoundedDelta = _
        Replace(Format$(Round(value, 2), "0.00"), ",", ".")
End Function

Private Function BreaksSummaryDictionaryValue( _
    ByVal dictionary As Object, _
    ByVal keyName As String) As Long

    If dictionary Is Nothing Then Exit Function

    If dictionary.Exists(keyName) Then
        BreaksSummaryDictionaryValue = CLng(dictionary(keyName))
    End If
End Function

Private Sub BreaksSummaryAddSample( _
    ByRef samples As Collection, _
    ByVal lineText As String, _
    ByVal maxSamples As Long)

    If samples Is Nothing Then Exit Sub
    If samples.Count >= maxSamples Then Exit Sub

    samples.Add BreaksSummaryCompactSample(lineText)
End Sub

Private Function BreaksSummaryCompactSample(ByVal lineText As String) As String
    Const MAX_SAMPLE_LENGTH As Long = 360

    lineText = Replace(lineText, vbCr, " ")
    lineText = Replace(lineText, vbLf, " ")

    If Len(lineText) > MAX_SAMPLE_LENGTH Then
        lineText = Left$(lineText, MAX_SAMPLE_LENGTH) & "..."
    End If

    BreaksSummaryCompactSample = lineText
End Function

Private Sub BreaksSummaryWriteSamples( _
    ByVal samples As Collection, _
    ByVal fileNumber As Long, _
    ByVal sampleType As String)

    Dim lngIndex As Long

    If samples Is Nothing Then
        Call EmitLine(fileNumber, "SAMPLE|" & sampleType & "|(none)")
        Exit Sub
    End If

    If samples.Count = 0 Then
        Call EmitLine(fileNumber, "SAMPLE|" & sampleType & "|(none)")
        Exit Sub
    End If

    For lngIndex = 1 To samples.Count
        Call EmitLine(fileNumber, _
            "SAMPLE|" & sampleType & "|" & CStr(lngIndex) & _
            "|" & CStr(samples.Item(lngIndex)))
    Next lngIndex
End Sub

Private Sub BreaksSummaryRegisterTarget( _
    ByVal lineText As String, _
    ByVal pageNo As Long, _
    ByVal pageDictionary As Object, _
    ByRef styleOnlyCount As Long, _
    ByRef geometryCount As Long)

    Dim lngExtra As Long
    Dim lngGeometry As Long
    Dim lngNewCrossings As Long
    Dim lngOldCrossings As Long
    Dim lngStyle As Long
    Dim strClassification As String
    Dim strTargetX As String

    strTargetX = BreaksSummaryField(lineText, "x")

    If BreaksSummaryField(lineText, "result") = "PASS" Then
        strClassification = "PASS"
    Else
        lngGeometry = CLng(Val(BreaksSummaryField(lineText, "geometryBreaks")))
        lngExtra = CLng(Val(BreaksSummaryField(lineText, "extraNew")))
        lngStyle = CLng(Val(BreaksSummaryField(lineText, "styleBreaks")))
        lngOldCrossings = CLng(Val(BreaksSummaryField(lineText, "oldCrossings")))
        lngNewCrossings = CLng(Val(BreaksSummaryField(lineText, "newCrossings")))

        If lngGeometry = 0 And lngExtra = 0 And _
           lngStyle > 0 And lngOldCrossings = lngNewCrossings Then

            strClassification = "STYLE_ONLY"
            styleOnlyCount = styleOnlyCount + lngStyle
        Else
            strClassification = "GEOMETRY/CROSSING"
            geometryCount = geometryCount + 1
        End If
    End If

    If Abs(Val(strTargetX) - 468#) <= 0.01 Then
        Call BreaksSummarySetPageValue( _
            pageDictionary, pageNo, "x468", strClassification)
    ElseIf Abs(Val(strTargetX) - 639#) <= 0.01 Then
        Call BreaksSummarySetPageValue( _
            pageDictionary, pageNo, "x639", strClassification)
    End If
End Sub

Private Sub BreaksSummaryRegisterWhitespace( _
    ByVal lineText As String, _
    ByVal dictionary As Object)

    Dim strKey As String

    strKey = _
        "leading " & BreaksSummaryField(lineText, "leadingOld") & ">" & _
        BreaksSummaryField(lineText, "leadingNew") & _
        "; trailing " & BreaksSummaryField(lineText, "trailingOld") & ">" & _
        BreaksSummaryField(lineText, "trailingNew") & _
        "; length " & BreaksSummaryField(lineText, "lengthOld") & ">" & _
        BreaksSummaryField(lineText, "lengthNew")

    Call PfcCore_IncrementDictionaryValue(dictionary, strKey)
End Sub

Private Sub BreaksSummaryRegisterFontPair( _
    ByVal lineText As String, _
    ByVal dictionary As Object)

    Dim strKey As String

    strKey = _
        BreaksSummaryField(lineText, "OLD") & " > " & _
        BreaksSummaryField(lineText, "NEW")

    If Len(Replace(strKey, " > ", vbNullString)) > 0 Then
        Call PfcCore_IncrementDictionaryValue(dictionary, strKey)
    End If
End Sub

Private Sub BreaksSummaryRegisterActionType( _
    ByVal lineText As String, _
    ByVal dictionary As Object)

    Dim arrParts() As String
    Dim lngCount As Long
    Dim strAction As String
    Dim strType As String

    arrParts = Split(lineText, "|")
    If UBound(arrParts) < 2 Then Exit Sub

    lngCount = CLng(Val(Replace(arrParts(1), "count=", vbNullString)))
    strAction = arrParts(2)
    strType = strAction

    If InStr(1, strType, "=", vbBinaryCompare) > 0 Then
        strType = Left$(strType, InStr(1, strType, "=", vbBinaryCompare) - 1)
    End If

    If lngCount <= 0 Then lngCount = 1
    Call BreaksSummaryIncrementBy(dictionary, strType, lngCount)
End Sub

Private Function BreaksSummaryLikelyPairingNoise( _
    ByVal lineText As String) As Boolean

    Dim dblDeltaX As Double
    Dim dblDeltaY As Double
    Dim strDelta As String
    Dim strX As String
    Dim strY As String

    strDelta = BreaksSummaryField(lineText, "DELTA_NEW_MINUS_OLD")
    If Len(strDelta) = 0 Then Exit Function

    strX = BreaksSummarySubField(strDelta, "x")
    strY = BreaksSummarySubField(strDelta, "y")

    dblDeltaX = Val(strX)
    dblDeltaY = Val(strY)

    BreaksSummaryLikelyPairingNoise = _
        Abs(dblDeltaY) > 5# Or Abs(dblDeltaX) > 50#
End Function

Private Function BreaksSummarySubField( _
    ByVal value As String, _
    ByVal keyName As String) As String

    Dim arrParts() As String
    Dim lngIndex As Long
    Dim strPrefix As String

    strPrefix = keyName & "="
    arrParts = Split(value, ",")

    For lngIndex = LBound(arrParts) To UBound(arrParts)
        If Left$(arrParts(lngIndex), Len(strPrefix)) = strPrefix Then
            BreaksSummarySubField = Mid$(arrParts(lngIndex), Len(strPrefix) + 1)
            Exit Function
        End If
    Next lngIndex
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    textValue As String, x As Double
' Returns:       String
' Description:   Infers the Oracle report field role from text content and X position.
'-------------------------------------------------------------------------------
Private Function BreaksInferFieldRole( _
    ByVal textValue As String, _
    ByVal x As Double) As String

    Const METHOD_NAME As String = "BreaksInferFieldRole"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strWhgRole As String

    On Error GoTo ErrorHandler

    BreaksInferFieldRole = "GENERAL"

    If BreaksLooksLikeCurrency(textValue) Then
        strWhgRole = BreaksInferWhgRoleByX(x)
        If Len(strWhgRole) > 0 Then
            BreaksInferFieldRole = strWhgRole
            GoTo ExitFunction
        End If
    End If

    If BreaksLooksLikeNumericText(textValue) Then
        If x >= 126# - BREAKS_FIELD_X_TOLERANCE And _
           x < 283.52 + BREAKS_FIELD_X_TOLERANCE Then
            BreaksInferFieldRole = "MAKLERGEBUEHREN"
        ElseIf x >= 328.52 - BREAKS_FIELD_X_TOLERANCE And _
               x < 468# + BREAKS_FIELD_X_TOLERANCE Then
            BreaksInferFieldRole = "STEUERN"
        ElseIf x >= 504# - BREAKS_FIELD_X_TOLERANCE And _
               x < 639# + BREAKS_FIELD_X_TOLERANCE Then
            BreaksInferFieldRole = "ABWICKLUNGSPROVISION"
        ElseIf x >= 675# - BREAKS_FIELD_X_TOLERANCE And _
               x < 855# + BREAKS_FIELD_X_TOLERANCE Then
            BreaksInferFieldRole = "SPESEN"
        ElseIf x >= 891# - BREAKS_FIELD_X_TOLERANCE And _
               x < 1026# + BREAKS_FIELD_X_TOLERANCE Then
            BreaksInferFieldRole = "NOMINALE_STUECKE"
        ElseIf x >= 1053# - BREAKS_FIELD_X_TOLERANCE And _
               x < 1179# + BREAKS_FIELD_X_TOLERANCE Then
            BreaksInferFieldRole = "KURS_OR_ABRECH_AMOUNT"
        ElseIf x >= 1206# - BREAKS_FIELD_X_TOLERANCE Then
            BreaksInferFieldRole = "DEVISENKURS"
        End If
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksInferFieldRole = "GENERAL"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "textValue;x", _
        textValue, _
        x

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    x As Double
' Returns:       String
' Description:   Returns the specific Whg field role for an Oracle text X position.
