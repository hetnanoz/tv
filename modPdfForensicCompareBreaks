Private Function BreaksBuildHorizontalGeometryMultiplicity( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long) As Object

    Const METHOD_NAME As String = "BreaksBuildHorizontalGeometryMultiplicity"
    Dim errorManager As New ErrorManager
    Dim dict As Object
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strKey As String

    On Error GoTo ErrorHandler

    Set dict = CreateObject("Scripting.Dictionary")

    For lngIndex = 0 To pdfDoc.LineCount - 1
        If pdfDoc.Lines(lngIndex).PageNo = pageNo Then
            If BreaksLineOrientation(pdfDoc.Lines(lngIndex)) = "H" Then
                strKey = PfcCore_CanonicalLineGeometryKey(pdfDoc.Lines(lngIndex))
                Call PfcCore_IncrementDictionaryValue(dict, strKey)
            End If
        End If
    Next lngIndex

    Set BreaksBuildHorizontalGeometryMultiplicity = dict
    GoTo ExitFunction

ExitFunction:
    Set dict = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Set BreaksBuildHorizontalGeometryMultiplicity = CreateObject("Scripting.Dictionary")

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo", _
        pageNo

    errorManager.save
    Resume ExitFunction
End Function

