    Dim blnTop As Boolean

    BreaksOpticalGetFieldBounds = False
    fieldName = vbNullString
    leftX = 0#
    rightX = 0#

    blnTop = (rowKind = "TOP" Or rowKind = "HEADER_TOP")

    If blnTop Then
        Select Case fieldIndex
            Case 1
                fieldName = "TOP_DEPOTNR": leftX = 40.52: rightX = 126#
            Case 2
                fieldName = "TOP_FONDSBEZEICHNUNG": leftX = 126#: rightX = 328.52
            Case 3
                fieldName = "TOP_GESCHAEFTSART": leftX = 328.52: rightX = 414#
            Case 4
                fieldName = "TOP_SCHLUSSTAG": leftX = 414#: rightX = 504#
            Case 5
                fieldName = "TOP_VALUTATAG": leftX = 504#: rightX = 553.52
            Case 6
                fieldName = "TOP_WKN": leftX = 553.52: rightX = 594#
            Case 7
                fieldName = "TOP_ISIN": leftX = 594#: rightX = 675#
            Case 8
                fieldName = "TOP_WERTPAPIERBEZEICHNUNG": leftX = 675#: rightX = 891#
            Case 9
                fieldName = "TOP_NOMINALE_STUECKE": leftX = 891#: rightX = 1026#
            Case 10
                fieldName = "TOP_WHG_NOMINALE": leftX = 1026#: rightX = 1053#
            Case 11
                fieldName = "TOP_KURS": leftX = 1053#: rightX = 1179#
            Case 12
                fieldName = "TOP_STUECKZINSEN": leftX = 1179#: rightX = 1323.04
            Case Else
                Exit Function
        End Select
    Else
        Select Case fieldIndex
            Case 1
                fieldName = "BOTTOM_TRANSAKTIONSNR": leftX = 40.52: rightX = 126#
            Case 2
                fieldName = "BOTTOM_MAKLERGEBUEHREN": leftX = 126#: rightX = 283.52
            Case 3
                fieldName = "BOTTOM_WHG_MAKLER": leftX = 283.52: rightX = 328.52
            Case 4
                fieldName = "BOTTOM_STEUERN": leftX = 328.52: rightX = 468#
            Case 5
                fieldName = "BOTTOM_WHG_STEUERN": leftX = 468#: rightX = 504#
            Case 6
                fieldName = "BOTTOM_ABWICKLUNGSPROVISION": leftX = 504#: rightX = 639#
            Case 7
                fieldName = "BOTTOM_WHG_ABWICKLUNG": leftX = 639#: rightX = 675#
            Case 8
                fieldName = "BOTTOM_SPESEN": leftX = 675#: rightX = 855#
            Case 9
                fieldName = "BOTTOM_WHG_SPESEN": leftX = 855#: rightX = 891#
            Case 10
                fieldName = "BOTTOM_AUSM_BETRAG_WHG": leftX = 891#: rightX = 1053#
            Case 11
                fieldName = "BOTTOM_AUSM_BETRAG_ABRECH_WHG": leftX = 1053#: rightX = 1179#
