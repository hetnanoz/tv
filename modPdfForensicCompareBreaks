' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    oldDoc As tPdfDocument, newDoc As tPdfDocument, fileNumber As Long
' Returns:       ---
' Description:   Writes compact OLD/NEW details for numeric and Whg fields even when the normal break summary omits them.
'-------------------------------------------------------------------------------
 '-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    oldDoc As tPdfDocument, newDoc As tPdfDocument, fileNumber As Long
' Returns:       ---
' Description:   Writes page-1 F0/F1/F2 font resource internals for direct OLD/NEW comparison.
'-------------------------------------------------------------------------------
Private Sub BreaksWriteFontResourceForensics( _
    ByRef oldDoc As tPdfDocument, _
    ByRef newDoc As tPdfDocument, _
    ByVal fileNumber As Long)

    Const METHOD_NAME As String = "BreaksWriteFontResourceForensics"
    Dim arrAliases As Variant
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strAlias As String
    Dim strNew As String
    Dim strNewSemantic As String
    Dim strOld As String
    Dim strOldSemantic As String

    On Error GoTo ErrorHandler

    If oldDoc.PageCount < 1 Or newDoc.PageCount < 1 Then
        GoTo ExitSub
    End If

    arrAliases = Array("/F0", "/F1", "/F2")

    For lngIndex = LBound(arrAliases) To UBound(arrAliases)
        strAlias = CStr(arrAliases(lngIndex))
        strOld = BreaksFontForensicEntry( _
            oldDoc.Pages(1).FontForensicSignature, _
            strAlias)
        strNew = BreaksFontForensicEntry( _
            newDoc.Pages(1).FontForensicSignature, _
            strAlias)

        strOldSemantic = BreaksNormalizeFontForensicEntry(strOld)
        strNewSemantic = BreaksNormalizeFontForensicEntry(strNew)

        Call EmitLine(fileNumber, _
            "FONT_FORENSIC|alias=" & strAlias & _
            "|OLD=" & strOld & _
            "|NEW=" & strNew & _
            "|semanticExact=" & PfcCore_BoolText(strOldSemantic = strNewSemantic) & _
            "|serializedExact=" & PfcCore_BoolText(strOld = strNew))
    Next lngIndex

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitSub
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    signature As String, aliasName As String
' Returns:       String
' Description:   Extracts one alias entry from a semicolon-delimited forensic signature.
'-------------------------------------------------------------------------------
Private Function BreaksFontForensicEntry( _
    ByVal signature As String, _
    ByVal aliasName As String) As String

    Const METHOD_NAME As String = "BreaksFontForensicEntry"
    Dim arrEntries() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strEntry As String

    On Error GoTo ErrorHandler

    BreaksFontForensicEntry = "(missing)"

    If Len(signature) = 0 Then
        GoTo ExitFunction
    End If

    arrEntries = Split(signature, ";")

    For lngIndex = LBound(arrEntries) To UBound(arrEntries)
        strEntry = Trim$(arrEntries(lngIndex))

        If Left$(strEntry, Len(aliasName) + 1) = aliasName & "=" Or _
           Left$(strEntry, Len(aliasName) + 1) = aliasName & "|" Then

            If Left$(strEntry, Len(aliasName) + 1) = aliasName & "=" Then
                strEntry = aliasName & "|" & Mid$(strEntry, Len(aliasName) + 2)
            End If

            BreaksFontForensicEntry = strEntry
            Exit For
        End If
    Next lngIndex

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksFontForensicEntry = "(error)"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "aliasName", _
        aliasName

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-08
' Parameters:    forensicEntry As String
' Returns:       String
' Description:   Removes arbitrary PDF object numbers before semantic font comparison.
'-------------------------------------------------------------------------------
Private Function BreaksNormalizeFontForensicEntry( _
    ByVal forensicEntry As String) As String

    Const METHOD_NAME As String = "BreaksNormalizeFontForensicEntry"
    Dim arrParts() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strPart As String
    Dim strResult As String

    On Error GoTo ErrorHandler

    If Len(forensicEntry) = 0 Then
        GoTo ExitFunction
    End If

    arrParts = Split(forensicEntry, "|")

    For lngIndex = LBound(arrParts) To UBound(arrParts)
        strPart = arrParts(lngIndex)

        If Left$(strPart, 4) <> "obj=" Then
            If Len(strResult) > 0 Then
                strResult = strResult & "|"
            End If
            strResult = strResult & strPart
        End If
    Next lngIndex

    BreaksNormalizeFontForensicEntry = strResult

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksNormalizeFontForensicEntry = forensicEntry

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

 '-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    oldDoc As tPdfDocument, newDoc As tPdfDocument, fileNumber As Long
' Returns:       ---
' Description:   Groups matched text by the physical Oracle table cell, avoiding value-based role guesses.
'-------------------------------------------------------------------------------

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
