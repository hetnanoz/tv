    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    textValue As String
' Returns:       Boolean
' Description:   Identifies three-letter currency-like report values.
'-------------------------------------------------------------------------------
Private Function BreaksLooksLikeCurrency(ByVal textValue As String) As Boolean

    Const METHOD_NAME As String = "BreaksLooksLikeCurrency"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strText As String
    Dim strChar As String

    On Error GoTo ErrorHandler

    BreaksLooksLikeCurrency = False
    strText = UCase$(Trim$(textValue))

    If Len(strText) <> 3 Then
        GoTo ExitFunction
    End If

    For lngIndex = 1 To 3
        strChar = Mid$(strText, lngIndex, 1)
        If strChar < "A" Or strChar > "Z" Then
            GoTo ExitFunction
        End If
    Next lngIndex

    BreaksLooksLikeCurrency = True

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksLooksLikeCurrency = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "textValue", _
        textValue

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    textValue As String
' Returns:       Boolean
' Description:   Identifies numeric-looking report text without changing its formatting.
'-------------------------------------------------------------------------------
Private Function BreaksLooksLikeNumericText(ByVal textValue As String) As Boolean

    Const METHOD_NAME As String = "BreaksLooksLikeNumericText"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim strChar As String
    Dim strText As String

    On Error GoTo ErrorHandler

    BreaksLooksLikeNumericText = False
    strText = Trim$(textValue)
    strText = Replace(strText, " ", vbNullString)

    If Len(strText) = 0 Then
        GoTo ExitFunction
    End If

    For lngIndex = 1 To Len(strText)
        strChar = Mid$(strText, lngIndex, 1)

        If (strChar < "0" Or strChar > "9") And _
           strChar <> "." And _
           strChar <> "," And _
           strChar <> "-" And _
           strChar <> "+" Then
            GoTo ExitFunction
        End If
    Next lngIndex

    BreaksLooksLikeNumericText = True

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksLooksLikeNumericText = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "textValue", _
        textValue

    errorManager.save
    Resume ExitFunction
End Function


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    oldDoc, newDoc, pageNo, fileNumber, actionDictionary, counters
' Returns:       ---
' Description:   Compares optical row topology. A vertical rule is actionable when
'                it enters the interior of a logical TOP/BOTTOM cell in NEW but
'                no equivalent rule enters the same cell in OLD.
'-------------------------------------------------------------------------------
Private Sub BreaksWriteOpticalCellTopology( _
    ByRef oldDoc As tPdfDocument, _
    ByRef newDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal fileNumber As Long, _
    ByVal actionDictionary As Object, _
    ByRef criticalCount As Long, _
    ByRef structuralCount As Long, _
    ByRef infoCount As Long)

    Const METHOD_NAME As String = "BreaksWriteOpticalCellTopology"
    Dim dblBottomY As Double
    Dim dblLeftX As Double
    Dim dblRightX As Double
    Dim dblTopY As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngAffectedCells As Long
    Dim lngField As Long
    Dim lngFieldCount As Long
    Dim lngNewCount As Long
    Dim lngNewOnly As Long
    Dim lngNewOnlyTotal As Long
    Dim lngOldCount As Long
    Dim lngRow As Long
    Dim lngSlot As Long
    Dim lngStyleMismatch As Long
    Dim lngStyleMismatchTotal As Long
    Dim strField As String
    Dim strLineSample As String
    Dim strRowKind As String
    Dim strTextSample As String

    On Error GoTo ErrorHandler

    For lngRow = 1 To 2
        If lngRow = 1 Then
            strRowKind = "HEADER_TOP"
        Else
            strRowKind = "HEADER_BOTTOM"
        End If

        Call BreaksOpticalHeaderRowBounds( _
            pageNo, _
            strRowKind, _
            dblBottomY, _
            dblTopY)

        If Right$(strRowKind, 3) = "TOP" Then
            lngFieldCount = 12
        Else
            lngFieldCount = 13
        End If

        For lngField = 1 To lngFieldCount
            If BreaksOpticalGetFieldBounds( _
                strRowKind, _
                lngField, _
                strField, _
                dblLeftX, _
                dblRightX) Then

                strLineSample = vbNullString
                Call BreaksOpticalCompareCell( _
                    oldDoc, _
                    newDoc, _
                    pageNo, _
                    dblLeftX, _
                    dblRightX, _
                    dblBottomY, _
                    dblTopY, _
                    lngOldCount, _
                    lngNewCount, _
                    lngNewOnly, _
                    lngStyleMismatch, _
                    strLineSample)

                If lngNewOnly > 0 Then
                    lngAffectedCells = lngAffectedCells + 1
                    lngNewOnlyTotal = lngNewOnlyTotal + lngNewOnly
                    criticalCount = criticalCount + lngNewOnly
                    strTextSample = BreaksOpticalCellTextSample( _
                        newDoc, _
                        pageNo, _
                        dblLeftX, _
                        dblRightX, _
                        dblBottomY, _
                        dblTopY)

                    Call EmitLine(fileNumber, _
                        "OPTICAL_CELL_TOPOLOGY|page=" & CStr(pageNo) & _
                        "|slot=HEADER|row=" & strRowKind & _
                        "|field=" & strField & _
                        "|oldIntrusions=" & CStr(lngOldCount) & _
                        "|newIntrusions=" & CStr(lngNewCount) & _
                        "|newOnly=" & CStr(lngNewOnly) & _
                        "|cellX=" & NumTxt(dblLeftX) & ".." & NumTxt(dblRightX) & _
                        "|cellY=" & NumTxt(dblBottomY) & ".." & NumTxt(dblTopY) & _
                        "|textSample=" & strTextSample & _
                        "|lineSample=" & strLineSample & _
                        "|FIX=Do not move text yet; first make NEW separator span/row ownership match OLD.")

                    Call PfcCore_IncrementDictionaryValue( _
                        actionDictionary, _
                        "OPTICAL_SEPARATOR_TOPOLOGY|field=" & strField)
                End If

                If lngStyleMismatch > 0 Then
                    lngStyleMismatchTotal = lngStyleMismatchTotal + lngStyleMismatch
                    infoCount = infoCount + lngStyleMismatch
                End If
            End If
        Next lngField
    Next lngRow

    For lngSlot = 1 To BreaksOracleMaxTradesForPage(pageNo)
        For lngRow = 1 To 2
            If lngRow = 1 Then
                strRowKind = "TOP"
            Else
                strRowKind = "BOTTOM"
            End If

            Call BreaksOpticalTransactionRowBounds( _
                pageNo, _
                lngSlot, _
                strRowKind, _
                dblBottomY, _
                dblTopY)

            If strRowKind = "TOP" Then
                lngFieldCount = 12
            Else
                lngFieldCount = 13
            End If

            For lngField = 1 To lngFieldCount
                If BreaksOpticalGetFieldBounds( _
                    strRowKind, _
                    lngField, _
                    strField, _
                    dblLeftX, _
                    dblRightX) Then

                    strLineSample = vbNullString
                    Call BreaksOpticalCompareCell( _
                        oldDoc, _
                        newDoc, _
                        pageNo, _
                        dblLeftX, _
                        dblRightX, _
                        dblBottomY, _
                        dblTopY, _
                        lngOldCount, _
                        lngNewCount, _
                        lngNewOnly, _
                        lngStyleMismatch, _
                        strLineSample)

                    If lngNewOnly > 0 Then
                        lngAffectedCells = lngAffectedCells + 1
                        lngNewOnlyTotal = lngNewOnlyTotal + lngNewOnly
                        criticalCount = criticalCount + lngNewOnly
                        strTextSample = BreaksOpticalCellTextSample( _
                            newDoc, _
                            pageNo, _
                            dblLeftX, _
                            dblRightX, _
                            dblBottomY, _
                            dblTopY)

                        Call EmitLine(fileNumber, _
                            "OPTICAL_CELL_TOPOLOGY|page=" & CStr(pageNo) & _
                            "|slot=" & CStr(lngSlot) & _
                            "|row=" & strRowKind & _
                            "|field=" & strField & _
                            "|oldIntrusions=" & CStr(lngOldCount) & _
                            "|newIntrusions=" & CStr(lngNewCount) & _
                            "|newOnly=" & CStr(lngNewOnly) & _
                            "|cellX=" & NumTxt(dblLeftX) & ".." & NumTxt(dblRightX) & _
                            "|cellY=" & NumTxt(dblBottomY) & ".." & NumTxt(dblTopY) & _
                            "|textSample=" & strTextSample & _
                            "|lineSample=" & strLineSample & _
                            "|FIX=Do not move text yet; first make NEW separator span/row ownership match OLD.")

                        Call PfcCore_IncrementDictionaryValue( _
                            actionDictionary, _
                            "OPTICAL_SEPARATOR_TOPOLOGY|field=" & strField)
                    End If

                    If lngStyleMismatch > 0 Then
                        lngStyleMismatchTotal = lngStyleMismatchTotal + lngStyleMismatch
                        infoCount = infoCount + lngStyleMismatch
                    End If
                End If
            Next lngField
        Next lngRow
    Next lngSlot

    Call EmitLine(fileNumber, _
        "OPTICAL_TOPOLOGY_SUMMARY|page=" & CStr(pageNo) & _
        "|newOnlyIntrusions=" & CStr(lngNewOnlyTotal) & _
        "|affectedCells=" & CStr(lngAffectedCells) & _
        "|matchedGeometryStyleDiffs=" & CStr(lngStyleMismatchTotal) & _
        "|status=" & IIf(lngNewOnlyTotal = 0, "PASS", "FAIL"))

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo", _
        pageNo

    errorManager.save
    Resume ExitSub
End Sub

Private Sub BreaksOpticalCompareCell( _
    ByRef oldDoc As tPdfDocument, _
    ByRef newDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal leftX As Double, _
    ByVal rightX As Double, _
    ByVal bottomY As Double, _
    ByVal topY As Double, _
    ByRef oldCount As Long, _
    ByRef newCount As Long, _
    ByRef newOnlyCount As Long, _
    ByRef styleMismatchCount As Long, _
    ByRef sampleText As String)

    Const METHOD_NAME As String = "BreaksOpticalCompareCell"
    Dim blnOldUsed() As Boolean
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngMatch As Long
    Dim lngNewIndex As Long
    Dim lngOldIndex As Long

    On Error GoTo ErrorHandler

    oldCount = 0
    newCount = 0
    newOnlyCount = 0
    styleMismatchCount = 0
    sampleText = vbNullString

    If oldDoc.LineCount > 0 Then
        ReDim blnOldUsed(0 To oldDoc.LineCount - 1)
    Else
        ReDim blnOldUsed(0 To 0)
    End If

    For lngOldIndex = 0 To oldDoc.LineCount - 1
        If BreaksOpticalLineIsCellIntrusion( _
            oldDoc.Lines(lngOldIndex), _
            pageNo, _
            leftX, _
            rightX, _
            bottomY, _
            topY) Then

            oldCount = oldCount + 1
        End If
    Next lngOldIndex

    For lngNewIndex = 0 To newDoc.LineCount - 1
        If BreaksOpticalLineIsCellIntrusion( _
            newDoc.Lines(lngNewIndex), _
            pageNo, _
            leftX, _
            rightX, _
            bottomY, _
            topY) Then

            newCount = newCount + 1
            lngMatch = BreaksOpticalFindMatchingOldLine( _
                oldDoc, _
                blnOldUsed, _
                pageNo, _
                leftX, _
                rightX, _
                bottomY, _
                topY, _
                newDoc.Lines(lngNewIndex))

            If lngMatch >= 0 Then
                blnOldUsed(lngMatch) = True

                If Not BreaksOpticalLineVisualStyleMatches( _
                    oldDoc.Lines(lngMatch), _
                    newDoc.Lines(lngNewIndex)) Then

                    styleMismatchCount = styleMismatchCount + 1
                End If
            Else
                newOnlyCount = newOnlyCount + 1

                If Len(sampleText) = 0 Then
                    sampleText = BreaksOpticalLineSample( _
                        newDoc.Lines(lngNewIndex), _
                        bottomY, _
                        topY)
                End If
            End If
        End If
    Next lngNewIndex

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo;leftX;rightX;bottomY;topY", _
        pageNo, _
        leftX, _
        rightX, _
        bottomY, _
        topY

    errorManager.save
    Resume ExitSub
End Sub

Private Function BreaksOpticalFindMatchingOldLine( _
    ByRef oldDoc As tPdfDocument, _
    ByRef oldUsed() As Boolean, _
    ByVal pageNo As Long, _
    ByVal leftX As Double, _
    ByVal rightX As Double, _
    ByVal bottomY As Double, _
    ByVal topY As Double, _
    ByRef newLine As tPdfLine) As Long

    Dim dblNewHigh As Double
    Dim dblNewLow As Double
    Dim dblNewX As Double
    Dim dblOldHigh As Double
    Dim dblOldLow As Double
    Dim dblOldX As Double
    Dim lngOldIndex As Long

    BreaksOpticalFindMatchingOldLine = -1

    dblNewX = (newLine.X1 + newLine.X2) / 2#
    dblNewLow = MaxDouble(MinDouble(newLine.Y1, newLine.Y2), bottomY)
    dblNewHigh = MinDouble(MaxDouble(newLine.Y1, newLine.Y2), topY)

    For lngOldIndex = 0 To oldDoc.LineCount - 1
        If Not oldUsed(lngOldIndex) Then
            If BreaksOpticalLineIsCellIntrusion( _
                oldDoc.Lines(lngOldIndex), _
                pageNo, _
                leftX, _
                rightX, _
                bottomY, _
                topY) Then

                dblOldX = (oldDoc.Lines(lngOldIndex).X1 + _
                    oldDoc.Lines(lngOldIndex).X2) / 2#
                dblOldLow = MaxDouble( _
                    MinDouble(oldDoc.Lines(lngOldIndex).Y1, oldDoc.Lines(lngOldIndex).Y2), _
                    bottomY)
                dblOldHigh = MinDouble( _
                    MaxDouble(oldDoc.Lines(lngOldIndex).Y1, oldDoc.Lines(lngOldIndex).Y2), _
                    topY)

                If Abs(dblOldX - dblNewX) <= _
                    BREAKS_OPTICAL_LINE_MATCH_X_TOLERANCE And _
                   Abs(dblOldLow - dblNewLow) <= _
                    BREAKS_OPTICAL_LINE_MATCH_Y_TOLERANCE And _
                   Abs(dblOldHigh - dblNewHigh) <= _
                    BREAKS_OPTICAL_LINE_MATCH_Y_TOLERANCE Then

                    BreaksOpticalFindMatchingOldLine = lngOldIndex
                    Exit Function
                End If
            End If
        End If
    Next lngOldIndex
End Function

Private Function BreaksOpticalLineIsCellIntrusion( _
    ByRef lineInfo As tPdfLine, _
    ByVal pageNo As Long, _
    ByVal leftX As Double, _
    ByVal rightX As Double, _
    ByVal bottomY As Double, _
    ByVal topY As Double) As Boolean

    Dim dblHigh As Double
    Dim dblLow As Double
    Dim dblOverlap As Double
    Dim dblX As Double

    BreaksOpticalLineIsCellIntrusion = False

    If lineInfo.PageNo <> pageNo Then
        Exit Function
    End If

    If Abs(lineInfo.X1 - lineInfo.X2) > COORD_TOLERANCE Then
        Exit Function
    End If

    dblX = (lineInfo.X1 + lineInfo.X2) / 2#

    If dblX <= leftX + BREAKS_OPTICAL_X_INTERIOR_MARGIN Or _
       dblX >= rightX - BREAKS_OPTICAL_X_INTERIOR_MARGIN Then
        Exit Function
    End If

    dblLow = MaxDouble(MinDouble(lineInfo.Y1, lineInfo.Y2), bottomY)
    dblHigh = MinDouble(MaxDouble(lineInfo.Y1, lineInfo.Y2), topY)
    dblOverlap = dblHigh - dblLow

    BreaksOpticalLineIsCellIntrusion = _
        dblOverlap >= BREAKS_OPTICAL_MIN_ROW_OVERLAP
End Function

Private Function BreaksOpticalLineVisualStyleMatches( _
    ByRef oldLine As tPdfLine, _
    ByRef newLine As tPdfLine) As Boolean

    BreaksOpticalLineVisualStyleMatches = _
        Abs(oldLine.LineWidth - newLine.LineWidth) <= 0.05 And _
        oldLine.StrokeColor = newLine.StrokeColor
End Function

Private Function BreaksOpticalLineSample( _
    ByRef lineInfo As tPdfLine, _
    ByVal bottomY As Double, _
    ByVal topY As Double) As String

    Dim dblHigh As Double
    Dim dblLow As Double
    Dim dblX As Double

    dblX = (lineInfo.X1 + lineInfo.X2) / 2#
    dblLow = MaxDouble(MinDouble(lineInfo.Y1, lineInfo.Y2), bottomY)
    dblHigh = MinDouble(MaxDouble(lineInfo.Y1, lineInfo.Y2), topY)

    BreaksOpticalLineSample = _
        "x=" & NumTxt(dblX) & _
        ",rawY=" & NumTxt(MinDouble(lineInfo.Y1, lineInfo.Y2)) & _
            ".." & NumTxt(MaxDouble(lineInfo.Y1, lineInfo.Y2)) & _
        ",cellOverlapY=" & NumTxt(dblLow) & ".." & NumTxt(dblHigh) & _
        ",w=" & NumTxt(lineInfo.LineWidth) & _
        ",paint=" & lineInfo.PaintOperator & _
        ",source=" & lineInfo.SourceOperator
End Function

Private Function BreaksOpticalCellTextSample( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal leftX As Double, _
    ByVal rightX As Double, _
    ByVal bottomY As Double, _
    ByVal topY As Double) As String

    Dim lngIndex As Long
    Dim strText As String

    BreaksOpticalCellTextSample = "(none)"

    For lngIndex = 0 To pdfDoc.TextCount - 1
        If pdfDoc.Texts(lngIndex).PageNo = pageNo Then
            If pdfDoc.Texts(lngIndex).X >= leftX - BREAKS_FIELD_X_TOLERANCE And _
               pdfDoc.Texts(lngIndex).X <= rightX + BREAKS_FIELD_X_TOLERANCE And _
               pdfDoc.Texts(lngIndex).Y >= bottomY - BREAKS_BASELINE_TOLERANCE And _
               pdfDoc.Texts(lngIndex).Y <= topY + BREAKS_BASELINE_TOLERANCE Then

                strText = Trim$(pdfDoc.Texts(lngIndex).TextValue)

                If Len(strText) > 0 Then
                    BreaksOpticalCellTextSample = _
                        SanitizeReportText(BreaksShortText(strText)) & _
                        "@x=" & NumTxt(pdfDoc.Texts(lngIndex).X) & _
                        ",y=" & NumTxt(pdfDoc.Texts(lngIndex).Y) & _
                        ",font=" & pdfDoc.Texts(lngIndex).FontName & _
                        "@" & NumTxt(pdfDoc.Texts(lngIndex).FontSize)
                    Exit Function
                End If
            End If
        End If
    Next lngIndex
End Function

Private Sub BreaksOpticalHeaderRowBounds( _
    ByVal pageNo As Long, _
    ByVal rowKind As String, _
    ByRef bottomY As Double, _
    ByRef topY As Double)

    If pageNo = 1 Then
        If rowKind = "HEADER_TOP" Then
            bottomY = 535.48
            topY = 553.48
        Else
            bottomY = 517.48
            topY = 535.48
        End If
    Else
        If rowKind = "HEADER_TOP" Then
            bottomY = 589.48
            topY = 607.48
        Else
            bottomY = 571.48
            topY = 589.48
        End If
    End If
End Sub

Private Sub BreaksOpticalTransactionRowBounds( _
    ByVal pageNo As Long, _
    ByVal slotNo As Long, _
    ByVal rowKind As String, _
    ByRef bottomY As Double, _
    ByRef topY As Double)

    Dim dblBottomBaseline As Double
    Dim dblTopBaseline As Double

    dblTopBaseline = BreaksOpticalTopBaseline(pageNo, slotNo)
    dblBottomBaseline = dblTopBaseline - 18#

    If rowKind = "TOP" Then
        bottomY = dblTopBaseline - BREAKS_OPTICAL_BASELINE_TO_BOTTOM
        topY = dblTopBaseline + BREAKS_OPTICAL_BASELINE_TO_TOP
    Else
        bottomY = dblBottomBaseline - BREAKS_OPTICAL_BASELINE_TO_BOTTOM
        topY = dblBottomBaseline + BREAKS_OPTICAL_BASELINE_TO_TOP
    End If
End Sub

Private Function BreaksOpticalTopBaseline( _
    ByVal pageNo As Long, _
    ByVal slotNo As Long) As Double

    Dim arrBaselines As Variant

    If pageNo = 1 Then
        arrBaselines = Array( _
            504#, 463.48, 423#, 382.48, 342#, 301.48, _
            261#, 220.48, 180#, 139.48, 99#)
    Else
        arrBaselines = Array( _
            558#, 517.48, 477#, 436.48, 396#, 355.48, _
            315#, 274.48, 234#, 193.48, 153#, 112.48)
    End If

    If slotNo >= 1 And slotNo <= UBound(arrBaselines) + 1 Then
        BreaksOpticalTopBaseline = CDbl(arrBaselines(slotNo - 1))
    End If
End Function

