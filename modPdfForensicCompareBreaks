'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    oldDoc As tPdfDocument, newDoc As tPdfDocument, pageNo As Long, fileNumber As Long
' Returns:       ---
' Description:   Checks whether NEW contains extra exact or near full-width horizontal overdraws.
'-------------------------------------------------------------------------------
Private Sub BreaksWriteHorizontalRuleSanity( _
    ByRef oldDoc As tPdfDocument, _
    ByRef newDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal fileNumber As Long)

    Const METHOD_NAME As String = "BreaksWriteHorizontalRuleSanity"
    Dim errorManager As New ErrorManager
    Dim dictNew As Object
    Dim dictOld As Object
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngExtraNew As Long
    Dim lngMaxNew As Long
    Dim lngMaxOld As Long
    Dim lngNearNew As Long
    Dim lngNearOld As Long
    Dim lngTolerantExtraNew As Long
    Dim strSample As String
    Dim strStatus As String

    On Error GoTo ErrorHandler

    Set dictOld = BreaksBuildHorizontalGeometryMultiplicity(oldDoc, pageNo)
    Set dictNew = BreaksBuildHorizontalGeometryMultiplicity(newDoc, pageNo)

    lngMaxOld = BreaksDictionaryMaxLong(dictOld)
    lngMaxNew = BreaksDictionaryMaxLong(dictNew)
    lngExtraNew = BreaksCountDictionaryExcess(dictOld, dictNew, strSample)

    lngNearOld = BreaksCountNearFullWidthHorizontalPairs(oldDoc, pageNo)
    lngNearNew = BreaksCountNearFullWidthHorizontalPairs(newDoc, pageNo)
    lngTolerantExtraNew = BreaksCountTolerantFullWidthHorizontalExcess( _
        oldDoc, _
        newDoc, _
        pageNo, _
        strSample)

    If lngTolerantExtraNew > 0 Or lngNearNew > lngNearOld Then
        strStatus = "SUSPECT"
    Else
        strStatus = "PASS_COORD_SERIALIZATION_ONLY"
    End If

    Call EmitLine(fileNumber, _
        "RULES|page=" & CStr(pageNo) & _
        "|status=" & strStatus & _
        "|extraExactNew=" & CStr(lngExtraNew) & _
        "|tolerantExtraNew=" & CStr(lngTolerantExtraNew) & _
        "|maxMultiplicityOld=" & CStr(lngMaxOld) & _
        "|maxMultiplicityNew=" & CStr(lngMaxNew) & _
        "|nearFullWidthPairsOld=" & CStr(lngNearOld) & _
        "|nearFullWidthPairsNew=" & CStr(lngNearNew) & _
        "|sample=" & strSample)

ExitSub:
    Set dictNew = Nothing
    Set dictOld = Nothing
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo", _
        pageNo

    errorManager.save
    Resume ExitSub
End Sub

