'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    textValue As String
' Returns:       String
' Description:   Buckets a numeric display by integer-digit count while ignoring
'                grouping spaces and the decimal part.
'-------------------------------------------------------------------------------
Private Function BreaksIntegerDigitBucket(ByVal textValue As String) As String

    Const METHOD_NAME As String = "BreaksIntegerDigitBucket"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngComma As Long
    Dim lngDigits As Long
    Dim lngDot As Long
    Dim lngIndex As Long
    Dim lngStop As Long
    Dim strChar As String
    Dim strCore As String

    On Error GoTo ErrorHandler

    strCore = Trim$(textValue)
    lngDot = InStrRev(strCore, ".")
    lngComma = InStrRev(strCore, ",")

    If lngDot > lngComma Then
        lngStop = lngDot - 1
    ElseIf lngComma > 0 Then
        lngStop = lngComma - 1
    Else
        lngStop = Len(strCore)
    End If

    For lngIndex = 1 To lngStop
        strChar = Mid$(strCore, lngIndex, 1)
        If strChar >= "0" And strChar <= "9" Then
            lngDigits = lngDigits + 1
        End If
    Next lngIndex

    Select Case lngDigits
        Case 0
            BreaksIntegerDigitBucket = "NA"
        Case 1 To 3
            BreaksIntegerDigitBucket = "1-3"
        Case 4 To 6
            BreaksIntegerDigitBucket = "4-6"
        Case 7 To 9
            BreaksIntegerDigitBucket = "7-9"
        Case Else
            BreaksIntegerDigitBucket = "10+"
    End Select

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksIntegerDigitBucket = "ERR"

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription, "textValue", textValue
    errorManager.save
    Resume ExitFunction
End Function

