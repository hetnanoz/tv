'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    pageNo As Long, y As Double
' Returns:       String
' Description:   Classifies a text baseline as TOP or BOTTOM transaction row.
'-------------------------------------------------------------------------------
Private Function BreaksOracleRowKind( _
    ByVal pageNo As Long, _
    ByVal y As Double) As String

    Const METHOD_NAME As String = "BreaksOracleRowKind"
    Const BASELINE_TOLERANCE As Double = 1.1
    Const DATA_ROW_HEIGHT As Double = 18#
    Dim arrTopBaselines As Variant
    Dim dblBottom As Double
    Dim dblDistanceBottom As Double
    Dim dblDistanceTop As Double
    Dim dblTop As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long

    On Error GoTo ErrorHandler

    BreaksOracleRowKind = vbNullString

    If pageNo = 1 Then
        arrTopBaselines = Array(504#, 463.48, 423#, 382.48, 342#, 301.48, 261#, 220.48, 180#, 139.48, 99#)
    Else
        arrTopBaselines = Array(558#, 517.48, 477#, 436.48, 396#, 355.48, 315#, 274.48, 234#, 193.48, 153#, 112.48)
    End If

    For lngIndex = LBound(arrTopBaselines) To UBound(arrTopBaselines)
        dblTop = CDbl(arrTopBaselines(lngIndex))
        dblBottom = dblTop - DATA_ROW_HEIGHT

        dblDistanceTop = BreaksBaselineDistance(y, dblTop)
        dblDistanceBottom = BreaksBaselineDistance(y, dblBottom)

        If dblDistanceTop <= BASELINE_TOLERANCE Or _
           dblDistanceBottom <= BASELINE_TOLERANCE Then

            If dblDistanceTop <= dblDistanceBottom Then
                BreaksOracleRowKind = "TOP"
            Else
                BreaksOracleRowKind = "BOTTOM"
            End If

            Exit For
        End If
    Next lngIndex

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksOracleRowKind = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo;y", _
        pageNo, _
        y

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    actualY As Double, baseY As Double
' Returns:       Double
' Description:   Measures against both the 9 pt baseline and the Oracle 8 pt +0.76 baseline.
'-------------------------------------------------------------------------------
Private Function BreaksBaselineDistance( _
    ByVal actualY As Double, _
    ByVal baseY As Double) As Double

    Const METHOD_NAME As String = "BreaksBaselineDistance"
    Const EIGHT_PT_OFFSET As Double = 0.76
    Dim dblA As Double
    Dim dblB As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    dblA = Abs(actualY - baseY)
    dblB = Abs(actualY - (baseY + EIGHT_PT_OFFSET))

    If dblA <= dblB Then
        BreaksBaselineDistance = dblA
    Else
        BreaksBaselineDistance = dblB
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksBaselineDistance = 1E+30

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "actualY;baseY", _
        actualY, _
        baseY

    errorManager.save
    Resume ExitFunction
End Function

