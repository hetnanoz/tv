' Parameters:    oldDoc As tPdfDocument, newDoc As tPdfDocument, fileNumber As Long
' Returns:       ---
' Description:   Emits a compact field-level matrix for the remaining numeric
'                whitespace and Whg alignment differences. It deliberately
'                omits individual transaction samples so one screenshot is useful.
'-------------------------------------------------------------------------------
Private Sub BreaksWritePaddingAndWhgDecisionMatrix( _
    ByRef oldDoc As tPdfDocument, _
    ByRef newDoc As tPdfDocument, _
    ByVal fileNumber As Long)

    Const METHOD_NAME As String = "BreaksWritePaddingAndWhgDecisionMatrix"
    Dim blnNewUsed() As Boolean
    Dim dictNumeric As Object
    Dim dictWhg As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim lngInputValueRowsOmitted As Long
    Dim lngNewIndex As Long
    Dim lngPage As Long
    Dim lngPages As Long
    Dim strKey As String
    Dim strRole As String

    On Error GoTo ErrorHandler

    Set dictNumeric = CreateObject("Scripting.Dictionary")
    Set dictWhg = CreateObject("Scripting.Dictionary")

    lngPages = oldDoc.PageCount
    If newDoc.PageCount < lngPages Then
        lngPages = newDoc.PageCount
    End If

    For lngPage = 1 To lngPages
        If newDoc.TextCount > 0 Then
            ReDim blnNewUsed(0 To newDoc.TextCount - 1)
        Else
            ReDim blnNewUsed(0 To 0)
        End If

        For lngIndex = 0 To oldDoc.TextCount - 1
            If oldDoc.Texts(lngIndex).PageNo = lngPage Then
                strRole = BreaksInferStructuralFieldRole( _
                    lngPage, _
                    oldDoc.Texts(lngIndex).X, _
                    oldDoc.Texts(lngIndex).Y)

                If BreaksIsPaddingMatrixRole(strRole) Or _
                   BreaksIsWhgMatrixRole(strRole) Then

                    lngNewIndex = FindBreaksExactTextMatch( _
                        oldDoc, _
                        newDoc, _
                        lngIndex, _
                        lngPage, _
                        blnNewUsed)

                    If lngNewIndex < 0 Then
                        lngNewIndex = FindBreaksGeometryTextMatch( _
                            oldDoc, _
                            newDoc, _
                            lngIndex, _
                            lngPage, _
                            blnNewUsed)
                    End If

                    If lngNewIndex >= 0 Then
                        blnNewUsed(lngNewIndex) = True

                        If Not BreaksAreComparableFieldValues( _
                            oldDoc.Texts(lngIndex).TextValue, _
                            newDoc.Texts(lngNewIndex).TextValue) Then

                            lngInputValueRowsOmitted = _
                                lngInputValueRowsOmitted + 1
                            GoTo ContinuePaddingMatrixText
                        End If

                        If BreaksIsPaddingMatrixRole(strRole) Then
                            strKey = _
                                "role=" & strRole & _
                                "|intDigits=" & BreaksIntegerDigitBucket( _
                                    oldDoc.Texts(lngIndex).TextValue) & _
                                "|lead=" & CStr(BreaksLeadingSpaceCount( _
                                    oldDoc.Texts(lngIndex).TextValue)) & ">" & _
                                    CStr(BreaksLeadingSpaceCount( _
                                    newDoc.Texts(lngNewIndex).TextValue)) & _
                                "|font=" & oldDoc.Texts(lngIndex).FontName & "@" & _
                                    NumTxt(oldDoc.Texts(lngIndex).FontSize) & ">" & _
                                    newDoc.Texts(lngNewIndex).FontName & "@" & _
                                    NumTxt(newDoc.Texts(lngNewIndex).FontSize) & _
                                "|dX=" & NumTxt(newDoc.Texts(lngNewIndex).X - _
                                    oldDoc.Texts(lngIndex).X) & _
                                "|dY=" & NumTxt(newDoc.Texts(lngNewIndex).Y - _
                                    oldDoc.Texts(lngIndex).Y)

                            Call PfcCore_IncrementDictionaryValue(dictNumeric, strKey)
                        End If

                        If BreaksIsWhgMatrixRole(strRole) Then
                            strKey = _
                                "role=" & strRole & _
                                "|value=" & BreaksShortText(Trim$( _
                                    oldDoc.Texts(lngIndex).TextValue)) & _
                                "|font=" & oldDoc.Texts(lngIndex).FontName & "@" & _
                                    NumTxt(oldDoc.Texts(lngIndex).FontSize) & ">" & _
                                    newDoc.Texts(lngNewIndex).FontName & "@" & _
                                    NumTxt(newDoc.Texts(lngNewIndex).FontSize) & _
                                "|dX=" & NumTxt(newDoc.Texts(lngNewIndex).X - _
                                    oldDoc.Texts(lngIndex).X) & _
                                "|dY=" & NumTxt(newDoc.Texts(lngNewIndex).Y - _
                                    oldDoc.Texts(lngIndex).Y)

                            Call PfcCore_IncrementDictionaryValue(dictWhg, strKey)
                        End If
                    End If
                End If
            End If

ContinuePaddingMatrixText:
        Next lngIndex
    Next lngPage

    Call EmitLine(fileNumber, "NUMERIC_PADDING")
    Call BreaksSummaryWriteDictionary( _
        dictNumeric, _
        fileNumber, _
        35, _
        "PAD")

    Call EmitLine(fileNumber, "WHG_POSITION_FONT")
    Call BreaksSummaryWriteDictionary( _
        dictWhg, _
        fileNumber, _
        25, _
        "WHG_CELL")

    Call EmitLine(fileNumber, _
        "INPUT_VALUE_ROWS_OMITTED|count=" & _
        CStr(lngInputValueRowsOmitted) & _
        "|actionRequired=FALSE")

ExitSub:
    Set dictNumeric = Nothing
    Set dictWhg = Nothing
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitSub
End Sub

