Private Sub WriteBreaksSuperShortReport( _
    ByRef oldDoc As tPdfDocument, _
    ByRef newDoc As tPdfDocument, _
    ByVal detailedBreaksPath As String, _
    ByVal outputPath As String)

    Const METHOD_NAME As String = "WriteBreaksSuperShortReport"
    Dim arrIssueKeys As Variant
    Dim blnReady As Boolean
    Dim dictIssueCounts As Object
    Dim dictIssueSamples As Object
    Dim dictPageResults As Object
    Dim dictSampleCounts As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCritical As Long
    Dim lngCurrentPage As Long
    Dim lngFileIn As Long
    Dim lngFileOut As Long
    Dim lngIndex As Long
    Dim lngInfo As Long
    Dim lngInputValueDependentXEvents As Long
    Dim lngOperatorSerializationPages As Long
    Dim lngPage As Long
    Dim lngPagesCompared As Long
    Dim lngSampleIndex As Long
    Dim lngStructural As Long
    Dim strFamily As String
    Dim strIssueKey As String
    Dim strLine As String
    Dim strPageLine As String
    Dim strPageResult As String
    Dim strResult As String
    Dim strSampleKey As String

    On Error GoTo ErrorHandler

    Set dictIssueCounts = CreateObject("Scripting.Dictionary")
    Set dictIssueSamples = CreateObject("Scripting.Dictionary")
    Set dictPageResults = CreateObject("Scripting.Dictionary")
    Set dictSampleCounts = CreateObject("Scripting.Dictionary")

    lngFileIn = FreeFile
    Open detailedBreaksPath For Input Access Read As #lngFileIn

    Do While Not EOF(lngFileIn)
        Line Input #lngFileIn, strLine

        If Left$(strLine, 5) = "PAGE|" Then
            lngCurrentPage = CLng(Val(Mid$(strLine, 6)))
            If lngCurrentPage > lngPagesCompared Then
                lngPagesCompared = lngCurrentPage
            End If

        ElseIf Left$(strLine, 12) = "PAGE_RESULT|" Then
            lngPage = CLng(Val(BreaksSummaryField(strLine, "page")))
            If lngPage <= 0 Then
                lngPage = lngCurrentPage
            End If

            dictPageResults(CStr(lngPage)) = strLine

        ElseIf Left$(strLine, 17) = "PAGE_STREAM_INFO|" Then
            If BreaksSummaryField(strLine, "type") = "OPERATOR_PROFILE_COUNT_ONLY" Then
                lngOperatorSerializationPages = lngOperatorSerializationPages + 1
            End If

        ElseIf Left$( _
            strLine, _
            Len("TEXT_POSITION_INPUT_VALUE_INFO|")) = _
            "TEXT_POSITION_INPUT_VALUE_INFO|" Then

            lngInputValueDependentXEvents = _
                lngInputValueDependentXEvents + 1

        ElseIf Left$(strLine, 15) = "BREAKS_SUMMARY|" Then
            lngCritical = CLng(Val(BreaksSummaryField(strLine, "critical")))
            lngStructural = CLng(Val(BreaksSummaryField(strLine, "structural")))
            lngInfo = CLng(Val(BreaksSummaryField(strLine, "informational")))

            If CLng(Val(BreaksSummaryField(strLine, "pagesCompared"))) > 0 Then
                lngPagesCompared = CLng(Val(BreaksSummaryField(strLine, "pagesCompared")))
            End If

        ElseIf BreaksIsSuperShortBreakingLine(strLine) Then
            strFamily = BreaksSuperShortIssueFamily(strLine)

            If Len(strFamily) = 0 Then
                strFamily = "UNCLASSIFIED_BREAK"
            End If

            Call BreaksSummaryIncrementBy( _
                dictIssueCounts, _
                strFamily, _
                1)

            Call BreaksSuperShortAddSample( _
                dictIssueSamples, _
                dictSampleCounts, _
                strFamily, _
                "page=" & CStr(lngCurrentPage) & "|" & strLine)
        End If
    Loop

    Close #lngFileIn
    lngFileIn = 0

    If dictIssueCounts.Count = 0 And _
       (lngCritical > 0 Or lngStructural > 0) Then

        Call BreaksSummaryIncrementBy( _
            dictIssueCounts, _
            "UNCLASSIFIED_BREAKS", _
            lngCritical + lngStructural)
    End If

    blnReady = _
        dictIssueCounts.Count = 0 And _
        lngCritical = 0 And _
        lngStructural = 0

    If blnReady Then
        strResult = "READY_FOR_CLIENT_PARSER_TEST"
    Else
        strResult = "ACTION_REQUIRED"
    End If

    lngFileOut = OpenNew(outputPath)

    Call EmitLine(lngFileOut, "ORACLE_COMPATIBILITY_SUPER_SHORT_V3_OPTICAL_TOPOLOGY")
    Call EmitLine(lngFileOut, "OLD|" & oldDoc.PdfPath)
    Call EmitLine(lngFileOut, "NEW|" & newDoc.PdfPath)
    Call EmitLine(lngFileOut, _
        "RESULT|status=" & strResult & _
        "|breakFamilies=" & CStr(dictIssueCounts.Count) & _
        "|criticalEvents=" & CStr(lngCritical) & _
        "|structuralActionableEvents=" & CStr(lngStructural) & _
        "|pagesCompared=" & CStr(lngPagesCompared))
    Call EmitLine(lngFileOut, _
        "SCOPE|Only parser-sensitive breaks are listed. Compatible operator-count serialization and input-value differences are omitted.")
    Call EmitLine(lngFileOut, _
        "POLICY|WKN_CONTENT=EXCLUDED|positionFontStillAudited=TRUE" & _
        "|INPUT_DIFFERENT_WIDTH_ALIGNED_X=EXCLUDED|baselineFontStillAudited=TRUE")
    Call EmitLine(lngFileOut, _
        "POLICY|OPTICAL_CELL_TOPOLOGY=ENABLED|foreignRowSeparatorsComparedToOld=TRUE")

    If blnReady Then
        Call EmitLine(lngFileOut, "BREAKING_ISSUES|NONE")

        If lngOperatorSerializationPages > 0 Then
            Call EmitLine(lngFileOut, _
                "COMPATIBLE_INFO|operatorProfileCountOnlyPages=" & _
                CStr(lngOperatorSerializationPages) & _
                "|actionRequired=FALSE")
        End If

        If lngInputValueDependentXEvents > 0 Then
            Call EmitLine(lngFileOut, _
                "COMPATIBLE_INFO|inputValueDependentXEvents=" & _
                CStr(lngInputValueDependentXEvents) & _
                "|actionRequired=FALSE|retestWithMatchedInputForExactX=TRUE")
        End If

        Call EmitLine(lngFileOut, _
            "NEXT|Proceed to the proprietary client-parser test.")
        GoTo ExitSub
    End If

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "BREAKING_ISSUES")

    arrIssueKeys = BreaksSuperShortSortedIssueKeys(dictIssueCounts)

    For lngIndex = LBound(arrIssueKeys) To UBound(arrIssueKeys)
        If lngIndex >= BREAKS_SUPER_SHORT_MAX_FAMILIES Then
            Call EmitLine(lngFileOut, _
                "ISSUE|... " & _
                CStr(dictIssueCounts.Count - BREAKS_SUPER_SHORT_MAX_FAMILIES) & _
                " additional family/families omitted")
            Exit For
        End If

        strIssueKey = CStr(arrIssueKeys(lngIndex))
        Call EmitLine(lngFileOut, _
            "ISSUE|family=" & strIssueKey & _
            "|count=" & CStr(dictIssueCounts(strIssueKey)))
    Next lngIndex

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "AFFECTED_PAGES")

    For lngPage = 1 To lngPagesCompared
        If dictPageResults.Exists(CStr(lngPage)) Then
            strPageLine = CStr(dictPageResults(CStr(lngPage)))
            strPageResult = BreaksSummaryField(strPageLine, "result")

            If Not BreaksSuperShortPageResultIsPass(strPageResult) Then
                Call EmitLine(lngFileOut, _
                    "PAGE_ISSUE|" & Mid$(strPageLine, Len("PAGE_RESULT|") + 1))
            End If
        End If
    Next lngPage

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, "DETAIL_SAMPLES")

    For lngIndex = LBound(arrIssueKeys) To UBound(arrIssueKeys)
        If lngIndex >= BREAKS_SUPER_SHORT_MAX_FAMILIES Then
            Exit For
        End If

        strIssueKey = CStr(arrIssueKeys(lngIndex))

        For lngSampleIndex = 1 To BREAKS_SUPER_SHORT_SAMPLES_PER_FAMILY
            strSampleKey = strIssueKey & Chr$(30) & CStr(lngSampleIndex)

            If dictIssueSamples.Exists(strSampleKey) Then
                Call EmitLine(lngFileOut, _
                    "DETAIL|family=" & strIssueKey & _
                    "|" & CStr(dictIssueSamples(strSampleKey)))
            End If
        Next lngSampleIndex
    Next lngIndex

    If lngInputValueDependentXEvents > 0 Then
        Call EmitLine(lngFileOut, vbNullString)
        Call EmitLine(lngFileOut, _
            "COMPATIBLE_INFO|inputValueDependentXEvents=" & _
            CStr(lngInputValueDependentXEvents) & _
            "|actionRequired=FALSE|retestWithMatchedInputForExactX=TRUE")
    End If

    Call EmitLine(lngFileOut, vbNullString)
    Call EmitLine(lngFileOut, _
        "NEXT|Fix the listed families in order, rerun the audit, and send this same super-short file.")

ExitSub:
    If lngFileIn > 0 Then Close #lngFileIn
    If lngFileOut > 0 Then Close #lngFileOut

    Set dictIssueCounts = Nothing
    Set dictIssueSamples = Nothing
    Set dictPageResults = Nothing
    Set dictSampleCounts = Nothing
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "detailedBreaksPath;outputPath", _
        detailedBreaksPath, _
        outputPath

    errorManager.save
    Resume ExitSub
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-08
' Parameters:    lineText As String
' Returns:       Boolean
' Description:   Returns True only for parser-sensitive break-detail lines.
'-------------------------------------------------------------------------------
Private Function BreaksIsSuperShortBreakingLine( _
    ByVal lineText As String) As Boolean

    Const METHOD_NAME As String = "BreaksIsSuperShortBreakingLine"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    BreaksIsSuperShortBreakingLine = _
        Left$(lineText, Len("DOCUMENT_BREAK|")) = "DOCUMENT_BREAK|" Or _
        Left$(lineText, Len("PAGE_BREAK|")) = "PAGE_BREAK|" Or _
        Left$(lineText, Len("PAGE_STREAM_BREAK|")) = "PAGE_STREAM_BREAK|" Or _
        Left$(lineText, Len("TEXT_POSITION|")) = "TEXT_POSITION|" Or _
        Left$(lineText, Len("TEXT_FONT|")) = "TEXT_FONT|" Or _
        Left$(lineText, Len("WHITESPACE_ONLY|")) = "WHITESPACE_ONLY|" Or _
        Left$(lineText, Len("FIXED_TEXT_CONTENT|")) = "FIXED_TEXT_CONTENT|" Or _
        Left$(lineText, Len("FIXED_TEXT_ONLY_OLD|")) = "FIXED_TEXT_ONLY_OLD|" Or _
        Left$(lineText, Len("FIXED_TEXT_ONLY_NEW|")) = "FIXED_TEXT_ONLY_NEW|" Or _
        Left$(lineText, Len("TARGET_SEPARATOR_STYLE|")) = "TARGET_SEPARATOR_STYLE|" Or _
        Left$(lineText, Len("TARGET_SEPARATOR_GEOMETRY|")) = "TARGET_SEPARATOR_GEOMETRY|" Or _
        Left$(lineText, Len("TARGET_SEPARATOR_EXTRA_NEW|")) = "TARGET_SEPARATOR_EXTRA_NEW|" Or _
        Left$(lineText, Len("OPTICAL_CELL_TOPOLOGY|")) = "OPTICAL_CELL_TOPOLOGY|" Or _
        Left$(lineText, Len("VECTOR_STYLE|")) = "VECTOR_STYLE|" Or _
        Left$(lineText, Len("VECTOR_GEOMETRY|")) = "VECTOR_GEOMETRY|" Or _
        Left$(lineText, Len("VECTOR_ONLY_OLD|")) = "VECTOR_ONLY_OLD|" Or _
        Left$(lineText, Len("VECTOR_ONLY_NEW|")) = "VECTOR_ONLY_NEW|"

    If Left$(lineText, Len("TARGET_SEPARATOR|")) = "TARGET_SEPARATOR|" Then
        If BreaksSummaryField(lineText, "result") = "FAIL" Then
            BreaksIsSuperShortBreakingLine = True
        End If
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksIsSuperShortBreakingLine = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-08
' Parameters:    lineText As String
' Returns:       String
' Description:   Creates a stable code-level issue family from one raw break line.
'-------------------------------------------------------------------------------
Private Function BreaksSuperShortIssueFamily( _
    ByVal lineText As String) As String

    Const METHOD_NAME As String = "BreaksSuperShortIssueFamily"
    Dim arrParts() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strPrefix As String
    Dim strRole As String
    Dim strType As String
    Dim strX As String

    On Error GoTo ErrorHandler

    arrParts = Split(lineText, "|")
    strPrefix = arrParts(0)
    strType = BreaksSummaryField(lineText, "type")
    strRole = BreaksSummaryField(lineText, "role")
    strX = BreaksSummaryField(lineText, "x")

    Select Case strPrefix
        Case "DOCUMENT_BREAK"
            BreaksSuperShortIssueFamily = "DOCUMENT_" & strType

        Case "PAGE_BREAK"
            BreaksSuperShortIssueFamily = "PAGE_" & strType

        Case "PAGE_STREAM_BREAK"
            BreaksSuperShortIssueFamily = "STREAM_" & strType

        Case "TEXT_POSITION"
            If Len(strRole) = 0 Then strRole = "UNCLASSIFIED"
            BreaksSuperShortIssueFamily = "TEXT_POSITION_" & strRole

        Case "TEXT_FONT"
            If Len(strRole) = 0 Then strRole = "UNCLASSIFIED"
            BreaksSuperShortIssueFamily = "TEXT_FONT_" & strRole

        Case "WHITESPACE_ONLY"
            If Len(strRole) = 0 Then strRole = "UNCLASSIFIED"
            BreaksSuperShortIssueFamily = "WHITESPACE_" & strRole

        Case "TARGET_SEPARATOR", _
             "TARGET_SEPARATOR_STYLE", _
             "TARGET_SEPARATOR_GEOMETRY", _
             "TARGET_SEPARATOR_EXTRA_NEW"

            If Len(strX) = 0 Then strX = "UNKNOWN"
            BreaksSuperShortIssueFamily = "TARGET_SEPARATOR_X_" & _
                Replace(strX, ".", "_")

        Case "OPTICAL_CELL_TOPOLOGY"
            strRole = BreaksSummaryField(lineText, "field")
            If Len(strRole) = 0 Then strRole = "UNCLASSIFIED"
            BreaksSuperShortIssueFamily = "OPTICAL_SEPARATOR_" & strRole

        Case "VECTOR_STYLE"
            BreaksSuperShortIssueFamily = "VECTOR_STYLE"

        Case "VECTOR_GEOMETRY", _
             "VECTOR_ONLY_OLD", _
             "VECTOR_ONLY_NEW"

            BreaksSuperShortIssueFamily = "VECTOR_GEOMETRY"

        Case Else
            BreaksSuperShortIssueFamily = strPrefix
    End Select

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksSuperShortIssueFamily = "UNCLASSIFIED_BREAK"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-08
' Parameters:    sampleDictionary, countDictionary, family, sampleText
' Returns:       ---
' Description:   Stores a bounded number of representative samples per issue family.
'-------------------------------------------------------------------------------
Private Sub BreaksSuperShortAddSample( _
    ByVal sampleDictionary As Object, _
    ByVal countDictionary As Object, _
    ByVal family As String, _
    ByVal sampleText As String)

    Const METHOD_NAME As String = "BreaksSuperShortAddSample"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCount As Long
    Dim strSampleKey As String

    On Error GoTo ErrorHandler

    If countDictionary.Exists(family) Then
        lngCount = CLng(countDictionary(family))
    End If

    If lngCount >= BREAKS_SUPER_SHORT_SAMPLES_PER_FAMILY Then
        GoTo ExitSub
    End If

    lngCount = lngCount + 1
    countDictionary(family) = lngCount
    strSampleKey = family & Chr$(30) & CStr(lngCount)
    sampleDictionary(strSampleKey) = SanitizeReportText(sampleText)

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "family", _
        family

    errorManager.save
    Resume ExitSub
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-08
' Parameters:    issueDictionary As Object
' Returns:       Variant
' Description:   Returns issue-family keys sorted by count descending, then name.
'-------------------------------------------------------------------------------
Private Function BreaksSuperShortSortedIssueKeys( _
    ByVal issueDictionary As Object) As Variant

    Const METHOD_NAME As String = "BreaksSuperShortSortedIssueKeys"
    Dim arrKeys() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim lngInner As Long
    Dim strSwap As String
    Dim varKey As Variant

    On Error GoTo ErrorHandler

    If issueDictionary.Count = 0 Then
        BreaksSuperShortSortedIssueKeys = Array()
        GoTo ExitFunction
    End If

    ReDim arrKeys(0 To issueDictionary.Count - 1)

    For Each varKey In issueDictionary.Keys
        arrKeys(lngIndex) = CStr(varKey)
        lngIndex = lngIndex + 1
    Next varKey

    For lngIndex = LBound(arrKeys) To UBound(arrKeys) - 1
        For lngInner = lngIndex + 1 To UBound(arrKeys)
            If CLng(issueDictionary(arrKeys(lngInner))) > _
               CLng(issueDictionary(arrKeys(lngIndex))) Or _
               (CLng(issueDictionary(arrKeys(lngInner))) = _
                CLng(issueDictionary(arrKeys(lngIndex))) And _
                StrComp(arrKeys(lngInner), arrKeys(lngIndex), vbBinaryCompare) < 0) Then

                strSwap = arrKeys(lngIndex)
                arrKeys(lngIndex) = arrKeys(lngInner)
                arrKeys(lngInner) = strSwap
            End If
        Next lngInner
    Next lngIndex

    BreaksSuperShortSortedIssueKeys = arrKeys

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksSuperShortSortedIssueKeys = Array()

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-08
' Parameters:    pageResult As String
' Returns:       Boolean
' Description:   Treats PASS and PASS_* compatibility statuses as non-breaking.
'-------------------------------------------------------------------------------
Private Function BreaksSuperShortPageResultIsPass( _
    ByVal pageResult As String) As Boolean

    Const METHOD_NAME As String = "BreaksSuperShortPageResultIsPass"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    BreaksSuperShortPageResultIsPass = _
        Left$(UCase$(Trim$(pageResult)), 4) = "PASS"

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BreaksSuperShortPageResultIsPass = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageResult", _
        pageResult

    errorManager.save
    Resume ExitFunction
End Function

