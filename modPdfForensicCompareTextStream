Private Function PfcTsSnapshotForIndex( _
    ByVal dictCache As Object, _
    ByRef pdfDoc As tPdfDocument, _
    ByVal textIndex As Long) As String

    Dim lngOrdinal As Long
    Dim lngPage As Long
    Dim strKey As String

    If dictCache Is Nothing Then
        PfcTsSnapshotForIndex = "MISSING_CACHE"
        Exit Function
    End If

    If textIndex < 0 Or textIndex >= pdfDoc.TextCount Then
        PfcTsSnapshotForIndex = "MISSING"
        Exit Function
    End If

    lngPage = pdfDoc.Texts(textIndex).PageNo

    If lngPage < 1 Or lngPage > pdfDoc.PageCount Then
        PfcTsSnapshotForIndex = "MISSING_PAGE"
        Exit Function
    End If

    lngOrdinal = textIndex - pdfDoc.Pages(lngPage).TextStart + 1
    strKey = PfcTsCacheKey(lngPage, lngOrdinal)

    If dictCache.Exists(strKey) Then
        PfcTsSnapshotForIndex = CStr(dictCache(strKey))
    Else
        PfcTsSnapshotForIndex = _
            "MISSING_EVENT|page=" & CStr(lngPage) & _
            "|ordinal=" & CStr(lngOrdinal)
    End If
End Function

Private Function PfcTsCacheKey( _
    ByVal pageNo As Long, _
    ByVal textOrdinal As Long) As String

    PfcTsCacheKey = _
        "P" & CStr(pageNo) & _
        "|T" & CStr(textOrdinal)
End Function

'===============================================================================
' TARGET COMPARISON
'===============================================================================

Private Sub PfcTsComparePart( _
    ByVal anchorId As String, _
    ByVal role As String, _
    ByVal familySuffix As String, _
    ByVal fieldName As String, _
    ByVal oldSnapshot As String, _
    ByVal betterSnapshot As String, _
    ByVal currentSnapshot As String, _
    ByVal priority As Long, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim strBetter As String
    Dim strCurrent As String
    Dim strDirection As String
    Dim strFamily As String
    Dim strOld As String
    Dim strSample As String

    strOld = PfcTsField(oldSnapshot, fieldName)
    strBetter = PfcTsField(betterSnapshot, fieldName)
    strCurrent = PfcTsField(currentSnapshot, fieldName)

    If strCurrent = strOld Then Exit Sub

    If strBetter = strOld Then
        strDirection = "OLD_EQ_BETTER_CURRENT_DIFF"
    ElseIf strBetter = strCurrent Then
        strDirection = "BETTER_EQ_CURRENT_OLD_DIFF"
    Else
        strDirection = "ALL_DIFFER"
    End If

    strFamily = _
        "DOXIS_V19_" & familySuffix & "_CHANGED_" & role

    strSample = _
        "tx=" & anchorId & _
        "|role=" & role & _
        "|field=" & fieldName & _
        "|direction=" & strDirection & _
        "|OLD=" & PfcTsLimit(strOld, 500) & _
        "|BETTER=" & PfcTsLimit(strBetter, 500) & _
        "|CURRENT=" & PfcTsLimit(strCurrent, 500) & _
        "|comparisonBasis=OLD_ORACLE"

    Call PfcTsAddIssue( _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples, _
        strFamily, _
        priority, _
        strSample)
End Sub

Private Function PfcTsRolePriority(ByVal role As String) As Long
    If role = "TOP_ISIN" Then
        PfcTsRolePriority = 3
    ElseIf InStr(1, role, "WHG", vbBinaryCompare) > 0 Then
        PfcTsRolePriority = 3
    ElseIf role = "TOP_SCHLUSSTAG" Or role = "TOP_VALUTATAG" Then
        PfcTsRolePriority = 2
    Else
        PfcTsRolePriority = 1
    End If
End Function

Private Function PfcTsGroupingPriority(ByVal role As String) As Long
    If role = "TOP_ISIN" Or _
       InStr(1, role, "WHG", vbBinaryCompare) > 0 Then

        PfcTsGroupingPriority = 2
    Else
        PfcTsGroupingPriority = 1
    End If
End Function

Private Function PfcTsLocalOpsPriority(ByVal role As String) As Long
    If role = "TOP_ISIN" Or _
       InStr(1, role, "WHG", vbBinaryCompare) > 0 Then

        PfcTsLocalOpsPriority = 2
    Else
        PfcTsLocalOpsPriority = 1
    End If
End Function

Private Sub PfcTsAddIssue( _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object, _
    ByVal family As String, _
    ByVal priority As Long, _
    ByVal sampleText As String)

    Dim lngCount As Long
    Dim strSampleKey As String

    If dictIssueCounts.Exists(family) Then
        dictIssueCounts(family) = CLng(dictIssueCounts(family)) + 1

        If priority > CLng(dictIssuePriorities(family)) Then
            dictIssuePriorities(family) = priority
        End If
    Else
        dictIssueCounts.Add family, 1
        dictIssuePriorities.Add family, priority
    End If

    lngCount = CLng(dictIssueCounts(family))
    If lngCount > MAX_SAMPLES_PER_FAMILY Then Exit Sub

    strSampleKey = family & "|" & CStr(lngCount)

    If Not dictIssueSamples.Exists(strSampleKey) Then
        dictIssueSamples.Add strSampleKey, sampleText
    End If
End Sub

Private Function PfcTsField( _
    ByVal snapshot As String, _
    ByVal fieldName As String) As String

    Dim arrParts As Variant
    Dim lngIndex As Long
    Dim strPart As String
    Dim strPrefix As String

    strPrefix = fieldName & "="
    arrParts = Split(snapshot, "|")

    For lngIndex = LBound(arrParts) To UBound(arrParts)
        strPart = CStr(arrParts(lngIndex))

        If Left$(strPart, Len(strPrefix)) = strPrefix Then
            PfcTsField = Mid$(strPart, Len(strPrefix) + 1)
            Exit Function
        End If
    Next lngIndex

    PfcTsField = "(missing)"
End Function

