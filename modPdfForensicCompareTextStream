Private Function PfcTsPageDiagnostic( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long) As String

    If pageNo < 1 Or pageNo > pdfDoc.PageCount Then
        PfcTsPageDiagnostic = "MISSING_PAGE"
        Exit Function
    End If

    PfcTsPageDiagnostic = _
        "refs=" & PfcTsSafe(pdfDoc.Pages(pageNo).ContentReferences) & _
        ",filters=" & PfcTsSafe(pdfDoc.Pages(pageNo).ContentFilters) & _
        ",len=" & CStr(pdfDoc.Pages(pageNo).ContentLength) & _
        ",ops=" & PfcTsTextOperatorProfile(pdfDoc.Pages(pageNo).ContentText) & _
        ",eol=" & PfcTsEolProfile(pdfDoc.Pages(pageNo).ContentText)
End Function

Private Function PfcTsTextOperatorProfile( _
    ByVal content As String) As String

    Dim arrTokens() As String
    Dim lngBt As Long
    Dim lngEt As Long
    Dim lngIndex As Long
    Dim lngQ As Long
    Dim lngBigQ As Long
    Dim lngTc As Long
    Dim lngTd As Long
    Dim lngTD As Long
    Dim lngTf As Long
    Dim lngTj As Long
    Dim lngTJ As Long
    Dim lngTm As Long
    Dim lngTr As Long
    Dim lngTs As Long
    Dim lngTw As Long
    Dim lngTz As Long
    Dim lngTokenCount As Long
    Dim lngW As Long
    Dim lngWStar As Long
    Dim lngCm As Long

    lngTokenCount = Tokenize(content, arrTokens)

    For lngIndex = 0 To lngTokenCount - 1
        Select Case arrTokens(lngIndex)
            Case "BT": lngBt = lngBt + 1
            Case "ET": lngEt = lngEt + 1
            Case "Tf": lngTf = lngTf + 1
            Case "Tm": lngTm = lngTm + 1
            Case "Td": lngTd = lngTd + 1
            Case "TD": lngTD = lngTD + 1
            Case "Tj": lngTj = lngTj + 1
            Case "TJ": lngTJ = lngTJ + 1
            Case "Tc": lngTc = lngTc + 1
            Case "Tw": lngTw = lngTw + 1
            Case "Tz": lngTz = lngTz + 1
            Case "Tr": lngTr = lngTr + 1
            Case "Ts": lngTs = lngTs + 1
            Case "q": lngQ = lngQ + 1
            Case "Q": lngBigQ = lngBigQ + 1
            Case "W": lngW = lngW + 1
            Case "W*": lngWStar = lngWStar + 1
            Case "cm": lngCm = lngCm + 1
        End Select
    Next lngIndex

    PfcTsTextOperatorProfile = _
        "BT" & CStr(lngBt) & _
        "/ET" & CStr(lngEt) & _
        "/Tf" & CStr(lngTf) & _
        "/Tm" & CStr(lngTm) & _
        "/Td" & CStr(lngTd) & _
        "/TD" & CStr(lngTD) & _
        "/Tj" & CStr(lngTj) & _
        "/TJ" & CStr(lngTJ) & _
        "/Tc" & CStr(lngTc) & _
        "/Tw" & CStr(lngTw) & _
        "/Tz" & CStr(lngTz) & _
        "/Tr" & CStr(lngTr) & _
        "/Ts" & CStr(lngTs) & _
        "/q" & CStr(lngQ) & _
        "/Q" & CStr(lngBigQ) & _
        "/W" & CStr(lngW) & _
        "/W*" & CStr(lngWStar) & _
        "/cm" & CStr(lngCm)
End Function

Private Function PfcTsEolProfile(ByVal content As String) As String
    Dim lngCr As Long
    Dim lngCrLf As Long
    Dim lngLf As Long
    Dim lngTab As Long

    lngCrLf = PfcTsCountSubstring(content, vbCrLf)
    lngCr = PfcTsCountSubstring(content, vbCr) - lngCrLf
    lngLf = PfcTsCountSubstring(content, vbLf) - lngCrLf
    lngTab = PfcTsCountSubstring(content, vbTab)

    PfcTsEolProfile = _
        "CRLF" & CStr(lngCrLf) & _
        "/LF" & CStr(lngLf) & _
        "/CR" & CStr(lngCr) & _
        "/TAB" & CStr(lngTab)
End Function

Private Function PfcTsCountSubstring( _
    ByVal sourceText As String, _
    ByVal searchText As String) As Long

    Dim lngPosition As Long
    Dim lngStart As Long

    If Len(searchText) = 0 Then Exit Function

    lngStart = 1

    Do
        lngPosition = InStr(lngStart, sourceText, searchText, vbBinaryCompare)
        If lngPosition = 0 Then Exit Do

        PfcTsCountSubstring = PfcTsCountSubstring + 1
        lngStart = lngPosition + Len(searchText)
    Loop
End Function

