Private Function PfcTsSafe(ByVal value As String) As String
    Dim strResult As String

    strResult = SanitizeReportText(value)
    strResult = Replace(strResult, "|", "/")
    strResult = Replace(strResult, vbCr, " ")
    strResult = Replace(strResult, vbLf, " ")

    PfcTsSafe = strResult
End Function

Private Function PfcTsLimit( _
    ByVal value As String, _
    ByVal maxLength As Long) As String

    If Len(value) <= maxLength Then
        PfcTsLimit = value
    Else
        PfcTsLimit = Left$(value, maxLength) & "..."
    End If
End Function

Private Function PfcTsNum(ByVal value As String) As String
    If Len(Trim$(value)) = 0 Then
        PfcTsNum = "0"
    Else
        PfcTsNum = NumTxt(Val(value))
    End If
End Function
