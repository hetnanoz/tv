    PfcTsCtmSignature = _
        NumTxt(ctmA) & "," & _
        NumTxt(ctmB) & "," & _
        NumTxt(ctmC) & "," & _
        NumTxt(ctmD) & "," & _
        NumTxt(ctmE) & "," & _
