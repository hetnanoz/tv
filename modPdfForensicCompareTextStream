Private Function PfcTsIsOperator(ByVal tokenValue As String) As Boolean
    Select Case tokenValue
        Case "q", "Q", "cm", _
             "w", "J", "j", "M", "d", "ri", "i", "gs", _
             "m", "l", "c", "v", "y", "h", "re", _
             "S", "s", "f", "F", "f*", "B", "B*", "b", "b*", "n", _
             "W", "W*", _
             "BT", "ET", "Tc", "Tw", "Tz", "TL", "Tf", "Tr", "Ts", _
             "Td", "TD", "Tm", "T*", "Tj", "TJ", "'", _
             "g", "G", "rg", "RG", "k", "K", "cs", "CS", "sc", "SC", _
             "scn", "SCN", "Do"

            PfcTsIsOperator = True
    End Select
End Function

Private Function PfcTsOperatorWindow( _
    ByRef opNames() As String, _
    ByVal opCount As Long, _
    ByVal centerOp As Long, _
    ByVal radius As Long) As String

    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngStart As Long
    Dim strResult As String

    If centerOp < 1 Or centerOp > opCount Then
        PfcTsOperatorWindow = "(missing)"
        Exit Function
    End If

    lngStart = centerOp - radius
    If lngStart < 1 Then lngStart = 1

    lngEnd = centerOp + radius
    If lngEnd > opCount Then lngEnd = opCount

    For lngIndex = lngStart To lngEnd
        If Len(strResult) > 0 Then strResult = strResult & ">"

        If lngIndex = centerOp Then
            strResult = strResult & "[" & opNames(lngIndex) & "]"
        Else
            strResult = strResult & opNames(lngIndex)
        End If
    Next lngIndex

    PfcTsOperatorWindow = strResult
End Function

Private Sub PfcTsIncrementCount( _
    ByVal dictCounts As Object, _
    ByVal keyText As String)

    If dictCounts.Exists(keyText) Then
        dictCounts(keyText) = CLng(dictCounts(keyText)) + 1
    Else
        dictCounts.Add keyText, 1
    End If
End Sub

Private Sub PfcTsConcatMatrix( _
    ByVal a As Double, _
    ByVal b As Double, _
    ByVal c As Double, _
    ByVal d As Double, _
    ByVal e As Double, _
    ByVal f As Double, _
    ByRef ctmA As Double, _
    ByRef ctmB As Double, _
    ByRef ctmC As Double, _
    ByRef ctmD As Double, _
    ByRef ctmE As Double, _
    ByRef ctmF As Double)

    Dim dblNewA As Double
    Dim dblNewB As Double
    Dim dblNewC As Double
    Dim dblNewD As Double
    Dim dblNewE As Double
    Dim dblNewF As Double

    dblNewA = a * ctmA + b * ctmC
    dblNewB = a * ctmB + b * ctmD
    dblNewC = c * ctmA + d * ctmC
    dblNewD = c * ctmB + d * ctmD
    dblNewE = e * ctmA + f * ctmC + ctmE
    dblNewF = e * ctmB + f * ctmD + ctmF

    ctmA = dblNewA
    ctmB = dblNewB
    ctmC = dblNewC
    ctmD = dblNewD
    ctmE = dblNewE
    ctmF = dblNewF
End Sub

