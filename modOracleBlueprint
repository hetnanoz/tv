'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    ---
' Returns:       Long
' Description:   Counts clip rectangles whose state is active at the next show.
'-------------------------------------------------------------------------------
Private Function BlueprintClipCarriesToShowCount() As Long

    Dim lngIndex As Long
    Dim lngNextShow As Long

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).Source = "re" And _
           Len(m_prim(lngIndex).ClipOperator) > 0 Then

            lngNextShow = BlueprintFindNextShowForPrimitive(lngIndex)

            If lngNextShow >= 0 Then
                If m_show(lngNextShow).ClipActive And _
                   m_show(lngNextShow).ClipSetToken >= _
                        m_prim(lngIndex).PaintTokenIndex Then

                    BlueprintClipCarriesToShowCount = _
                        BlueprintClipCarriesToShowCount + 1
                End If
            End If
        End If
    Next lngIndex

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    lngFile As Long
' Returns:       ---
' Description:   Collapses empty/whitespace show operations by X/font/clip state.
'-------------------------------------------------------------------------------
Private Sub BlueprintWriteDigestShowPatterns(ByVal lngFile As Long)

    Dim arrCount() As Long
    Dim arrKey() As String
    Dim lngIndex As Long
    Dim lngKeyCount As Long
    Dim strClass As String
    Dim strKey As String

    ReDim arrKey(0 To 2047)
    ReDim arrCount(0 To 2047)

    For lngIndex = 0 To m_showCount - 1
        strClass = BlueprintTextShowClass(m_show(lngIndex))

        If strClass <> "VISIBLE_TEXT" Then
            strKey = _
                "class=" & strClass & _
                "|clip=" & BlueprintBoolText(m_show(lngIndex).ClipActive) & _
                "|op=" & m_show(lngIndex).ShowOperator & _
                "|x=" & BlueprintNumText(m_show(lngIndex).X) & _
                "|font=" & m_show(lngIndex).FontName & _
                "|size=" & BlueprintNumText(m_show(lngIndex).FontSize) & _
                "|stringTokens=" & CStr(m_show(lngIndex).StringTokenCount) & _
                "|decodedLen=" & CStr(Len(m_show(lngIndex).DecodedValue)) & _
                "|ws=" & CStr(BlueprintWhitespaceCount(m_show(lngIndex).DecodedValue)) & _
                "|marker=" & BlueprintVisibleMarker(m_show(lngIndex).DecodedValue)

            Call BlueprintCountKey(arrKey, arrCount, lngKeyCount, strKey)
        End If
    Next lngIndex

    Call BlueprintEmit(lngFile, "NONVISIBLE TEXT SHOW PATTERNS  (Y collapsed)")

    If lngKeyCount = 0 Then
        Call BlueprintEmit(lngFile, "  (none)")
    Else
        For lngIndex = 0 To lngKeyCount - 1
            Call BlueprintEmit(lngFile, _
                "  SHOWPATTERN|" & arrKey(lngIndex) & _
                "|count=" & CStr(arrCount(lngIndex)))
        Next lngIndex
    End If

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    lngFile As Long
' Returns:       ---
' Description:   Collapses clip rectangles by the next show operator. This makes
'                a 34-clip OLD/CURRENT delta traceable to an exact X/width/field.
'-------------------------------------------------------------------------------
Private Sub BlueprintWriteDigestClipToShowPatterns(ByVal lngFile As Long)

    Dim arrCount() As Long
    Dim arrKey() As String
    Dim blnCarries As Boolean
    Dim blnDirect As Boolean
    Dim lngIndex As Long
    Dim lngKeyCount As Long
    Dim lngNextShow As Long
    Dim strKey As String

    ReDim arrKey(0 To 2047)
    ReDim arrCount(0 To 2047)

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).Source = "re" And _
           Len(m_prim(lngIndex).ClipOperator) > 0 Then

            lngNextShow = BlueprintFindNextShowForPrimitive(lngIndex)
            blnDirect = False
            blnCarries = False

            If lngNextShow >= 0 Then
                blnDirect = BlueprintIsLastPathBeforeShow(lngIndex, lngNextShow)

                If m_show(lngNextShow).ClipActive Then
                    blnCarries = _
                        (m_show(lngNextShow).ClipSetToken >= _
                         m_prim(lngIndex).PaintTokenIndex)
                End If

                strKey = _
                    "clipX=" & BlueprintNumText(m_prim(lngIndex).RectX) & _
                    "|clipW=" & BlueprintNumText(m_prim(lngIndex).RectW) & _
                    "|clipH=" & BlueprintNumText(m_prim(lngIndex).RectH) & _
                    "|class=" & BlueprintPrimitiveClass(m_prim(lngIndex)) & _
                    "|direct=" & BlueprintBoolText(blnDirect) & _
                    "|carries=" & BlueprintBoolText(blnCarries) & _
                    "|showClass=" & BlueprintTextShowClass(m_show(lngNextShow)) & _
                    "|showX=" & BlueprintNumText(m_show(lngNextShow).X) & _
                    "|font=" & m_show(lngNextShow).FontName & _
                    "|size=" & BlueprintNumText(m_show(lngNextShow).FontSize)
            Else
                strKey = _
                    "clipX=" & BlueprintNumText(m_prim(lngIndex).RectX) & _
                    "|clipW=" & BlueprintNumText(m_prim(lngIndex).RectW) & _
                    "|clipH=" & BlueprintNumText(m_prim(lngIndex).RectH) & _
                    "|class=" & BlueprintPrimitiveClass(m_prim(lngIndex)) & _
                    "|nextShow=NONE"
            End If

            Call BlueprintCountKey(arrKey, arrCount, lngKeyCount, strKey)
        End If
    Next lngIndex

    Call BlueprintEmit(lngFile, "CLIP -> NEXT SHOW PATTERNS  (Y collapsed)")

    If lngKeyCount = 0 Then
        Call BlueprintEmit(lngFile, "  (none)")
    Else
        For lngIndex = 0 To lngKeyCount - 1
            Call BlueprintEmit(lngFile, _
                "  CLIPSHOW|" & arrKey(lngIndex) & _
                "|count=" & CStr(arrCount(lngIndex)))
        Next lngIndex
    End If

End Sub


