'-------------------------------------------------------------------------------
' Module:       modOracleBlueprint
' Purpose:      Paint-aware extractor for the original Oracle Reports PDF.
'
'               The existing modPdfReport analyser records path geometry but
'               never reads the painting operator, so a stroked rectangle, a
'               filled rectangle and an invisible "re n" path are all collected
'               the same way. That distinction is exactly what the Helaba/DOXIS
'               investigation depends on, so this module rebuilds the walk with
'               a full graphics state and classifies every primitive by the
'               operator that terminates its path.
'
'  Output:      One file, <base>_blueprint.txt, written next to the source PDF:
'                 SECTION 1 DIAGNOSTICS  why each page did or did not decode
'                 SECTION 2 COUNTERS     ml, re and invisible re n totals plus
'                                        paste-ready Array() constants
'                 SECTION 3 TABLE SPEC   media box, fonts, rule grid, per-cell
'                                        geometry and measured padding
'                 SECTION 4 BOXES        rectangles clustered into row bands,
'                                        invisible ones listed separately
'                 SECTION 5 PRIMITIVES   every primitive with paint + clip operator
'                 SECTION 6 TEXT RUNS    text with resolved coordinates + active clip
'                 SECTION 7 CLIP PATHS   W/W* classification and nearest-text evidence
'
' Dependencies: InflateStream, exposed as Public by the existing modPdfReport
'               module (imported as modpdfinflate). No references, no external
'               tools, no administrator rights.
'
' Entry point:  RunOracleBlueprint - set the two constants and press F5.
'-------------------------------------------------------------------------------
Option Explicit

Private Const CLASS_NAME As String = "modOracleBlueprint"
Private Const BLUEPRINT_VERSION As String = "V3_TEXT_SHOW_AWARE"

Private Const BAND_TOLERANCE As Double = 1.5
Private Const COORD_TOLERANCE As Double = 0.05
Private Const MAX_PRIMITIVES As Long = 60000
Private Const MAX_TEXTS As Long = 40000
Private Const MAX_SHOWS As Long = 50000
Private Const RECT_MIN_SIDE As Double = 2#
Private Const MAX_OBJECT_NUMBER_DIGITS As Long = 9

Private Type tPrimitive
    PageNo As Long
    Source As String
    Paint As String
    ClipOperator As String
    GraphicsDepth As Long
    PathTokenIndex As Long
    PaintTokenIndex As Long
    X1 As Double
    Y1 As Double
    X2 As Double
    Y2 As Double
    RectX As Double
    RectY As Double
    RectW As Double
    RectH As Double
    LineWidth As Double
    FillGray As String
    StrokeGray As String
    Orientation As String
End Type

Private Type tTextRun
    PageNo As Long
    X As Double
    Y As Double
    FontName As String
    FontSize As Double
    TextValue As String
    TokenIndex As Long
    GraphicsDepth As Long
    ClipActive As Boolean
    ClipOperator As String
    ClipSetToken As Long
    ClipSummary As String
End Type

Private Type tTextShow
    PageNo As Long
    X As Double
    Y As Double
    FontName As String
    FontSize As Double
    RawValue As String
    DecodedValue As String
    ShowOperator As String
    HasStringOperand As Boolean
    StringTokenCount As Long
    TokenIndex As Long
    GraphicsDepth As Long
    ClipActive As Boolean
    ClipOperator As String
    ClipSetToken As Long
    ClipSummary As String
End Type

Private Type tGraphicsState
    LineWidth As Double
    FillGray As String
    StrokeGray As String
    ClipActive As Boolean
    ClipOperator As String
    ClipSetToken As Long
    ClipSummary As String
End Type

Private m_pdf() As Byte
Private m_objNum() As Long
Private m_objPos() As Long
Private m_objCount As Long

Private m_prim() As tPrimitive
Private m_primCount As Long

Private m_text() As tTextRun
Private m_textCount As Long

Private m_show() As tTextShow
Private m_showCount As Long

Private m_diag() As String
Private m_diagCount As Long
Private m_step As String

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    ---
' Returns:       ---
' Description:   Asks for the PDF and writes every report next to the chosen file.
'-------------------------------------------------------------------------------
Public Sub RunOracleBlueprint()

    Const METHOD_NAME As String = "RunOracleBlueprint"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim varSelection As Variant

    On Error GoTo ErrorHandler

    varSelection = Application.GetOpenFilename( _
        FileFilter:="PDF files (*.pdf), *.pdf", _
        Title:="Select the PDF to analyse")

    If VarType(varSelection) = vbBoolean Then
        GoTo ExitSub
    End If

    ' An empty output folder makes the extractor write next to the source file.
    Call OracleBlueprintExtract(CStr(varSelection), vbNullString)

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitSub
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strPdfPath As String, strOutFolder As String
' Returns:       ---
' Description:   Reads one PDF and writes the full report plus the short digest.
'-------------------------------------------------------------------------------
Public Sub OracleBlueprintExtract( _
    ByVal strPdfPath As String, _
    ByVal strOutFolder As String)

    Const METHOD_NAME As String = "OracleBlueprintExtract"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim lngPageCount As Long
    Dim strBase As String
    Dim lngFile As Long
    Dim strContent As String
    Dim strFolder As String
    Dim strReport As String
    Dim varPages As Variant

    On Error GoTo ErrorHandler

    If Len(Dir$(strPdfPath)) = 0 Then
        Err.Raise 1001, METHOD_NAME, "The source PDF was not found: " & strPdfPath
    End If

    strFolder = strOutFolder

    ' Default to the folder the source PDF was picked from.
    If Len(Trim$(strFolder)) = 0 Then
        strFolder = Left$(strPdfPath, InStrRev(strPdfPath, "\"))
    End If

    If Right$(strFolder, 1) <> "\" Then
        strFolder = strFolder & "\"
    End If

    strBase = BlueprintFileBaseName(strPdfPath)

    m_step = "READ_BYTES"
    m_pdf = BlueprintReadBytes(strPdfPath)

    m_step = "BUILD_OBJECT_INDEX"

    m_primCount = 0
    m_textCount = 0
    m_showCount = 0
    m_diagCount = 0
    ReDim m_prim(0 To MAX_PRIMITIVES - 1)
    ReDim m_text(0 To MAX_TEXTS - 1)
    ReDim m_show(0 To MAX_SHOWS - 1)
    ReDim m_diag(0 To 1023)

    Call BlueprintBuildObjectIndex

    m_step = "PAGE_OBJECT_LIST"
    varPages = BlueprintPageObjectNumbers()

    If Not IsArray(varPages) Then
        Err.Raise 1002, METHOD_NAME, "No /Type /Page objects were found."
    End If

    For lngIndex = LBound(varPages) To UBound(varPages)
        lngPageCount = lngPageCount + 1

        m_step = "PAGE_" & CStr(lngPageCount) & "_CONTENT"
        strContent = BlueprintPageContent(CLng(varPages(lngIndex)), lngPageCount)

        If Len(strContent) > 0 Then
            m_step = "PAGE_" & CStr(lngPageCount) & "_WALK"
            Call BlueprintWalkContent(strContent, lngPageCount)
        End If
    Next lngIndex

    ' Everything goes into one report file, section by section.
    m_step = "WRITE_REPORT"
    strReport = strFolder & strBase & "_blueprint.txt"

    Call BlueprintWriteReport(strReport, strPdfPath, lngPageCount, varPages)

    If m_primCount = 0 Then
        MsgBox "Blueprint finished but found NO primitives. " & _
               "Read the DIAGNOSTICS section of:" & vbCrLf & vbCrLf & strReport, _
               vbExclamation
    Else
        MsgBox "Blueprint complete - " & CStr(lngPageCount) & " page(s), " & _
               CStr(m_primCount) & " primitive(s), " & CStr(m_textCount) & " text run(s)." & _
               vbCrLf & vbCrLf & "Start here:" & vbCrLf & _
               BlueprintDigestPath(strReport) & vbCrLf & vbCrLf & _
               "Full detail:" & vbCrLf & strReport, _
               vbInformation
    End If

ExitSub:
    Erase m_prim
    Erase m_text
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    ' Record where the run stopped and still write whatever was collected, so
    ' the report always explains the failure instead of leaving no output.
    Call BlueprintLogDiag("FATAL|step=" & m_step & _
        "|err=" & CStr(errNumber) & "|desc=" & BlueprintSanitize(errDescription))

    On Error Resume Next

    If Len(strReport) = 0 Then
        strReport = strFolder & strBase & "_blueprint.txt"
    End If

    Call BlueprintWriteReport(strReport, strPdfPath, lngPageCount, varPages)

    MsgBox "Blueprint stopped at step " & m_step & _
           " with error " & CStr(errNumber) & " (" & errDescription & ")." & _
           vbCrLf & vbCrLf & "Partial report and DIAGNOSTICS written to:" & _
           vbCrLf & strReport, _
           vbExclamation

    On Error GoTo 0

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pdfPath;step", _
        strPdfPath, _
        m_step

    errorManager.save
    Resume ExitSub
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strReport As String, strSource As String, lngPageCount As Long, varPages As Variant
' Returns:       ---
' Description:   Writes the whole report. Each section is guarded so that one
'                failing section cannot suppress the rest of the output.
'-------------------------------------------------------------------------------
Private Sub BlueprintWriteReport( _
    ByVal strReport As String, _
    ByVal strSource As String, _
    ByVal lngPageCount As Long, _
    ByVal varPages As Variant)

    Dim lngFile As Long

    lngFile = BlueprintOpenNew(strReport)

    Call BlueprintEmit(lngFile, "ORACLE_BLUEPRINT_" & BLUEPRINT_VERSION)
    Call BlueprintEmit(lngFile, "source|" & strSource)
    Call BlueprintEmit(lngFile, "lastStep|" & m_step)
    Call BlueprintEmit(lngFile, "pages|" & CStr(lngPageCount))
    Call BlueprintEmit(lngFile, "primitives|" & CStr(m_primCount))
    Call BlueprintEmit(lngFile, "textRuns|" & CStr(m_textCount))
    Call BlueprintEmit(lngFile, "textShowOps|" & CStr(m_showCount))
    Call BlueprintEmit(lngFile, "units|PDF points, origin bottom-left")
    Call BlueprintEmit(lngFile, "")

    On Error Resume Next
    Call BlueprintWriteDiagnostics(lngFile)
    Call BlueprintWriteSummary(lngFile, lngPageCount)
    Call BlueprintWriteTable(lngFile, varPages)
    Call BlueprintWriteBoxes(lngFile)
    Call BlueprintWritePrimitives(lngFile)
    Call BlueprintWriteText(lngFile)
    Call BlueprintWriteClipForensics(lngFile)
    Call BlueprintWriteTextShowForensics(lngFile)
    On Error GoTo 0

    Close #lngFile

    ' The digest is a second, much shorter file next to the full report.
    On Error Resume Next
    Call BlueprintWriteDigest( _
        BlueprintDigestPath(strReport), _
        strSource, _
        lngPageCount, _
        varPages)
    On Error GoTo 0

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strReport As String
' Returns:       String
' Description:   Derives the digest file name from the full report file name.
'-------------------------------------------------------------------------------
Private Function BlueprintDigestPath(ByVal strReport As String) As String

    Dim lngDot As Long

    lngDot = InStrRev(strReport, ".")

    If lngDot > 1 Then
        BlueprintDigestPath = Left$(strReport, lngDot - 1) & "_SHORT.txt"
    Else
        BlueprintDigestPath = strReport & "_SHORT.txt"
    End If

End Function

'===============================================================================
' CONTENT STREAM WALKER
'===============================================================================

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strContent As String, lngPageNo As Long
' Returns:       ---
' Description:   Walks one page stream, tracking the graphics state and flushing
'                each pending path with the operator that actually paints it.
'-------------------------------------------------------------------------------
Private Sub BlueprintWalkContent( _
    ByVal strContent As String, _
    ByVal lngPageNo As Long)

    Const METHOD_NAME As String = "BlueprintWalkContent"
    Dim arrKinds() As String
    Dim arrTokens() As String
    Dim blnInText As Boolean
    Dim blnPendingStringSeen As Boolean
    Dim dblCurX As Double
    Dim dblCurY As Double
    Dim dblLineX As Double
    Dim dblLineY As Double
    Dim dblOperand() As Double
    Dim dblFontSize As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim gsCurrent As tGraphicsState
    Dim gsStack() As tGraphicsState
    Dim lngIndex As Long
    Dim lngOperandCount As Long
    Dim lngPendingStringCount As Long
    Dim lngStackTop As Long
    Dim lngTokenCount As Long
    Dim pathBuffer() As tPrimitive
    Dim lngPathCount As Long
    Dim strFontName As String
    Dim strKind As String
    Dim strPendingClip As String
    Dim strPendingText As String
    Dim strToken As String

    On Error GoTo ErrorHandler

    Call BlueprintTokenize(strContent, arrTokens, arrKinds, lngTokenCount)

    If lngTokenCount = 0 Then
        GoTo ExitSub
    End If

    ReDim dblOperand(0 To 15)
    ReDim gsStack(0 To 63)
    ReDim pathBuffer(0 To 511)

    gsCurrent.LineWidth = 1#
    gsCurrent.FillGray = "0"
    gsCurrent.StrokeGray = "0"
    lngStackTop = -1

    For lngIndex = 0 To lngTokenCount - 1
        strToken = arrTokens(lngIndex)
        strKind = arrKinds(lngIndex)

        Select Case strKind
            Case "NUM"
                If lngOperandCount < 16 Then
                    dblOperand(lngOperandCount) = Val(strToken)
                    lngOperandCount = lngOperandCount + 1
                End If

            Case "STR"
                strPendingText = strPendingText & strToken
                blnPendingStringSeen = True
                lngPendingStringCount = lngPendingStringCount + 1

            Case "NAME"
                strFontName = strToken

            Case Else
                Select Case strToken
                    Case "q"
                        If lngStackTop < 63 Then
                            lngStackTop = lngStackTop + 1
                            gsStack(lngStackTop) = gsCurrent
                        End If

                    Case "Q"
                        If lngStackTop >= 0 Then
                            gsCurrent = gsStack(lngStackTop)
                            lngStackTop = lngStackTop - 1
                        End If

                    Case "w"
                        If lngOperandCount >= 1 Then
                            gsCurrent.LineWidth = dblOperand(lngOperandCount - 1)
                        End If

                    Case "g"
                        If lngOperandCount >= 1 Then
                            gsCurrent.FillGray = BlueprintNumText(dblOperand(lngOperandCount - 1))
                        End If

                    Case "G"
                        If lngOperandCount >= 1 Then
                            gsCurrent.StrokeGray = BlueprintNumText(dblOperand(lngOperandCount - 1))
                        End If

                    Case "rg"
                        If lngOperandCount >= 3 Then
                            gsCurrent.FillGray = "RGB"
                        End If

                    Case "RG"
                        If lngOperandCount >= 3 Then
                            gsCurrent.StrokeGray = "RGB"
                        End If

                    Case "m"
                        If lngOperandCount >= 2 Then
                            dblCurX = dblOperand(lngOperandCount - 2)
                            dblCurY = dblOperand(lngOperandCount - 1)
                        End If

                    Case "l"
                        If lngOperandCount >= 2 Then
                            Call BlueprintPushSegment( _
                                pathBuffer, _
                                lngPathCount, _
                                lngPageNo, _
                                dblCurX, _
                                dblCurY, _
                                dblOperand(lngOperandCount - 2), _
                                dblOperand(lngOperandCount - 1), _
                                gsCurrent, _
                                lngIndex, _
                                lngStackTop + 1)

                            dblCurX = dblOperand(lngOperandCount - 2)
                            dblCurY = dblOperand(lngOperandCount - 1)
                        End If

                    Case "re"
                        If lngOperandCount >= 4 Then
                            Call BlueprintPushRectangle( _
                                pathBuffer, _
                                lngPathCount, _
                                lngPageNo, _
                                dblOperand(lngOperandCount - 4), _
                                dblOperand(lngOperandCount - 3), _
                                dblOperand(lngOperandCount - 2), _
                                dblOperand(lngOperandCount - 1), _
                                gsCurrent, _
                                lngIndex, _
                                lngStackTop + 1)
                        End If

                    Case "W", "W*"
                        ' W/W* does not consume the current path. It marks that
                        ' path as the next clipping path; the following painting
                        ' operator (normally n) terminates it.
                        strPendingClip = strToken

                    Case "S", "s", "f", "F", "f*", "B", "B*", "b", "b*", "n"
                        Call BlueprintFlushPath( _
                            pathBuffer, _
                            lngPathCount, _
                            strToken, _
                            strPendingClip, _
                            lngIndex, _
                            gsCurrent)

                        strPendingClip = vbNullString

                    Case "BT"
                        blnInText = True
                        dblLineX = 0#
                        dblLineY = 0#
                        strPendingText = vbNullString
                        blnPendingStringSeen = False
                        lngPendingStringCount = 0

                    Case "ET"
                        blnInText = False

                    Case "Tf"
                        If lngOperandCount >= 1 Then
                            dblFontSize = dblOperand(lngOperandCount - 1)
                        End If

                    Case "Td", "TD"
                        If lngOperandCount >= 2 Then
                            dblLineX = dblLineX + dblOperand(lngOperandCount - 2)
                            dblLineY = dblLineY + dblOperand(lngOperandCount - 1)
                        End If

                    Case "Tm"
                        If lngOperandCount >= 6 Then
                            dblLineX = dblOperand(lngOperandCount - 2)
                            dblLineY = dblOperand(lngOperandCount - 1)
                        End If

                    Case "Tj", "TJ", "'", """"
                        ' V3 records every text-show operator, including an
                        ' explicit empty literal () and whitespace-only strings.
                        ' The legacy m_text collection remains unchanged so the
                        ' existing table/field analysis keeps identical semantics.
                        Call BlueprintAddShow( _
                            lngPageNo, _
                            dblLineX, _
                            dblLineY, _
                            strFontName, _
                            dblFontSize, _
                            strPendingText, _
                            strToken, _
                            blnPendingStringSeen, _
                            lngPendingStringCount, _
                            lngIndex, _
                            lngStackTop + 1, _
                            gsCurrent)

                        If Len(strPendingText) > 0 Then
                            Call BlueprintAddText( _
                                lngPageNo, _
                                dblLineX, _
                                dblLineY, _
                                strFontName, _
                                dblFontSize, _
                                strPendingText, _
                                lngIndex, _
                                lngStackTop + 1, _
                                gsCurrent)
                        End If

                        strPendingText = vbNullString
                        blnPendingStringSeen = False
                        lngPendingStringCount = 0
                End Select

                lngOperandCount = 0
        End Select
    Next lngIndex

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo;tokenIndex", _
        lngPageNo, _
        lngIndex

    errorManager.save
    Resume ExitSub
End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    pathBuffer() As tPrimitive, lngPathCount As Long, ...
' Returns:       ---
' Description:   Buffers one straight segment until its paint operator arrives.
'-------------------------------------------------------------------------------
Private Sub BlueprintPushSegment( _
    ByRef pathBuffer() As tPrimitive, _
    ByRef lngPathCount As Long, _
    ByVal lngPageNo As Long, _
    ByVal dblX1 As Double, _
    ByVal dblY1 As Double, _
    ByVal dblX2 As Double, _
    ByVal dblY2 As Double, _
    ByRef gsCurrent As tGraphicsState, _
    ByVal lngTokenIndex As Long, _
    ByVal lngGraphicsDepth As Long)

    If lngPathCount > UBound(pathBuffer) Then
        ReDim Preserve pathBuffer(0 To lngPathCount + 511)
    End If

    pathBuffer(lngPathCount).PageNo = lngPageNo
    pathBuffer(lngPathCount).Source = "m/l"
    pathBuffer(lngPathCount).GraphicsDepth = lngGraphicsDepth
    pathBuffer(lngPathCount).PathTokenIndex = lngTokenIndex
    pathBuffer(lngPathCount).X1 = dblX1
    pathBuffer(lngPathCount).Y1 = dblY1
    pathBuffer(lngPathCount).X2 = dblX2
    pathBuffer(lngPathCount).Y2 = dblY2
    pathBuffer(lngPathCount).LineWidth = gsCurrent.LineWidth
    pathBuffer(lngPathCount).FillGray = gsCurrent.FillGray
    pathBuffer(lngPathCount).StrokeGray = gsCurrent.StrokeGray

    If Abs(dblX1 - dblX2) <= COORD_TOLERANCE Then
        pathBuffer(lngPathCount).Orientation = "VERTICAL"
    ElseIf Abs(dblY1 - dblY2) <= COORD_TOLERANCE Then
        pathBuffer(lngPathCount).Orientation = "HORIZONTAL"
    Else
        pathBuffer(lngPathCount).Orientation = "DIAGONAL"
    End If

    lngPathCount = lngPathCount + 1

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    pathBuffer() As tPrimitive, lngPathCount As Long, ...
' Returns:       ---
' Description:   Buffers one rectangle subpath until its paint operator arrives.
'-------------------------------------------------------------------------------
Private Sub BlueprintPushRectangle( _
    ByRef pathBuffer() As tPrimitive, _
    ByRef lngPathCount As Long, _
    ByVal lngPageNo As Long, _
    ByVal dblX As Double, _
    ByVal dblY As Double, _
    ByVal dblWidth As Double, _
    ByVal dblHeight As Double, _
    ByRef gsCurrent As tGraphicsState, _
    ByVal lngTokenIndex As Long, _
    ByVal lngGraphicsDepth As Long)

    If lngPathCount > UBound(pathBuffer) Then
        ReDim Preserve pathBuffer(0 To lngPathCount + 511)
    End If

    pathBuffer(lngPathCount).PageNo = lngPageNo
    pathBuffer(lngPathCount).Source = "re"
    pathBuffer(lngPathCount).GraphicsDepth = lngGraphicsDepth
    pathBuffer(lngPathCount).PathTokenIndex = lngTokenIndex
    pathBuffer(lngPathCount).RectX = dblX
    pathBuffer(lngPathCount).RectY = dblY
    pathBuffer(lngPathCount).RectW = dblWidth
    pathBuffer(lngPathCount).RectH = dblHeight
    pathBuffer(lngPathCount).X1 = dblX
    pathBuffer(lngPathCount).Y1 = dblY
    pathBuffer(lngPathCount).X2 = dblX + dblWidth
    pathBuffer(lngPathCount).Y2 = dblY + dblHeight
    pathBuffer(lngPathCount).LineWidth = gsCurrent.LineWidth
    pathBuffer(lngPathCount).FillGray = gsCurrent.FillGray
    pathBuffer(lngPathCount).StrokeGray = gsCurrent.StrokeGray

    If Abs(dblWidth) < RECT_MIN_SIDE And Abs(dblHeight) >= RECT_MIN_SIDE Then
        pathBuffer(lngPathCount).Orientation = "VERTICAL_RULE"
    ElseIf Abs(dblHeight) < RECT_MIN_SIDE And Abs(dblWidth) >= RECT_MIN_SIDE Then
        pathBuffer(lngPathCount).Orientation = "HORIZONTAL_RULE"
    Else
        pathBuffer(lngPathCount).Orientation = "BOX"
    End If

    lngPathCount = lngPathCount + 1

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    pathBuffer() As tPrimitive, lngPathCount As Long, strPaint As String
' Returns:       ---
' Description:   Commits every buffered subpath using the terminating operator.
'-------------------------------------------------------------------------------
Private Sub BlueprintFlushPath( _
    ByRef pathBuffer() As tPrimitive, _
    ByRef lngPathCount As Long, _
    ByVal strPaint As String, _
    ByVal strClipOperator As String, _
    ByVal lngTokenIndex As Long, _
    ByRef gsCurrent As tGraphicsState)

    Dim lngIndex As Long
    Dim strClipSummary As String

    If Len(strClipOperator) > 0 And lngPathCount > 0 Then
        strClipSummary = BlueprintBufferedPathSummary( _
            pathBuffer, _
            lngPathCount, _
            strClipOperator)

        ' Keep the most recently applied clip signature. The effective PDF clip
        ' is an intersection of all active clips, but retaining only the latest
        ' signature keeps the forensic output bounded while q/Q still restores
        ' the correct active-state scope.
        gsCurrent.ClipSummary = strClipSummary

        gsCurrent.ClipActive = True
        gsCurrent.ClipOperator = strClipOperator
        gsCurrent.ClipSetToken = lngTokenIndex
    End If

    For lngIndex = 0 To lngPathCount - 1
        If m_primCount < MAX_PRIMITIVES Then
            m_prim(m_primCount) = pathBuffer(lngIndex)
            m_prim(m_primCount).Paint = strPaint
            m_prim(m_primCount).ClipOperator = strClipOperator
            m_prim(m_primCount).PaintTokenIndex = lngTokenIndex
            m_primCount = m_primCount + 1
        End If
    Next lngIndex

    lngPathCount = 0

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    pathBuffer() As tPrimitive, lngPathCount As Long, strClipOperator As String
' Returns:       String
' Description:   Builds a compact signature of the path that W/W* turns into a
'                clipping path. The signature is also carried into later text
'                runs through the graphics-state stack.
'-------------------------------------------------------------------------------
Private Function BlueprintBufferedPathSummary( _
    ByRef pathBuffer() As tPrimitive, _
    ByVal lngPathCount As Long, _
    ByVal strClipOperator As String) As String

    Const MAX_PARTS As Long = 6
    Dim lngIndex As Long
    Dim lngLimit As Long
    Dim strResult As String

    strResult = strClipOperator & ":"
    lngLimit = lngPathCount

    If lngLimit > MAX_PARTS Then
        lngLimit = MAX_PARTS
    End If

    For lngIndex = 0 To lngLimit - 1
        If lngIndex > 0 Then
            strResult = strResult & ";"
        End If

        If pathBuffer(lngIndex).Source = "re" Then
            strResult = strResult & _
                "re[" & BlueprintNumText(pathBuffer(lngIndex).RectX) & "," & _
                BlueprintNumText(pathBuffer(lngIndex).RectY) & "," & _
                BlueprintNumText(pathBuffer(lngIndex).RectW) & "," & _
                BlueprintNumText(pathBuffer(lngIndex).RectH) & "]"
        Else
            strResult = strResult & _
                "ml[" & BlueprintNumText(pathBuffer(lngIndex).X1) & "," & _
                BlueprintNumText(pathBuffer(lngIndex).Y1) & ">" & _
                BlueprintNumText(pathBuffer(lngIndex).X2) & "," & _
                BlueprintNumText(pathBuffer(lngIndex).Y2) & "]"
        End If
    Next lngIndex

    If lngPathCount > lngLimit Then
        strResult = strResult & ";+" & CStr(lngPathCount - lngLimit) & " more"
    End If

    BlueprintBufferedPathSummary = strResult

End Function


'-------------------------------------------------------------------------------
