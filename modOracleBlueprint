'===============================================================================
' TOKENIZER
'===============================================================================

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strContent As String, arrTokens() As String, arrKinds() As String, lngCount As Long
' Returns:       ---
' Description:   Splits a content stream into typed tokens: NUM, STR, NAME or OP.
'-------------------------------------------------------------------------------
Private Sub BlueprintTokenize( _
    ByVal strContent As String, _
    ByRef arrTokens() As String, _
    ByRef arrKinds() As String, _
    ByRef lngCount As Long)

    Dim lngCapacity As Long
    Dim lngDepth As Long
    Dim lngLength As Long
    Dim lngPos As Long
    Dim lngStart As Long
    Dim strChar As String
    Dim strWord As String

    lngLength = Len(strContent)
    lngCapacity = 4096
    ReDim arrTokens(0 To lngCapacity - 1)
    ReDim arrKinds(0 To lngCapacity - 1)
    lngCount = 0
    lngPos = 1

    Do While lngPos <= lngLength
        strChar = Mid$(strContent, lngPos, 1)

        If strChar = " " Or strChar = vbTab Or strChar = vbCr Or _
           strChar = vbLf Or strChar = Chr$(0) Then
            lngPos = lngPos + 1

        ElseIf strChar = "(" Then
            lngDepth = 1
            lngStart = lngPos + 1
            lngPos = lngPos + 1

            Do While lngPos <= lngLength And lngDepth > 0
                strChar = Mid$(strContent, lngPos, 1)

                If strChar = "\" Then
                    lngPos = lngPos + 2
                Else
                    If strChar = "(" Then
                        lngDepth = lngDepth + 1
                    ElseIf strChar = ")" Then
                        lngDepth = lngDepth - 1
                    End If

                    lngPos = lngPos + 1
                End If
            Loop

            Call BlueprintAddToken( _
                arrTokens, arrKinds, lngCount, lngCapacity, _
                Mid$(strContent, lngStart, lngPos - lngStart - 1), "STR")

        ElseIf strChar = "/" Then
            lngStart = lngPos
            lngPos = lngPos + 1

            Do While lngPos <= lngLength
                strChar = Mid$(strContent, lngPos, 1)

                If InStr(" " & vbTab & vbCr & vbLf & "/[]()<>", strChar) > 0 Then
                    Exit Do
                End If

                lngPos = lngPos + 1
            Loop

            Call BlueprintAddToken( _
                arrTokens, arrKinds, lngCount, lngCapacity, _
                Mid$(strContent, lngStart, lngPos - lngStart), "NAME")

        ElseIf strChar = "[" Or strChar = "]" Or strChar = "<" Or strChar = ">" Then
            lngPos = lngPos + 1

        Else
            lngStart = lngPos

            Do While lngPos <= lngLength
                strChar = Mid$(strContent, lngPos, 1)

                If InStr(" " & vbTab & vbCr & vbLf & "/[]()<>", strChar) > 0 Then
                    Exit Do
                End If

                lngPos = lngPos + 1
            Loop

            strWord = Mid$(strContent, lngStart, lngPos - lngStart)

            If Len(strWord) = 0 Then
                lngPos = lngPos + 1
            Else
                If BlueprintIsNumeric(strWord) Then
                    Call BlueprintAddToken( _
                        arrTokens, arrKinds, lngCount, lngCapacity, strWord, "NUM")
                Else
                    Call BlueprintAddToken( _
                        arrTokens, arrKinds, lngCount, lngCapacity, strWord, "OP")
                End If
            End If
        End If
    Loop

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrTokens() As String, arrKinds() As String, lngCount As Long, lngCapacity As Long, strToken As String, strKind As String
' Returns:       ---
' Description:   Appends one token and grows both parallel arrays when required.
'-------------------------------------------------------------------------------
Private Sub BlueprintAddToken( _
    ByRef arrTokens() As String, _
    ByRef arrKinds() As String, _
    ByRef lngCount As Long, _
    ByRef lngCapacity As Long, _
    ByVal strToken As String, _
    ByVal strKind As String)

    If lngCount >= lngCapacity Then
        lngCapacity = lngCapacity * 2
        ReDim Preserve arrTokens(0 To lngCapacity - 1)
        ReDim Preserve arrKinds(0 To lngCapacity - 1)
    End If

    arrTokens(lngCount) = strToken
    arrKinds(lngCount) = strKind
    lngCount = lngCount + 1

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strValue As String
' Returns:       Boolean
' Description:   Returns whether a token is a PDF real or integer literal.
'-------------------------------------------------------------------------------
Private Function BlueprintIsNumeric(ByVal strValue As String) As Boolean

    Dim blnDigit As Boolean
    Dim lngIndex As Long
    Dim strChar As String

    BlueprintIsNumeric = False

    If Len(strValue) = 0 Then
        Exit Function
    End If

    For lngIndex = 1 To Len(strValue)
        strChar = Mid$(strValue, lngIndex, 1)

        If strChar >= "0" And strChar <= "9" Then
            blnDigit = True
        ElseIf strChar = "." Or strChar = "-" Or strChar = "+" Then
            ' Sign and decimal point are allowed anywhere in a PDF real.
        Else
            Exit Function
        End If
    Next lngIndex

    BlueprintIsNumeric = blnDigit

End Function

'===============================================================================
' PDF OBJECT ACCESS
'===============================================================================

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strPath As String
' Returns:       Byte()
' Description:   Loads the whole file into a byte array.
'-------------------------------------------------------------------------------
Private Function BlueprintReadBytes(ByVal strPath As String) As Byte()

    Dim arrData() As Byte
    Dim lngFile As Long

    lngFile = FreeFile
    Open strPath For Binary Access Read As #lngFile

    If LOF(lngFile) > 0 Then
        ReDim arrData(0 To LOF(lngFile) - 1)
        Get #lngFile, , arrData
    Else
        ReDim arrData(0 To 0)
    End If

    Close #lngFile
    BlueprintReadBytes = arrData

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    ---
' Returns:       ---
' Description:   Indexes every "N G obj" header found in the raw file bytes.
'-------------------------------------------------------------------------------
Private Sub BlueprintBuildObjectIndex()

    Dim lngGenEnd As Long
    Dim lngGenStart As Long
    Dim lngIndex As Long
    Dim lngNumEnd As Long
    Dim lngNumStart As Long
    Dim lngNumber As Long
    Dim lngPos As Long
    Dim lngUpper As Long

    lngUpper = UBound(m_pdf)
    m_objCount = 0
    ReDim m_objNum(0 To 4095)
    ReDim m_objPos(0 To 4095)

    For lngIndex = 1 To lngUpper - 3
        If m_pdf(lngIndex) = 111 And m_pdf(lngIndex + 1) = 98 And _
           m_pdf(lngIndex + 2) = 106 Then

            ' The keyword has to stand alone, otherwise "endobj" matches too.
            If BlueprintIsSpaceByte(m_pdf(lngIndex - 1)) Then
                lngPos = lngIndex - 1

                Do While lngPos >= 0
                    If Not BlueprintIsSpaceByte(m_pdf(lngPos)) Then
                        Exit Do
                    End If

                    lngPos = lngPos - 1
                Loop

                lngGenEnd = lngPos

                Do While lngPos >= 0
                    If m_pdf(lngPos) < 48 Or m_pdf(lngPos) > 57 Then
                        Exit Do
                    End If

                    lngPos = lngPos - 1
                Loop

                lngGenStart = lngPos + 1

                If lngGenEnd >= lngGenStart Then
                    Do While lngPos >= 0
                        If Not BlueprintIsSpaceByte(m_pdf(lngPos)) Then
                            Exit Do
                        End If

                        lngPos = lngPos - 1
                    Loop

                    lngNumEnd = lngPos

                    Do While lngPos >= 0
                        If m_pdf(lngPos) < 48 Or m_pdf(lngPos) > 57 Then
                            Exit Do
                        End If

                        lngPos = lngPos - 1
                    Loop

                    lngNumStart = lngPos + 1

                    ' A digit run longer than a real object number comes from
                    ' binary stream data, not from an object header. Converting it
                    ' would exceed Long and raise an overflow.
                    If lngNumEnd >= lngNumStart And _
                       lngNumEnd - lngNumStart < MAX_OBJECT_NUMBER_DIGITS Then

                        ' Read ONLY the object-number digits. Val() strips blanks,
                        ' so Val("11 0 ") returns 110 rather than 11 and every
                        ' /Kids and /Contents lookup then misses.
                        lngNumber = BlueprintSafeLong( _
                            BlueprintBytesToText(lngNumStart, lngNumEnd))

                        If lngNumber > 0 Then
                            If m_objCount > UBound(m_objNum) Then
                                ReDim Preserve m_objNum(0 To m_objCount + 4095)
                                ReDim Preserve m_objPos(0 To m_objCount + 4095)
                            End If

                            m_objNum(m_objCount) = lngNumber
                            m_objPos(m_objCount) = lngIndex + 3
                            m_objCount = m_objCount + 1
                        End If
                    End If
                End If
            End If
        End If
    Next lngIndex

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strValue As String
' Returns:       Long
' Description:   Converts digits to Long, returning zero instead of overflowing.
'-------------------------------------------------------------------------------
Private Function BlueprintSafeLong(ByVal strValue As String) As Long

    Dim dblValue As Double

    BlueprintSafeLong = 0
    dblValue = Val(Trim$(strValue))

    If dblValue >= 1# And dblValue <= 2147483647# Then
        BlueprintSafeLong = CLng(dblValue)
    End If

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngByte As Long
' Returns:       Boolean
' Description:   Returns whether a byte is PDF whitespace.
'-------------------------------------------------------------------------------
Private Function BlueprintIsSpaceByte(ByVal lngByte As Long) As Boolean

    BlueprintIsSpaceByte = _
        (lngByte = 32 Or lngByte = 9 Or lngByte = 13 Or lngByte = 10 Or lngByte = 0)

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngFrom As Long, lngTo As Long
' Returns:       String
' Description:   Converts a byte range to text, one character per byte.
'-------------------------------------------------------------------------------
Private Function BlueprintBytesToText( _
    ByVal lngFrom As Long, _
    ByVal lngTo As Long) As String

    Dim arrSlice() As Byte
    Dim lngIndex As Long

    If lngTo < lngFrom Then
        BlueprintBytesToText = vbNullString
        Exit Function
    End If

    ReDim arrSlice(0 To lngTo - lngFrom)

    For lngIndex = lngFrom To lngTo
        arrSlice(lngIndex - lngFrom) = m_pdf(lngIndex)
    Next lngIndex

    ' StrConv maps every byte to one character. Only the ASCII range matters for
    ' operators and numbers, and that range is always mapped one to one.
    BlueprintBytesToText = StrConv(arrSlice, vbUnicode)

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngObjNumber As Long
' Returns:       Long
' Description:   Returns the index of one object number, or -1 when absent.
'-------------------------------------------------------------------------------
Private Function BlueprintIndexOfObject(ByVal lngObjNumber As Long) As Long

    Dim lngIndex As Long

    BlueprintIndexOfObject = -1

    ' An incrementally updated PDF redefines objects, so the last definition wins.
    For lngIndex = 0 To m_objCount - 1
        If m_objNum(lngIndex) = lngObjNumber Then
            BlueprintIndexOfObject = lngIndex
        End If
    Next lngIndex

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngObjIndex As Long
' Returns:       String
' Description:   Returns the dictionary text of one object, up to its stream.
'-------------------------------------------------------------------------------
Private Function BlueprintObjectDict(ByVal lngObjIndex As Long) As String

    Const DICT_SCAN_LIMIT As Long = 8192
    Dim lngEnd As Long
    Dim lngStart As Long
    Dim lngStream As Long
    Dim strChunk As String

    lngStart = m_objPos(lngObjIndex)
    lngEnd = lngStart + DICT_SCAN_LIMIT

    If lngEnd > UBound(m_pdf) Then
        lngEnd = UBound(m_pdf)
    End If

    strChunk = BlueprintBytesToText(lngStart, lngEnd)
    lngStream = InStr(strChunk, "stream")

    If lngStream > 0 Then
        strChunk = Left$(strChunk, lngStream - 1)
    End If

    BlueprintObjectDict = strChunk

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    ---
' Returns:       Variant
' Description:   Returns the page object numbers, preferring the /Kids order.
'-------------------------------------------------------------------------------
Private Function BlueprintPageObjectNumbers() As Variant

    Dim arrResult() As Long
    Dim lngCount As Long
    Dim lngIndex As Long
    Dim strDict As String
    Dim strKids As String
    Dim varKids As Variant

    ' First attempt: the /Kids array of the page tree keeps the printed order.
    For lngIndex = 0 To m_objCount - 1
        strDict = BlueprintObjectDict(lngIndex)

        If InStr(strDict, "/Type") > 0 And InStr(strDict, "/Pages") > 0 Then
            strKids = BlueprintKeyValueRaw(strDict, "/Kids")

            If Len(strKids) > 0 Then
                varKids = BlueprintReferenceNumbers(strKids)

                If IsArray(varKids) Then
                    If UBound(varKids) >= 0 Then
                        BlueprintPageObjectNumbers = varKids
                        Exit Function
                    End If
                End If
            End If
        End If
    Next lngIndex

    ' Fallback: document order of every /Type /Page object.
    ReDim arrResult(0 To m_objCount)

    For lngIndex = 0 To m_objCount - 1
        strDict = BlueprintObjectDict(lngIndex)

        If InStr(strDict, "/Type") > 0 And InStr(strDict, "/Page") > 0 Then
            If InStr(strDict, "/Pages") = 0 Then
                arrResult(lngCount) = m_objNum(lngIndex)
                lngCount = lngCount + 1
            End If
        End If
    Next lngIndex

    If lngCount = 0 Then
        BlueprintPageObjectNumbers = Empty
    Else
        ReDim Preserve arrResult(0 To lngCount - 1)
        BlueprintPageObjectNumbers = arrResult
    End If

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strDict As String, strKey As String
' Returns:       String
' Description:   Returns the bracketed value that follows one dictionary key.
'-------------------------------------------------------------------------------
Private Function BlueprintExtractBracketed( _
    ByVal strDict As String, _
    ByVal strKey As String) As String

    Dim lngClose As Long
    Dim lngKey As Long
    Dim lngOpen As Long

    BlueprintExtractBracketed = vbNullString
    lngKey = InStr(strDict, strKey)

    If lngKey = 0 Then
        Exit Function
    End If

    lngOpen = InStr(lngKey, strDict, "[")

    If lngOpen = 0 Then
        Exit Function
    End If

    lngClose = InStr(lngOpen, strDict, "]")

    If lngClose = 0 Then
        Exit Function
    End If

    BlueprintExtractBracketed = Mid$(strDict, lngOpen + 1, lngClose - lngOpen - 1)

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strValue As String
' Returns:       Variant
' Description:   Extracts every "N G R" object number from a reference list.
'-------------------------------------------------------------------------------
Private Function BlueprintReferenceNumbers(ByVal strValue As String) As Variant

    Dim arrParts As Variant
    Dim arrResult() As Long
    Dim lngCount As Long
    Dim lngIndex As Long
    Dim strNormalized As String

    strNormalized = Replace(strValue, vbCr, " ")
    strNormalized = Replace(strNormalized, vbLf, " ")
    strNormalized = Trim$(strNormalized)

    Do While InStr(strNormalized, "  ") > 0
        strNormalized = Replace(strNormalized, "  ", " ")
    Loop

    arrParts = Split(strNormalized, " ")
    ReDim arrResult(0 To UBound(arrParts) + 1)

    For lngIndex = LBound(arrParts) To UBound(arrParts)
        If UCase$(Trim$(CStr(arrParts(lngIndex)))) = "R" And lngIndex >= 2 Then
            arrResult(lngCount) = BlueprintSafeLong(CStr(arrParts(lngIndex - 2)))
            lngCount = lngCount + 1
        End If
    Next lngIndex

    If lngCount = 0 Then
        BlueprintReferenceNumbers = Empty
    Else
        ReDim Preserve arrResult(0 To lngCount - 1)
        BlueprintReferenceNumbers = arrResult
    End If

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngPageObjNumber As Long, lngPageOrdinal As Long
' Returns:       String
' Description:   Returns the decoded content of one page, joining every part.
'-------------------------------------------------------------------------------
Private Function BlueprintPageContent( _
    ByVal lngPageObjNumber As Long, _
    ByVal lngPageOrdinal As Long) As String

    Dim errDescription As String
    Dim errNumber As Long
    Dim lngIndex As Long
    Dim lngObjIndex As Long
    Dim strContents As String
    Dim strDict As String
    Dim strPart As String
    Dim strResult As String
    Dim varRefs As Variant

    On Error GoTo ErrorHandler

    lngObjIndex = BlueprintIndexOfObject(lngPageObjNumber)

    If lngObjIndex < 0 Then
        Call BlueprintLogDiag("PAGE|" & CStr(lngPageOrdinal) & _
            "|obj=" & CStr(lngPageObjNumber) & "|ERROR=page object not in index")
        GoTo ExitFunction
    End If

    strDict = BlueprintObjectDict(lngObjIndex)

    ' The value of /Contents is either a direct reference or an array of them.
    ' It must be read immediately after the key: searching for the next "["
    ' anywhere in the dictionary picks up /ProcSet or /Annots instead.
    strContents = BlueprintKeyValueRaw(strDict, "/Contents")
    varRefs = BlueprintReferenceNumbers(strContents)

    If Not IsArray(varRefs) Then
        Call BlueprintLogDiag("PAGE|" & CStr(lngPageOrdinal) & _
            "|obj=" & CStr(lngPageObjNumber) & _
            "|ERROR=no /Contents reference resolved" & _
            "|rawValue=" & BlueprintSanitize(Left$(strContents, 80)))
        GoTo ExitFunction
    End If

    For lngIndex = LBound(varRefs) To UBound(varRefs)
        strPart = BlueprintStreamText(CLng(varRefs(lngIndex)), lngPageOrdinal)

        ' Appending a separator for an empty part would report decodedChars=1
        ' for a page that actually decoded nothing.
        If Len(strPart) > 0 Then
            strResult = strResult & strPart & vbLf
        End If
    Next lngIndex

    Call BlueprintLogDiag("PAGE|" & CStr(lngPageOrdinal) & _
        "|obj=" & CStr(lngPageObjNumber) & _
        "|contentRefs=" & CStr(UBound(varRefs) - LBound(varRefs) + 1) & _
        "|decodedChars=" & CStr(Len(strResult)))

    BlueprintPageContent = strResult

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    Call BlueprintLogDiag("PAGE|" & CStr(lngPageOrdinal) & _
        "|obj=" & CStr(lngPageObjNumber) & _
        "|ERROR=" & CStr(errNumber) & " " & BlueprintSanitize(errDescription))

    BlueprintPageContent = strResult
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strDict As String, strKey As String
' Returns:       String
' Description:   Returns the value that directly follows one dictionary key,
'                accepting an array only when it opens immediately after it.
'-------------------------------------------------------------------------------
Private Function BlueprintKeyValueRaw( _
    ByVal strDict As String, _
    ByVal strKey As String) As String

    Dim lngClose As Long
    Dim lngKey As Long
    Dim lngPos As Long
    Dim strChar As String

    lngKey = InStr(strDict, strKey)

    If lngKey = 0 Then
        Exit Function
    End If

    lngPos = lngKey + Len(strKey)

    Do While lngPos <= Len(strDict)
        strChar = Mid$(strDict, lngPos, 1)

        If strChar <> " " And strChar <> vbTab And _
           strChar <> vbCr And strChar <> vbLf Then
            Exit Do
        End If

        lngPos = lngPos + 1
    Loop

    If lngPos > Len(strDict) Then
        Exit Function
    End If

    If Mid$(strDict, lngPos, 1) = "[" Then
        lngClose = InStr(lngPos, strDict, "]")

        If lngClose = 0 Then
            Exit Function
        End If

        BlueprintKeyValueRaw = Mid$(strDict, lngPos + 1, lngClose - lngPos - 1)
    Else
        BlueprintKeyValueRaw = Mid$(strDict, lngPos, 48)
    End If

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strLine As String
' Returns:       ---
' Description:   Records one diagnostic line for the report.
'-------------------------------------------------------------------------------
Private Sub BlueprintLogDiag(ByVal strLine As String)

    If m_diagCount > UBound(m_diag) Then
        Exit Sub
    End If

    m_diag(m_diagCount) = strLine
    m_diagCount = m_diagCount + 1

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngFile As Long
' Returns:       ---
' Description:   Writes why each page did or did not yield a content stream.
'-------------------------------------------------------------------------------
Private Function BlueprintObjectNumberSample() As String

    Dim lngIndex As Long
    Dim lngLimit As Long
    Dim strResult As String

    lngLimit = m_objCount - 1

    If lngLimit > 19 Then
        lngLimit = 19
    End If

    For lngIndex = 0 To lngLimit
        strResult = strResult & CStr(m_objNum(lngIndex)) & " "
    Next lngIndex

    If m_objCount > 20 Then
        strResult = strResult & "..."
    End If

    BlueprintObjectNumberSample = Trim$(strResult)

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngFile As Long
' Returns:       ---
' Description:   Writes why each page did or did not yield a content stream.
'-------------------------------------------------------------------------------
Private Sub BlueprintWriteDiagnostics(ByVal lngFile As Long)

    Dim lngIndex As Long

    Call BlueprintEmit(lngFile, "===== SECTION 1 - DIAGNOSTICS =====")
    Call BlueprintEmit(lngFile, "read|Every page must report decodedChars > 0. " & _
        "A zero there means the stream was never decoded and every counter below " & _
        "is meaningless rather than small.")
    Call BlueprintEmit(lngFile, "objectsIndexed|" & CStr(m_objCount))
    Call BlueprintEmit(lngFile, "objectNumbers|" & BlueprintObjectNumberSample())
    Call BlueprintEmit(lngFile, "")

    For lngIndex = 0 To m_diagCount - 1
        Call BlueprintEmit(lngFile, "  " & m_diag(lngIndex))
    Next lngIndex

    Call BlueprintEmit(lngFile, "")

End Sub

