'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    prim As tPrimitive
' Returns:       String
' Description:   Classifies path semantics, distinguishing plain re n from
'                clipping rectangles terminated by n.
'-------------------------------------------------------------------------------
Private Function BlueprintPrimitiveClass( _
    ByRef prim As tPrimitive) As String

    If prim.Source = "re" And prim.Paint = "n" Then
        Select Case prim.ClipOperator
            Case "W"
                BlueprintPrimitiveClass = "CLIP_RE_W_N"
            Case "W*"
                BlueprintPrimitiveClass = "CLIP_RE_WSTAR_N"
            Case Else
                BlueprintPrimitiveClass = "PLAIN_RE_N"
        End Select
    ElseIf Len(prim.ClipOperator) > 0 Then
        BlueprintPrimitiveClass = _
            "CLIP_" & Replace(UCase$(prim.Source), "/", "_") & "_" & _
            Replace(prim.ClipOperator, "*", "STAR") & "_" & UCase$(prim.Paint)
    Else
        BlueprintPrimitiveClass = _
            "PLAIN_" & Replace(UCase$(prim.Source), "/", "_") & "_" & UCase$(prim.Paint)
    End If

End Function

