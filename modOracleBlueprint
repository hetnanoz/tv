Private Function BlueprintPageMediaBox(ByVal lngPageObjNumber As Long) As String

    Dim lngObjIndex As Long
    Dim strBox As String

    BlueprintPageMediaBox = "(not declared on the page object)"
    lngObjIndex = BlueprintIndexOfObject(lngPageObjNumber)

    If lngObjIndex < 0 Then
        Exit Function
    End If

    strBox = BlueprintExtractBracketed(BlueprintObjectDict(lngObjIndex), "/MediaBox")

    If Len(Trim$(strBox)) > 0 Then
        BlueprintPageMediaBox = Trim$(strBox)
    End If

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngPageObjNumber As Long
' Returns:       String
' Description:   Returns every font resource of one page with the raw and the
'                decoded /BaseFont, so #xx serialisation stays visible.
'-------------------------------------------------------------------------------
Private Function BlueprintFontResources(ByVal lngPageObjNumber As Long) As String

    Dim arrParts As Variant
    Dim lngFontKey As Long
    Dim lngIndex As Long
    Dim lngObjIndex As Long
    Dim lngTarget As Long
    Dim strBase As String
    Dim strDict As String
    Dim strFontBlock As String
    Dim strResult As String

    BlueprintFontResources = "(no /Font resource found)"
    lngObjIndex = BlueprintIndexOfObject(lngPageObjNumber)

    If lngObjIndex < 0 Then
        Exit Function
    End If

    strDict = BlueprintObjectDict(lngObjIndex)
    lngFontKey = InStr(strDict, "/Font")

    If lngFontKey = 0 Then
        Exit Function
    End If

    strFontBlock = Mid$(strDict, lngFontKey, 400)
    strFontBlock = Replace(strFontBlock, vbCr, " ")
    strFontBlock = Replace(strFontBlock, vbLf, " ")
    strFontBlock = Replace(strFontBlock, "<<", " ")
    strFontBlock = Replace(strFontBlock, ">>", " ")

    Do While InStr(strFontBlock, "  ") > 0
        strFontBlock = Replace(strFontBlock, "  ", " ")
    Loop

    arrParts = Split(Trim$(strFontBlock), " ")

    For lngIndex = LBound(arrParts) To UBound(arrParts)
        If UCase$(Trim$(CStr(arrParts(lngIndex)))) = "R" And lngIndex >= 3 Then
            lngTarget = BlueprintIndexOfObject(CLng(Val(CStr(arrParts(lngIndex - 2)))))

            If lngTarget >= 0 Then
                strBase = BlueprintValueAfterKey( _
                    BlueprintObjectDict(lngTarget), "/BaseFont")
                strBase = Trim$(Split(Trim$(strBase) & " ", " ")(0))

                strResult = strResult & CStr(arrParts(lngIndex - 3)) & _
                    "=raw:" & strBase & _
                    ",decoded:" & BlueprintDecodeName(strBase) & "  "
            End If
        End If
    Next lngIndex

    If Len(strResult) > 0 Then
        BlueprintFontResources = Trim$(strResult)
    End If

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strName As String
' Returns:       String
' Description:   Resolves the #xx escapes used inside PDF name objects.
'-------------------------------------------------------------------------------
Private Function BlueprintDecodeName(ByVal strName As String) As String

    Dim lngIndex As Long
    Dim strChar As String
    Dim strResult As String

    lngIndex = 1

    Do While lngIndex <= Len(strName)
        strChar = Mid$(strName, lngIndex, 1)

        If strChar = "#" And lngIndex + 2 <= Len(strName) Then
            strResult = strResult & Chr$(CLng("&H" & Mid$(strName, lngIndex + 1, 2)))
            lngIndex = lngIndex + 3
        Else
            strResult = strResult & strChar
            lngIndex = lngIndex + 1
        End If
    Loop

    BlueprintDecodeName = strResult

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    ---
' Returns:       String
' Description:   Returns the /Producer and /Creator entries of the document.
'-------------------------------------------------------------------------------
Private Function BlueprintInfoDictionary() As String

    Dim lngIndex As Long
    Dim strDict As String
    Dim strResult As String

    strResult = "PRODUCER=(absent)|CREATOR=(absent)"

    For lngIndex = 0 To m_objCount - 1
        strDict = BlueprintObjectDict(lngIndex)

        If InStr(strDict, "/Producer") > 0 Or InStr(strDict, "/Creator") > 0 Then
            strResult = _
                "PRODUCER=" & BlueprintParenValue(strDict, "/Producer") & _
                "|CREATOR=" & BlueprintParenValue(strDict, "/Creator")
            Exit For
        End If
    Next lngIndex

    BlueprintInfoDictionary = strResult

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strDict As String, strKey As String
' Returns:       String
' Description:   Returns the parenthesised string value of one dictionary key.
'-------------------------------------------------------------------------------
Private Function BlueprintParenValue( _
    ByVal strDict As String, _
    ByVal strKey As String) As String

    Dim lngClose As Long
    Dim lngKey As Long
    Dim lngOpen As Long

    BlueprintParenValue = "(absent)"
    lngKey = InStr(strDict, strKey)

    If lngKey = 0 Then
        Exit Function
    End If

    lngOpen = InStr(lngKey, strDict, "(")

    If lngOpen = 0 Then
        Exit Function
    End If

    lngClose = InStr(lngOpen, strDict, ")")

    If lngClose = 0 Then
        Exit Function
    End If

    BlueprintParenValue = Mid$(strDict, lngOpen + 1, lngClose - lngOpen - 1)

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrValues() As Double, lngCount As Long, dblValue As Double
' Returns:       ---
' Description:   Appends one coordinate unless an equal one is already present.
'-------------------------------------------------------------------------------
Private Sub BlueprintAddDistinct( _
    ByRef arrValues() As Double, _
    ByRef lngCount As Long, _
    ByVal dblValue As Double)

    Dim lngIndex As Long

    For lngIndex = 0 To lngCount - 1
        If Abs(arrValues(lngIndex) - dblValue) <= COORD_TOLERANCE Then
            Exit Sub
        End If
    Next lngIndex

    If lngCount > UBound(arrValues) Then
        Exit Sub
    End If

    arrValues(lngCount) = dblValue
    lngCount = lngCount + 1

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrValues() As Double, lngCount As Long
' Returns:       ---
' Description:   Sorts one coordinate list ascending.
'-------------------------------------------------------------------------------
Private Sub BlueprintSortDoubles( _
    ByRef arrValues() As Double, _
    ByVal lngCount As Long)

    Dim dblSwap As Double
    Dim lngInner As Long
    Dim lngOuter As Long

    For lngOuter = 0 To lngCount - 2
        For lngInner = 0 To lngCount - 2 - lngOuter
            If arrValues(lngInner) > arrValues(lngInner + 1) Then
                dblSwap = arrValues(lngInner)
                arrValues(lngInner) = arrValues(lngInner + 1)
                arrValues(lngInner + 1) = dblSwap
            End If
        Next lngInner
    Next lngOuter

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrValues() As Double, lngCount As Long
' Returns:       String
' Description:   Formats a coordinate list as a spaced, readable line.
'-------------------------------------------------------------------------------
Private Function BlueprintDoubleList( _
    ByRef arrValues() As Double, _
    ByVal lngCount As Long) As String

    Dim lngIndex As Long
    Dim strResult As String

    For lngIndex = 0 To lngCount - 1
        strResult = strResult & BlueprintNumText(arrValues(lngIndex)) & " "
    Next lngIndex

    BlueprintDoubleList = Trim$(strResult)

End Function

