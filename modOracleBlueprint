Private Function BlueprintMaxPage() As Long

    Dim lngIndex As Long

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).PageNo > BlueprintMaxPage Then
            BlueprintMaxPage = m_prim(lngIndex).PageNo
        End If
    Next lngIndex

