'-------------------------------------------------------------------------------
Private Function BlueprintFileBaseName(ByVal strPath As String) As String

    Dim lngDot As Long
    Dim strName As String

    strName = Mid$(strPath, InStrRev(strPath, "\") + 1)
    lngDot = InStrRev(strName, ".")

    If lngDot > 1 Then
        strName = Left$(strName, lngDot - 1)
    End If

    BlueprintFileBaseName = strName

End Function

