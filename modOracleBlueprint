'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngFile As Long
' Returns:       ---
' Description:   Writes clip-aware evidence. This is the key section for deciding
'                whether Oracle's apparent "re n" rectangles are plain invisible
'                paths or real W/W* clipping paths used to delimit text cells.
'-------------------------------------------------------------------------------
Private Sub BlueprintWriteClipForensics(ByVal lngFile As Long)

    Dim blnCarriesToShow As Boolean
    Dim blnCarriesToText As Boolean
    Dim blnDirectBeforeShow As Boolean
    Dim blnDirectBeforeText As Boolean
    Dim lngAllClip As Long
    Dim lngClipOther As Long
    Dim lngClipWN As Long
    Dim lngClipWStarN As Long
    Dim lngIndex As Long
    Dim lngNextShow As Long
    Dim lngNextText As Long
    Dim lngPlainN As Long
    Dim lngReNTotal As Long
    Dim lngTextClipped As Long
    Dim strClass As String
    Dim strLine As String

    For lngIndex = 0 To m_primCount - 1
        If Len(m_prim(lngIndex).ClipOperator) > 0 Then
            lngAllClip = lngAllClip + 1
        End If

        If m_prim(lngIndex).Source = "re" And m_prim(lngIndex).Paint = "n" Then
            lngReNTotal = lngReNTotal + 1
            strClass = BlueprintPrimitiveClass(m_prim(lngIndex))

            Select Case strClass
                Case "PLAIN_RE_N"
                    lngPlainN = lngPlainN + 1
                Case "CLIP_RE_W_N"
                    lngClipWN = lngClipWN + 1
                Case "CLIP_RE_WSTAR_N"
                    lngClipWStarN = lngClipWStarN + 1
                Case Else
                    lngClipOther = lngClipOther + 1
            End Select
        End If
    Next lngIndex

    For lngIndex = 0 To m_textCount - 1
        If m_text(lngIndex).ClipActive Then
            lngTextClipped = lngTextClipped + 1
        End If
    Next lngIndex

    Call BlueprintEmit(lngFile, "===== SECTION 7 - CLIP PATH FORENSICS =====")
    Call BlueprintEmit(lngFile, "purpose|Separate plain re n from re W n / re W* n. " & _
        "PDF clipping is part of graphics state and survives until Q restores the prior state.")
    Call BlueprintEmit(lngFile, "COUNTS|re_n_total=" & CStr(lngReNTotal) & _
        "|plain_re_n=" & CStr(lngPlainN) & _
        "|clip_re_W_n=" & CStr(lngClipWN) & _
        "|clip_re_Wstar_n=" & CStr(lngClipWStarN) & _
        "|clip_other_n=" & CStr(lngClipOther) & _
        "|all_clip_subpaths=" & CStr(lngAllClip) & _
        "|texts_with_active_clip=" & CStr(lngTextClipped) & _
        "|shows_with_active_clip=" & CStr(BlueprintShowClipCount()))
    Call BlueprintEmit(lngFile, "classification|PLAIN_RE_N = re ... n without W/W*. " & _
        "CLIP_RE_W_N / CLIP_RE_WSTAR_N = the same rectangle also changes the clipping path.")
    Call BlueprintEmit(lngFile, "")

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).Source = "re" And _
           (m_prim(lngIndex).Paint = "n" Or Len(m_prim(lngIndex).ClipOperator) > 0) Then

            lngNextText = BlueprintFindNextTextForPrimitive(lngIndex)
            lngNextShow = BlueprintFindNextShowForPrimitive(lngIndex)
            blnDirectBeforeText = False
            blnCarriesToText = False
            blnDirectBeforeShow = False
            blnCarriesToShow = False

            If lngNextShow >= 0 Then
                blnDirectBeforeShow = BlueprintIsLastPathBeforeShow(lngIndex, lngNextShow)

                If m_show(lngNextShow).ClipActive Then
                    blnCarriesToShow = _
                        (m_show(lngNextShow).ClipSetToken >= m_prim(lngIndex).PaintTokenIndex)
                End If
            End If

            If lngNextText >= 0 Then
                blnDirectBeforeText = BlueprintIsLastPathBeforeText(lngIndex, lngNextText)

                If m_text(lngNextText).ClipActive Then
                    blnCarriesToText = _
                        (m_text(lngNextText).ClipSetToken >= m_prim(lngIndex).PaintTokenIndex)
                End If
            End If

            strLine = _
                "CLIPPATH|page=" & CStr(m_prim(lngIndex).PageNo) & _
                "|class=" & BlueprintPrimitiveClass(m_prim(lngIndex)) & _
                "|clipOp=" & BlueprintNullLabel(m_prim(lngIndex).ClipOperator) & _
                "|paint=" & m_prim(lngIndex).Paint & _
                "|x=" & BlueprintNumText(m_prim(lngIndex).RectX) & _
                "|y=" & BlueprintNumText(m_prim(lngIndex).RectY) & _
                "|w=" & BlueprintNumText(m_prim(lngIndex).RectW) & _
                "|h=" & BlueprintNumText(m_prim(lngIndex).RectH) & _
                "|x2=" & BlueprintNumText(m_prim(lngIndex).RectX + m_prim(lngIndex).RectW) & _
                "|y2=" & BlueprintNumText(m_prim(lngIndex).RectY + m_prim(lngIndex).RectH) & _
                "|gsDepth=" & CStr(m_prim(lngIndex).GraphicsDepth) & _
                "|pathTok=" & CStr(m_prim(lngIndex).PathTokenIndex) & _
                "|paintTok=" & CStr(m_prim(lngIndex).PaintTokenIndex)

            If lngNextText >= 0 Then
                strLine = strLine & _
                    "|nextTextTok=" & CStr(m_text(lngNextText).TokenIndex) & _
                    "|tokenGap=" & CStr(m_text(lngNextText).TokenIndex - _
                        m_prim(lngIndex).PaintTokenIndex) & _
                    "|directBeforeText=" & BlueprintBoolText(blnDirectBeforeText) & _
                    "|clipCarriesToText=" & BlueprintBoolText(blnCarriesToText) & _
                    "|nextTextGsDepth=" & CStr(m_text(lngNextText).GraphicsDepth) & _
                    "|nextTextClipActive=" & BlueprintBoolText(m_text(lngNextText).ClipActive) & _
                    "|nextTextClipOp=" & BlueprintNullLabel(m_text(lngNextText).ClipOperator) & _
                    "|nextTextX=" & BlueprintNumText(m_text(lngNextText).X) & _
                    "|nextTextY=" & BlueprintNumText(m_text(lngNextText).Y) & _
                    "|nextTextFont=" & m_text(lngNextText).FontName & _
                    "|nextTextSize=" & BlueprintNumText(m_text(lngNextText).FontSize) & _
                    "|nextText=" & BlueprintSanitize(m_text(lngNextText).TextValue)
            Else
                strLine = strLine & "|nextText=(none)"
            End If

            If lngNextShow >= 0 Then
                strLine = strLine & _
                    "|nextShowTok=" & CStr(m_show(lngNextShow).TokenIndex) & _
                    "|showGap=" & CStr(m_show(lngNextShow).TokenIndex - _
                        m_prim(lngIndex).PaintTokenIndex) & _
                    "|directBeforeShow=" & BlueprintBoolText(blnDirectBeforeShow) & _
                    "|clipCarriesToShow=" & BlueprintBoolText(blnCarriesToShow) & _
                    "|nextShowClass=" & BlueprintTextShowClass(m_show(lngNextShow)) & _
                    "|nextShowOp=" & m_show(lngNextShow).ShowOperator & _
                    "|nextShowX=" & BlueprintNumText(m_show(lngNextShow).X) & _
                    "|nextShowY=" & BlueprintNumText(m_show(lngNextShow).Y) & _
                    "|nextShowFont=" & m_show(lngNextShow).FontName & _
                    "|nextShowSize=" & BlueprintNumText(m_show(lngNextShow).FontSize) & _
                    "|nextShowMarker=" & BlueprintVisibleMarker(m_show(lngNextShow).DecodedValue)
            Else
                strLine = strLine & "|nextShow=(none)"
            End If

            Call BlueprintEmit(lngFile, strLine)
        End If
    Next lngIndex

    Call BlueprintEmit(lngFile, "")

End Sub

