' Description:   Formats a number with a dot separator regardless of locale.
'-------------------------------------------------------------------------------
Private Function BlueprintNumText(ByVal dblValue As Double) As String

    BlueprintNumText = Replace(Format$(dblValue, "0.####"), ",", ".")

End Function

