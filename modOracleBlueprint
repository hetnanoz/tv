'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    lngPrimitiveIndex As Long
' Returns:       Long
' Description:   Finds the first later text-show operator, including () Tj.
'-------------------------------------------------------------------------------
Private Function BlueprintFindNextShowForPrimitive( _
    ByVal lngPrimitiveIndex As Long) As Long

    Dim lngBestToken As Long
    Dim lngIndex As Long
    Dim lngPaintToken As Long
    Dim lngPageNo As Long

    BlueprintFindNextShowForPrimitive = -1
    lngBestToken = 2147483647
    lngPageNo = m_prim(lngPrimitiveIndex).PageNo
    lngPaintToken = m_prim(lngPrimitiveIndex).PaintTokenIndex

    For lngIndex = 0 To m_showCount - 1
        If m_show(lngIndex).PageNo = lngPageNo Then
            If m_show(lngIndex).TokenIndex > lngPaintToken And _
               m_show(lngIndex).TokenIndex < lngBestToken Then

                lngBestToken = m_show(lngIndex).TokenIndex
                BlueprintFindNextShowForPrimitive = lngIndex
            End If
        End If
    Next lngIndex

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    lngPrimitiveIndex As Long, lngShowIndex As Long
' Returns:       Boolean
' Description:   TRUE when no later completed path exists before the show op.
'-------------------------------------------------------------------------------
Private Function BlueprintIsLastPathBeforeShow( _
    ByVal lngPrimitiveIndex As Long, _
    ByVal lngShowIndex As Long) As Boolean

    Dim lngIndex As Long
    Dim lngPaintToken As Long
    Dim lngPageNo As Long
    Dim lngShowToken As Long

    BlueprintIsLastPathBeforeShow = True
    lngPageNo = m_prim(lngPrimitiveIndex).PageNo
    lngPaintToken = m_prim(lngPrimitiveIndex).PaintTokenIndex
    lngShowToken = m_show(lngShowIndex).TokenIndex

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).PageNo = lngPageNo Then
            If m_prim(lngIndex).PaintTokenIndex > lngPaintToken And _
               m_prim(lngIndex).PaintTokenIndex < lngShowToken Then

                BlueprintIsLastPathBeforeShow = False
                Exit Function
            End If
        End If
    Next lngIndex

End Function

