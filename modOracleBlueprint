'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngFile As Long
' Returns:       ---
' Description:   Clusters rectangles into row bands so that invisible cell boxes
'                become directly comparable between two PDFs.
'-------------------------------------------------------------------------------
Private Sub BlueprintWriteBoxes(ByVal lngFile As Long)

    Dim arrBandTop() As Double
    Dim arrBandBottom() As Double
    Dim blnMatched As Boolean
    Dim dblBottom As Double
    Dim dblTop As Double
    Dim lngBand As Long
    Dim lngBandCount As Long
    Dim lngIndex As Long
    Dim lngPage As Long
    Dim lngPageMax As Long
    Dim strInvisible As String
    Dim strVisible As String

    Call BlueprintEmit(lngFile, "===== SECTION 4 - BOXES BY ROW BAND =====")
    Call BlueprintEmit(lngFile, "purpose|Compare INVISIBLE box X-lists between " & _
        "the Oracle original and the generated PDF. A band present in OLD but " & _
        "missing in NEW is a cell the parser can no longer delimit.")
    Call BlueprintEmit(lngFile, "")

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).PageNo > lngPageMax Then
            lngPageMax = m_prim(lngIndex).PageNo
        End If
    Next lngIndex

    For lngPage = 1 To lngPageMax
        lngBandCount = 0
        ReDim arrBandTop(0 To 255)
        ReDim arrBandBottom(0 To 255)

        ' Collect the distinct vertical bands occupied by real boxes.
        For lngIndex = 0 To m_primCount - 1
            If m_prim(lngIndex).PageNo = lngPage And _
               m_prim(lngIndex).Source = "re" And _
               m_prim(lngIndex).Orientation = "BOX" Then

                dblBottom = m_prim(lngIndex).RectY
                dblTop = m_prim(lngIndex).RectY + m_prim(lngIndex).RectH
                blnMatched = False

                For lngBand = 0 To lngBandCount - 1
                    If Abs(arrBandBottom(lngBand) - dblBottom) <= BAND_TOLERANCE And _
                       Abs(arrBandTop(lngBand) - dblTop) <= BAND_TOLERANCE Then

                        blnMatched = True
                        Exit For
                    End If
                Next lngBand

                If Not blnMatched And lngBandCount <= 255 Then
                    arrBandBottom(lngBandCount) = dblBottom
                    arrBandTop(lngBandCount) = dblTop
                    lngBandCount = lngBandCount + 1
                End If
            End If
        Next lngIndex

        Call BlueprintEmit(lngFile, "PAGE|" & CStr(lngPage) & _
            "|bands=" & CStr(lngBandCount))

        For lngBand = 0 To lngBandCount - 1
            strVisible = vbNullString
            strInvisible = vbNullString

            For lngIndex = 0 To m_primCount - 1
                If m_prim(lngIndex).PageNo = lngPage And _
                   m_prim(lngIndex).Source = "re" And _
                   m_prim(lngIndex).Orientation = "BOX" Then

                    If Abs(m_prim(lngIndex).RectY - arrBandBottom(lngBand)) <= BAND_TOLERANCE And _
                       Abs(m_prim(lngIndex).RectY + m_prim(lngIndex).RectH - _
                           arrBandTop(lngBand)) <= BAND_TOLERANCE Then

                        If m_prim(lngIndex).Paint = "n" Then
                            strInvisible = strInvisible & _
                                BlueprintNumText(m_prim(lngIndex).RectX) & ".." & _
                                BlueprintNumText(m_prim(lngIndex).RectX + _
                                    m_prim(lngIndex).RectW) & " "
                        Else
                            strVisible = strVisible & _
                                BlueprintNumText(m_prim(lngIndex).RectX) & ".." & _
                                BlueprintNumText(m_prim(lngIndex).RectX + _
                                    m_prim(lngIndex).RectW) & _
                                "(" & m_prim(lngIndex).Paint & ") "
                        End If
                    End If
                End If
            Next lngIndex

            Call BlueprintEmit(lngFile, _
                "  BAND|y=" & BlueprintNumText(arrBandBottom(lngBand)) & ".." & _
                BlueprintNumText(arrBandTop(lngBand)) & _
                "|height=" & BlueprintNumText(arrBandTop(lngBand) - _
                    arrBandBottom(lngBand)))

            Call BlueprintEmit(lngFile, "    INVISIBLE_X|" & Trim$(strInvisible))
            Call BlueprintEmit(lngFile, "    VISIBLE_X  |" & Trim$(strVisible))
        Next lngBand

        Call BlueprintEmit(lngFile, "")
    Next lngPage

End Sub

