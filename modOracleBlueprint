Private Function BlueprintValueAfterKey( _
    ByVal strDict As String, _
    ByVal strKey As String) As String

    Dim lngKey As Long

    lngKey = InStr(strDict, strKey)

    If lngKey = 0 Then
        Exit Function
    End If

    BlueprintValueAfterKey = Mid$(strDict, lngKey + Len(strKey), 40)

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngObjNumber As Long, lngPageOrdinal As Long
' Returns:       String
' Description:   Returns one stream object fully decoded through its filter chain.
'-------------------------------------------------------------------------------
Private Function BlueprintStreamText( _
    ByVal lngObjNumber As Long, _
    ByVal lngPageOrdinal As Long) As String

    Dim errDescription As String
    Dim errNumber As Long
    Dim arrRaw() As Byte
    Dim arrStage() As Byte
    Dim lngDataEnd As Long
    Dim lngDataStart As Long
    Dim lngEndStream As Long
    Dim lngIndex As Long
    Dim lngObjIndex As Long
    Dim lngProduced As Long
    Dim lngStream As Long
    Dim strChunk As String
    Dim strDict As String

    On Error GoTo ErrorHandler

    lngObjIndex = BlueprintIndexOfObject(lngObjNumber)

    If lngObjIndex < 0 Then
        Call BlueprintLogDiag("  STREAM|page=" & CStr(lngPageOrdinal) & _
            "|obj=" & CStr(lngObjNumber) & "|ERROR=stream object not in index")
        GoTo ExitFunction
    End If

    strDict = BlueprintObjectDict(lngObjIndex)

    ' Locate the payload between the "stream" keyword and "endstream".
    strChunk = BlueprintBytesToText( _
        m_objPos(lngObjIndex), _
        BlueprintMinLong(m_objPos(lngObjIndex) + 8192, UBound(m_pdf)))

    lngStream = InStr(strChunk, "stream")

    If lngStream = 0 Then
        Call BlueprintLogDiag("  STREAM|page=" & CStr(lngPageOrdinal) & _
            "|obj=" & CStr(lngObjNumber) & "|ERROR=no stream keyword")
        GoTo ExitFunction
    End If

    lngDataStart = m_objPos(lngObjIndex) + lngStream + 5

    If m_pdf(lngDataStart) = 13 Then
        lngDataStart = lngDataStart + 1
    End If

    If m_pdf(lngDataStart) = 10 Then
        lngDataStart = lngDataStart + 1
    End If

    lngEndStream = BlueprintFindEndStream(lngDataStart)

    If lngEndStream <= lngDataStart Then
        Call BlueprintLogDiag("  STREAM|page=" & CStr(lngPageOrdinal) & _
            "|obj=" & CStr(lngObjNumber) & "|ERROR=no endstream keyword")
        GoTo ExitFunction
    End If

    lngDataEnd = lngEndStream - 1
    ReDim arrRaw(0 To lngDataEnd - lngDataStart)

    For lngIndex = lngDataStart To lngDataEnd
        arrRaw(lngIndex - lngDataStart) = m_pdf(lngIndex)
    Next lngIndex

    ' Oracle uses /FlateDecode. modRawOraclePdfExport uses the ASCII85 plus
    ' Flate chain, so ASCII85 has to run first when it is declared.
    Call BlueprintLogDiag("  STREAM|page=" & CStr(lngPageOrdinal) & _
        "|obj=" & CStr(lngObjNumber) & _
        "|rawBytes=" & CStr(UBound(arrRaw) + 1) & _
        "|filter=" & BlueprintSanitize(BlueprintKeyValueRaw(strDict, "/Filter")))

    If InStr(strDict, "/ASCII85Decode") > 0 Then
        arrRaw = BlueprintAscii85Decode(arrRaw)
    End If

    If InStr(strDict, "/FlateDecode") > 0 Then
        On Error Resume Next
        lngProduced = InflateStream( _
            arrRaw, _
            BlueprintZlibSkip(arrRaw), _
            UBound(arrRaw), _
            arrStage)
        On Error GoTo 0

        If lngProduced > 0 Then
            ReDim Preserve arrStage(0 To lngProduced - 1)
            BlueprintStreamText = StrConv(arrStage, vbUnicode)
        Else
            Call BlueprintLogDiag("  STREAM|page=" & CStr(lngPageOrdinal) & _
                "|obj=" & CStr(lngObjNumber) & "|ERROR=inflate produced 0 bytes")
        End If
    Else
        BlueprintStreamText = StrConv(arrRaw, vbUnicode)
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    Call BlueprintLogDiag("  STREAM|page=" & CStr(lngPageOrdinal) & _
        "|obj=" & CStr(lngObjNumber) & _
        "|ERROR=" & CStr(errNumber) & " " & BlueprintSanitize(errDescription))

    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngFrom As Long
' Returns:       Long
' Description:   Returns the byte position of the next "endstream" keyword.
'-------------------------------------------------------------------------------
Private Function BlueprintFindEndStream(ByVal lngFrom As Long) As Long

    Dim lngIndex As Long
    Dim lngUpper As Long

    lngUpper = UBound(m_pdf) - 8
    BlueprintFindEndStream = -1

    For lngIndex = lngFrom To lngUpper
        If m_pdf(lngIndex) = 101 Then
            If m_pdf(lngIndex + 1) = 110 And m_pdf(lngIndex + 2) = 100 And _
               m_pdf(lngIndex + 3) = 115 And m_pdf(lngIndex + 4) = 116 And _
               m_pdf(lngIndex + 5) = 114 And m_pdf(lngIndex + 6) = 101 And _
               m_pdf(lngIndex + 7) = 97 And m_pdf(lngIndex + 8) = 109 Then

                BlueprintFindEndStream = lngIndex
                Exit Function
            End If
        End If
    Next lngIndex

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrSource() As Byte
' Returns:       Byte()
' Description:   Decodes an ASCII85 payload, tolerating the optional <~ prefix.
'-------------------------------------------------------------------------------
Private Function BlueprintAscii85Decode(ByRef arrSource() As Byte) As Byte()

    Dim arrOut() As Byte
    Dim dblTuple As Double
    Dim lngByte As Long
    Dim lngGroup As Long
    Dim lngIndex As Long
    Dim lngOutLen As Long
    Dim lngPad As Long

    ReDim arrOut(0 To 65535)
    lngIndex = 0

    If UBound(arrSource) >= 1 Then
        If arrSource(0) = 60 And arrSource(1) = 126 Then
            lngIndex = 2
        End If
    End If

    dblTuple = 0#
    lngGroup = 0

    Do While lngIndex <= UBound(arrSource)
        lngByte = arrSource(lngIndex)

        If lngByte = 126 Then
            Exit Do
        End If

        If lngByte = 122 And lngGroup = 0 Then
            ' The z shorthand stands for four zero bytes.
            Call BlueprintAppendByte(arrOut, lngOutLen, 0)
            Call BlueprintAppendByte(arrOut, lngOutLen, 0)
            Call BlueprintAppendByte(arrOut, lngOutLen, 0)
            Call BlueprintAppendByte(arrOut, lngOutLen, 0)

        ElseIf lngByte >= 33 And lngByte <= 117 Then
            dblTuple = dblTuple * 85# + CDbl(lngByte - 33)
            lngGroup = lngGroup + 1

            If lngGroup = 5 Then
                Call BlueprintEmitTupleBytes(arrOut, lngOutLen, dblTuple, 4)
                dblTuple = 0#
                lngGroup = 0
            End If
        End If

        lngIndex = lngIndex + 1
    Loop

    ' A partial final group is padded with the highest digit and yields one
    ' byte less than the number of characters it holds.
    If lngGroup > 0 Then
        For lngPad = lngGroup To 4
            dblTuple = dblTuple * 85# + 84#
        Next lngPad

        Call BlueprintEmitTupleBytes(arrOut, lngOutLen, dblTuple, lngGroup - 1)
    End If

    If lngOutLen = 0 Then
        ReDim arrOut(0 To 0)
    Else
        ReDim Preserve arrOut(0 To lngOutLen - 1)
    End If

    BlueprintAscii85Decode = arrOut

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrOut() As Byte, lngOutLen As Long, dblTuple As Double, lngCount As Long
' Returns:       ---
' Description:   Writes the leading bytes of one ASCII85 tuple using division
'                only. A bitwise And would coerce the tuple to Long first, and
'                every group whose value reaches 2^31 then raises an overflow.
'-------------------------------------------------------------------------------
Private Sub BlueprintEmitTupleBytes( _
    ByRef arrOut() As Byte, _
    ByRef lngOutLen As Long, _
    ByVal dblTuple As Double, _
    ByVal lngCount As Long)

    Dim dblRemainder As Double
    Dim dblScale As Double
    Dim lngIndex As Long
    Dim lngPart As Long

    dblRemainder = dblTuple

    For lngIndex = 3 To 0 Step -1
        dblScale = 256# ^ lngIndex
        lngPart = Int(dblRemainder / dblScale)
        dblRemainder = dblRemainder - CDbl(lngPart) * dblScale

        If (3 - lngIndex) < lngCount Then
            ' An oversized group is tolerated rather than rejected.
            Call BlueprintAppendByte( _
                arrOut, _
                lngOutLen, _
                lngPart - Int(lngPart / 256) * 256)
        End If
    Next lngIndex

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrOut() As Byte, lngOutLen As Long, lngValue As Long
' Returns:       ---
' Description:   Appends one byte, growing the buffer when it runs out of room.
'-------------------------------------------------------------------------------
Private Sub BlueprintAppendByte( _
    ByRef arrOut() As Byte, _
    ByRef lngOutLen As Long, _
    ByVal lngValue As Long)

    If lngOutLen > UBound(arrOut) Then
        ReDim Preserve arrOut(0 To (UBound(arrOut) + 1) * 2 - 1)
    End If

    arrOut(lngOutLen) = CByte(lngValue)
    lngOutLen = lngOutLen + 1

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrData() As Byte
' Returns:       Long
' Description:   Returns 2 when the payload starts with a zlib header, else 0.
'-------------------------------------------------------------------------------
Private Function BlueprintZlibSkip(ByRef arrData() As Byte) As Long

    BlueprintZlibSkip = 0

    If UBound(arrData) < 1 Then
        Exit Function
    End If

    If (arrData(0) And 15) = 8 Then
        If ((CLng(arrData(0)) * 256 + CLng(arrData(1))) Mod 31) = 0 Then
            BlueprintZlibSkip = 2
        End If
    End If

End Function

