' Parameters:    lngLeft As Long, lngRight As Long
' Returns:       Long
' Description:   Returns the smaller of two values.
'-------------------------------------------------------------------------------
Private Function BlueprintMinLong( _
    ByVal lngLeft As Long, _
    ByVal lngRight As Long) As Long

    If lngLeft < lngRight Then
        BlueprintMinLong = lngLeft
    Else
        BlueprintMinLong = lngRight
    End If

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    strValue As String
' Returns:       String
' Description:   Replaces the characters that would break the pipe-delimited report.
'-------------------------------------------------------------------------------
Private Function BlueprintSanitize(ByVal strValue As String) As String

    Dim strResult As String

    strResult = Replace(strValue, vbCr, " ")
    strResult = Replace(strResult, vbLf, " ")
    strResult = Replace(strResult, "|", "/")
    BlueprintSanitize = Trim$(strResult)

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    strRaw As String
' Returns:       String
' Description:   Decodes PDF literal-string escapes sufficiently for text-show
'                classification. Octal escapes and escaped line continuations are
'                handled so "\040" is correctly recognised as a space.
'-------------------------------------------------------------------------------
Private Function BlueprintDecodeLiteralText(ByVal strRaw As String) As String

    Dim intCode As Long
    Dim intDigit As Long
    Dim lngIndex As Long
    Dim lngLength As Long
    Dim lngOctalDigits As Long
    Dim strChar As String
    Dim strNext As String
    Dim strResult As String

    lngLength = Len(strRaw)
    lngIndex = 1

    Do While lngIndex <= lngLength
        strChar = Mid$(strRaw, lngIndex, 1)

        If strChar <> "\" Then
            strResult = strResult & strChar
            lngIndex = lngIndex + 1
        ElseIf lngIndex = lngLength Then
            strResult = strResult & "\"
            lngIndex = lngIndex + 1
        Else
            strNext = Mid$(strRaw, lngIndex + 1, 1)

            Select Case strNext
                Case "n"
                    strResult = strResult & vbLf
                    lngIndex = lngIndex + 2
                Case "r"
                    strResult = strResult & vbCr
                    lngIndex = lngIndex + 2
                Case "t"
                    strResult = strResult & vbTab
                    lngIndex = lngIndex + 2
                Case "b"
                    strResult = strResult & Chr$(8)
                    lngIndex = lngIndex + 2
                Case "f"
                    strResult = strResult & Chr$(12)
                    lngIndex = lngIndex + 2
                Case "(", ")", "\"
                    strResult = strResult & strNext
                    lngIndex = lngIndex + 2
                Case vbCr
                    lngIndex = lngIndex + 2

                    If lngIndex <= lngLength Then
                        If Mid$(strRaw, lngIndex, 1) = vbLf Then
                            lngIndex = lngIndex + 1
                        End If
                    End If
                Case vbLf
                    lngIndex = lngIndex + 2
                Case "0" To "7"
                    intCode = 0
                    lngOctalDigits = 0

                    Do While lngIndex + 1 <= lngLength And lngOctalDigits < 3
                        strNext = Mid$(strRaw, lngIndex + 1, 1)

                        If strNext < "0" Or strNext > "7" Then
                            Exit Do
                        End If

                        intDigit = Asc(strNext) - Asc("0")
                        intCode = (intCode * 8) + intDigit
                        lngOctalDigits = lngOctalDigits + 1
                        lngIndex = lngIndex + 1
                    Loop

                    strResult = strResult & Chr$(intCode And &HFF&)
                    lngIndex = lngIndex + 1
                Case Else
                    ' PDF treats a backslash before any other character as that
                    ' character itself for practical literal-string parsing.
                    strResult = strResult & strNext
                    lngIndex = lngIndex + 2
            End Select
        End If
    Loop

    BlueprintDecodeLiteralText = strResult

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    strValue As String
' Returns:       Boolean
' Description:   TRUE only when every decoded character is whitespace/control
'                used as spacing by the Oracle Reports text stream.
'-------------------------------------------------------------------------------
Private Function BlueprintIsWhitespaceOnly(ByVal strValue As String) As Boolean

    Dim intCode As Long
    Dim lngIndex As Long

    BlueprintIsWhitespaceOnly = False

    If Len(strValue) = 0 Then
        Exit Function
    End If

    For lngIndex = 1 To Len(strValue)
        intCode = AscW(Mid$(strValue, lngIndex, 1))

        Select Case intCode
            Case 0, 9, 10, 12, 13, 32
                ' accepted whitespace
            Case Else
                Exit Function
        End Select
    Next lngIndex

    BlueprintIsWhitespaceOnly = True

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    strValue As String
' Returns:       Long
' Description:   Counts decoded whitespace/control characters.
'-------------------------------------------------------------------------------
Private Function BlueprintWhitespaceCount(ByVal strValue As String) As Long

    Dim intCode As Long
    Dim lngIndex As Long

    For lngIndex = 1 To Len(strValue)
        intCode = AscW(Mid$(strValue, lngIndex, 1))

        Select Case intCode
            Case 0, 9, 10, 12, 13, 32
                BlueprintWhitespaceCount = BlueprintWhitespaceCount + 1
        End Select
    Next lngIndex

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    showItem As tTextShow
' Returns:       String
' Description:   Stable semantic class for one text-show operator.
'-------------------------------------------------------------------------------
Private Function BlueprintTextShowClass(ByRef showItem As tTextShow) As String

    If Not showItem.HasStringOperand Then
        BlueprintTextShowClass = "NO_STRING_OPERAND"
    ElseIf Len(showItem.DecodedValue) = 0 Then
        BlueprintTextShowClass = "EMPTY_LITERAL"
    ElseIf BlueprintIsWhitespaceOnly(showItem.DecodedValue) Then
        BlueprintTextShowClass = "WHITESPACE_ONLY"
    Else
        BlueprintTextShowClass = "VISIBLE_TEXT"
    End If

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-12
' Parameters:    strValue As String
' Returns:       String
' Description:   Makes otherwise invisible whitespace explicit in the reports.
'-------------------------------------------------------------------------------
Private Function BlueprintVisibleMarker(ByVal strValue As String) As String

    Dim intCode As Long
    Dim lngIndex As Long
    Dim strChar As String
    Dim strResult As String

    For lngIndex = 1 To Len(strValue)
        strChar = Mid$(strValue, lngIndex, 1)
        intCode = AscW(strChar)

        Select Case intCode
            Case 0
                strResult = strResult & "[NUL]"
            Case 9
                strResult = strResult & "[TAB]"
            Case 10
                strResult = strResult & "[LF]"
            Case 12
                strResult = strResult & "[FF]"
            Case 13
                strResult = strResult & "[CR]"
            Case 32
                strResult = strResult & "[SP]"
            Case Else
                If strChar = "|" Then
                    strResult = strResult & "/"
                Else
                    strResult = strResult & strChar
                End If
        End Select

        If Len(strResult) > 160 Then
            strResult = Left$(strResult, 160) & "..."
            Exit For
        End If
    Next lngIndex

    If Len(strResult) = 0 Then
        strResult = "(empty)"
    End If

    BlueprintVisibleMarker = strResult

End Function

