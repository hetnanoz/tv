'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngFile As Long, lngPageCount As Long
' Returns:       ---
' Description:   Writes the counters that map onto the forensic report vocabulary
'                plus paste-ready Array() constants for modRawOraclePdfExport.
'-------------------------------------------------------------------------------
Private Sub BlueprintWriteSummary( _
    ByVal lngFile As Long, _
    ByVal lngPageCount As Long)

    Dim arrX() As Double
    Dim lngBoxInvisible As Long
    Dim lngBoxVisible As Long
    Dim lngIndex As Long
    Dim lngMlPainted As Long
    Dim lngMlVertical As Long
    Dim lngRePainted As Long
    Dim lngReInvisible As Long
    Dim lngRePlainN As Long
    Dim lngReClipWN As Long
    Dim lngReClipWStarN As Long
    Dim lngClipOther As Long
    Dim lngXCount As Long
    Dim strLine As String

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).Source = "m/l" Then
            If m_prim(lngIndex).Paint <> "n" Then
                lngMlPainted = lngMlPainted + 1

                If m_prim(lngIndex).Orientation = "VERTICAL" Then
                    lngMlVertical = lngMlVertical + 1
                End If
            End If
        Else
            If m_prim(lngIndex).Paint = "n" Then
                lngReInvisible = lngReInvisible + 1

                Select Case BlueprintPrimitiveClass(m_prim(lngIndex))
                    Case "PLAIN_RE_N"
                        lngRePlainN = lngRePlainN + 1
                    Case "CLIP_RE_W_N"
                        lngReClipWN = lngReClipWN + 1
                    Case "CLIP_RE_WSTAR_N"
                        lngReClipWStarN = lngReClipWStarN + 1
                    Case Else
                        lngClipOther = lngClipOther + 1
                End Select

                If m_prim(lngIndex).Orientation = "BOX" Then
                    lngBoxInvisible = lngBoxInvisible + 1
                End If
            Else
                lngRePainted = lngRePainted + 1

                If m_prim(lngIndex).Orientation = "BOX" Then
                    lngBoxVisible = lngBoxVisible + 1
                End If
            End If
        End If
    Next lngIndex

    Call BlueprintEmit(lngFile, "===== SECTION 2 - COUNTERS =====")
    Call BlueprintEmit(lngFile, "COUNTERS")
    Call BlueprintEmit(lngFile, "  painted_ml      |" & CStr(lngMlPainted) & _
        "   (compare with PAINTED_PRIMITIVES *_ml)")
    Call BlueprintEmit(lngFile, "  painted_ml_vert |" & CStr(lngMlVertical))
    Call BlueprintEmit(lngFile, "  painted_re      |" & CStr(lngRePainted) & _
        "   (compare with PAINTED_PRIMITIVES *_re)")
    Call BlueprintEmit(lngFile, "  invisible_re_n  |" & CStr(lngReInvisible) & _
        "   (legacy union: plain n + clip W/W* n)")
    Call BlueprintEmit(lngFile, "  plain_re_n      |" & CStr(lngRePlainN))
    Call BlueprintEmit(lngFile, "  clip_re_W_n     |" & CStr(lngReClipWN))
    Call BlueprintEmit(lngFile, "  clip_re_Wstar_n |" & CStr(lngReClipWStarN))
    Call BlueprintEmit(lngFile, "  clip_other_n    |" & CStr(lngClipOther))
    Call BlueprintEmit(lngFile, "  boxes_visible   |" & CStr(lngBoxVisible))
    Call BlueprintEmit(lngFile, "  boxes_invisible |" & CStr(lngBoxInvisible))
    Call BlueprintEmit(lngFile, "")

    Call BlueprintEmit(lngFile, "PASTE_READY_CONSTANTS")
    Call BlueprintEmit(lngFile, "' Distinct X of painted vertical m/l rules, page 1:")

    Call BlueprintCollectX(1, "m/l", "VERTICAL", False, arrX, lngXCount)
    strLine = BlueprintArrayLiteral(arrX, lngXCount)
    Call BlueprintEmit(lngFile, "  VerticalRuleX = " & strLine)
    Call BlueprintEmit(lngFile, "")

    Call BlueprintEmit(lngFile, "' Left X of INVISIBLE re n boxes, page 1:")
    Call BlueprintCollectX(1, "re", "BOX", True, arrX, lngXCount)
    strLine = BlueprintArrayLiteral(arrX, lngXCount)
    Call BlueprintEmit(lngFile, "  InvisibleBoxX = " & strLine)
    Call BlueprintEmit(lngFile, "")

    Call BlueprintEmit(lngFile, "' Left X of VISIBLE re boxes, page 1:")
    Call BlueprintCollectX(1, "re", "BOX", False, arrX, lngXCount)
    strLine = BlueprintArrayLiteral(arrX, lngXCount)
    Call BlueprintEmit(lngFile, "  VisibleBoxX   = " & strLine)
    Call BlueprintEmit(lngFile, "")

    Call BlueprintEmit(lngFile, "HOW_TO_READ")
    Call BlueprintEmit(lngFile, "  1|Run this module on OLD and on the generated PDF.")
    Call BlueprintEmit(lngFile, "  2|Diff SECTION 4. INVISIBLE_X is retained as a legacy " & _
        "union, but PLAIN_RE_N_X / CLIP_W_N_X / CLIP_WSTAR_N_X are the decisive lists.")
    Call BlueprintEmit(lngFile, "  3|Diff SECTION 7. It reports the exact W/W* path, " & _
        "graphics-state depth and whether it is the last path immediately before text.")
    Call BlueprintEmit(lngFile, "  4|A large OLD-versus-NEW difference in CLIP_* with " & _
        "matching visible m/l geometry is a stronger DOXIS topology signal than re n count alone.")
    Call BlueprintEmit(lngFile, "")

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    lngPageNo As Long, strSource As String, strShape As String, blnInvisible As Boolean, arrX() As Double, lngCount As Long
' Returns:       ---
' Description:   Collects the distinct, ascending X values of one primitive class.
'-------------------------------------------------------------------------------
Private Sub BlueprintCollectX( _
    ByVal lngPageNo As Long, _
    ByVal strSource As String, _
    ByVal strShape As String, _
    ByVal blnInvisible As Boolean, _
    ByRef arrX() As Double, _
    ByRef lngCount As Long)

    Dim blnIsInvisible As Boolean
    Dim blnSeen As Boolean
    Dim dblSwap As Double
    Dim dblValue As Double
    Dim lngIndex As Long
    Dim lngInner As Long
    Dim lngOuter As Long

    lngCount = 0
    ReDim arrX(0 To 511)

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).PageNo = lngPageNo And _
           m_prim(lngIndex).Source = strSource And _
           m_prim(lngIndex).Orientation = strShape Then

            blnIsInvisible = (m_prim(lngIndex).Paint = "n")

            If blnIsInvisible = blnInvisible Then
                If strSource = "re" Then
                    dblValue = m_prim(lngIndex).RectX
                Else
                    dblValue = m_prim(lngIndex).X1
                End If

                blnSeen = False

                For lngInner = 0 To lngCount - 1
                    If Abs(arrX(lngInner) - dblValue) <= COORD_TOLERANCE Then
                        blnSeen = True
                        Exit For
                    End If
                Next lngInner

                If Not blnSeen And lngCount <= 511 Then
                    arrX(lngCount) = dblValue
                    lngCount = lngCount + 1
                End If
            End If
        End If
    Next lngIndex

    For lngOuter = 0 To lngCount - 2
        For lngInner = 0 To lngCount - 2 - lngOuter
            If arrX(lngInner) > arrX(lngInner + 1) Then
                dblSwap = arrX(lngInner)
                arrX(lngInner) = arrX(lngInner + 1)
                arrX(lngInner + 1) = dblSwap
            End If
        Next lngInner
    Next lngOuter

End Sub

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    arrX() As Double, lngCount As Long
' Returns:       String
' Description:   Formats a coordinate list as a VBA Array() literal.
'-------------------------------------------------------------------------------
Private Function BlueprintArrayLiteral( _
    ByRef arrX() As Double, _
    ByVal lngCount As Long) As String

    Dim lngIndex As Long
    Dim strResult As String

    If lngCount = 0 Then
        BlueprintArrayLiteral = "Array()"
        Exit Function
    End If

    strResult = "Array("

    For lngIndex = 0 To lngCount - 1
        If lngIndex > 0 Then
            strResult = strResult & ", "
        End If

        strResult = strResult & BlueprintNumText(arrX(lngIndex)) & "#"
    Next lngIndex

    BlueprintArrayLiteral = strResult & ")"

End Function

