'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    ---
' Returns:       Long
' Description:   Counts clip rectangles that are the last completed path before
'                the next text-show operation on the same page.
'-------------------------------------------------------------------------------
Private Function BlueprintDirectClipBeforeTextCount() As Long

    Dim lngIndex As Long
    Dim lngNextText As Long

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).Source = "re" And _
           Len(m_prim(lngIndex).ClipOperator) > 0 Then

            lngNextText = BlueprintFindNextTextForPrimitive(lngIndex)

            If lngNextText >= 0 Then
                If BlueprintIsLastPathBeforeText(lngIndex, lngNextText) Then
                    BlueprintDirectClipBeforeTextCount = _
                        BlueprintDirectClipBeforeTextCount + 1
                End If
            End If
        End If
    Next lngIndex

End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-11
' Parameters:    ---
' Returns:       Long
' Description:   Counts clip rectangles whose clip state is still active at the
'                first later text-show operation.
'-------------------------------------------------------------------------------
Private Function BlueprintClipCarriesToTextCount() As Long

    Dim lngIndex As Long
    Dim lngNextText As Long

    For lngIndex = 0 To m_primCount - 1
        If m_prim(lngIndex).Source = "re" And _
           Len(m_prim(lngIndex).ClipOperator) > 0 Then

            lngNextText = BlueprintFindNextTextForPrimitive(lngIndex)

            If lngNextText >= 0 Then
                If m_text(lngNextText).ClipActive And _
                   m_text(lngNextText).ClipSetToken >= _
                        m_prim(lngIndex).PaintTokenIndex Then

                    BlueprintClipCarriesToTextCount = _
                        BlueprintClipCarriesToTextCount + 1
