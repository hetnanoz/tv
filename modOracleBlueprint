Private Function BlueprintOpenNew(ByVal strPath As String) As Long

    Dim lngFile As Long

    lngFile = FreeFile

    If Len(Dir$(strPath)) > 0 Then
        Kill strPath
    End If

    Open strPath For Output As #lngFile
    BlueprintOpenNew = lngFile

