            Call BlueprintEmit(lngFile, _
                "PRIM|page=" & CStr(m_prim(lngIndex).PageNo) & _
                "|src=m/l" & _
                "|paint=" & m_prim(lngIndex).Paint & _
                "|visible=" & BlueprintVisibility(m_prim(lngIndex).Paint) & _
                "|shape=" & m_prim(lngIndex).Orientation & _
                "|x1=" & BlueprintNumText(m_prim(lngIndex).X1) & _
                "|y1=" & BlueprintNumText(m_prim(lngIndex).Y1) & _
                "|x2=" & BlueprintNumText(m_prim(lngIndex).X2) & _
                "|y2=" & BlueprintNumText(m_prim(lngIndex).Y2) & _
                "|lw=" & BlueprintNumText(m_prim(lngIndex).LineWidth) & _
                "|stroke=" & m_prim(lngIndex).StrokeGray)
        End If
