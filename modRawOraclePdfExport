'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksMacro As Excel.Worksheet
' Returns:       Boolean
' Description:   Returns whether the raw Oracle-compatible PDF mode is enabled.
'-------------------------------------------------------------------------------
Public Function IsRawOraclePdfEnabled(ByVal wksMacro As Excel.Worksheet) As Boolean
    Const METHOD_NAME As String = "IsRawOraclePdfEnabled"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim rngFlag As Excel.Range
    Dim strFlag As String
    Dim varFlag As Variant

    On Error GoTo ErrorHandler

    IsRawOraclePdfEnabled = False

    If wksMacro Is Nothing Then
        Err.Raise 1001, METHOD_NAME, "The Tradeversand worksheet is required."
    End If

    On Error Resume Next
    Set rngFlag = wksMacro.Range(CONFIG_RANGE_NAME)
    On Error GoTo ErrorHandler

    If rngFlag Is Nothing Then
        GoTo ExitFunction
    End If

    varFlag = rngFlag.Value

    If VarType(varFlag) = vbBoolean Then
        IsRawOraclePdfEnabled = CBool(varFlag)
        GoTo ExitFunction
    End If

    If IsNumeric(varFlag) Then
        IsRawOraclePdfEnabled = (CDbl(varFlag) <> 0#)
        GoTo ExitFunction
    End If

    strFlag = UCase$(Trim$(CStr(varFlag)))
    IsRawOraclePdfEnabled = _
        (strFlag = "TRUE" Or strFlag = "PRAWDA" Or strFlag = "YES" Or _
         strFlag = "JA" Or strFlag = "ORACLE" Or strFlag = "1")

ExitFunction:
    Set rngFlag = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsRawOraclePdfEnabled = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    targetPath As String, wksSource As Excel.Worksheet, logoPath As String
' Returns:       Boolean
' Description:   Generates a synchronous raw PDF 1.4 from the completed report worksheet.
'-------------------------------------------------------------------------------
Public Function GenerateRawOraclePdfFromWorksheet( _
    ByVal targetPath As String, _
    ByVal wksSource As Excel.Worksheet, _
    ByVal logoPath As String) As Boolean

    Const METHOD_NAME As String = "GenerateRawOraclePdfFromWorksheet"
    Dim arrBottomRows() As Long
    Dim arrTopRows() As Long
    Dim blnFileOpened As Boolean
    Dim blnHasLogo As Boolean
    Dim colPageContents As Collection
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngFileNumber As Long
    Dim lngLogoComponents As Long
    Dim lngLogoHeight As Long
    Dim lngLogoWidth As Long
    Dim lngTradeCount As Long
    Dim strDocument As String
    Dim strLogoHex As String

    On Error GoTo ErrorHandler

    GenerateRawOraclePdfFromWorksheet = False

    If wksSource Is Nothing Then
        Err.Raise 1001, METHOD_NAME, "The completed report worksheet is required."
    End If

    If Not ValidateTargetPath(targetPath) Then
        Err.Raise 1020, METHOD_NAME, "The target PDF path is invalid or inaccessible."
    End If

    wksSource.Calculate

    If Not CollectTransactionRows(wksSource, arrTopRows, arrBottomRows, lngTradeCount) Then
        Err.Raise 1001, METHOD_NAME, "No transaction row pairs were found in the report worksheet."
    End If

    blnHasLogo = PrepareLogoImage( _
        wksSource, _
        logoPath, _
        strLogoHex, _
        lngLogoWidth, _
        lngLogoHeight, _
        lngLogoComponents)

    If Not blnHasLogo Then
        Err.Raise 1013, METHOD_NAME, "The report logo could not be prepared as a JPEG image."
    End If

    If Not BuildAllPageContents( _
        wksSource, _
        arrTopRows, _
        arrBottomRows, _
        lngTradeCount, _
        blnHasLogo, _
        colPageContents) Then

        Err.Raise 1024, METHOD_NAME, "The Oracle PDF page contents could not be built."
    End If

    If Not BuildPdfDocument( _
        colPageContents, _
        strLogoHex, _
        lngLogoWidth, _
        lngLogoHeight, _
        lngLogoComponents, _
        strDocument) Then

        Err.Raise 1024, METHOD_NAME, "The PDF object structure or XREF table could not be built."
    End If

    If Len(Dir$(targetPath)) > 0 Then
        Kill targetPath
    End If

    lngFileNumber = FreeFile
    Open targetPath For Output Access Write Lock Write As #lngFileNumber
    blnFileOpened = True
    Print #lngFileNumber, strDocument;
    Close #lngFileNumber
    blnFileOpened = False

    If Len(Dir$(targetPath)) = 0 Then
        Err.Raise 1011, METHOD_NAME, "The raw Oracle PDF file was not created."
    End If

    If FileLen(targetPath) <= 0 Then
        Err.Raise 1011, METHOD_NAME, "The raw Oracle PDF file is empty."
    End If

    If Not HasPdf14Header(targetPath) Then
        Err.Raise 1024, METHOD_NAME, "The generated file does not start with the PDF 1.4 header."
    End If

    GenerateRawOraclePdfFromWorksheet = True

ExitFunction:
    If blnFileOpened Then
        On Error Resume Next
        Close #lngFileNumber
        On Error GoTo 0
    End If

    If Not GenerateRawOraclePdfFromWorksheet Then
        On Error Resume Next
        If Len(Dir$(targetPath)) > 0 Then
            Kill targetPath
        End If
        On Error GoTo 0
    End If

    Set colPageContents = Nothing
    Set wksSource = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GenerateRawOraclePdfFromWorksheet = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "targetPath;tradeCount", _
        targetPath, _
        lngTradeCount

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    targetPath As String
' Returns:       Boolean
' Description:   Validates the target PDF path and its parent folder.
'-------------------------------------------------------------------------------
Private Function ValidateTargetPath(ByVal targetPath As String) As Boolean
    Const METHOD_NAME As String = "ValidateTargetPath"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim fso As Object
    Dim strParentFolder As String

    On Error GoTo ErrorHandler

    ValidateTargetPath = False

    If Len(Trim$(targetPath)) = 0 Then
        Err.Raise 1020, METHOD_NAME, "The target PDF path is required."
    End If

    If LCase$(Right$(Trim$(targetPath), 4)) <> ".pdf" Then
        Err.Raise 1020, METHOD_NAME, "The target path must end with .pdf."
    End If

    Set fso = CreateObject("Scripting.FileSystemObject")
    strParentFolder = CStr(fso.GetParentFolderName(targetPath))

    If Len(strParentFolder) = 0 Then
        Err.Raise 1020, METHOD_NAME, "The target parent folder could not be resolved."
    End If

    If Not fso.FolderExists(strParentFolder) Then
        Err.Raise 1022, METHOD_NAME, "The target parent folder does not exist."
    End If

    ValidateTargetPath = True

ExitFunction:
    Set fso = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ValidateTargetPath = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "targetPath", _
        targetPath

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, arrTopRows() As Long, arrBottomRows() As Long, lngTradeCount As Long
' Returns:       Boolean
' Description:   Collects the two worksheet rows belonging to each transaction.
'-------------------------------------------------------------------------------
Private Function CollectTransactionRows( _
    ByVal wksSource As Excel.Worksheet, _
    ByRef arrTopRows() As Long, _
    ByRef arrBottomRows() As Long, _
    ByRef lngTradeCount As Long) As Boolean

    Const METHOD_NAME As String = "CollectTransactionRows"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCapacity As Long
    Dim lngLastRow As Long
    Dim lngRow As Long

    On Error GoTo ErrorHandler

    CollectTransactionRows = False
    lngTradeCount = 0
    lngLastRow = GetLastUsedRow(wksSource)

    If lngLastRow < FIRST_DATA_ROW + 1 Then
        GoTo ExitFunction
    End If

    lngCapacity = 16
    ReDim arrTopRows(1 To lngCapacity)
    ReDim arrBottomRows(1 To lngCapacity)

    lngRow = FIRST_DATA_ROW

    Do While lngRow <= lngLastRow - 1
        If IsTransactionRowPair(wksSource, lngRow, lngLastRow) Then
            lngTradeCount = lngTradeCount + 1

            If lngTradeCount > lngCapacity Then
                lngCapacity = lngCapacity * 2
                ReDim Preserve arrTopRows(1 To lngCapacity)
                ReDim Preserve arrBottomRows(1 To lngCapacity)
            End If

            arrTopRows(lngTradeCount) = lngRow
            arrBottomRows(lngTradeCount) = lngRow + 1
            lngRow = lngRow + 2
        Else
            lngRow = lngRow + 1
        End If
    Loop

    If lngTradeCount = 0 Then
        GoTo ExitFunction
    End If

    ReDim Preserve arrTopRows(1 To lngTradeCount)
    ReDim Preserve arrBottomRows(1 To lngTradeCount)
    CollectTransactionRows = True

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    CollectTransactionRows = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "lastRow;tradeCount", _
        lngLastRow, _
        lngTradeCount

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, lngTopRow As Long, lngLastRow As Long
' Returns:       Boolean
' Description:   Returns whether two consecutive worksheet rows form one transaction.
'-------------------------------------------------------------------------------
Private Function IsTransactionRowPair( _
    ByVal wksSource As Excel.Worksheet, _
    ByVal lngTopRow As Long, _
    ByVal lngLastRow As Long) As Boolean

    Const METHOD_NAME As String = "IsTransactionRowPair"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim strBottomKey As String
    Dim strTopKey As String

    On Error GoTo ErrorHandler

    IsTransactionRowPair = False

    If lngTopRow < FIRST_DATA_ROW Or lngTopRow + 1 > lngLastRow Then
        GoTo ExitFunction
    End If

    strTopKey = Trim$(CStr(wksSource.Cells(lngTopRow, 1).Text))
    strBottomKey = Trim$(CStr(wksSource.Cells(lngTopRow + 1, 1).Text))

    IsTransactionRowPair = (Len(strTopKey) > 0 And Len(strBottomKey) > 0)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsTransactionRowPair = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topRow;lastRow", _
        lngTopRow, _
        lngLastRow

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet
' Returns:       Long
' Description:   Returns the last used worksheet row.
'-------------------------------------------------------------------------------
Private Function GetLastUsedRow(ByVal wksSource As Excel.Worksheet) As Long
    Const METHOD_NAME As String = "GetLastUsedRow"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim rngLast As Excel.Range

    On Error GoTo ErrorHandler

    GetLastUsedRow = 0

    Set rngLast = wksSource.Cells.Find( _
        What:="*", _
        After:=wksSource.Cells(1, 1), _
        LookIn:=xlFormulas, _
        LookAt:=xlPart, _
        SearchOrder:=xlByRows, _
        SearchDirection:=xlPrevious, _
        MatchCase:=False)

    If Not rngLast Is Nothing Then
        GetLastUsedRow = rngLast.Row
    End If

ExitFunction:
    Set rngLast = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GetLastUsedRow = 0

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, arrTopRows() As Long, arrBottomRows() As Long, lngTradeCount As Long, blnHasLogo As Boolean, colPageContents As Collection
' Returns:       Boolean
' Description:   Builds the uncompressed content stream for every PDF page.
'-------------------------------------------------------------------------------
Private Function BuildAllPageContents( _
    ByVal wksSource As Excel.Worksheet, _
    ByRef arrTopRows() As Long, _
    ByRef arrBottomRows() As Long, _
    ByVal lngTradeCount As Long, _
    ByVal blnHasLogo As Boolean, _
    ByRef colPageContents As Collection) As Boolean

    Const METHOD_NAME As String = "BuildAllPageContents"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngPage As Long
    Dim lngPageCount As Long
    Dim strPageContent As String

    On Error GoTo ErrorHandler

    BuildAllPageContents = False
    Set colPageContents = New Collection

    If lngTradeCount <= 0 Then
        Err.Raise 1001, METHOD_NAME, "At least one transaction is required."
    End If

    lngPageCount = (lngTradeCount + MAX_TRANSACTIONS_PER_PAGE - 1) \ MAX_TRANSACTIONS_PER_PAGE

    For lngPage = 1 To lngPageCount
        strPageContent = BuildSinglePageContent( _
            wksSource, _
            arrTopRows, _
            arrBottomRows, _
            lngTradeCount, _
            lngPage, _
            lngPageCount, _
            blnHasLogo)

        If Len(strPageContent) = 0 Then
            Err.Raise 1024, METHOD_NAME, "A page content stream was empty."
        End If

        colPageContents.Add strPageContent
    Next lngPage

    BuildAllPageContents = (colPageContents.Count = lngPageCount)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildAllPageContents = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "tradeCount;pageCount", _
        lngTradeCount, _
        lngPageCount

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, arrTopRows() As Long, arrBottomRows() As Long, lngTradeCount As Long, lngPage As Long, lngPageCount As Long, blnHasLogo As Boolean
' Returns:       String
' Description:   Builds one page using the fixed Oracle report geometry.
'-------------------------------------------------------------------------------
Private Function BuildSinglePageContent( _
    ByVal wksSource As Excel.Worksheet, _
    ByRef arrTopRows() As Long, _
    ByRef arrBottomRows() As Long, _
    ByVal lngTradeCount As Long, _
    ByVal lngPage As Long, _
    ByVal lngPageCount As Long, _
    ByVal blnHasLogo As Boolean) As String

    Const METHOD_NAME As String = "BuildSinglePageContent"
    Dim arrBottomColumns As Variant
    Dim arrBottomHeaderTextX As Variant
    Dim arrBottomWidths As Variant
    Dim arrBottomX As Variant
    Dim arrTopColumns As Variant
    Dim arrTopHeaderTextX As Variant
    Dim arrTopWidths As Variant
    Dim arrTopX As Variant
    Dim blnFirstPage As Boolean
    Dim blnLastPage As Boolean
    Dim dblBottomBaseline As Double
    Dim dblBottomRowY As Double
    Dim dblHeaderBottomY As Double
    Dim dblHeaderTopY As Double
    Dim dblSeparatorY As Double
    Dim dblTableBottomY As Double
    Dim dblTableTopY As Double
    Dim dblTopBaseline As Double
    Dim dblTopRowY As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngFirstTrade As Long
    Dim lngLastTrade As Long
    Dim lngSlot As Long
    Dim lngTradeIndex As Long
    Dim strContent As String

    On Error GoTo ErrorHandler

    BuildSinglePageContent = vbNullString

    blnFirstPage = (lngPage = 1)
    blnLastPage = (lngPage = lngPageCount)
    lngFirstTrade = ((lngPage - 1) * MAX_TRANSACTIONS_PER_PAGE) + 1
    lngLastTrade = lngFirstTrade + MAX_TRANSACTIONS_PER_PAGE - 1

    If lngLastTrade > lngTradeCount Then
        lngLastTrade = lngTradeCount
    End If

    arrTopX = GetTopGridX()
    arrTopWidths = GetTopGridWidths()
    arrBottomX = GetBottomGridX()
    arrBottomWidths = GetBottomGridWidths()
    arrTopColumns = GetTopSourceColumns()
    arrBottomColumns = GetBottomSourceColumns()
    arrTopHeaderTextX = GetTopHeaderTextX()
    arrBottomHeaderTextX = GetBottomHeaderTextX()

    If blnFirstPage Then
        dblHeaderTopY = FIRST_PAGE_HEADER_TOP_Y
        dblHeaderBottomY = FIRST_PAGE_HEADER_BOTTOM_Y
        dblTableTopY = FIRST_PAGE_TABLE_TOP_Y
    Else
        dblHeaderTopY = CONTINUATION_PAGE_HEADER_TOP_Y
        dblHeaderBottomY = CONTINUATION_PAGE_HEADER_BOTTOM_Y
        dblTableTopY = CONTINUATION_PAGE_TABLE_TOP_Y
    End If

    strContent = "0 G" & vbCrLf & "0 g" & vbCrLf & "0 w" & vbCrLf

    If blnFirstPage And blnHasLogo Then
        strContent = strContent & _
            "q" & vbCrLf & _
            PdfNumber(LOGO_WIDTH) & " 0 0 " & PdfNumber(LOGO_HEIGHT) & " " & _
            PdfNumber(LOGO_X) & " " & PdfNumber(LOGO_Y) & " cm" & vbCrLf & _
            "/Im0 Do" & vbCrLf & _
            "Q" & vbCrLf
    End If

    strContent = strContent & BuildGridRowContent( _
        wksSource, _
        5, _
        arrTopColumns, _
        arrTopX, _
        arrTopWidths, _
        dblHeaderTopY, _
        IIf(blnFirstPage, 540.76, 594.76), _
        True, _
        arrTopHeaderTextX)

    strContent = strContent & BuildGridRowContent( _
        wksSource, _
        6, _
        arrBottomColumns, _
        arrBottomX, _
        arrBottomWidths, _
        dblHeaderBottomY, _
        IIf(blnFirstPage, 522.76, 576.76), _
        True, _
        arrBottomHeaderTextX)

    lngSlot = 0

    For lngTradeIndex = lngFirstTrade To lngLastTrade
        lngSlot = lngSlot + 1
        dblTopBaseline = GetTransactionTopBaseline(blnFirstPage, lngSlot)
        dblBottomBaseline = dblTopBaseline - DATA_ROW_HEIGHT
        dblTopRowY = dblTopBaseline - DATA_BASELINE_OFFSET
        dblBottomRowY = dblBottomBaseline - DATA_BASELINE_OFFSET
        dblSeparatorY = dblBottomBaseline - (DATA_BASELINE_OFFSET + SEPARATOR_HEIGHT)

        strContent = strContent & BuildGridRowContent( _
            wksSource, _
            arrTopRows(lngTradeIndex), _
            arrTopColumns, _
            arrTopX, _
            arrTopWidths, _
            dblTopRowY, _
            dblTopBaseline, _
            False)

        strContent = strContent & BuildGridRowContent( _
            wksSource, _
            arrBottomRows(lngTradeIndex), _
            arrBottomColumns, _
            arrBottomX, _
            arrBottomWidths, _
            dblBottomRowY, _
            dblBottomBaseline, _
            False)

        strContent = strContent & _
            "q " & PdfNumber(SEPARATOR_GRAY_LEVEL) & " g " & _
            PdfNumber(TABLE_LEFT_X) & " " & PdfNumber(dblSeparatorY) & " " & _
            PdfNumber(TABLE_WIDTH) & " " & PdfNumber(SEPARATOR_HEIGHT) & " re f Q" & vbCrLf & _
            PdfNumber(TABLE_LEFT_X) & " " & PdfNumber(dblSeparatorY) & " " & _
            PdfNumber(TABLE_WIDTH) & " " & PdfNumber(SEPARATOR_HEIGHT) & " re S" & vbCrLf
    Next lngTradeIndex

    dblTableBottomY = dblSeparatorY

    strContent = strContent & _
        PdfNumber(TABLE_LEFT_X) & " " & PdfNumber(dblTableBottomY) & " " & _
        PdfNumber(TABLE_WIDTH) & " " & PdfNumber(dblTableTopY - dblTableBottomY) & " re S" & vbCrLf

    If blnLastPage Then
        strContent = strContent & BuildAbsoluteTextCommand( _
            "/F0", _
            FOOTER_FONT_SIZE, _
            FOOTER_X, _
            dblTableBottomY - FOOTER_BASELINE_GAP, _
            FOOTER_TEXT)
    End If

    strContent = strContent & BuildAbsoluteTextCommand( _
        "/F0", _
        PAGE_NUMBER_FONT_SIZE, _
        PAGE_NUMBER_X, _
        PAGE_NUMBER_Y, _
        CStr(lngPage) & " / " & CStr(lngPageCount))

    BuildSinglePageContent = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildSinglePageContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "page;pageCount;firstTrade;lastTrade", _
        lngPage, _
        lngPageCount, _
        lngFirstTrade, _
        lngLastTrade

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, lngSourceRow As Long, arrSourceColumns As Variant, arrX As Variant, arrWidths As Variant, dblRowY As Double, dblBaselineY As Double, blnHeader As Boolean, varFixedTextX As Variant
' Returns:       String
' Description:   Draws one complete 12-column or 13-column row.
'-------------------------------------------------------------------------------
Private Function BuildGridRowContent( _
    ByVal wksSource As Excel.Worksheet, _
    ByVal lngSourceRow As Long, _
    ByVal arrSourceColumns As Variant, _
    ByVal arrX As Variant, _
    ByVal arrWidths As Variant, _
    ByVal dblRowY As Double, _
    ByVal dblBaselineY As Double, _
    ByVal blnHeader As Boolean, _
    Optional ByVal varFixedTextX As Variant) As String

    Const METHOD_NAME As String = "BuildGridRowContent"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim dblFixedTextX As Double
    Dim lngIndex As Long
    Dim rngSource As Excel.Range
    Dim strContent As String

    On Error GoTo ErrorHandler

    BuildGridRowContent = vbNullString

    If UBound(arrSourceColumns) <> UBound(arrX) Or UBound(arrX) <> UBound(arrWidths) Then
        Err.Raise 1024, METHOD_NAME, "The row geometry arrays do not have matching dimensions."
    End If

    If Not IsMissing(varFixedTextX) Then
        If Not IsArray(varFixedTextX) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text anchor configuration is not an array."
        End If
        If UBound(varFixedTextX) <> UBound(arrX) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text anchor array does not match the row geometry."
        End If
    End If

    For lngIndex = LBound(arrX) To UBound(arrX)
        Set rngSource = wksSource.Cells(lngSourceRow, CLng(arrSourceColumns(lngIndex)))

        dblFixedTextX = -1#
        If Not IsMissing(varFixedTextX) Then
            dblFixedTextX = CDbl(varFixedTextX(lngIndex))
        End If

        strContent = strContent & BuildCellContent( _
            rngSource, _
            CDbl(arrX(lngIndex)), _
            dblRowY, _
            CDbl(arrWidths(lngIndex)), _
            DATA_ROW_HEIGHT, _
            dblBaselineY, _
            blnHeader, _
            dblFixedTextX)
    Next lngIndex

    BuildGridRowContent = strContent

ExitFunction:
    Set rngSource = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildGridRowContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "sourceRow;rowY;baselineY;header", _
        lngSourceRow, _
        dblRowY, _
        dblBaselineY, _
        blnHeader

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    rngSource As Excel.Range, dblX As Double, dblY As Double, dblWidth As Double, dblHeight As Double, dblBaselineY As Double, blnHeader As Boolean, dblFixedTextX As Double
' Returns:       String
' Description:   Draws one explicit PDF rectangle and the worksheet text inside it.
'-------------------------------------------------------------------------------
Private Function BuildCellContent( _
    ByVal rngSource As Excel.Range, _
    ByVal dblX As Double, _
    ByVal dblY As Double, _
    ByVal dblWidth As Double, _
    ByVal dblHeight As Double, _
    ByVal dblBaselineY As Double, _
    ByVal blnHeader As Boolean, _
    Optional ByVal dblFixedTextX As Double = -1#) As String

    Const METHOD_NAME As String = "BuildCellContent"
    Dim dblFontSize As Double
    Dim dblTextWidth As Double
    Dim dblTextX As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngAlignment As Long
    Dim strContent As String
    Dim strFont As String
    Dim strText As String

    On Error GoTo ErrorHandler

    BuildCellContent = vbNullString
    strText = GetWorksheetDisplayText(rngSource)

    If blnHeader Then
        strContent = strContent & _
            "q " & PdfNumber(HEADER_GRAY_LEVEL) & " g " & _
            PdfNumber(dblX) & " " & PdfNumber(dblY) & " " & _
            PdfNumber(dblWidth) & " " & PdfNumber(dblHeight) & " re f Q" & vbCrLf
        strFont = "/F0"
        dblFontSize = HEADER_FONT_SIZE
        lngAlignment = xlCenter
    Else
        strFont = "/F1"
        dblFontSize = GetDataFontSize(strText)
        lngAlignment = ResolveCellAlignment(rngSource, strText)
    End If

    strContent = strContent & _
        PdfNumber(dblX) & " " & PdfNumber(dblY) & " " & _
        PdfNumber(dblWidth) & " " & PdfNumber(dblHeight) & " re S" & vbCrLf

    If Len(strText) = 0 Then
        BuildCellContent = strContent
        GoTo ExitFunction
    End If

    If blnHeader And dblFixedTextX >= 0# Then
        dblTextX = dblFixedTextX
    Else
        dblFontSize = FitFontSize(strText, strFont, dblFontSize, dblWidth - (2# * TEXT_HORIZONTAL_PADDING))
        dblTextWidth = EstimateBase14TextWidth(strText, strFont, dblFontSize)

        Select Case lngAlignment
            Case xlCenter
                dblTextX = dblX + ((dblWidth - dblTextWidth) / 2#)
            Case xlRight
                dblTextX = dblX + dblWidth - TEXT_HORIZONTAL_PADDING - dblTextWidth
            Case Else
                dblTextX = dblX + TEXT_HORIZONTAL_PADDING
        End Select

        If dblTextX < dblX + 0.5 Then
            dblTextX = dblX + 0.5
        End If
    End If

    strContent = strContent & BuildAbsoluteTextCommand( _
        strFont, _
        dblFontSize, _
        dblTextX, _
        dblBaselineY, _
        strText)

    BuildCellContent = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildCellContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "x;y;width;height;header;fixedTextX", _
        dblX, _
        dblY, _
        dblWidth, _
        dblHeight, _
        blnHeader, _
        dblFixedTextX

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    rngSource As Excel.Range
' Returns:       String
' Description:   Returns the displayed worksheet value used by the existing report.
'-------------------------------------------------------------------------------
Private Function GetWorksheetDisplayText(ByVal rngSource As Excel.Range) As String
    Const METHOD_NAME As String = "GetWorksheetDisplayText"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim rngValue As Excel.Range
    Dim strText As String

    On Error GoTo ErrorHandler

    GetWorksheetDisplayText = vbNullString

    If rngSource Is Nothing Then
        GoTo ExitFunction
    End If

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    If IsError(rngValue.Value) Or IsEmpty(rngValue.Value) Then
        GoTo ExitFunction
    End If

    strText = CStr(rngValue.Text)

    If Len(strText) = 0 Or Replace(strText, "#", vbNullString) = vbNullString Then
        If IsDate(rngValue.Value) Then
            strText = Format$(CDate(rngValue.Value), "dd-mm-yy")
        Else
            strText = CStr(rngValue.Value)
        End If
    End If

    strText = Replace(strText, vbCr, " ")
    strText = Replace(strText, vbLf, " ")
    strText = Replace(strText, ChrW(160), " ")
    GetWorksheetDisplayText = Trim$(strText)

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GetWorksheetDisplayText = vbNullString

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    rngSource As Excel.Range, strText As String
' Returns:       Long
' Description:   Resolves the visual alignment used for one report value.
'-------------------------------------------------------------------------------
Private Function ResolveCellAlignment( _
    ByVal rngSource As Excel.Range, _
    ByVal strText As String) As Long

    Const METHOD_NAME As String = "ResolveCellAlignment"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngAlignment As Long
    Dim rngValue As Excel.Range

    On Error GoTo ErrorHandler

    ResolveCellAlignment = xlLeft

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    lngAlignment = CLng(rngValue.HorizontalAlignment)

    If lngAlignment = xlCenter Or lngAlignment = xlRight Or lngAlignment = xlLeft Then
        ResolveCellAlignment = lngAlignment
        GoTo ExitFunction
    End If

    If IsDate(rngValue.Value) Then
        ResolveCellAlignment = xlCenter
    ElseIf IsNumeric(rngValue.Value) And Len(strText) > 0 Then
        ResolveCellAlignment = xlRight
    ElseIf Len(strText) = 3 And UCase$(strText) = strText And strText Like "[A-Z][A-Z][A-Z]" Then
        ResolveCellAlignment = xlCenter
    Else
        ResolveCellAlignment = xlLeft
    End If

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ResolveCellAlignment = xlLeft

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

