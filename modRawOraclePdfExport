'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    rngSource As Excel.Range, strText As String
' Returns:       Long
' Description:   Resolves the visual alignment used for one report value.
'-------------------------------------------------------------------------------
Private Function ResolveCellAlignment( _
    ByVal rngSource As Excel.Range, _
    ByVal strText As String) As Long

    Const METHOD_NAME As String = "ResolveCellAlignment"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngAlignment As Long
    Dim rngValue As Excel.Range

    On Error GoTo ErrorHandler

    ResolveCellAlignment = xlLeft

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    lngAlignment = CLng(rngValue.HorizontalAlignment)

    If lngAlignment = xlCenter Or lngAlignment = xlRight Or lngAlignment = xlLeft Then
        ResolveCellAlignment = lngAlignment
        GoTo ExitFunction
    End If

    If IsDate(rngValue.Value) Then
        ResolveCellAlignment = xlCenter
    ElseIf IsNumeric(rngValue.Value) And Len(strText) > 0 Then
        ResolveCellAlignment = xlRight
    ElseIf Len(strText) = 3 And UCase$(strText) = strText And strText Like "[A-Z][A-Z][A-Z]" Then
        ResolveCellAlignment = xlCenter
    Else
        ResolveCellAlignment = xlLeft
    End If

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ResolveCellAlignment = xlLeft

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    rngSource As Excel.Range, strText As String, blnTopTransactionRow As Boolean, lngFieldIndex As Long
' Returns:       String
' Description:   Applies Oracle-only display normalization to selected numeric report fields.
'-------------------------------------------------------------------------------
Private Function NormalizeOracleFieldDisplayText( _
    ByVal rngSource As Excel.Range, _
    ByVal strText As String, _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long) As String

    Const METHOD_NAME As String = "NormalizeOracleFieldDisplayText"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCommaPosition As Long
    Dim lngDecimalPosition As Long
    Dim lngDotPosition As Long
    Dim rngValue As Excel.Range
    Dim strResult As String

    On Error GoTo ErrorHandler

    NormalizeOracleFieldDisplayText = strText

    If Len(strText) = 0 Then
        GoTo ExitFunction
    End If

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    If IsError(rngValue.Value) Or IsEmpty(rngValue.Value) Then
        GoTo ExitFunction
    End If

    If IsDate(rngValue.Value) Or Not IsNumeric(rngValue.Value) Then
        GoTo ExitFunction
    End If

    ' Oracle display rule: preserve the worksheet's thousands separator and
    ' decimal separator, but remove non-significant zeroes at the end of the
    ' fractional part. This is PDF-only formatting; source values are untouched.
    strResult = Trim$(strText)

    lngDotPosition = InStrRev(strResult, ".")
    lngCommaPosition = InStrRev(strResult, ",")

    If lngDotPosition > lngCommaPosition Then
        lngDecimalPosition = lngDotPosition
    Else
        lngDecimalPosition = lngCommaPosition
    End If

    If lngDecimalPosition > 0 Then
        Do While Len(strResult) > lngDecimalPosition And _
                 Right$(strResult, 1) = "0"
            strResult = Left$(strResult, Len(strResult) - 1)
        Loop

        If Len(strResult) = lngDecimalPosition Then
            strResult = Left$(strResult, lngDecimalPosition - 1)
        End If
    End If

    NormalizeOracleFieldDisplayText = strResult

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    NormalizeOracleFieldDisplayText = strText

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topTransactionRow;fieldIndex;text", _
        blnTopTransactionRow, _
        lngFieldIndex, _
        strText

    errorManager.save
    Resume ExitFunction
End Function

