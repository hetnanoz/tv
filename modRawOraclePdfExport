'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    strContent As String
' Returns:       Byte()
' Description:   Builds a valid zlib stream containing uncompressed DEFLATE stored blocks.
'-------------------------------------------------------------------------------
Private Function BuildZlibStoredBytes(ByVal strContent As String) As Byte()
    Const METHOD_NAME As String = "BuildZlibStoredBytes"
    Dim arrData() As Byte
    Dim arrOutput() As Byte
    Dim blnFinal As Boolean
    Dim dblAdler As Double
    Dim dblRemainder As Double
    Dim dblS1 As Double
    Dim dblS2 As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngBlockLength As Long
    Dim lngDataLength As Long
    Dim lngDataPosition As Long
    Dim lngIndex As Long
    Dim lngNLen As Long
    Dim lngOutputLength As Long
    Dim lngOutputPosition As Long

    On Error GoTo ErrorHandler

    arrData = StrConv(strContent, vbFromUnicode)
    lngDataLength = UBound(arrData) - LBound(arrData) + 1
    lngOutputLength = 2 + lngDataLength + (((lngDataLength + 65534) \ 65535) * 5) + 4
    ReDim arrOutput(0 To lngOutputLength - 1)

    arrOutput(0) = &H78
    arrOutput(1) = &H1
    lngOutputPosition = 2
    lngDataPosition = 0
    dblS1 = 1#
    dblS2 = 0#

    Do While lngDataPosition < lngDataLength
        lngBlockLength = lngDataLength - lngDataPosition
        If lngBlockLength > 65535 Then
            lngBlockLength = 65535
        End If

        blnFinal = (lngDataPosition + lngBlockLength >= lngDataLength)
        If blnFinal Then
            arrOutput(lngOutputPosition) = 1
        Else
            arrOutput(lngOutputPosition) = 0
        End If
        lngOutputPosition = lngOutputPosition + 1

        lngNLen = 65535 - lngBlockLength
        arrOutput(lngOutputPosition) = CByte(lngBlockLength And &HFF&)
        arrOutput(lngOutputPosition + 1) = CByte((lngBlockLength \ 256) And &HFF&)
        arrOutput(lngOutputPosition + 2) = CByte(lngNLen And &HFF&)
        arrOutput(lngOutputPosition + 3) = CByte((lngNLen \ 256) And &HFF&)
        lngOutputPosition = lngOutputPosition + 4

        For lngIndex = 0 To lngBlockLength - 1
            arrOutput(lngOutputPosition) = arrData(lngDataPosition + lngIndex)
            dblS1 = dblS1 + CDbl(arrData(lngDataPosition + lngIndex))
            If dblS1 >= 65521# Then
                dblS1 = dblS1 - 65521#
            End If
            dblS2 = dblS2 + dblS1
            dblS2 = dblS2 - (Fix(dblS2 / 65521#) * 65521#)
            lngOutputPosition = lngOutputPosition + 1
        Next lngIndex

        lngDataPosition = lngDataPosition + lngBlockLength
    Loop

    dblAdler = (dblS2 * 65536#) + dblS1
    arrOutput(lngOutputPosition) = CByte(Fix(dblAdler / 16777216#))
    dblRemainder = dblAdler - (CDbl(arrOutput(lngOutputPosition)) * 16777216#)
    arrOutput(lngOutputPosition + 1) = CByte(Fix(dblRemainder / 65536#))
    dblRemainder = dblRemainder - (CDbl(arrOutput(lngOutputPosition + 1)) * 65536#)
    arrOutput(lngOutputPosition + 2) = CByte(Fix(dblRemainder / 256#))
    arrOutput(lngOutputPosition + 3) = CByte(dblRemainder - (CDbl(arrOutput(lngOutputPosition + 2)) * 256#))

    BuildZlibStoredBytes = arrOutput

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ReDim arrOutput(0 To 0)
    BuildZlibStoredBytes = arrOutput

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "contentLength", _
        Len(strContent)

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    arrBytes() As Byte
' Returns:       String
' Description:   Encodes binary bytes using PDF ASCII85 syntax including the end marker.
'-------------------------------------------------------------------------------
Private Function Ascii85EncodeBytes(ByRef arrBytes() As Byte) As String
    Const METHOD_NAME As String = "Ascii85EncodeBytes"
    Dim arrDigits(0 To 4) As Long
    Dim dblDivisor As Double
    Dim dblValue As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngAvailable As Long
    Dim lngByteCount As Long
    Dim lngDigit As Long
    Dim lngIndex As Long
    Dim lngInner As Long
    Dim lngLastIndex As Long
    Dim strEncoded As String
    Dim strGroup As String

    On Error GoTo ErrorHandler

    lngLastIndex = UBound(arrBytes)
    lngIndex = LBound(arrBytes)

    Do While lngIndex <= lngLastIndex
        lngAvailable = lngLastIndex - lngIndex + 1
        If lngAvailable > 4 Then
            lngByteCount = 4
        Else
            lngByteCount = lngAvailable
        End If

        dblValue = 0#
        For lngInner = 0 To 3
            dblValue = dblValue * 256#
            If lngInner < lngByteCount Then
                dblValue = dblValue + CDbl(arrBytes(lngIndex + lngInner))
            End If
        Next lngInner

        If lngByteCount = 4 And dblValue = 0# Then
            strEncoded = strEncoded & "z"
        Else
            strGroup = vbNullString
            For lngDigit = 4 To 0 Step -1
                dblDivisor = 85# ^ lngDigit
                arrDigits(4 - lngDigit) = CLng(Fix(dblValue / dblDivisor))
                dblValue = dblValue - (CDbl(arrDigits(4 - lngDigit)) * dblDivisor)
                strGroup = strGroup & Chr$(arrDigits(4 - lngDigit) + 33)
            Next lngDigit
            strEncoded = strEncoded & Left$(strGroup, lngByteCount + 1)
        End If

        lngIndex = lngIndex + lngByteCount
    Loop

    Ascii85EncodeBytes = strEncoded & "~>"

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Ascii85EncodeBytes = vbNullString

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    colPageContents As Collection, strLogoHex As String, lngLogoWidth As Long, lngLogoHeight As Long, lngLogoComponents As Long, strDocument As String
' Returns:       Boolean
' Description:   Builds Oracle-style PDF objects, filtered page streams, the classic XREF table, trailer, and EOF marker.
'-------------------------------------------------------------------------------
Private Function BuildPdfDocument( _
    ByVal colPageContents As Collection, _
    ByVal strLogoHex As String, _
    ByVal lngLogoWidth As Long, _
    ByVal lngLogoHeight As Long, _
    ByVal lngLogoComponents As Long, _
    ByRef strDocument As String) As Boolean

    Const METHOD_NAME As String = "BuildPdfDocument"
    Dim arrObjects() As String
    Dim arrOffsets() As Long
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngContentObject As Long
    Dim lngFirstPageObject As Long
    Dim lngImageObject As Long
    Dim lngObject As Long
    Dim lngObjectCount As Long
    Dim lngPage As Long
    Dim lngPageObject As Long
    Dim lngStartXref As Long
    Dim strColorSpace As String
    Dim strEncodedContent As String
    Dim strKids As String
    Dim strPageResources As String

    On Error GoTo ErrorHandler

    BuildPdfDocument = False
    strDocument = vbNullString

    If colPageContents Is Nothing Then
        Err.Raise 1001, METHOD_NAME, "The page content collection is required."
    End If

    If colPageContents.Count = 0 Then
        Err.Raise 1001, METHOD_NAME, "At least one PDF page is required."
    End If

    lngImageObject = 8
    lngFirstPageObject = 9
    lngObjectCount = 8 + (colPageContents.Count * 2)

    ReDim arrObjects(1 To lngObjectCount)
    ReDim arrOffsets(1 To lngObjectCount)

    arrObjects(1) = "<< /Type /Catalog /Pages 2 0 R >>"
    arrObjects(3) = "<< /Type /Font /Subtype /Type1 /BaseFont /#54#69#6D#65#73#2D#42#6F#6C#64 /Encoding /WinAnsiEncoding >>"
    arrObjects(4) = _
        "<< /Type /Font /Subtype /Type1 /BaseFont /#41#72#69#61#6C#2D#42#6F#6C#64 " & _
        "/FirstChar 32 /LastChar 255 /Widths 6 0 R /FontDescriptor 7 0 R " & _
        "/Encoding /WinAnsiEncoding >>"
    arrObjects(5) = "<< /Type /Font /Subtype /Type1 /BaseFont /#54#69#6D#65#73#2D#52#6F#6D#61#6E /Encoding /WinAnsiEncoding >>"
    arrObjects(6) = GetArialBoldWidthsArray()
    arrObjects(7) = _
        "<< /Type /FontDescriptor /FontName /#41#72#69#61#6C#2D#42#6F#6C#64 /Flags 32 " & _
        "/FontBBox [-664 -324 2000 1039] /ItalicAngle 0 /Ascent 1031 " & _
        "/Descent -281 /CapHeight 750 /StemV 0 /MissingWidth 0 >>"

    Select Case lngLogoComponents
        Case 1
            strColorSpace = "/DeviceGray"
        Case 4
            strColorSpace = "/DeviceCMYK"
        Case Else
            strColorSpace = "/DeviceRGB"
    End Select

    arrObjects(lngImageObject) = _
        "<< /Type /XObject /Subtype /Image /Width " & CStr(lngLogoWidth) & _
        " /Height " & CStr(lngLogoHeight) & _
        " /ColorSpace " & strColorSpace & _
        " /BitsPerComponent 8 /Filter [/ASCIIHexDecode /DCTDecode] /Length " & _
        CStr(Len(strLogoHex)) & " >>" & vbCrLf & _
        "stream" & vbCrLf & _
        strLogoHex & vbCrLf & _
        "endstream"

    For lngPage = 1 To colPageContents.Count
        lngPageObject = lngFirstPageObject + ((lngPage - 1) * 2)
        lngContentObject = lngPageObject + 1

        If Len(strKids) > 0 Then
            strKids = strKids & " "
        End If
        strKids = strKids & CStr(lngPageObject) & " 0 R"

        strPageResources = "<< /Font << /F0 3 0 R /F1 4 0 R /F2 5 0 R >>"

        If lngPage = 1 Then
            strPageResources = strPageResources & _
                " /XObject << /Im0 " & CStr(lngImageObject) & " 0 R >>"
        End If
        strPageResources = strPageResources & " >>"

        arrObjects(lngPageObject) = _
            "<< /Type /Page /Parent 2 0 R " & _
            "/MediaBox [0 0 1368 684] /CropBox [0 0 1368 684] " & _
            "/Resources " & strPageResources & _
            " /Contents " & CStr(lngContentObject) & " 0 R >>"

        strEncodedContent = BuildFlateAscii85Stream(CStr(colPageContents(lngPage)))
        If Len(strEncodedContent) = 0 Then
            Err.Raise 1024, METHOD_NAME, "A PDF page stream could not be encoded with ASCII85 and Flate."
        End If

        arrObjects(lngContentObject) = _
            "<< /Length " & CStr(Len(strEncodedContent)) & _
            " /Filter [/ASCII85Decode /FlateDecode] >>" & vbCrLf & _
            "stream" & vbCrLf & _
            strEncodedContent & vbCrLf & _
            "endstream"
    Next lngPage

    arrObjects(2) = _
        "<< /Type /Pages /Count " & CStr(colPageContents.Count) & _
        " /Kids [" & strKids & "] >>"

    strDocument = PDF_HEADER & vbCrLf & "% Tradeversand Oracle-compatible raw PDF" & vbCrLf

    For lngObject = 1 To lngObjectCount
        arrOffsets(lngObject) = Len(strDocument)
        strDocument = strDocument & _
            CStr(lngObject) & " 0 obj" & vbCrLf & _
            arrObjects(lngObject) & vbCrLf & _
            "endobj" & vbCrLf
    Next lngObject

    lngStartXref = Len(strDocument)
    strDocument = strDocument & _
        "xref" & vbCrLf & _
        "0 " & CStr(lngObjectCount + 1) & vbCrLf & _
        "0000000000 65535 f" & vbCrLf

    For lngObject = 1 To lngObjectCount
        strDocument = strDocument & _
            Format$(arrOffsets(lngObject), "0000000000") & " 00000 n" & vbCrLf
    Next lngObject

    strDocument = strDocument & _
        "trailer" & vbCrLf & _
        "<< /Size " & CStr(lngObjectCount + 1) & " /Root 1 0 R >>" & vbCrLf & _
        "startxref" & vbCrLf & _
        CStr(lngStartXref) & vbCrLf & _
        "%%EOF" & vbCrLf

    BuildPdfDocument = True

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildPdfDocument = False
    strDocument = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "objectCount", _
        lngObjectCount

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    targetPath As String
' Returns:       Boolean
' Description:   Checks that the generated file begins with the PDF 1.4 header.
'-------------------------------------------------------------------------------
Private Function HasPdf14Header(ByVal targetPath As String) As Boolean
    Const METHOD_NAME As String = "HasPdf14Header"
    Dim arrHeader(0 To 7) As Byte
    Dim blnFileOpened As Boolean
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngFileNumber As Long
    Dim strHeader As String

    On Error GoTo ErrorHandler

    HasPdf14Header = False

    lngFileNumber = FreeFile
    Open targetPath For Binary Access Read Lock Read As #lngFileNumber
    blnFileOpened = True
    Get #lngFileNumber, 1, arrHeader
    Close #lngFileNumber
    blnFileOpened = False

    strHeader = StrConv(arrHeader, vbUnicode)
    HasPdf14Header = (Left$(strHeader, 8) = PDF_HEADER)

ExitFunction:
    If blnFileOpened Then
        On Error Resume Next
        Close #lngFileNumber
        On Error GoTo 0
    End If
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    HasPdf14Header = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "targetPath", _
        targetPath

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    dblValue As Double
' Returns:       String
' Description:   Formats a PDF number with a dot decimal separator.
'-------------------------------------------------------------------------------
Private Function PdfNumber(ByVal dblValue As Double) As String
    Const METHOD_NAME As String = "PdfNumber"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long

    On Error GoTo ErrorHandler

    PdfNumber = Replace(Format$(dblValue, "0.##"), ",", ".")

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    PdfNumber = "0"

    errorManager.addError CLASS_NAME, METHOD_NAME, errNumber, errDescription
    errorManager.save
    Resume ExitFunction
End Function

