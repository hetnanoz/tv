ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    IsOracleCurrencyField = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "topTransactionRow;fieldIndex", _
        blnTopTransactionRow, _
        lngFieldIndex

    errorManager.save
    Resume ExitFunction
