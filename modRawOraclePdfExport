    If blnFirstPage Then
        GetOracleMaxTransactionsForPage = FIRST_PAGE_MAX_TRANSACTIONS
    Else
        GetOracleMaxTransactionsForPage = CONTINUATION_PAGE_MAX_TRANSACTIONS
    End If
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, arrTopRows() As Long, arrBottomRows() As Long, lngTradeCount As Long, blnHasLogo As Boolean, colPageContents As Collection
' Returns:       Boolean
' Description:   Builds the uncompressed content stream for every PDF page.
'-------------------------------------------------------------------------------
Private Function BuildAllPageContents( _
    ByVal wksSource As Excel.Worksheet, _
    ByRef arrTopRows() As Long, _
    ByRef arrBottomRows() As Long, _
    ByVal lngTradeCount As Long, _
    ByVal blnHasLogo As Boolean, _
    ByRef colPageContents As Collection) As Boolean

    Const METHOD_NAME As String = "BuildAllPageContents"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngPage As Long
    Dim lngPageCount As Long
    Dim strPageContent As String

    On Error GoTo ErrorHandler

    BuildAllPageContents = False
    Set colPageContents = New Collection

    If lngTradeCount <= 0 Then
        Err.Raise 1001, METHOD_NAME, "At least one transaction is required."
    End If

    lngPageCount = GetOraclePageCount(lngTradeCount)

    For lngPage = 1 To lngPageCount
        strPageContent = BuildSinglePageContent( _
            wksSource, _
            arrTopRows, _
            arrBottomRows, _
            lngTradeCount, _
            lngPage, _
            lngPageCount, _
            blnHasLogo)

        If Len(strPageContent) = 0 Then
            Err.Raise 1024, METHOD_NAME, "A page content stream was empty."
        End If

        colPageContents.Add strPageContent
    Next lngPage

    BuildAllPageContents = (colPageContents.Count = lngPageCount)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildAllPageContents = False

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "tradeCount;pageCount", _
        lngTradeCount, _
        lngPageCount

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    wksSource As Excel.Worksheet, arrTopRows() As Long, arrBottomRows() As Long, lngTradeCount As Long, lngPage As Long, lngPageCount As Long, blnHasLogo As Boolean
' Returns:       String
' Description:   Builds one page using the fixed Oracle report geometry.
'-------------------------------------------------------------------------------
Private Function BuildSinglePageContent( _
    ByVal wksSource As Excel.Worksheet, _
    ByRef arrTopRows() As Long, _
    ByRef arrBottomRows() As Long, _
    ByVal lngTradeCount As Long, _
    ByVal lngPage As Long, _
    ByVal lngPageCount As Long, _
    ByVal blnHasLogo As Boolean) As String

    Const METHOD_NAME As String = "BuildSinglePageContent"
    Dim arrBottomColumns As Variant
    Dim arrBottomDataTextX As Variant
    Dim arrBottomHeaderLabels As Variant
    Dim arrBottomHeaderTextX As Variant
    Dim arrBottomWidths As Variant
    Dim arrBottomX As Variant
    Dim arrTopColumns As Variant
    Dim arrTopDataTextX As Variant
    Dim arrTopHeaderLabels As Variant
    Dim arrTopHeaderTextX As Variant
    Dim arrTopWidths As Variant
    Dim arrTopX As Variant
    Dim blnDrawSeparatorBottom As Boolean
    Dim blnDrawTradeTop As Boolean
    Dim blnFirstPage As Boolean
    Dim blnLastPage As Boolean
    Dim dblBottomBaseline As Double
    Dim dblBottomRowY As Double
    Dim dblHeaderBottomY As Double
    Dim dblHeaderTopY As Double
    Dim dblSeparatorY As Double
    Dim dblTableBottomY As Double
    Dim dblTableTopY As Double
    Dim dblTopBaseline As Double
    Dim dblTopRowTopY As Double
    Dim dblTopRowY As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngFirstTrade As Long
    Dim lngLastTrade As Long
    Dim lngSlot As Long
    Dim lngTradeIndex As Long
    Dim strContent As String

    On Error GoTo ErrorHandler

    BuildSinglePageContent = vbNullString

    blnFirstPage = (lngPage = 1)
    blnLastPage = (lngPage = lngPageCount)

    Call GetOraclePageTradeBounds( _
        lngTradeCount, _
        lngPage, _
        lngFirstTrade, _
        lngLastTrade)

    arrTopX = GetTopGridX()
    arrTopWidths = GetTopGridWidths()
    arrBottomX = GetBottomGridX()
    arrBottomWidths = GetBottomGridWidths()
    arrTopColumns = GetTopSourceColumns()
    arrBottomColumns = GetBottomSourceColumns()
    arrTopDataTextX = GetTopDataTextX()
    arrBottomDataTextX = GetBottomDataTextX()
    arrTopHeaderTextX = GetTopHeaderTextX()
    arrBottomHeaderTextX = GetBottomHeaderTextX()
    arrTopHeaderLabels = GetTopHeaderLabels()
    arrBottomHeaderLabels = GetBottomHeaderLabels()

    If blnFirstPage Then
        dblHeaderTopY = FIRST_PAGE_HEADER_TOP_Y
        dblHeaderBottomY = FIRST_PAGE_HEADER_BOTTOM_Y
        dblTableTopY = FIRST_PAGE_TABLE_TOP_Y
    Else
        dblHeaderTopY = CONTINUATION_PAGE_HEADER_TOP_Y
        dblHeaderBottomY = CONTINUATION_PAGE_HEADER_BOTTOM_Y
        dblTableTopY = CONTINUATION_PAGE_TABLE_TOP_Y
    End If

    strContent = "0 g" & vbCrLf & "0 w" & vbCrLf

    If blnFirstPage And blnHasLogo Then
        strContent = strContent & _
            "q" & vbCrLf & _
            PdfNumber(LOGO_WIDTH) & " 0 0 " & PdfNumber(LOGO_HEIGHT) & " " & _
            PdfNumber(LOGO_X) & " " & PdfNumber(LOGO_Y) & " cm" & vbCrLf & _
            "/Im0 Do" & vbCrLf & _
            "Q" & vbCrLf
    End If

    strContent = strContent & BuildOracleHeaderStructure( _
        arrTopX, _
        arrBottomX, _
        dblHeaderBottomY, _
        dblHeaderTopY, _
        dblTableTopY, _
        IIf(blnFirstPage, 540#, 594#))

    strContent = strContent & BuildGridRowContent( _
        wksSource, _
        5, _
        arrTopColumns, _
        arrTopX, _
        arrTopWidths, _
        dblHeaderTopY, _
        IIf(blnFirstPage, 540.76, 594.76), _
        True, _
        arrTopHeaderTextX, _
        arrTopHeaderLabels)

    strContent = strContent & BuildGridRowContent( _
        wksSource, _
        6, _
        arrBottomColumns, _
        arrBottomX, _
        arrBottomWidths, _
        dblHeaderBottomY, _
        IIf(blnFirstPage, 522.76, 576.76), _
        True, _
        arrBottomHeaderTextX, _
        arrBottomHeaderLabels)

    lngSlot = 0

    For lngTradeIndex = lngFirstTrade To lngLastTrade
        lngSlot = lngSlot + 1
        dblTopBaseline = GetTransactionTopBaseline(blnFirstPage, lngSlot)
        dblBottomBaseline = dblTopBaseline - DATA_ROW_HEIGHT
        dblTopRowTopY = GetTransactionTopRowTopY(blnFirstPage, lngSlot)
        dblTopRowY = GetTransactionTopRowBottomY(blnFirstPage, lngSlot)
        dblBottomRowY = GetTransactionBottomRowBottomY(blnFirstPage, lngSlot)
        dblSeparatorY = GetTransactionSeparatorBottomY(blnFirstPage, lngSlot)
        blnDrawTradeTop = (lngSlot > 1)
        blnDrawSeparatorBottom = (lngTradeIndex < lngLastTrade)

        strContent = strContent & BuildOracleTransactionStructure( _
            arrTopX, _
            arrBottomX, _
            dblTopBaseline, _
            dblBottomBaseline, _
            dblTopRowTopY, _
            dblTopRowY, _
            dblBottomRowY, _
            dblSeparatorY, _
            blnDrawTradeTop, _
            blnDrawSeparatorBottom)

        strContent = strContent & BuildGridRowContent( _
            wksSource, _
            arrTopRows(lngTradeIndex), _
            arrTopColumns, _
            arrTopX, _
            arrTopWidths, _
            dblTopRowY, _
            dblTopBaseline, _
            False, _
            varFixedTextX:=arrTopDataTextX, _
            blnTopTransactionRow:=True)

        strContent = strContent & BuildGridRowContent( _
            wksSource, _
            arrBottomRows(lngTradeIndex), _
            arrBottomColumns, _
            arrBottomX, _
            arrBottomWidths, _
            dblBottomRowY, _
            dblBottomBaseline, _
            False, _
            arrBottomDataTextX)
    Next lngTradeIndex

    dblTableBottomY = dblSeparatorY

    strContent = strContent & BuildStrokedRectangleCommand( _
        TABLE_LEFT_X, _
        dblTableBottomY, _
        TABLE_WIDTH, _
        dblTableTopY - dblTableBottomY)

    If blnLastPage Then
        strContent = strContent & BuildAbsoluteTextCommand( _
            "/F1", _
            FOOTER_FONT_SIZE, _
            FOOTER_X, _
            dblTableBottomY - FOOTER_BASELINE_GAP, _
            FOOTER_TEXT)
    End If

    strContent = strContent & BuildPageNumberCommand( _
        lngPage, _
        lngPageCount)

    BuildSinglePageContent = strContent

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildSinglePageContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "page;pageCount;firstTrade;lastTrade", _
        lngPage, _
        lngPageCount, _
        lngFirstTrade, _
        lngLastTrade

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    wksSource As Excel.Worksheet, lngSourceRow As Long, arrSourceColumns As Variant, arrX As Variant, arrWidths As Variant, dblRowY As Double, dblBaselineY As Double, blnHeader As Boolean, varFixedTextX As Variant, varFixedTextValues As Variant, blnTopTransactionRow As Boolean
' Returns:       String
' Description:   Builds text for one fixed Oracle upper or lower report row.
'-------------------------------------------------------------------------------
Private Function BuildGridRowContent( _
    ByVal wksSource As Excel.Worksheet, _
    ByVal lngSourceRow As Long, _
    ByVal arrSourceColumns As Variant, _
    ByVal arrX As Variant, _
    ByVal arrWidths As Variant, _
    ByVal dblRowY As Double, _
    ByVal dblBaselineY As Double, _
    ByVal blnHeader As Boolean, _
    Optional ByVal varFixedTextX As Variant, _
    Optional ByVal varFixedTextValues As Variant, _
    Optional ByVal blnTopTransactionRow As Boolean = False) As String

    Const METHOD_NAME As String = "BuildGridRowContent"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim dblFixedTextX As Double
    Dim lngIndex As Long
    Dim rngSource As Excel.Range
    Dim strContent As String
    Dim strOverrideText As String

    On Error GoTo ErrorHandler

    BuildGridRowContent = vbNullString

    If UBound(arrSourceColumns) <> UBound(arrX) Or UBound(arrX) <> UBound(arrWidths) Then
        Err.Raise 1024, METHOD_NAME, "The row geometry arrays do not have matching dimensions."
    End If

    If Not IsMissing(varFixedTextX) Then
        If Not IsArray(varFixedTextX) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text anchor configuration is not an array."
        End If
        If UBound(varFixedTextX) <> UBound(arrX) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text anchor array does not match the row geometry."
        End If
    End If

    If Not IsMissing(varFixedTextValues) Then
        If Not IsArray(varFixedTextValues) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text value configuration is not an array."
        End If
        If UBound(varFixedTextValues) <> UBound(arrX) Then
            Err.Raise 1024, METHOD_NAME, "The fixed text value array does not match the row geometry."
        End If
    End If

    For lngIndex = LBound(arrX) To UBound(arrX)
        Set rngSource = wksSource.Cells(lngSourceRow, CLng(arrSourceColumns(lngIndex)))

        dblFixedTextX = -1#
        If Not IsMissing(varFixedTextX) Then
            dblFixedTextX = CDbl(varFixedTextX(lngIndex))
        End If

        strOverrideText = vbNullString
        If Not IsMissing(varFixedTextValues) Then
            strOverrideText = CStr(varFixedTextValues(lngIndex))
        End If

        strContent = strContent & BuildCellContent( _
            rngSource, _
            CDbl(arrX(lngIndex)), _
            dblRowY, _
            CDbl(arrWidths(lngIndex)), _
            DATA_ROW_HEIGHT, _
            dblBaselineY, _
            blnHeader, _
            dblFixedTextX, _
            strOverrideText, _
            blnTopTransactionRow, _
            lngIndex)
    Next lngIndex

    BuildGridRowContent = strContent

ExitFunction:
    Set rngSource = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildGridRowContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "sourceRow;rowY;baselineY;header", _
        lngSourceRow, _
        dblRowY, _
        dblBaselineY, _
        blnHeader

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    rngSource As Excel.Range, dblX As Double, dblY As Double, dblWidth As Double, dblHeight As Double, dblBaselineY As Double, blnHeader As Boolean, dblFixedTextX As Double, strOverrideText As String, blnTopTransactionRow As Boolean, lngFieldIndex As Long
' Returns:       String
' Description:   Builds one Oracle-compatible text run from a worksheet cell or fixed header label.
'-------------------------------------------------------------------------------
Private Function BuildCellContent( _
    ByVal rngSource As Excel.Range, _
    ByVal dblX As Double, _
    ByVal dblY As Double, _
    ByVal dblWidth As Double, _
    ByVal dblHeight As Double, _
    ByVal dblBaselineY As Double, _
    ByVal blnHeader As Boolean, _
    Optional ByVal dblFixedTextX As Double = -1#, _
    Optional ByVal strOverrideText As String = vbNullString, _
    Optional ByVal blnTopTransactionRow As Boolean = False, _
    Optional ByVal lngFieldIndex As Long = -1) As String

    Const METHOD_NAME As String = "BuildCellContent"
    Const FONT_SIZE_TOLERANCE As Double = 0.01
    Const ORACLE_EIGHT_PT_BASELINE_OFFSET As Double = 0.76
    Dim dblEffectiveRightPadding As Double
    Dim dblFontSize As Double
    Dim dblTextWidth As Double
    Dim dblTextX As Double
    Dim dblTextY As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngAlignment As Long
    Dim strFont As String
    Dim strText As String

    On Error GoTo ErrorHandler

    BuildCellContent = vbNullString

    If blnHeader And Len(strOverrideText) > 0 Then
        strText = strOverrideText
    Else
        strText = GetWorksheetDisplayText(rngSource)
    End If

    If blnHeader Then
        strFont = "/F0"
        dblFontSize = HEADER_FONT_SIZE
        lngAlignment = xlCenter
    Else
        strText = NormalizeOracleFieldDisplayText( _
            rngSource, _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex)

        strFont = "/F2"
        dblFontSize = ResolveOracleDataFontSize( _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex)

        dblFixedTextX = ResolveOracleFixedDataTextX( _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex, _
            dblFixedTextX)

        lngAlignment = ResolveOracleDataAlignment( _
            rngSource, _
            strText, _
            blnTopTransactionRow, _
            lngFieldIndex)

        strText = ApplyOracleNumericFieldPadding( _
            rngSource, _
            strText, _
            lngAlignment, _
            blnTopTransactionRow, _
            lngFieldIndex)
    End If

    If Len(strText) = 0 Then
        GoTo ExitFunction
    End If

    dblTextY = dblBaselineY
    dblEffectiveRightPadding = TEXT_RIGHT_PADDING

    If Not blnHeader Then
        If rngSource.Column = 21 Then
            ' Devisenkurs keeps the independently audited 8 pt Oracle anchor.
            dblFontSize = LONG_TEXT_FONT_SIZE
            dblEffectiveRightPadding = ORACLE_DEVISENKURS_RIGHT_PADDING
        End If
    End If

    If blnHeader And dblFixedTextX >= 0# Then
        dblTextX = dblFixedTextX
    Else
        dblFontSize = FitFontSize( _
            strText, _
            strFont, _
            dblFontSize, _
            dblWidth - TEXT_LEFT_PADDING - TEXT_RIGHT_PADDING)

        dblTextWidth = EstimateBase14TextWidth( _
            strText, _
            strFont, _
            dblFontSize)

        If dblFixedTextX >= 0# Then
            ' FIX19: parser-audited Oracle data anchor. Only fields with an
            ' explicit old-PDF coordinate use this path; all other data remains
            ' content-dependent and keeps the normal alignment calculation.
            dblTextX = dblFixedTextX
        Else
            Select Case lngAlignment
                Case xlCenter
                    dblTextX = dblX + ((dblWidth - dblTextWidth) / 2#)
                Case xlRight
                    dblTextX = dblX + dblWidth - dblEffectiveRightPadding - dblTextWidth
                Case Else
                    dblTextX = dblX + TEXT_LEFT_PADDING
            End Select
        End If

        If dblTextX < dblX + 0.5 Then
            dblTextX = dblX + 0.5
        End If
    End If

    If Not blnHeader Then
        If Abs(dblFontSize - LONG_TEXT_FONT_SIZE) < FONT_SIZE_TOLERANCE Then
            dblTextY = dblBaselineY + ORACLE_EIGHT_PT_BASELINE_OFFSET
        End If
    End If

    BuildCellContent = BuildAbsoluteTextCommand( _
        strFont, _
        dblFontSize, _
        dblTextX, _
        dblTextY, _
        strText)

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildCellContent = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "x;y;width;height;header;fixedTextX", _
        dblX, _
        dblY, _
        dblWidth, _
        dblHeight, _
        blnHeader, _
        dblFixedTextX

    errorManager.save
    Resume ExitFunction
End Function


'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    arrTopX As Variant, arrBottomX As Variant, dblHeaderBottomY As Double, dblHeaderTopY As Double, dblTableTopY As Double, dblSpecialY As Double
