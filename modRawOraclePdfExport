' Author:        Pawel Ligezka
' Creation date: 2026-08-05
' Parameters:    rngSource As Excel.Range
' Returns:       String
' Description:   Returns the displayed worksheet value used by the existing report.
'-------------------------------------------------------------------------------
Private Function GetWorksheetDisplayText(ByVal rngSource As Excel.Range) As String

    Const METHOD_NAME As String = "GetWorksheetDisplayText"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim rngValue As Excel.Range
    Dim strText As String

    On Error GoTo ErrorHandler

    GetWorksheetDisplayText = vbNullString

    If rngSource Is Nothing Then
        GoTo ExitFunction
    End If

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    If IsError(rngValue.Value) Or IsEmpty(rngValue.Value) Then
        GoTo ExitFunction
    End If

    strText = CStr(rngValue.Text)

    If Len(strText) = 0 Or Replace(strText, "#", vbNullString) = vbNullString Then
        If IsDate(rngValue.Value) Then
            strText = Format$(CDate(rngValue.Value), "dd-mm-yy")
        Else
            strText = CStr(rngValue.Value)
        End If
    End If

    strText = Replace(strText, vbCr, " ")
    strText = Replace(strText, vbLf, " ")
    strText = Replace(strText, ChrW(160), " ")
    strText = RTrim$(strText)

    If Len(Trim$(strText)) = 0 Then
        strText = vbNullString
    End If

    GetWorksheetDisplayText = strText

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    GetWorksheetDisplayText = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
' Creation date: 2026-08-07
' Parameters:    rngSource As Excel.Range, strText As String, lngAlignment As Long
' Returns:       String
' Description:   Reproduces Oracle Reports fixed-field padding for right-aligned numeric data.
'-------------------------------------------------------------------------------
Private Function ApplyOracleNumericFieldPadding( _
    ByVal rngSource As Excel.Range, _
    ByVal strText As String, _
    ByVal lngAlignment As Long, _
    ByVal blnTopTransactionRow As Boolean, _
    ByVal lngFieldIndex As Long) As String

    Const METHOD_NAME As String = "ApplyOracleNumericFieldPadding"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngLeadingSpaces As Long
    Dim rngValue As Excel.Range
    Dim strCoreText As String
    Dim strTrailingText As String

    On Error GoTo ErrorHandler

    ApplyOracleNumericFieldPadding = strText

    If Len(strText) = 0 Or lngAlignment <> xlRight Then
        GoTo ExitFunction
    End If

    Set rngValue = rngSource

    If rngSource.MergeCells Then
        Set rngValue = rngSource.MergeArea.Cells(1, 1)
    End If

    If IsDate(rngValue.Value) Or Not IsNumeric(rngValue.Value) Then
        GoTo ExitFunction
    End If

    ' Preserve any deliberate trailing whitespace supplied by the Oracle
    ' display formatter. Current FIX25 does not add numeric trailing spaces.
    strTrailingText = vbNullString
    Do While Len(strText) > 0 And Right$(strText, 1) = " "
        strTrailingText = strTrailingText & " "
        strText = Left$(strText, Len(strText) - 1)
    Loop

    strCoreText = LTrim$(strText)

    If Len(strCoreText) = 0 Then
        GoTo ExitFunction
    End If

    lngLeadingSpaces = ORACLE_NUMERIC_LEADING_SPACES

    ApplyOracleNumericFieldPadding = _
        Space$(lngLeadingSpaces) & strCoreText & strTrailingText

ExitFunction:
    Set rngValue = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ApplyOracleNumericFieldPadding = strText

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "alignment;topTransactionRow;fieldIndex;text", _
        lngAlignment, _
        blnTopTransactionRow, _
        lngFieldIndex, _
        strText

    errorManager.save
    Resume ExitFunction
End Function

'-------------------------------------------------------------------------------
' Author:        Pawel Ligezka
