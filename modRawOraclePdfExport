    On Error GoTo ErrorHandler

    strContent = BuildFilledStrokedRectangleCommand( _
        TABLE_LEFT_X, _
        dblHeaderBottomY, _
        TABLE_WIDTH, _
        dblTableTopY - dblHeaderBottomY, _
        HEADER_GRAY_LEVEL)

    strContent = strContent & BuildNoPaintRectangleCommand( _
        ORACLE_HEADER_SPECIAL_X, _
        dblSpecialY, _
        ORACLE_HEADER_SPECIAL_WIDTH, _
        ORACLE_DETAIL_HEIGHT)

    strContent = strContent & BuildHeaderGridStrokeContent( _
