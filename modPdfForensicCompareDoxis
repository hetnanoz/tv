        oldAnchor = vbNullString
    End If

    Print #fileNo, "----------------------------------------------------------------"
    Print #fileNo, _
        "TRANSACTION" & _
        "|id=" & anchorId & _
        "|tx=" & DoxisV18AnchorDisplay(betterAnchor) & _
        "|OLD=" & DoxisV18AnchorLocation(oldAnchor) & _
        "|BETTER=" & DoxisV18AnchorLocation(betterAnchor) & _
        "|CURRENT=" & DoxisV18AnchorLocation(currentAnchor)

    Call DoxisV18CompareAnchorSeparator( _
        fileNo, _
        anchorId, _
        468#, _
        "TOP_SCHLUSSTAG", _
        oldDoc, _
        betterDoc, _
        currentDoc, _
        oldAnchor, _
        betterAnchor, _
        currentAnchor, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Call DoxisV18CompareAnchorSeparator( _
        fileNo, _
        anchorId, _
        639#, _
        "TOP_ISIN", _
        oldDoc, _
        betterDoc, _
        currentDoc, _
        oldAnchor, _
        betterAnchor, _
        currentAnchor, _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples)

    Call DoxisV181CompareNoPaintTargetX( _
        fileNo, anchorId, 468#, "TOP_SCHLUSSTAG", _
        oldDoc, betterDoc, currentDoc, _
        oldAnchor, betterAnchor, currentAnchor, _
        dictIssueCounts, dictIssuePriorities, dictIssueSamples)

    Call DoxisV181CompareNoPaintTargetX( _
        fileNo, anchorId, 639#, "TOP_ISIN", _
        oldDoc, betterDoc, currentDoc, _
        oldAnchor, betterAnchor, currentAnchor, _
        dictIssueCounts, dictIssuePriorities, dictIssueSamples)

    Call DoxisV181CompareGlobalProjectionRoles( _
        fileNo, anchorId, _
        oldDoc, betterDoc, currentDoc, _
        oldAnchor, betterAnchor, currentAnchor, _
        dictIssueCounts, dictIssuePriorities, dictIssueSamples)

    arrRoles = DoxisV18TargetRoles()

    For lngRole = LBound(arrRoles) To UBound(arrRoles)
        strRole = CStr(arrRoles(lngRole))

        Call DoxisV18CompareTargetText( _
            fileNo, _
            anchorId, _
            strRole, _
            oldDoc, _
            betterDoc, _
            currentDoc, _
            oldAnchor, _
            betterAnchor, _
            currentAnchor, _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples)
    Next lngRole
End Sub

