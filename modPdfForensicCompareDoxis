    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim arrRoles As Variant
    Dim lngIndex As Long
    Dim strRole As String

    arrRoles = Array( _
        "TOP_ISIN", _
        "TOP_SCHLUSSTAG", _
        "TOP_FONDSBEZEICHNUNG", _
        "TOP_WERTPAPIERBEZEICHNUNG", _
        "TOP_NOMINALE_STUECKE", _
        "TOP_STUECKZINSEN", _
        "TOP_WHG_NOMINALE", _
        "BOTTOM_ABWICKLUNGSPROVISION", _
        "BOTTOM_WHG_MAKLER", _
        "BOTTOM_WHG_STEUERN", _
        "BOTTOM_WHG_ABWICKLUNG", _
        "BOTTOM_WHG_SPESEN", _
        "BOTTOM_WHG_ABRECH")

    For lngIndex = LBound(arrRoles) To UBound(arrRoles)
        strRole = CStr(arrRoles(lngIndex))

        Call DoxisV181CompareGlobalProjectionRole( _
            fileNo, anchorId, strRole, _
            oldDoc, betterDoc, currentDoc, _
