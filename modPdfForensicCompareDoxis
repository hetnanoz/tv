Private Function DoxisV18BuildAnchorMap( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal documentLabel As String, _
    ByVal fileNo As Long) As Object

    Const METHOD_NAME As String = "DoxisV18BuildAnchorMap"
    Dim dictAnchors As Object
    Dim dictOccurrences As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngOccurrence As Long
    Dim lngPage As Long
    Dim lngStart As Long
    Dim strAnchorId As String
    Dim strBaseKey As String
    Dim strDisplay As String
    Dim strRole As String

    On Error GoTo ErrorHandler

    Set dictAnchors = CreateObject("Scripting.Dictionary")
    Set dictOccurrences = CreateObject("Scripting.Dictionary")

    For lngPage = 1 To pdfDoc.PageCount
        lngStart = pdfDoc.Pages(lngPage).TextStart
        lngEnd = lngStart + pdfDoc.Pages(lngPage).TextCount - 1

        For lngIndex = lngStart To lngEnd
            strRole = RegressionInferStructuralFieldRole( _
                lngPage, _
                pdfDoc.Texts(lngIndex).X, _
                pdfDoc.Texts(lngIndex).Y)

            If strRole = "BOTTOM_TRANSAKTIONSNR" Then
                strDisplay = Trim$(pdfDoc.Texts(lngIndex).TextValue)
                strBaseKey = DoxisV18NormalizeAnchorKey(strDisplay)

                If Len(strBaseKey) > 0 Then
                    If dictOccurrences.Exists(strBaseKey) Then
                        lngOccurrence = CLng(dictOccurrences(strBaseKey)) + 1
                        dictOccurrences(strBaseKey) = lngOccurrence
                    Else
                        lngOccurrence = 1
                        dictOccurrences.Add strBaseKey, lngOccurrence
                    End If

                    strAnchorId = strBaseKey
                    If lngOccurrence > 1 Then
                        strAnchorId = strAnchorId & "#OCC" & CStr(lngOccurrence)
                    End If

                    dictAnchors.Add _
                        strAnchorId, _
                        DoxisV18PackAnchor( _
                            lngPage, _
                            pdfDoc.Texts(lngIndex).Y + 18#, _
                            pdfDoc.Texts(lngIndex).Y, _
                            lngIndex, _
                            strDisplay)

                    Print #fileNo, _
                        "ANCHOR" & _
                        "|doc=" & documentLabel & _
                        "|id=" & strAnchorId & _
                        "|tx=" & SanitizeReportText(strDisplay) & _
                        "|page=" & CStr(lngPage) & _
                        "|topY=" & NumTxt(pdfDoc.Texts(lngIndex).Y + 18#) & _
                        "|bottomY=" & NumTxt(pdfDoc.Texts(lngIndex).Y)
                End If
            End If
        Next lngIndex
    Next lngPage

    Print #fileNo, _
        "ANCHOR_SUMMARY" & _
        "|doc=" & documentLabel & _
        "|count=" & CStr(dictAnchors.Count) & _
        "|distinctTransactionNumbers=" & CStr(dictOccurrences.Count)
    Print #fileNo, ""

    Set DoxisV18BuildAnchorMap = dictAnchors

ExitFunction:
    Set dictOccurrences = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "documentLabel", _
        documentLabel

    errorManager.save

    If dictAnchors Is Nothing Then
        Set dictAnchors = CreateObject("Scripting.Dictionary")
    End If

    Set DoxisV18BuildAnchorMap = dictAnchors
    Resume ExitFunction
End Function

Private Function DoxisV18NormalizeAnchorKey(ByVal textValue As String) As String
    Dim strValue As String

    strValue = UCase$(Trim$(textValue))
    strValue = Replace(strValue, Chr$(160), " ")
    strValue = Replace(strValue, vbTab, " ")
    strValue = Replace(strValue, " ", "")

    DoxisV18NormalizeAnchorKey = strValue
End Function

Private Function DoxisV18PackAnchor( _
    ByVal pageNo As Long, _
    ByVal topY As Double, _
    ByVal bottomY As Double, _
    ByVal textIndex As Long, _
    ByVal displayValue As String) As String

    DoxisV18PackAnchor = _
        CStr(pageNo) & "|" & _
