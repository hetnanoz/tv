Private Function DoxisV182OptionalDelta( _
    ByVal oldIndex As Long, _
    ByVal currentIndex As Long, _
    ByVal deltaValue As Double) As String

    If oldIndex < 0 Or currentIndex < 0 Then
        DoxisV182OptionalDelta = "NA"
    Else
        DoxisV182OptionalDelta = NumTxt(deltaValue)
    End If
End Function

Private Function DoxisV182CutIsWorse( _
    ByVal currentCut As Long, _
    ByVal referenceCut As Long) As Boolean

    If currentCut < 0 Then Exit Function

    If referenceCut < 0 Then
        DoxisV182CutIsWorse = True
    Else
        DoxisV182CutIsWorse = (currentCut < referenceCut)
    End If
End Function

Private Function DoxisV182FontRegressionPriority( _
    ByVal role As String, _
    ByVal betterMatchesOld As Boolean) As Long

    If betterMatchesOld Then
        If role = "TOP_ISIN" Or _
           InStr(1, role, "WHG", vbBinaryCompare) > 0 Then

            DoxisV182FontRegressionPriority = 3
        Else
            DoxisV182FontRegressionPriority = 2
        End If
    Else
        DoxisV182FontRegressionPriority = _
            DoxisV18FontSerializationPriority(role)

        If DoxisV182FontRegressionPriority < 1 Then
            DoxisV182FontRegressionPriority = 1
        End If
    End If
End Function

