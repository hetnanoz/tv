Private Sub DoxisV18CompareTransactionSet( _
    ByVal fileNo As Long, _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchors As Object, _
    ByVal betterAnchors As Object, _
    ByVal currentAnchors As Object, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim arrKeys As Variant
    Dim lngIndex As Long
    Dim strAnchorId As String
    Dim strSample As String

    Print #fileNo, "================================================================"
    Print #fileNo, "TRANSACTION_ANCHORED_COMPARISON"
    Print #fileNo, "================================================================"

    If betterAnchors.Count = 0 Then
        Call DoxisAddIssue( _
            dictIssueCounts, _
            dictIssuePriorities, _
            dictIssueSamples, _
            "DOXIS_V18_2_NO_BETTER_TRANSACTION_ANCHORS", _
            2, _
            "The BETTER-PARSING PDF contains no detectable BOTTOM_TRANSAKTIONSNR anchors.")
        Exit Sub
    End If

    arrKeys = SortedDictionaryKeys(betterAnchors)

    For lngIndex = LBound(arrKeys) To UBound(arrKeys)
        strAnchorId = CStr(arrKeys(lngIndex))

        If Not currentAnchors.Exists(strAnchorId) Then
            strSample = _
                "tx=" & DoxisV18AnchorDisplay(CStr(betterAnchors(strAnchorId))) & _
                "|betterPage=" & CStr(DoxisV18AnchorPage(CStr(betterAnchors(strAnchorId))))

            If oldAnchors.Exists(strAnchorId) Then
                Call DoxisAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    "DOXIS_V18_2_TRANSACTION_ANCHOR_MISSING_CURRENT_VS_OLD", _
                    3, _
                    strSample & "|OLD_hasAnchor=TRUE")
            Else
                Call DoxisAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    "DOXIS_V18_2_TRANSACTION_ANCHOR_MISSING_CURRENT", _
                    1, _
                    strSample & "|OLD_hasAnchor=FALSE")
            End If

            Print #fileNo, _
                "TRANSACTION_MISSING_CURRENT" & _
                "|id=" & strAnchorId & _
                "|" & strSample
        Else
            Call DoxisV18CompareTransaction( _
                fileNo, _
                strAnchorId, _
                oldDoc, _
                betterDoc, _
                currentDoc, _
                oldAnchors, _
                betterAnchors, _
                currentAnchors, _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples)
        End If
    Next lngIndex

    If currentAnchors.Count > 0 Then
        arrKeys = SortedDictionaryKeys(currentAnchors)

        For lngIndex = LBound(arrKeys) To UBound(arrKeys)
            strAnchorId = CStr(arrKeys(lngIndex))

            If Not betterAnchors.Exists(strAnchorId) Then
                Print #fileNo, _
                    "TRANSACTION_CURRENT_ONLY" & _
                    "|id=" & strAnchorId & _
                    "|tx=" & DoxisV18AnchorDisplay(CStr(currentAnchors(strAnchorId))) & _
                    "|page=" & CStr(DoxisV18AnchorPage(CStr(currentAnchors(strAnchorId))))

                Call DoxisAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    "DOXIS_V18_TRANSACTION_ANCHOR_CURRENT_ONLY", _
                    1, _
                    "tx=" & DoxisV18AnchorDisplay(CStr(currentAnchors(strAnchorId))))
            End If
        Next lngIndex
    End If

    Print #fileNo, ""
End Sub

Private Sub DoxisV18CompareTransaction( _
