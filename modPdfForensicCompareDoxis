Private Function RegressionStripFontObjectNumbers( _
    ByVal forensicSignature As String) As String

    Const METHOD_NAME As String = "RegressionStripFontObjectNumbers"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngEnd As Long
    Dim lngStart As Long
    Dim strResult As String

    On Error GoTo ErrorHandler

    strResult = forensicSignature
    lngStart = InStr(1, strResult, "|obj=", vbBinaryCompare)

    Do While lngStart > 0
        lngEnd = InStr(lngStart + 5, strResult, "|", vbBinaryCompare)

        If lngEnd = 0 Then
            strResult = Left$(strResult, lngStart - 1)
            Exit Do
        End If

        strResult = _
            Left$(strResult, lngStart - 1) & _
            Mid$(strResult, lngEnd)

        lngStart = InStr(lngStart, strResult, "|obj=", vbBinaryCompare)
    Loop

    RegressionStripFontObjectNumbers = strResult

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    RegressionStripFontObjectNumbers = forensicSignature

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionDirection( _
    ByVal oldSignature As String, _
    ByVal goodSignature As String, _
    ByVal currentSignature As String) As String

    If goodSignature = currentSignature Then
        RegressionDirection = "STABLE_GOOD_TO_CURRENT"
    ElseIf goodSignature = oldSignature And _
           currentSignature <> oldSignature Then
        RegressionDirection = "REGRESSED_FROM_OLD_MATCH"
    ElseIf currentSignature = oldSignature And _
           goodSignature <> oldSignature Then
        RegressionDirection = "MOVED_TOWARD_OLD"
    ElseIf goodSignature <> oldSignature And _
           currentSignature <> oldSignature Then
        RegressionDirection = "CHANGED_BETWEEN_GENERATED"
    Else
        RegressionDirection = "CHANGED"
    End If
End Function

Private Function RegressionPriorityFromDirection( _
    ByVal direction As String, _
    ByVal basePriority As Long) As Long

    RegressionPriorityFromDirection = basePriority

    If direction = "REGRESSED_FROM_OLD_MATCH" Then
        If RegressionPriorityFromDirection < 3 Then
            RegressionPriorityFromDirection = _
                RegressionPriorityFromDirection + 1
        End If
    ElseIf direction = "MOVED_TOWARD_OLD" Then
        If RegressionPriorityFromDirection > 1 Then
            RegressionPriorityFromDirection = _
                RegressionPriorityFromDirection - 1
        End If
    End If
End Function


Private Sub RegressionAddIssue( _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object, _
    ByVal family As String, _
    ByVal priority As Long, _
    ByVal sample As String)

    Const MAX_SAMPLES_PER_FAMILY As Long = 4
    Dim lngCount As Long
    Dim lngExistingPriority As Long
    Dim lngSampleNo As Long
    Dim strSampleKey As String

    If dictIssueCounts.Exists(family) Then
        lngCount = CLng(dictIssueCounts(family)) + 1
    Else
        lngCount = 1
    End If
    dictIssueCounts(family) = lngCount

    If dictIssuePriorities.Exists(family) Then
        lngExistingPriority = CLng(dictIssuePriorities(family))
        If priority > lngExistingPriority Then
            dictIssuePriorities(family) = priority
        End If
    Else
        dictIssuePriorities(family) = priority
    End If

    For lngSampleNo = 1 To MAX_SAMPLES_PER_FAMILY
        strSampleKey = family & "|" & CStr(lngSampleNo)

        If Not dictIssueSamples.Exists(strSampleKey) Then
            dictIssueSamples(strSampleKey) = _
                RegressionLimitText(sample, 1400)
            Exit For
        End If
    Next lngSampleNo
End Sub

Private Function RegressionPriorityLabel( _
