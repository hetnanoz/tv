Private Function DoxisV18RawFontEntry( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal fontAlias As String) As String

    Dim arrEntries As Variant
    Dim lngIndex As Long
    Dim strEntry As String
    Dim strSignature As String

    If pageNo < 1 Or pageNo > pdfDoc.PageCount Then Exit Function

    strSignature = pdfDoc.Pages(pageNo).FontForensicSignature
    If Len(strSignature) = 0 Then Exit Function
    If strSignature = "(none)" Or strSignature = "(unresolved)" Then Exit Function

    arrEntries = Split(strSignature, ";")

    For lngIndex = LBound(arrEntries) To UBound(arrEntries)
        strEntry = CStr(arrEntries(lngIndex))

        If Left$(strEntry, Len(fontAlias) + 1) = fontAlias & "|" Then
            DoxisV18RawFontEntry = strEntry
            Exit Function
        End If
    Next lngIndex
End Function

Private Function DoxisV18PipeField( _
    ByVal pipeText As String, _
    ByVal fieldName As String) As String

    Dim arrParts As Variant
    Dim lngIndex As Long
    Dim strPrefix As String
    Dim strValue As String

    strPrefix = fieldName & "="
    arrParts = Split(pipeText, "|")

    For lngIndex = LBound(arrParts) To UBound(arrParts)
        strValue = CStr(arrParts(lngIndex))

        If Left$(strValue, Len(strPrefix)) = strPrefix Then
            DoxisV18PipeField = Mid$(strValue, Len(strPrefix) + 1)
            Exit Function
        End If
    Next lngIndex

    DoxisV18PipeField = "(absent)"
End Function

Private Function DoxisV18DecodePdfName(ByVal pdfName As String) As String
    Dim lngCode As Long
    Dim lngIndex As Long
    Dim strHex As String
    Dim strResult As String

    lngIndex = 1

    Do While lngIndex <= Len(pdfName)
        If Mid$(pdfName, lngIndex, 1) = "#" And _
           lngIndex + 2 <= Len(pdfName) Then

            strHex = Mid$(pdfName, lngIndex + 1, 2)

            If DoxisV18IsHexByte(strHex) Then
                lngCode = CLng("&H" & strHex)
                strResult = strResult & Chr$(lngCode)
                lngIndex = lngIndex + 3
            Else
                strResult = strResult & Mid$(pdfName, lngIndex, 1)
                lngIndex = lngIndex + 1
            End If
        Else
            strResult = strResult & Mid$(pdfName, lngIndex, 1)
            lngIndex = lngIndex + 1
        End If
    Loop

    DoxisV18DecodePdfName = strResult
End Function

Private Function DoxisV18IsHexByte(ByVal textValue As String) As Boolean
    Dim lngIndex As Long
    Dim strChar As String

    If Len(textValue) <> 2 Then Exit Function

    For lngIndex = 1 To 2
        strChar = UCase$(Mid$(textValue, lngIndex, 1))

        If InStr(1, "0123456789ABCDEF", strChar, vbBinaryCompare) = 0 Then
            Exit Function
        End If
    Next lngIndex

    DoxisV18IsHexByte = True
End Function

Private Function DoxisV18FontSerializationPriority(ByVal role As String) As Long
    If role = "TOP_ISIN" Or InStr(1, role, "WHG", vbBinaryCompare) > 0 Then
        DoxisV18FontSerializationPriority = 2
    Else
        DoxisV18FontSerializationPriority = 1
    End If
End Function

Private Function DoxisTextTopologySnapshot( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal textIndex As Long, _
    ByVal role As String, _
    ByRef riskScore As Double, _
    ByRef separatorSignature As String) As String

    Const METHOD_NAME As String = "DoxisTextTopologySnapshot"
    Dim dblBandBottom As Double
    Dim dblGlyphBottom As Double
    Dim dblGlyphTop As Double
    Dim dblLineGap As Double
    Dim dblLineX As Double
    Dim dblTextEnd As Double
    Dim dblTextWidth As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCutIndex As Long
    Dim lngLineIndex As Long
    Dim strRisk As String

    On Error GoTo ErrorHandler

    riskScore = 0#
    separatorSignature = "(none)"

    dblTextWidth = EstimateTextWidth( _
        pdfDoc.Texts(textIndex).TextValue, _
        pdfDoc.Texts(textIndex).FontName, _
        pdfDoc.Texts(textIndex).FontSize)

    dblTextEnd = pdfDoc.Texts(textIndex).X + dblTextWidth
    dblGlyphBottom = pdfDoc.Texts(textIndex).Y - _
        (pdfDoc.Texts(textIndex).FontSize * DOXIS_TEXT_DESCENDER_FACTOR)
    dblGlyphTop = pdfDoc.Texts(textIndex).Y + _
        (pdfDoc.Texts(textIndex).FontSize * DOXIS_TEXT_ASCENDER_FACTOR)
    dblBandBottom = pdfDoc.Texts(textIndex).Y - DOXIS_SEGMENTATION_BASELINE_BELOW

    lngLineIndex = DoxisFindMostRelevantVerticalSeparator( _
        pdfDoc, _
        pageNo, _
        pdfDoc.Texts(textIndex).X, _
        dblTextEnd, _
        dblGlyphBottom, _
        dblGlyphTop, _
        dblBandBottom, _
        pdfDoc.Texts(textIndex).Y, _
        dblLineGap, _
        dblLineX)

    If lngLineIndex >= 0 Then
        separatorSignature = DoxisLineSignature(pdfDoc.Lines(lngLineIndex))
        lngCutIndex = DoxisPredictCutCharacter( _
            pdfDoc.Texts(textIndex).TextValue, _
            pdfDoc.Texts(textIndex).FontName, _
            pdfDoc.Texts(textIndex).FontSize, _
            pdfDoc.Texts(textIndex).X, _
            dblLineX)

        riskScore = DoxisSeparatorRiskScore( _
            pdfDoc.Lines(lngLineIndex), _
            dblLineGap, _
            dblLineX, _
            pdfDoc.Texts(textIndex).X, _
            dblTextEnd, _
            dblGlyphBottom, _
            dblGlyphTop)

        strRisk = DoxisRiskLabel(riskScore)
    Else
        lngCutIndex = 0
        dblLineGap = 999#
        strRisk = "NONE"
    End If

    DoxisTextTopologySnapshot = _
        "text=" & SanitizeReportText(pdfDoc.Texts(textIndex).TextValue) & _
        ",x=" & NumTxt(pdfDoc.Texts(textIndex).X) & _
        ",y=" & NumTxt(pdfDoc.Texts(textIndex).Y) & _
        ",font=" & pdfDoc.Texts(textIndex).FontName & "@" & NumTxt(pdfDoc.Texts(textIndex).FontSize) & _
        ",estW=" & NumTxt(dblTextWidth) & _
        ",risk=" & strRisk & _
        ",riskScore=" & NumTxt(riskScore) & _
        ",separatorGapPt=" & DoxisOptionalNumber(dblLineGap) & _
        ",gapPx300=" & DoxisOptionalNumber(DoxisPointsToPixels(dblLineGap, DOXIS_RASTER_PROXY_DPI_LOW)) & _
        ",gapPx600=" & DoxisOptionalNumber(DoxisPointsToPixels(dblLineGap, DOXIS_RASTER_PROXY_DPI_HIGH)) & _
        ",predictedCutAfterChars=" & CStr(lngCutIndex) & _
        ",separator=" & separatorSignature

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    DoxisTextTopologySnapshot = "ERROR"
    riskScore = 0#
    separatorSignature = "(error)"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo;textIndex;role", _
        pageNo, _
        textIndex, _
        role

    errorManager.save
    Resume ExitFunction
End Function

Private Function DoxisFindMostRelevantVerticalSeparator( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal textX As Double, _
    ByVal textEndX As Double, _
    ByVal glyphBottom As Double, _
    ByVal glyphTop As Double, _
    ByVal segmentationBottom As Double, _
    ByVal baselineY As Double, _
    ByRef bestGap As Double, _
    ByRef bestLineX As Double) As Long

    Dim dblGap As Double
    Dim dblLineX As Double
    Dim dblScore As Double
    Dim dblBestScore As Double
    Dim dblYMax As Double
    Dim dblYMin As Double
    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngStart As Long

    DoxisFindMostRelevantVerticalSeparator = -1
    bestGap = 999#
    bestLineX = 0#
    dblBestScore = 1E+30

    If pageNo < 1 Or pageNo > pdfDoc.PageCount Then Exit Function

    lngStart = pdfDoc.Pages(pageNo).LineStart
    lngEnd = lngStart + pdfDoc.Pages(pageNo).LineCount - 1

    For lngIndex = lngStart To lngEnd
        If Abs(pdfDoc.Lines(lngIndex).X1 - pdfDoc.Lines(lngIndex).X2) <= _
           DOXIS_LINE_X_TOLERANCE Then

            dblLineX = _
                (pdfDoc.Lines(lngIndex).X1 + pdfDoc.Lines(lngIndex).X2) / 2#

            If dblLineX >= textX + DOXIS_TEXT_X_MARGIN And _
               dblLineX <= textEndX - DOXIS_TEXT_X_MARGIN Then

                dblYMin = MinDouble( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)

                dblYMax = MaxDouble( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)

                dblGap = DoxisVerticalGapToBand( _
                    dblYMin, _
                    dblYMax, _
                    glyphBottom, _
                    glyphTop)

                If dblGap > DOXIS_NEAR_SEPARATOR_GAP Then
                    dblGap = DoxisVerticalGapToBand( _
                        dblYMin, _
                        dblYMax, _
                        segmentationBottom, _
                        baselineY + 1#)
                End If

                If dblGap <= DOXIS_NEAR_SEPARATOR_GAP Then
                    dblScore = _
                        dblGap * 100# + _
                        Abs(dblLineX - ((textX + textEndX) / 2#))

                    If dblScore < dblBestScore Then
                        dblBestScore = dblScore
                        bestGap = dblGap
                        bestLineX = dblLineX
                        DoxisFindMostRelevantVerticalSeparator = lngIndex
                    End If
                End If
            End If
        End If
    Next lngIndex
End Function

Private Function DoxisSeparatorRiskScore( _
    ByRef pdfLine As tPdfLine, _
    ByVal lineGap As Double, _
    ByVal lineX As Double, _
    ByVal textX As Double, _
    ByVal textEndX As Double, _
    ByVal glyphBottom As Double, _
    ByVal glyphTop As Double) As Double

    Dim dblScore As Double
    Dim dblYMax As Double
    Dim dblYMin As Double

    dblYMin = MinDouble(pdfLine.Y1, pdfLine.Y2)
    dblYMax = MaxDouble(pdfLine.Y1, pdfLine.Y2)

    If lineX > textX And lineX < textEndX Then
        dblScore = dblScore + 30#
    End If

    If dblYMax >= glyphBottom And dblYMin <= glyphTop Then
        dblScore = dblScore + 70#
    ElseIf lineGap <= 1# Then
        dblScore = dblScore + 45#
    ElseIf lineGap <= 3# Then
        dblScore = dblScore + 30#
    ElseIf lineGap <= DOXIS_NEAR_SEPARATOR_GAP Then
        dblScore = dblScore + 15#
    End If

    If LCase$(pdfLine.SourceOperator) = "re" Then
        dblScore = dblScore + 8#
    End If

    If pdfLine.PaintOperator <> "S" Then
        dblScore = dblScore + 4#
    End If

    If pdfLine.LineWidth > 0.01 Then
        dblScore = dblScore + MinDouble(10#, pdfLine.LineWidth * 10#)
    End If

    DoxisSeparatorRiskScore = dblScore
End Function

Private Function DoxisRiskLabel(ByVal riskScore As Double) As String
    If riskScore >= 90# Then
        DoxisRiskLabel = "CROSSING_OR_VERY_HIGH"
    ElseIf riskScore >= 60# Then
        DoxisRiskLabel = "HIGH"
    ElseIf riskScore >= 40# Then
        DoxisRiskLabel = "MEDIUM"
    ElseIf riskScore > 0# Then
        DoxisRiskLabel = "NEAR"
    Else
        DoxisRiskLabel = "NONE"
    End If
End Function

Private Function DoxisPredictCutCharacter( _
    ByVal textValue As String, _
    ByVal fontName As String, _
    ByVal fontSize As Double, _
    ByVal textX As Double, _
    ByVal separatorX As Double) As Long

    Dim dblCursor As Double
    Dim lngIndex As Long

    DoxisPredictCutCharacter = 0
    dblCursor = textX

    If separatorX <= textX Then Exit Function

    For lngIndex = 1 To Len(textValue)
        dblCursor = dblCursor + DoxisCharacterWidthPoints( _
            Mid$(textValue, lngIndex, 1), _
            fontName, _
            fontSize)

        If dblCursor >= separatorX Then
            DoxisPredictCutCharacter = lngIndex - 1
            Exit Function
        End If
    Next lngIndex

    DoxisPredictCutCharacter = Len(textValue)
End Function

Private Function DoxisCharacterWidthPoints( _
    ByVal characterValue As String, _
    ByVal fontName As String, _
    ByVal fontSize As Double) As Double

    Dim dblFactor As Double
    Dim dblUnits As Double

    Select Case characterValue
        Case " "
            dblUnits = 0.25
        Case "i", "l", "I", ".", ",", ":", ";", "!", "'", "|"
            dblUnits = 0.25
        Case "M", "W", "m", "w", "@", "%"
            dblUnits = 0.85
        Case "0" To "9"
            dblUnits = 0.5
        Case "A" To "Z"
            dblUnits = 0.65
        Case Else
            dblUnits = 0.48
    End Select

    dblFactor = 1#
    If InStr(1, fontName, "Bold", vbTextCompare) > 0 Then
        dblFactor = 1.03
    End If

    DoxisCharacterWidthPoints = dblUnits * fontSize * dblFactor
End Function

Private Function DoxisVerticalGapToBand( _
    ByVal lineMinY As Double, _
    ByVal lineMaxY As Double, _
    ByVal bandMinY As Double, _
    ByVal bandMaxY As Double) As Double

    If lineMaxY < bandMinY Then
        DoxisVerticalGapToBand = bandMinY - lineMaxY
    ElseIf lineMinY > bandMaxY Then
        DoxisVerticalGapToBand = lineMinY - bandMaxY
    Else
        DoxisVerticalGapToBand = 0#
    End If
End Function

Private Function DoxisLineSignature(ByRef pdfLine As tPdfLine) As String
    DoxisLineSignature = _
        "x=" & NumTxt((pdfLine.X1 + pdfLine.X2) / 2#) & _
        ",y=" & NumTxt(MinDouble(pdfLine.Y1, pdfLine.Y2)) & _
        ".." & NumTxt(MaxDouble(pdfLine.Y1, pdfLine.Y2)) & _
        ",w=" & NumTxt(pdfLine.LineWidth) & _
        ",source=" & pdfLine.SourceOperator & _
        ",paint=" & pdfLine.PaintOperator & _
        ",color=" & pdfLine.StrokeColor
End Function

Private Function DoxisPointsToPixels( _
    ByVal pointsValue As Double, _
    ByVal dpi As Double) As Double

    If pointsValue >= 900# Then
        DoxisPointsToPixels = pointsValue
    Else
        DoxisPointsToPixels = pointsValue * dpi / 72#
    End If
End Function

Private Function DoxisOptionalNumber(ByVal value As Double) As String
    If value >= 900# Then
        DoxisOptionalNumber = "NA"
    Else
        DoxisOptionalNumber = NumTxt(value)
    End If
End Function

Private Function DoxisRolePriority(ByVal role As String) As Long
    If role = "TOP_ISIN" Then
        DoxisRolePriority = 3
    ElseIf InStr(1, role, "WHG", vbBinaryCompare) > 0 Then
        DoxisRolePriority = 3
    ElseIf role = "TOP_SCHLUSSTAG" Or role = "TOP_VALUTATAG" Then
        DoxisRolePriority = 2
    Else
        DoxisRolePriority = 1
    End If
End Function

Private Sub DoxisAddIssue( _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object, _
    ByVal family As String, _
    ByVal priority As Long, _
    ByVal sampleText As String)

    Dim lngCount As Long
    Dim lngSampleNo As Long
    Dim strKey As String

    If dictIssueCounts.Exists(family) Then
        dictIssueCounts(family) = CLng(dictIssueCounts(family)) + 1

        If priority > CLng(dictIssuePriorities(family)) Then
            dictIssuePriorities(family) = priority
        End If
    Else
        dictIssueCounts.Add family, 1
        dictIssuePriorities.Add family, priority
    End If

    lngCount = CLng(dictIssueCounts(family))
    lngSampleNo = lngCount

    If lngSampleNo > DOXIS_MAX_SAMPLES_PER_FAMILY Then Exit Sub

    strKey = family & "|" & CStr(lngSampleNo)

    If Not dictIssueSamples.Exists(strKey) Then
        dictIssueSamples.Add strKey, sampleText
    End If
End Sub

Private Sub DoxisWriteSuperShortReport( _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchors As Object, _
    ByVal betterAnchors As Object, _
    ByVal currentAnchors As Object, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object, _
    ByVal outputPath As String)

    Const METHOD_NAME As String = "DoxisWriteSuperShortReport"
    Dim arrKeys As Variant
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCritical As Long
    Dim lngFile As Long
    Dim lngHigh As Long
    Dim lngIndex As Long
    Dim lngPriority As Long
    Dim lngReview As Long
    Dim lngSample As Long
    Dim strFamily As String
    Dim strSampleKey As String
    Dim strStatus As String

    On Error GoTo ErrorHandler

    If dictIssueCounts.Count > 0 Then
        arrKeys = SortedDictionaryKeys(dictIssueCounts)

        For lngIndex = LBound(arrKeys) To UBound(arrKeys)
            strFamily = CStr(arrKeys(lngIndex))

            Select Case CLng(dictIssuePriorities(strFamily))
                Case Is >= 3
                    lngCritical = lngCritical + CLng(dictIssueCounts(strFamily))
                Case 2
                    lngHigh = lngHigh + CLng(dictIssueCounts(strFamily))
                Case Else
                    lngReview = lngReview + CLng(dictIssueCounts(strFamily))
            End Select
        Next lngIndex
    End If

    If lngCritical > 0 Then
        strStatus = "ACTION_REQUIRED_CRITICAL"
    ElseIf lngHigh > 0 Then
        strStatus = "ACTION_REQUIRED_HIGH"
    Else
        strStatus = "NO_TRANSACTION_ANCHORED_PARSER_REGRESSION_FOUND"
    End If

    lngFile = FreeFile
    Open outputPath For Output Access Write As #lngFile

    Print #lngFile, "ORACLE_DOXIS_TRANSACTION_ANCHORED_SUPER_SHORT_V19_TEXT_STREAM"
    Print #lngFile, "OLD_ORACLE|" & oldDoc.PdfPath
    Print #lngFile, "BETTER_PARSING|" & betterDoc.PdfPath
    Print #lngFile, "CURRENT|" & currentDoc.PdfPath
    Print #lngFile, _
        "RESULT|status=" & strStatus & _
        "|families=" & CStr(dictIssueCounts.Count) & _
        "|criticalEvents=" & CStr(lngCritical) & _
        "|highEvents=" & CStr(lngHigh) & _
        "|reviewEvents=" & CStr(lngReview)
    Print #lngFile, _
        "ANCHORS|OLD=" & CStr(oldAnchors.Count) & _
        "|BETTER=" & CStr(betterAnchors.Count) & _
        "|CURRENT=" & CStr(currentAnchors.Count)
    Print #lngFile, _
        "MODEL|Transaction-number anchored. OLD Oracle is the gold standard. BETTER is behavioural evidence only. V19 adds raw text-stream topology: show/position operators, BT grouping, text state, clip state, CTM and local operator windows."
    Print #lngFile, _
        "ISIN|Fixed x=639 and global visible/invisible-X cuts are blocking only when CURRENT is worse than OLD Oracle; BETTER is shown as a behavioural control."
    Print #lngFile, _
        "IMPORTANT|BETTER_PARSING_IS_NOT_A_GOLD_STANDARD=TRUE|A BETTER-only difference is not a blocker unless OLD supports the same direction."
    Print #lngFile, _
        "TEXT_STREAM|Blocking target checks now include show operator, positioning operator, BT grouping, text state, clip state and CTM. Local operator windows are retained as parser-tolerance evidence."
    Print #lngFile, _
        "PROVENANCE|PRODUCER_OLD=" & SanitizeReportText(oldDoc.ProducerValue) & _
        "|PRODUCER_BETTER=" & SanitizeReportText(betterDoc.ProducerValue) & _
        "|PRODUCER_CURRENT=" & SanitizeReportText(currentDoc.ProducerValue) & _
        "|CREATOR_OLD=" & SanitizeReportText(oldDoc.CreatorValue) & _
        "|CREATOR_BETTER=" & SanitizeReportText(betterDoc.CreatorValue) & _
        "|CREATOR_CURRENT=" & SanitizeReportText(currentDoc.CreatorValue)
    Print #lngFile, _
        "PAINTED_PRIMITIVES" & _
        "|OLD_ml=" & CStr(DoxisV182CountPaintedPrimitive(oldDoc, "m/l")) & _
        "|OLD_re=" & CStr(DoxisV182CountPaintedPrimitive(oldDoc, "re")) & _
        "|BETTER_ml=" & CStr(DoxisV182CountPaintedPrimitive(betterDoc, "m/l")) & _
        "|BETTER_re=" & CStr(DoxisV182CountPaintedPrimitive(betterDoc, "re")) & _
        "|CURRENT_ml=" & CStr(DoxisV182CountPaintedPrimitive(currentDoc, "m/l")) & _
        "|CURRENT_re=" & CStr(DoxisV182CountPaintedPrimitive(currentDoc, "re"))
    Print #lngFile, _
        "RE_N_CAPTURE|OLD_segments=" & CStr(oldDoc.NoPaintLineCount) & _
        "|BETTER_segments=" & CStr(betterDoc.NoPaintLineCount) & _
        "|CURRENT_segments=" & CStr(currentDoc.NoPaintLineCount) & _
        "|x468=" & CStr(DoxisV181CountNoPaintReVerticalAtX(oldDoc, 468#)) & "/" & _
                     CStr(DoxisV181CountNoPaintReVerticalAtX(betterDoc, 468#)) & "/" & _
                     CStr(DoxisV181CountNoPaintReVerticalAtX(currentDoc, 468#)) & _
        "|x639=" & CStr(DoxisV181CountNoPaintReVerticalAtX(oldDoc, 639#)) & "/" & _
                     CStr(DoxisV181CountNoPaintReVerticalAtX(betterDoc, 639#)) & "/" & _
                     CStr(DoxisV181CountNoPaintReVerticalAtX(currentDoc, 639#)) & _
        "|order=OLD/BETTER/CURRENT"

    If lngCritical = 0 And lngHigh = 0 Then
        Print #lngFile, "BREAKING_SIGNALS|NONE"

        If lngReview > 0 Then
            Print #lngFile, _
                "REVIEW_ONLY|There are non-blocking value/anchor differences, but no V18 transaction-anchored parser regression signal."
        End If

        Print #lngFile, _
            "NEXT|No CURRENT-vs-OLD parser-facing regression was found. If client behaviour still differs, inspect post-processing/provenance and the DOXISLoader extraction profile/configuration."
        GoTo ExitSub
    End If

    Print #lngFile, ""
    Print #lngFile, "BREAKING_SIGNALS"

    For lngPriority = 3 To 2 Step -1
        arrKeys = SortedDictionaryKeys(dictIssueCounts)

        For lngIndex = LBound(arrKeys) To UBound(arrKeys)
            strFamily = CStr(arrKeys(lngIndex))

            If CLng(dictIssuePriorities(strFamily)) = lngPriority Then
                Print #lngFile, _
                    "ISSUE" & _
                    "|priority=" & RegressionPriorityLabel(lngPriority) & _
                    "|family=" & strFamily & _
                    "|count=" & CStr(dictIssueCounts(strFamily))

                For lngSample = 1 To DOXIS_MAX_SAMPLES_PER_FAMILY
                    strSampleKey = strFamily & "|" & CStr(lngSample)

                    If dictIssueSamples.Exists(strSampleKey) Then
                        Print #lngFile, _
                            "DETAIL" & _
                            "|family=" & strFamily & _
                            "|" & CStr(dictIssueSamples(strSampleKey))
                    End If
                Next lngSample
            End If
        Next lngIndex
    Next lngPriority

    Print #lngFile, ""
    Print #lngFile, "INTERPRETATION_PRIORITY"
    Print #lngFile, _
        "1|TRIAD_SEPARATOR_PRIMITIVE_REGRESSION_X468/X639: strongest signal when OLD=BETTER and CURRENT alone changes m/l versus re and/or the exact Y span."
    Print #lngFile, _
        "2|ROW_INTRUSION_REGRESSION_X468/X639: direct transaction-anchored check catches >0.01pt CURRENT top-span growth, including the observed 0.04pt class."
    Print #lngFile, _
        "3|FONT_*_CURRENT_DIFFERS_OLD: inspect BaseFont literal versus #xx serialization and size only when CURRENT truly differs from OLD; alias-only differences are excluded from raw-core comparison."
    Print #lngFile, _
        "4|GLOBAL_INVISIBLE_RE_N_* is blocking only versus OLD. BETTER having zero re-n paths no longer creates a false regression by itself."
    Print #lngFile, _
        "5|PROVENANCE/PAINTED_PRIMITIVES: if CURRENT says re while the VBA source emits m/l, different Producer/Creator or a radically changed primitive profile supports post-processing/wrong-build rather than a geometry formula bug."

    Print #lngFile, ""
    Print #lngFile, _
        "NEXT|Send this V18.2 SUPER_SHORT first. Use DETAIL only for families that remain CRITICAL/HIGH after OLD-based filtering."

ExitSub:
    If lngFile <> 0 Then Close #lngFile
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "outputPath", _
        outputPath

    errorManager.save
    Resume ExitSub
End Sub

Private Function BuildDoxisTopologyDetailOutputPath( _
    ByVal betterPdfPath As String, _
    ByVal currentPdfPath As String) As String

    Dim lngSlashPosition As Long
    Dim strFolder As String

    lngSlashPosition = InStrRev(currentPdfPath, "\")
    If lngSlashPosition > 0 Then
        strFolder = Left$(currentPdfPath, lngSlashPosition)
    End If

    BuildDoxisTopologyDetailOutputPath = _
        strFolder & _
        FileBaseName(betterPdfPath) & _
        "_VS_" & _
        FileBaseName(currentPdfPath) & _
        "_DOXIS_V19_TEXT_STREAM_DETAIL.txt"
End Function

