    Dim strToken As String

    On Error GoTo ErrorHandler

    lngTokenCount = Tokenize(content, arrTokens)
    ReDim events(0 To lngTokenCount)

    For lngIndex = 0 To lngTokenCount - 1
        strToken = arrTokens(lngIndex)

        If IsAuditOperator(strToken) Then
            If includeOperands Then
                events(lngCount) = _
                    RegressionOperatorSummary( _
                        strToken, _
                        h0, _
                        h1, _
                        h2, _
                        h3, _
                        h4, _
                        h5)
            Else
                events(lngCount) = strToken
            End If

            lngCount = lngCount + 1
        End If

        h5 = h4
        h4 = h3
        h3 = h2
        h2 = h1
        h1 = h0
        h0 = strToken
    Next lngIndex

    RegressionBuildOperatorEventArray = lngCount

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    ReDim events(0 To 0)
    RegressionBuildOperatorEventArray = 0

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
