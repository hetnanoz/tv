Private Function RegressionOperatorSequenceSignature( _
    ByVal content As String, _
    ByVal includeOperands As Boolean) As String

    Const METHOD_NAME As String = "RegressionOperatorSequenceSignature"
    Dim arrTokens() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim h0 As String
    Dim h1 As String
    Dim h2 As String
    Dim h3 As String
    Dim h4 As String
    Dim h5 As String
    Dim lngIndex As Long
    Dim lngTokenCount As Long
    Dim strResult As String
    Dim strToken As String

    On Error GoTo ErrorHandler

    lngTokenCount = Tokenize(content, arrTokens)

    For lngIndex = 0 To lngTokenCount - 1
        strToken = arrTokens(lngIndex)

        If IsAuditOperator(strToken) Then
            If Len(strResult) > 0 Then
                strResult = strResult & ";"
            End If

            If includeOperands Then
                strResult = strResult & _
                    RegressionOperatorSummary( _
                        strToken, _
                        h0, _
                        h1, _
                        h2, _
                        h3, _
                        h4, _
                        h5)
            Else
                strResult = strResult & strToken
            End If
        End If

        h5 = h4
        h4 = h3
        h3 = h2
        h2 = h1
        h1 = h0
        h0 = strToken
    Next lngIndex

    RegressionOperatorSequenceSignature = strResult

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    RegressionOperatorSequenceSignature = "(error)"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "contentLength;includeOperands", _
        Len(content), _
        includeOperands

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionFirstOperatorDifferenceSummary( _
    ByVal goodContent As String, _
    ByVal currentContent As String, _
    ByVal includeOperands As Boolean) As String

    Const METHOD_NAME As String = "RegressionFirstOperatorDifferenceSummary"
    Dim arrCurrent() As String
    Dim arrGood() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCurrentCount As Long
    Dim lngGoodCount As Long
    Dim lngIndex As Long
    Dim lngLimit As Long

    On Error GoTo ErrorHandler

    lngGoodCount = RegressionBuildOperatorEventArray( _
        goodContent, _
        includeOperands, _
        arrGood)

    lngCurrentCount = RegressionBuildOperatorEventArray( _
        currentContent, _
        includeOperands, _
        arrCurrent)

    lngLimit = lngGoodCount
    If lngCurrentCount < lngLimit Then
        lngLimit = lngCurrentCount
    End If

    For lngIndex = 0 To lngLimit - 1
        If arrGood(lngIndex) <> arrCurrent(lngIndex) Then
            RegressionFirstOperatorDifferenceSummary = _
                "firstDiffOrdinal=" & CStr(lngIndex + 1) & _
                "|GOOD_WINDOW=" & _
                RegressionArrayWindow(arrGood, lngGoodCount, lngIndex, 5) & _
                "|CURRENT_WINDOW=" & _
                RegressionArrayWindow(arrCurrent, lngCurrentCount, lngIndex, 5)
            GoTo ExitFunction
        End If
    Next lngIndex

    If lngGoodCount <> lngCurrentCount Then
        RegressionFirstOperatorDifferenceSummary = _
            "firstDiffOrdinal=" & CStr(lngLimit + 1) & _
            "|GOOD_COUNT=" & CStr(lngGoodCount) & _
            "|CURRENT_COUNT=" & CStr(lngCurrentCount) & _
            "|GOOD_TAIL=" & _
            RegressionArrayWindow(arrGood, lngGoodCount, lngLimit, 5) & _
            "|CURRENT_TAIL=" & _
            RegressionArrayWindow(arrCurrent, lngCurrentCount, lngLimit, 5)
    Else
        RegressionFirstOperatorDifferenceSummary = _
            "firstDiffOrdinal=(none)"
    End If

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    RegressionFirstOperatorDifferenceSummary = "(error)"

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "includeOperands", _
        includeOperands

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionBuildOperatorEventArray( _
    ByVal content As String, _
    ByVal includeOperands As Boolean, _
    ByRef events() As String) As Long

    Const METHOD_NAME As String = "RegressionBuildOperatorEventArray"
    Dim arrTokens() As String
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim h0 As String
    Dim h1 As String
    Dim h2 As String
    Dim h3 As String
    Dim h4 As String
    Dim h5 As String
