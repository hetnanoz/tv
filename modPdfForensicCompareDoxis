Private Function RegressionBuildRectangleEventDictionary( _
    ByVal content As String, _
    ByVal mode As String, _
    ByVal targetX As Double) As Object

    Const METHOD_NAME As String = "RegressionBuildRectangleEventDictionary"
    Dim arrPending() As String
    Dim arrTokens() As String
    Dim dblLeft As Double
    Dim dblRight As Double
    Dim dictEvents As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim h0 As String
    Dim h1 As String
    Dim h2 As String
    Dim h3 As String
    Dim h4 As String
    Dim h5 As String
    Dim lngIndex As Long
    Dim lngPendingCount As Long
    Dim lngPendingIndex As Long
    Dim lngTokenCount As Long
    Dim strEvent As String
    Dim strFinalizer As String
    Dim strToken As String
    Dim strX As String
    Dim strY As String
    Dim strW As String
    Dim strH As String
    Dim varParts As Variant

    On Error GoTo ErrorHandler

    Set dictEvents = CreateObject("Scripting.Dictionary")
    ReDim arrPending(0 To 31)

    lngTokenCount = Tokenize(content, arrTokens)

    For lngIndex = 0 To lngTokenCount - 1
        strToken = arrTokens(lngIndex)

        If strToken = "re" Then
            If lngPendingCount > UBound(arrPending) Then
                ReDim Preserve arrPending(0 To UBound(arrPending) * 2)
            End If

            arrPending(lngPendingCount) = _
                NumTxt(Val(h3)) & "," & _
                NumTxt(Val(h2)) & "," & _
                NumTxt(Val(h1)) & "," & _
                NumTxt(Val(h0))

            lngPendingCount = lngPendingCount + 1

        ElseIf RegressionIsPathFinalizer(strToken) Then
            strFinalizer = strToken

            For lngPendingIndex = 0 To lngPendingCount - 1
                varParts = Split( _
                    arrPending(lngPendingIndex), _
                    ",")

                If UBound(varParts) >= 3 Then
                    strX = CStr(varParts(0))
                    strY = CStr(varParts(1))
                    strW = CStr(varParts(2))
                    strH = CStr(varParts(3))

                    If mode = "INVISIBLE" Then
                        If strFinalizer = "n" Then
                            strEvent = _
                                "re(" & strX & "," & strY & "," & _
                                strW & "," & strH & ")->n"

                            Call IncrementDictionaryValue( _
                                dictEvents, _
                                strEvent)
                        End If

                    ElseIf mode = "EDGE" Then
                        dblLeft = Val(strX)
                        dblRight = dblLeft + Val(strW)

                        If Abs(dblLeft - targetX) <= TARGET_TOLERANCE Or _
                           Abs(dblRight - targetX) <= TARGET_TOLERANCE Then

                            strEvent = _
                                "edgeX=" & NumTxt(targetX) & _
                                ",rect=" & strX & "," & strY & "," & _
                                strW & "," & strH & _
                                ",final=" & strFinalizer

                            Call IncrementDictionaryValue( _
                                dictEvents, _
                                strEvent)
                        End If
                    End If
                End If
            Next lngPendingIndex

            lngPendingCount = 0
        End If

        h5 = h4
        h4 = h3
        h3 = h2
        h2 = h1
        h1 = h0
        h0 = strToken
    Next lngIndex

    Set RegressionBuildRectangleEventDictionary = dictEvents

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Set RegressionBuildRectangleEventDictionary = Nothing

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "mode;targetX", _
        mode, _
        targetX

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionIsPathFinalizer( _
    ByVal operatorName As String) As Boolean

    Select Case operatorName
        Case "S", "s", "B", "B*", "b", "b*", _
             "f", "f*", "F", "n"
            RegressionIsPathFinalizer = True
    End Select
End Function

Private Function RegressionBuildTextContextMap( _
    ByVal content As String) As Object

    Const METHOD_NAME As String = "RegressionBuildTextContextMap"
    Dim arrOpNames() As String
    Dim arrOpSummaries() As String
    Dim arrTokens() As String
    Dim blnInArray As Boolean
    Dim dblFontSize As Double
    Dim dictEventFont As Object
    Dim dictEventOp As Object
    Dim dictResult As Object
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim h0 As String
    Dim h1 As String
    Dim h2 As String
    Dim h3 As String
    Dim h4 As String
    Dim h5 As String
    Dim lngCurrentOp As Long
    Dim lngIndex As Long
    Dim lngKeyIndex As Long
    Dim lngOpCount As Long
    Dim lngTextCount As Long
    Dim lngTokenCount As Long
    Dim strArrayText As String
    Dim strContext As String
    Dim strFontName As String
    Dim strKey As String
    Dim strLastText As String
    Dim strTextValue As String
    Dim strToken As String
    Dim varKeys As Variant

    On Error GoTo ErrorHandler

    Set dictEventFont = CreateObject("Scripting.Dictionary")
    Set dictEventOp = CreateObject("Scripting.Dictionary")
    Set dictResult = CreateObject("Scripting.Dictionary")

    lngTokenCount = Tokenize(content, arrTokens)
    ReDim arrOpNames(0 To lngTokenCount)
    ReDim arrOpSummaries(0 To lngTokenCount)

    For lngIndex = 0 To lngTokenCount - 1
        strToken = arrTokens(lngIndex)
        lngCurrentOp = -1

        If IsAuditOperator(strToken) Then
            arrOpNames(lngOpCount) = strToken
            arrOpSummaries(lngOpCount) = _
                RegressionOperatorSummary( _
                    strToken, _
                    h0, _
                    h1, _
                    h2, _
                    h3, _
                    h4, _
                    h5)

            lngCurrentOp = lngOpCount
            lngOpCount = lngOpCount + 1
        End If

        Select Case strToken
            Case "BT"
                strLastText = vbNullString
                strArrayText = vbNullString

            Case "Tf"
                dblFontSize = Val(h0)
                strFontName = h1

            Case "Tj", "'"
                strTextValue = strLastText

                If Len(Trim$(strTextValue)) > 0 Then
                    lngTextCount = lngTextCount + 1
                    strKey = CStr(lngTextCount)
                    dictEventOp(strKey) = lngCurrentOp
                    dictEventFont(strKey) = _
                        strFontName & "@" & NumTxt(dblFontSize)
                End If

            Case "TJ"
                strTextValue = strArrayText

                If Len(Trim$(strTextValue)) > 0 Then
                    lngTextCount = lngTextCount + 1
                    strKey = CStr(lngTextCount)
                    dictEventOp(strKey) = lngCurrentOp
                    dictEventFont(strKey) = _
                        strFontName & "@" & NumTxt(dblFontSize)
                End If

                strArrayText = vbNullString

            Case "["
                blnInArray = True
                strArrayText = vbNullString

            Case "]"
                blnInArray = False
        End Select

        If Len(strToken) > 0 Then
            If Left$(strToken, 1) = "(" Then
                strLastText = Mid$(strToken, 2)

                If blnInArray Then
                    strArrayText = _
                        strArrayText & strLastText
                End If
            End If
        End If

        h5 = h4
        h4 = h3
        h3 = h2
        h2 = h1
        h1 = h0
        h0 = strToken
    Next lngIndex

    If dictEventOp.Count > 0 Then
        varKeys = dictEventOp.Keys

        For lngKeyIndex = LBound(varKeys) To UBound(varKeys)
            strKey = CStr(varKeys(lngKeyIndex))
            lngCurrentOp = CLng(dictEventOp(strKey))

            strContext = _
                "FONT=" & CStr(dictEventFont(strKey)) & _
                "||OPS=" & _
                RegressionRelativeArrayWindow( _
                    arrOpNames, _
                    lngOpCount, _
                    lngCurrentOp, _
                    7) & _
                "||PATH=" & _
                RegressionNearestPathContext( _
                    arrOpNames, _
                    arrOpSummaries, _
                    lngOpCount, _
                    lngCurrentOp) & _
                "||RAW=" & _
                RegressionRelativeArrayWindow( _
                    arrOpSummaries, _
                    lngOpCount, _
                    lngCurrentOp, _
                    7)

            dictResult(strKey) = strContext
        Next lngKeyIndex
    End If

    Set RegressionBuildTextContextMap = dictResult

ExitFunction:
    Set dictEventFont = Nothing
    Set dictEventOp = Nothing
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    Set RegressionBuildTextContextMap = Nothing

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "contentLength", _
        Len(content)

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionRelativeArrayWindow( _
    ByRef values() As String, _
    ByVal valueCount As Long, _
    ByVal centreIndex As Long, _
    ByVal radius As Long) As String

    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngRelative As Long
    Dim lngStart As Long
    Dim strResult As String

    If valueCount <= 0 Or centreIndex < 0 Then
        RegressionRelativeArrayWindow = "(none)"
        Exit Function
    End If

    lngStart = centreIndex - radius
    If lngStart < 0 Then
        lngStart = 0
    End If

    lngEnd = centreIndex + radius
    If lngEnd > valueCount - 1 Then
        lngEnd = valueCount - 1
    End If

    For lngIndex = lngStart To lngEnd
        If Len(strResult) > 0 Then
            strResult = strResult & ">"
        End If

        lngRelative = lngIndex - centreIndex
        strResult = strResult & _
            CStr(lngRelative) & ":" & values(lngIndex)
    Next lngIndex

    RegressionRelativeArrayWindow = _
        RegressionLimitText(strResult, 1800)
End Function

Private Function RegressionNearestPathContext( _
    ByRef opNames() As String, _
    ByRef opSummaries() As String, _
    ByVal opCount As Long, _
    ByVal centreIndex As Long) As String

    Dim lngDistance As Long
    Dim lngIndex As Long
    Dim strNext As String
    Dim strPrevious As String

    For lngIndex = centreIndex - 1 To 0 Step -1
        If RegressionIsPathOperator(opNames(lngIndex)) Then
            lngDistance = centreIndex - lngIndex
            strPrevious = _
                "-" & CStr(lngDistance) & ":" & _
                opSummaries(lngIndex)
            Exit For
        End If
    Next lngIndex

    For lngIndex = centreIndex + 1 To opCount - 1
        If RegressionIsPathOperator(opNames(lngIndex)) Then
            lngDistance = lngIndex - centreIndex
            strNext = _
                "+" & CStr(lngDistance) & ":" & _
                opSummaries(lngIndex)
            Exit For
        End If
    Next lngIndex

    If Len(strPrevious) = 0 Then
        strPrevious = "(none)"
    End If

    If Len(strNext) = 0 Then
        strNext = "(none)"
    End If

    RegressionNearestPathContext = _
        "prev=" & strPrevious & _
        ",next=" & strNext
End Function

Private Function RegressionIsPathOperator( _
    ByVal operatorName As String) As Boolean

    Select Case operatorName
        Case "m", "l", "h", "re", _
             "S", "s", "B", "B*", "b", "b*", _
             "f", "f*", "F", "n"
            RegressionIsPathOperator = True
    End Select
End Function

Private Function RegressionContextPart( _
    ByVal contextValue As String, _
    ByVal partName As String) As String

    Dim arrParts As Variant
    Dim lngIndex As Long
    Dim strPrefix As String

    strPrefix = partName & "="
    arrParts = Split(contextValue, "||")

    For lngIndex = LBound(arrParts) To UBound(arrParts)
        If Left$(CStr(arrParts(lngIndex)), Len(strPrefix)) = strPrefix Then
            RegressionContextPart = _
                Mid$(CStr(arrParts(lngIndex)), Len(strPrefix) + 1)
            Exit Function
        End If
    Next lngIndex

    RegressionContextPart = "(missing)"
End Function

Private Sub RegressionCompareTargetTextContexts( _
    ByVal fileNo As Long, _
    ByVal pageNo As Long, _
    ByRef oldDoc As tPdfDocument, _
    ByRef goodDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldContextMap As Object, _
    ByVal goodContextMap As Object, _
    ByVal currentContextMap As Object, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Const METHOD_NAME As String = "RegressionCompareTargetTextContexts"
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngCurrentIndex As Long
    Dim lngGoodEnd As Long
    Dim lngGoodIndex As Long
    Dim lngGoodOrdinal As Long
    Dim lngGoodStart As Long
    Dim lngOldIndex As Long
    Dim strClass As String
    Dim strCurrentContext As String
    Dim strCurrentFontAlias As String
    Dim strCurrentFontSemantic As String
    Dim strDirection As String
    Dim strFamily As String
    Dim strGoodContext As String
    Dim strGoodFontAlias As String
    Dim strGoodFontSemantic As String
    Dim strOldContext As String
    Dim strOldFontAlias As String
    Dim strOldFontSemantic As String
    Dim strRole As String

    On Error GoTo ErrorHandler

    lngGoodStart = goodDoc.Pages(pageNo).TextStart
    lngGoodEnd = _
        lngGoodStart + _
        goodDoc.Pages(pageNo).TextCount - 1

    For lngGoodIndex = lngGoodStart To lngGoodEnd
        strRole = RegressionInferStructuralFieldRole( _
            pageNo, _
            goodDoc.Texts(lngGoodIndex).X, _
            goodDoc.Texts(lngGoodIndex).Y)

        If RegressionIsParserTargetRole(strRole) Then
            strClass = RegressionTargetRoleClass(strRole)

            lngCurrentIndex = RegressionFindCounterpartText( _
                currentDoc, _
                pageNo, _
                strRole, _
                goodDoc.Texts(lngGoodIndex).X, _
                goodDoc.Texts(lngGoodIndex).Y, _
                goodDoc.Texts(lngGoodIndex).TextValue)

            lngOldIndex = RegressionFindCounterpartText( _
                oldDoc, _
                pageNo, _
                strRole, _
                goodDoc.Texts(lngGoodIndex).X, _
                goodDoc.Texts(lngGoodIndex).Y, _
                goodDoc.Texts(lngGoodIndex).TextValue)

            If lngCurrentIndex < 0 Then
                strFamily = "TARGET_TEXT_MISSING_" & strClass

                Print #fileNo, _
                    "TARGET_REGRESSION" & _
                    "|family=" & strFamily & _
                    "|role=" & strRole & _
                    "|GOOD_TEXT=" & _
                    RegressionLimitText( _
                        goodDoc.Texts(lngGoodIndex).TextValue, _
                        120) & _
                    "|GOOD_X=" & NumTxt(goodDoc.Texts(lngGoodIndex).X) & _
                    "|GOOD_Y=" & NumTxt(goodDoc.Texts(lngGoodIndex).Y) & _
                    "|CURRENT=(missing)"

                Call RegressionAddIssue( _
                    dictIssueCounts, _
                    dictIssuePriorities, _
                    dictIssueSamples, _
                    strFamily, _
                    3, _
                    "page=" & CStr(pageNo) & _
                    "|role=" & strRole & _
                    "|GOOD_TEXT=" & _
                    RegressionLimitText( _
                        goodDoc.Texts(lngGoodIndex).TextValue, _
                        120) & _
                    "|GOOD_X=" & NumTxt(goodDoc.Texts(lngGoodIndex).X) & _
                    "|GOOD_Y=" & NumTxt(goodDoc.Texts(lngGoodIndex).Y))

                GoTo NextGoodText
            End If

            lngGoodOrdinal = _
                lngGoodIndex - _
                goodDoc.Pages(pageNo).TextStart + 1

            strGoodContext = RegressionContextByOrdinal( _
                goodContextMap, _
                lngGoodOrdinal)

            strCurrentContext = RegressionContextByOrdinal( _
                currentContextMap, _
                lngCurrentIndex - _
                currentDoc.Pages(pageNo).TextStart + 1)

            If lngOldIndex >= 0 Then
                strOldContext = RegressionContextByOrdinal( _
                    oldContextMap, _
                    lngOldIndex - _
                    oldDoc.Pages(pageNo).TextStart + 1)
            Else
                strOldContext = "(missing)"
            End If

            Call RegressionCompareTargetContextPart( _
                fileNo, _
                pageNo, _
                strRole, _
                strClass, _
                "OPERATOR_WINDOW", _
                RegressionContextPart(strOldContext, "OPS"), _
                RegressionContextPart(strGoodContext, "OPS"), _
                RegressionContextPart(strCurrentContext, "OPS"), _
                3, _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples)

            Call RegressionCompareTargetContextPart( _
                fileNo, _
                pageNo, _
                strRole, _
                strClass, _
                "PATH_NEIGHBOR", _
                RegressionContextPart(strOldContext, "PATH"), _
                RegressionContextPart(strGoodContext, "PATH"), _
                RegressionContextPart(strCurrentContext, "PATH"), _
                3, _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples)

            Call RegressionCompareTargetContextPart( _
                fileNo, _
                pageNo, _
                strRole, _
                strClass, _
                "RAW_OPERATOR_WINDOW", _
                RegressionContextPart(strOldContext, "RAW"), _
                RegressionContextPart(strGoodContext, "RAW"), _
                RegressionContextPart(strCurrentContext, "RAW"), _
                2, _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples)

            strGoodFontAlias = _
                goodDoc.Texts(lngGoodIndex).FontName & _
                "@" & NumTxt(goodDoc.Texts(lngGoodIndex).FontSize)

            strCurrentFontAlias = _
                currentDoc.Texts(lngCurrentIndex).FontName & _
                "@" & NumTxt(currentDoc.Texts(lngCurrentIndex).FontSize)

            If lngOldIndex >= 0 Then
                strOldFontAlias = _
                    oldDoc.Texts(lngOldIndex).FontName & _
                    "@" & NumTxt(oldDoc.Texts(lngOldIndex).FontSize)
            Else
                strOldFontAlias = "(missing)"
            End If

            Call RegressionCompareTargetContextPart( _
                fileNo, _
                pageNo, _
                strRole, _
                strClass, _
                "FONT_ALIAS_SIZE", _
                strOldFontAlias, _
                strGoodFontAlias, _
                strCurrentFontAlias, _
                2, _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples)

            strGoodFontSemantic = _
                RegressionTextFontSemanticSignature( _
                    goodDoc, _
                    pageNo, _
                    lngGoodIndex)

            strCurrentFontSemantic = _
                RegressionTextFontSemanticSignature( _
                    currentDoc, _
                    pageNo, _
                    lngCurrentIndex)

            If lngOldIndex >= 0 Then
                strOldFontSemantic = _
                    RegressionTextFontSemanticSignature( _
                        oldDoc, _
                        pageNo, _
                        lngOldIndex)
            Else
                strOldFontSemantic = "(missing)"
            End If

            Call RegressionCompareTargetContextPart( _
                fileNo, _
                pageNo, _
                strRole, _
                strClass, _
                "FONT_SEMANTIC", _
                strOldFontSemantic, _
                strGoodFontSemantic, _
                strCurrentFontSemantic, _
                3, _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples)

            If goodDoc.Texts(lngGoodIndex).TextValue <> _
               currentDoc.Texts(lngCurrentIndex).TextValue Then

                Print #fileNo, _
                    "TARGET_VALUE_INFO" & _
                    "|role=" & strRole & _
                    "|GOOD=" & _
                    RegressionLimitText( _
                        goodDoc.Texts(lngGoodIndex).TextValue, _
                        120) & _
                    "|CURRENT=" & _
                    RegressionLimitText( _
                        currentDoc.Texts(lngCurrentIndex).TextValue, _
                        120) & _
                    "|classification=INPUT_VALUE_NOT_USED_AS_PARSER_BREAK"
            End If
        End If

NextGoodText:
    Next lngGoodIndex

ExitSub:
    Exit Sub

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo", _
        pageNo

    errorManager.save
    Resume ExitSub
End Sub

Private Sub RegressionCompareTargetContextPart( _
    ByVal fileNo As Long, _
    ByVal pageNo As Long, _
    ByVal role As String, _
    ByVal roleClass As String, _
    ByVal contextFamily As String, _
    ByVal oldSignature As String, _
    ByVal goodSignature As String, _
    ByVal currentSignature As String, _
    ByVal basePriority As Long, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim lngPriority As Long
    Dim strDirection As String
    Dim strFamily As String

    If goodSignature = currentSignature Then
        Exit Sub
    End If

    strDirection = RegressionDirection( _
        oldSignature, _
        goodSignature, _
        currentSignature)

    strFamily = _
        "TARGET_" & contextFamily & "_" & roleClass

    lngPriority = RegressionPriorityFromDirection( _
        strDirection, _
        basePriority)

    Print #fileNo, _
        "TARGET_CONTEXT_DIFF" & _
        "|family=" & strFamily & _
        "|role=" & role & _
        "|direction=" & strDirection & _
        "|OLD=" & RegressionLimitText(oldSignature, 1100) & _
        "|GOOD=" & RegressionLimitText(goodSignature, 1100) & _
        "|CURRENT=" & RegressionLimitText(currentSignature, 1100)

    Call RegressionAddIssue( _
        dictIssueCounts, _
        dictIssuePriorities, _
        dictIssueSamples, _
        strFamily, _
        lngPriority, _
        "page=" & CStr(pageNo) & _
        "|role=" & role & _
        "|direction=" & strDirection & _
        "|GOOD=" & RegressionLimitText(goodSignature, 650) & _
        "|CURRENT=" & RegressionLimitText(currentSignature, 650))
End Sub

Private Function RegressionContextByOrdinal( _
    ByVal contextMap As Object, _
    ByVal ordinal As Long) As String

    If contextMap Is Nothing Then
        RegressionContextByOrdinal = "(map-error)"
    ElseIf contextMap.Exists(CStr(ordinal)) Then
        RegressionContextByOrdinal = _
            CStr(contextMap(CStr(ordinal)))
    Else
        RegressionContextByOrdinal = "(missing)"
    End If
End Function

Private Function RegressionFindCounterpartText( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal pageNo As Long, _
    ByVal targetRole As String, _
    ByVal targetX As Double, _
    ByVal targetY As Double, _
    ByVal targetText As String) As Long

    Const METHOD_NAME As String = "RegressionFindCounterpartText"
    Const MAX_Y_DISTANCE As Double = 3#
    Dim dblBestScore As Double
    Dim dblCurrentScore As Double
    Dim dblDx As Double
    Dim dblDy As Double
    Dim errorManager As New ErrorManager
    Dim errDescription As String
    Dim errNumber As Long
    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngStart As Long
    Dim strCandidateRole As String

    On Error GoTo ErrorHandler

    RegressionFindCounterpartText = -1
    dblBestScore = 1E+30

    If pageNo < 1 Or pageNo > pdfDoc.PageCount Then
        GoTo ExitFunction
    End If

    lngStart = pdfDoc.Pages(pageNo).TextStart
    lngEnd = lngStart + pdfDoc.Pages(pageNo).TextCount - 1

    For lngIndex = lngStart To lngEnd
        strCandidateRole = RegressionInferStructuralFieldRole( _
            pageNo, _
            pdfDoc.Texts(lngIndex).X, _
            pdfDoc.Texts(lngIndex).Y)

        If strCandidateRole = targetRole Then
            dblDy = Abs(pdfDoc.Texts(lngIndex).Y - targetY)

            If dblDy <= MAX_Y_DISTANCE Then
                dblDx = Abs(pdfDoc.Texts(lngIndex).X - targetX)
                dblCurrentScore = dblDy * 1000# + dblDx

                If pdfDoc.Texts(lngIndex).TextValue = targetText Then
                    dblCurrentScore = dblCurrentScore - 100000#
                End If

                If dblCurrentScore < dblBestScore Then
                    dblBestScore = dblCurrentScore
                    RegressionFindCounterpartText = lngIndex
                End If
            End If
        End If
    Next lngIndex

ExitFunction:
    Exit Function

ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    RegressionFindCounterpartText = -1

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "pageNo;targetRole;targetX;targetY", _
        pageNo, _
        targetRole, _
        targetX, _
        targetY

    errorManager.save
    Resume ExitFunction
End Function

Private Function RegressionIsParserTargetRole( _
    ByVal role As String) As Boolean

    If role = "TOP_ISIN" Or _
       role = "TOP_SCHLUSSTAG" Or _
       role = "TOP_VALUTATAG" Then

        RegressionIsParserTargetRole = True
        Exit Function
    End If

    If InStr(1, role, "WHG", vbBinaryCompare) > 0 Then
        RegressionIsParserTargetRole = True
    End If
End Function

Private Function RegressionTargetRoleClass( _
    ByVal role As String) As String

    If role = "TOP_ISIN" Then
        RegressionTargetRoleClass = "ISIN"
    ElseIf role = "TOP_SCHLUSSTAG" Or _
           role = "TOP_VALUTATAG" Then
        RegressionTargetRoleClass = "DATE"
    ElseIf InStr(1, role, "WHG", vbBinaryCompare) > 0 Then
        RegressionTargetRoleClass = "CURRENCY"
    Else
        RegressionTargetRoleClass = "OTHER"
    End If
End Function

Private Function RegressionInferStructuralFieldRole( _
    ByVal pageNo As Long, _
    ByVal x As Double, _
    ByVal y As Double) As String

    Dim strRowKind As String

    RegressionInferStructuralFieldRole = vbNullString
    strRowKind = RegressionOracleRowKind(pageNo, y)

    If strRowKind = "TOP" Then
        RegressionInferStructuralFieldRole = _
            RegressionTopFieldByX(x)
    ElseIf strRowKind = "BOTTOM" Then
        RegressionInferStructuralFieldRole = _
            RegressionBottomFieldByX(x)
    End If
End Function

Private Function RegressionOracleRowKind( _
    ByVal pageNo As Long, _
    ByVal y As Double) As String

    Const BASELINE_TOLERANCE As Double = 2#
    Const DATA_ROW_HEIGHT As Double = 18#
    Dim arrTopBaselines As Variant
    Dim dblBottom As Double
    Dim dblDistanceBottom As Double
    Dim dblDistanceTop As Double
    Dim dblTop As Double
    Dim lngIndex As Long

    RegressionOracleRowKind = vbNullString

    If pageNo = 1 Then
        arrTopBaselines = Array( _
            504#, _
            463.48, _
            423#, _
            382.48, _
            342#, _
            301.48, _
            261#, _
            220.48, _
            180#, _
            139.48, _
            99#)
    Else
        arrTopBaselines = Array( _
            558#, _
            517.48, _
            477#, _
            436.48, _
            396#, _
            355.48, _
            315#, _
            274.48, _
            234#, _
            193.48, _
            153#, _
            112.48)
    End If

    For lngIndex = LBound(arrTopBaselines) To UBound(arrTopBaselines)
        dblTop = CDbl(arrTopBaselines(lngIndex))
        dblBottom = dblTop - DATA_ROW_HEIGHT

        dblDistanceTop = Abs(y - dblTop)
        dblDistanceBottom = Abs(y - dblBottom)

        If dblDistanceTop <= BASELINE_TOLERANCE Or _
           dblDistanceBottom <= BASELINE_TOLERANCE Then

            If dblDistanceTop <= dblDistanceBottom Then
                RegressionOracleRowKind = "TOP"
            Else
                RegressionOracleRowKind = "BOTTOM"
            End If

            Exit Function
        End If
    Next lngIndex
End Function

