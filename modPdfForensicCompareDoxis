Private Function DoxisV18RelativeSeparatorSignature( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal packedAnchor As String, _
    ByVal targetX As Double, _
    ByRef matchedLineIndex As Long) As String

    Const MAX_TRANSACTION_LINE_GAP As Double = 8#
    Dim dblBandBottom As Double
    Dim dblBandTop As Double
    Dim dblBestScore As Double
    Dim dblGap As Double
    Dim dblLineMid As Double
    Dim dblLineX As Double
    Dim dblMidTarget As Double
    Dim dblScore As Double
    Dim dblYMax As Double
    Dim dblYMin As Double
    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngPage As Long
    Dim lngStart As Long

    matchedLineIndex = -1
    DoxisV18RelativeSeparatorSignature = "(none)"
    dblBestScore = 1E+30

    If Len(packedAnchor) = 0 Then
        DoxisV18RelativeSeparatorSignature = "MISSING_ANCHOR"
        Exit Function
    End If

    lngPage = DoxisV18AnchorPage(packedAnchor)
    If lngPage < 1 Or lngPage > pdfDoc.PageCount Then
        DoxisV18RelativeSeparatorSignature = "PAGE_MISSING"
        Exit Function
    End If

    dblBandBottom = DoxisV18AnchorBottomY(packedAnchor) - 6#
    dblBandTop = DoxisV18AnchorTopY(packedAnchor) + 2#
    dblMidTarget = DoxisV18AnchorBottomY(packedAnchor) + 4.5

    lngStart = pdfDoc.Pages(lngPage).LineStart
    lngEnd = lngStart + pdfDoc.Pages(lngPage).LineCount - 1

    For lngIndex = lngStart To lngEnd
        If Abs(pdfDoc.Lines(lngIndex).X1 - pdfDoc.Lines(lngIndex).X2) <= _
           DOXIS_LINE_X_TOLERANCE Then

            dblLineX = _
                (pdfDoc.Lines(lngIndex).X1 + pdfDoc.Lines(lngIndex).X2) / 2#

            If Abs(dblLineX - targetX) <= DOXIS_LINE_X_TOLERANCE Then
                dblYMin = MinDouble( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)

                dblYMax = MaxDouble( _
                    pdfDoc.Lines(lngIndex).Y1, _
                    pdfDoc.Lines(lngIndex).Y2)

                dblGap = DoxisVerticalGapToBand( _
                    dblYMin, _
                    dblYMax, _
                    dblBandBottom, _
                    dblBandTop)

                If dblGap <= MAX_TRANSACTION_LINE_GAP Then
                    dblLineMid = (dblYMin + dblYMax) / 2#
                    dblScore = _
                        dblGap * 100# + _
                        Abs(dblLineMid - dblMidTarget)

                    If dblScore < dblBestScore Then
                        dblBestScore = dblScore
                        matchedLineIndex = lngIndex
                    End If
                End If
            End If
        End If
    Next lngIndex

    If matchedLineIndex >= 0 Then
        dblLineX = _
            (pdfDoc.Lines(matchedLineIndex).X1 + _
             pdfDoc.Lines(matchedLineIndex).X2) / 2#

        dblYMin = MinDouble( _
            pdfDoc.Lines(matchedLineIndex).Y1, _
            pdfDoc.Lines(matchedLineIndex).Y2)

        dblYMax = MaxDouble( _
            pdfDoc.Lines(matchedLineIndex).Y1, _
            pdfDoc.Lines(matchedLineIndex).Y2)

        DoxisV18RelativeSeparatorSignature = _
            "x=" & NumTxt(dblLineX) & _
            ",dxTarget=" & NumTxt(dblLineX - targetX) & _
            ",relY=" & NumTxt(dblYMin - DoxisV18AnchorBottomY(packedAnchor)) & _
            ".." & NumTxt(dblYMax - DoxisV18AnchorBottomY(packedAnchor)) & _
            ",w=" & NumTxt(pdfDoc.Lines(matchedLineIndex).LineWidth) & _
            ",source=" & pdfDoc.Lines(matchedLineIndex).SourceOperator & _
            ",paint=" & pdfDoc.Lines(matchedLineIndex).PaintOperator & _
            ",color=" & pdfDoc.Lines(matchedLineIndex).StrokeColor
    End If
End Function

