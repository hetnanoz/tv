End Sub

Private Sub DoxisV181CompareGlobalProjectionRole( _
    ByVal fileNo As Long, _
    ByVal anchorId As String, _
    ByVal role As String, _
    ByRef oldDoc As tPdfDocument, _
    ByRef betterDoc As tPdfDocument, _
    ByRef currentDoc As tPdfDocument, _
    ByVal oldAnchor As String, _
    ByVal betterAnchor As String, _
    ByVal currentAnchor As String, _
    ByVal dictIssueCounts As Object, _
    ByVal dictIssuePriorities As Object, _
    ByVal dictIssueSamples As Object)

    Dim lngBetterCut As Long
    Dim lngBetterHiddenCut As Long
    Dim lngCurrentCut As Long
    Dim lngCurrentHiddenCut As Long
    Dim lngOldCut As Long
    Dim lngOldHiddenCut As Long
    Dim strBetter As String
    Dim strCurrent As String
    Dim strFamily As String
    Dim strOld As String
    Dim strSample As String

    strBetter = DoxisV181GlobalProjectionSnapshot( _
        betterDoc, betterAnchor, role, _
        lngBetterCut, lngBetterHiddenCut)

    strCurrent = DoxisV181GlobalProjectionSnapshot( _
        currentDoc, currentAnchor, role, _
        lngCurrentCut, lngCurrentHiddenCut)

    If Len(oldAnchor) > 0 Then
        strOld = DoxisV181GlobalProjectionSnapshot( _
            oldDoc, oldAnchor, role, _
            lngOldCut, lngOldHiddenCut)
    Else
        strOld = "MISSING"
        lngOldCut = -1
        lngOldHiddenCut = -1
    End If

    If strBetter <> "NO_TEXT" Or strCurrent <> "NO_TEXT" Then
        Print #fileNo, _
            "GLOBAL_X_PROJECTION" & _
            "|tx=" & anchorId & _
            "|role=" & role & _
            "|OLD=" & strOld & _
            "|BETTER=" & strBetter & _
            "|CURRENT=" & strCurrent
    End If

    If Len(oldAnchor) > 0 Then
        If DoxisV182CutIsWorse(lngCurrentCut, lngOldCut) Then
            strFamily = "DOXIS_V18_2_GLOBAL_VISIBLE_X_CUT_WORSE_VS_OLD_" & role
            strSample = _
                "tx=" & anchorId & _
                "|role=" & role & _
                "|OLD_cutAfter=" & DoxisV181OptionalCut(lngOldCut) & _
                "|BETTER_cutAfter=" & DoxisV181OptionalCut(lngBetterCut) & _
                "|CURRENT_cutAfter=" & DoxisV181OptionalCut(lngCurrentCut) & _
                "|comparisonBasis=OLD_ORACLE" & _
                "|hypothesis=vertical visible paths projected globally on X, row ownership ignored"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                DoxisV181ProjectionPriority(role), _
                strSample)
        End If

        If DoxisV182CutIsWorse(lngCurrentHiddenCut, lngOldHiddenCut) Then
            strFamily = "DOXIS_V18_2_GLOBAL_INVISIBLE_RE_N_CUT_WORSE_VS_OLD_" & role
            strSample = _
                "tx=" & anchorId & _
                "|role=" & role & _
                "|OLD_hiddenCutAfter=" & DoxisV181OptionalCut(lngOldHiddenCut) & _
                "|BETTER_hiddenCutAfter=" & DoxisV181OptionalCut(lngBetterHiddenCut) & _
                "|CURRENT_hiddenCutAfter=" & DoxisV181OptionalCut(lngCurrentHiddenCut) & _
                "|comparisonBasis=OLD_ORACLE" & _
                "|hypothesis=invisible re n vertical edges projected globally on X"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                DoxisV181ProjectionPriority(role), _
                strSample)
        End If

        If lngCurrentCut = lngOldCut And lngBetterCut <> lngOldCut Then
            Print #fileNo, _
                "GLOBAL_X_TRIAD_SIGNAL" & _
                "|tx=" & anchorId & _
                "|role=" & role & _
                "|visible=CURRENT_MATCHES_OLD_BETTER_DIFFERS"
        End If

        If lngCurrentHiddenCut = lngOldHiddenCut And _
           lngBetterHiddenCut <> lngOldHiddenCut Then

            Print #fileNo, _
                "GLOBAL_X_TRIAD_SIGNAL" & _
                "|tx=" & anchorId & _
                "|role=" & role & _
                "|invisible=CURRENT_MATCHES_OLD_BETTER_DIFFERS"
        End If
    Else
        If DoxisV182CutIsWorse(lngCurrentCut, lngBetterCut) Then
            strFamily = "DOXIS_V18_2_GLOBAL_VISIBLE_X_CUT_WORSE_" & role
            strSample = _
                "tx=" & anchorId & _
                "|role=" & role & _
                "|BETTER_cutAfter=" & DoxisV181OptionalCut(lngBetterCut) & _
                "|CURRENT_cutAfter=" & DoxisV181OptionalCut(lngCurrentCut) & _
                "|comparisonBasis=BETTER_FALLBACK_OLD_MISSING"

            Call DoxisAddIssue( _
                dictIssueCounts, _
                dictIssuePriorities, _
                dictIssueSamples, _
                strFamily, _
                DoxisV181ProjectionPriority(role), _
                strSample)
        End If
    End If
End Sub

Private Function DoxisV181GlobalProjectionSnapshot( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal packedAnchor As String, _
    ByVal role As String, _
    ByRef visibleCutAfter As Long, _
    ByRef hiddenCutAfter As Long) As String

    Dim dblEndX As Double
    Dim dblLineX As Double
    Dim dblTextX As Double
    Dim dblTextWidth As Double
    Dim lngEnd As Long
    Dim lngHiddenHits As Long
    Dim lngIndex As Long
    Dim lngPage As Long
    Dim lngStart As Long
    Dim lngTextIndex As Long
    Dim lngVisibleHits As Long
    Dim lngCandidateCut As Long
    Dim strHidden As String
    Dim strVisible As String
    Dim strValue As String

    visibleCutAfter = -1
    hiddenCutAfter = -1
    DoxisV181GlobalProjectionSnapshot = "NO_TEXT"

    lngTextIndex = DoxisV18FindTextInAnchor(pdfDoc, packedAnchor, role)
    If lngTextIndex < 0 Then Exit Function

    lngPage = pdfDoc.Texts(lngTextIndex).PageNo
    strValue = pdfDoc.Texts(lngTextIndex).TextValue
    dblTextX = pdfDoc.Texts(lngTextIndex).X
    dblTextWidth = EstimateTextWidth( _
        strValue, _
        pdfDoc.Texts(lngTextIndex).FontName, _
        pdfDoc.Texts(lngTextIndex).FontSize)

    dblEndX = dblTextX + dblTextWidth

    lngStart = pdfDoc.Pages(lngPage).LineStart
    lngEnd = lngStart + pdfDoc.Pages(lngPage).LineCount - 1

    For lngIndex = lngStart To lngEnd
        If Abs(pdfDoc.Lines(lngIndex).X1 - pdfDoc.Lines(lngIndex).X2) <= _
           DOXIS_LINE_X_TOLERANCE Then

            dblLineX = _
                (pdfDoc.Lines(lngIndex).X1 + pdfDoc.Lines(lngIndex).X2) / 2#

            If DoxisV181XInsideText( _
                dblLineX, dblTextX, dblEndX) Then

                lngCandidateCut = DoxisPredictCutCharacter( _
                    strValue, _
                    pdfDoc.Texts(lngTextIndex).FontName, _
                    pdfDoc.Texts(lngTextIndex).FontSize, _
                    dblTextX, _
                    dblLineX)

                If visibleCutAfter < 0 Or lngCandidateCut < visibleCutAfter Then
                    visibleCutAfter = lngCandidateCut
                End If

                lngVisibleHits = lngVisibleHits + 1
                If lngVisibleHits <= 6 Then
                    If Len(strVisible) > 0 Then strVisible = strVisible & ","
                    strVisible = strVisible & _
                        NumTxt(dblLineX) & ":" & CStr(lngCandidateCut) & _
                        ":" & pdfDoc.Lines(lngIndex).SourceOperator & _
                        "/" & pdfDoc.Lines(lngIndex).PaintOperator
                End If
            End If
        End If
    Next lngIndex

    lngStart = pdfDoc.Pages(lngPage).NoPaintLineStart
    lngEnd = lngStart + pdfDoc.Pages(lngPage).NoPaintLineCount - 1

    For lngIndex = lngStart To lngEnd
        If LCase$(Trim$(pdfDoc.NoPaintLines(lngIndex).SourceOperator)) = "re" And _
           LCase$(Trim$(pdfDoc.NoPaintLines(lngIndex).PaintOperator)) = "n" Then

            If Abs(pdfDoc.NoPaintLines(lngIndex).X1 - pdfDoc.NoPaintLines(lngIndex).X2) <= _
               DOXIS_LINE_X_TOLERANCE Then

                dblLineX = _
                    (pdfDoc.NoPaintLines(lngIndex).X1 + _
                     pdfDoc.NoPaintLines(lngIndex).X2) / 2#

                If DoxisV181XInsideText( _
                    dblLineX, dblTextX, dblEndX) Then

                    lngCandidateCut = DoxisPredictCutCharacter( _
                        strValue, _
                        pdfDoc.Texts(lngTextIndex).FontName, _
                        pdfDoc.Texts(lngTextIndex).FontSize, _
                        dblTextX, _
                        dblLineX)

                    If hiddenCutAfter < 0 Or lngCandidateCut < hiddenCutAfter Then
                        hiddenCutAfter = lngCandidateCut
                    End If

                    lngHiddenHits = lngHiddenHits + 1
                    If lngHiddenHits <= 6 Then
                        If Len(strHidden) > 0 Then strHidden = strHidden & ","
                        strHidden = strHidden & _
                            NumTxt(dblLineX) & ":" & CStr(lngCandidateCut) & _
                            ":re/n"
                    End If
                End If
            End If
        End If
    Next lngIndex

    DoxisV181GlobalProjectionSnapshot = _
        "text=" & SanitizeReportText(strValue) & _
        "|x=" & NumTxt(dblTextX) & ".." & NumTxt(dblEndX) & _
        "|visibleHits=" & CStr(lngVisibleHits) & _
        "|visibleMinCut=" & DoxisV181OptionalCut(visibleCutAfter) & _
        "|visibleX=" & IIf(Len(strVisible) = 0, "(none)", strVisible) & _
        "|reNhiddenHits=" & CStr(lngHiddenHits) & _
        "|reNhiddenMinCut=" & DoxisV181OptionalCut(hiddenCutAfter) & _
        "|reNhiddenX=" & IIf(Len(strHidden) = 0, "(none)", strHidden)
End Function

Private Function DoxisV181XInsideText( _
    ByVal candidateX As Double, _
    ByVal textX As Double, _
    ByVal textEndX As Double) As Boolean

    DoxisV181XInsideText = _
        candidateX > textX + DOXIS_GLOBAL_PROJECTION_EDGE_MARGIN And _
        candidateX < textEndX - DOXIS_GLOBAL_PROJECTION_EDGE_MARGIN
End Function

Private Function DoxisV181OptionalCut(ByVal cutValue As Long) As String
    If cutValue < 0 Then
        DoxisV181OptionalCut = "NONE"
    Else
        DoxisV181OptionalCut = CStr(cutValue)
    End If
End Function

Private Function DoxisV181ProjectionPriority(ByVal role As String) As Long
    Select Case role
        Case "TOP_ISIN", _
             "TOP_SCHLUSSTAG", _
             "TOP_WHG_NOMINALE", _
             "BOTTOM_WHG_MAKLER", _
             "BOTTOM_WHG_STEUERN", _
             "BOTTOM_WHG_ABWICKLUNG", _
             "BOTTOM_WHG_SPESEN", _
             "BOTTOM_WHG_ABRECH"
            DoxisV181ProjectionPriority = 3

        Case Else
            DoxisV181ProjectionPriority = 2
    End Select
End Function

