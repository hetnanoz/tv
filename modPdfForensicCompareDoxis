Private Function RegressionOperatorSummary( _
    ByVal operatorName As String, _
    ByVal h0 As String, _
    ByVal h1 As String, _
    ByVal h2 As String, _
    ByVal h3 As String, _
    ByVal h4 As String, _
    ByVal h5 As String) As String

    Select Case operatorName
        Case "Tf"
            RegressionOperatorSummary = _
                "Tf(" & h1 & "," & h0 & ")"

        Case "Tm", "cm"
            RegressionOperatorSummary = _
                operatorName & _
                "(" & h5 & "," & h4 & "," & h3 & "," & _
                h2 & "," & h1 & "," & h0 & ")"

        Case "Td", "TD", "m", "l"
            RegressionOperatorSummary = _
                operatorName & "(" & h1 & "," & h0 & ")"

        Case "re"
            RegressionOperatorSummary = _
                "re(" & h3 & "," & h2 & "," & h1 & "," & h0 & ")"

        Case "w", "G", "g", "J", "j", "M", "Tr", "Tc", "Tw", "Tz", "Ts"
            RegressionOperatorSummary = _
                operatorName & "(" & h0 & ")"

        Case "RG", "rg"
            RegressionOperatorSummary = _
                operatorName & "(" & h2 & "," & h1 & "," & h0 & ")"

        Case "K", "k"
            RegressionOperatorSummary = _
                operatorName & _
                "(" & h3 & "," & h2 & "," & h1 & "," & h0 & ")"

        Case "Do"
            RegressionOperatorSummary = _
                "Do(" & h0 & ")"

        Case "Tj", "'", """", "TJ"
            RegressionOperatorSummary = operatorName & "(<TEXT>)"

        Case Else
            RegressionOperatorSummary = operatorName
    End Select
End Function

Private Function RegressionArrayWindow( _
    ByRef values() As String, _
    ByVal valueCount As Long, _
    ByVal centreIndex As Long, _
    ByVal radius As Long) As String

    Dim lngEnd As Long
    Dim lngIndex As Long
    Dim lngStart As Long
    Dim strResult As String

    If valueCount <= 0 Then
        RegressionArrayWindow = "(none)"
        Exit Function
    End If

    lngStart = centreIndex - radius
    If lngStart < 0 Then
        lngStart = 0
    End If

    lngEnd = centreIndex + radius
    If lngEnd > valueCount - 1 Then
        lngEnd = valueCount - 1
    End If

    For lngIndex = lngStart To lngEnd
        If Len(strResult) > 0 Then
            strResult = strResult & ">"
        End If

        strResult = strResult & _
            CStr(lngIndex + 1) & ":" & values(lngIndex)
    Next lngIndex

    RegressionArrayWindow = RegressionLimitText(strResult, 1400)
End Function

