ErrorHandler:
    errNumber = VBA.Err.Number
    errDescription = VBA.Err.Description
    BuildParserRegressionSuperShortOutputPath = vbNullString

    errorManager.addError _
        CLASS_NAME, _
        METHOD_NAME, _
        errNumber, _
        errDescription, _
        "goodPdfPath;currentPdfPath", _
        goodPdfPath, _
        currentPdfPath

    errorManager.save
