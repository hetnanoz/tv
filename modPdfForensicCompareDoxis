Private Function DoxisV182CountPaintedPrimitive( _
    ByRef pdfDoc As tPdfDocument, _
    ByVal sourceOperator As String) As Long

    Dim lngIndex As Long

    For lngIndex = 0 To pdfDoc.LineCount - 1
        If LCase$(Trim$(pdfDoc.Lines(lngIndex).SourceOperator)) = _
           LCase$(Trim$(sourceOperator)) Then

            If LCase$(Trim$(pdfDoc.Lines(lngIndex).PaintOperator)) <> "n" Then
                DoxisV182CountPaintedPrimitive = _
                    DoxisV182CountPaintedPrimitive + 1
            End If
        End If
    Next lngIndex
End Function


